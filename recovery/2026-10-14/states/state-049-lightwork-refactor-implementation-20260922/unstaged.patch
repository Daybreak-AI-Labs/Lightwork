+async def goal_stream(request, world, goal_id, *, since, lease, visible,
+                      legacy=False, limit=0, max_batch=200, poll=0.5,
+                      max_poll=5.0, heartbeat=30.0, lifetime=300.0,
+                      clock=None, sleep=asyncio.sleep):
