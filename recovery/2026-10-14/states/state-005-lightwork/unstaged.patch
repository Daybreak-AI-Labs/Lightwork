+ordinary world tables their required DML first, then narrow the canonical
+audit, scheduler, and promotion relations; their admission gates reject extra
+privilege:
+
+```sql
+REVOKE CREATE ON SCHEMA public FROM PUBLIC;
+REVOKE CREATE ON SCHEMA public FROM maverick_runtime;
+GRANT USAGE ON SCHEMA public TO maverick_runtime;
+REVOKE CREATE, TEMPORARY ON DATABASE maverick FROM PUBLIC;
+REVOKE CREATE, TEMPORARY ON DATABASE maverick FROM maverick_runtime;
+GRANT CONNECT ON DATABASE maverick TO maverick_runtime;
+
+GRANT SELECT, INSERT, UPDATE, DELETE
+  ON ALL TABLES IN SCHEMA public TO maverick_runtime;
+GRANT USAGE, SELECT, UPDATE
+  ON ALL SEQUENCES IN SCHEMA public TO maverick_runtime;
+
+-- Runtime startup reads the migration ledger but can never advance it.
+REVOKE INSERT, UPDATE, DELETE, TRUNCATE, REFERENCES, TRIGGER
+  ON schema_migrations FROM maverick_runtime;
+
+-- Canonical audit events are append-only; only the head row is mutable.
+REVOKE UPDATE, DELETE, TRUNCATE, REFERENCES, TRIGGER
+  ON canonical_audit_events FROM maverick_runtime;
+REVOKE DELETE, TRUNCATE, REFERENCES, TRIGGER
+  ON canonical_audit_heads FROM maverick_runtime;
