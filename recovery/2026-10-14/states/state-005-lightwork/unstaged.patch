+def _legacy_oauth_path(tenant_id: str) -> Path:
+    from .paths import _tenant_segment, maverick_home
+
+    # Shared namespace admission already happened in the tenant registry. Do
+    # not create/read a host-local namespace claim merely to inspect legacy
+    # cutover state.
+    return (
+        maverick_home()
+        / "tenants"
+        / _tenant_segment(tenant_id)
+        / "oauth"
+        / "tokens.sealed"
