+    return tuple(
+        item.strip().strip("\"'")
+        for item in str(value or "").strip("{}").split(",")
+        if item.strip()
+    )
+
+
+def _canonical_promotion_check(value: object) -> str:
+    text = str(value or "").lower().replace('"', "")
+    for cast in (
+        "::text",
+        "::bigint",
+        "::integer",
+        "::float8",
+        "::double precision",
+    ):
+        text = text.replace(cast, "")
+    text = text.replace("check", "", 1)
+    return "".join(text.split()).replace("(", "").replace(")", "")
+
+
+def _promotion_check_is_exact(name: str, definition: object) -> bool:
+    actual = _canonical_promotion_check(definition)
+    expected = _canonical_promotion_check(
+        next(
+            expression
+            for checks in _POSTGRES_PROMOTION_CHECKS.values()
+            if (expression := checks.get(name)) is not None
+        )
+    )
+    if actual == expected:
+        return True
+    if name.endswith("tenant_len"):
+        return actual == _canonical_promotion_check(
+            "char_length(tenant_id) >= 1 AND char_length(tenant_id) <= 201"
+        )
+    if name == "ck_mvk_promotion_event_kind":
+        return actual == _canonical_promotion_check(
+            "event_kind = ANY (ARRAY['promote', 'prepare', 'commit', 'abort', "
+            "'recovery_conflict', 'rollback'])"
+        )
+    return False
+
+
+def _promotion_policy_expression_is_exact(value: object) -> bool:
+    text = "".join(str(value or "").lower().split()).replace("::text", "")
+    expected = "tenant_id=nullif(current_setting('maverick.tenant',true),'')"
+    return text in {expected, f"({expected})"}
+
+
+def _promotion_policy_rows_are_exact(rows: object) -> bool:
+    if not isinstance(rows, (tuple, list)) or len(rows) != 1:
+        return False
+    row = rows[0]
+    return (
+        str(_promotion_row_value(row, 0, "policyname"))
+        == _POSTGRES_PROMOTION_POLICY
+        and str(_promotion_row_value(row, 1, "permissive")).upper()
+        == "PERMISSIVE"
+        and _promotion_pg_array(_promotion_row_value(row, 2, "roles"))
+        == ("public",)
+        and str(_promotion_row_value(row, 3, "cmd")).upper() == "ALL"
+        and _promotion_policy_expression_is_exact(
+            _promotion_row_value(row, 4, "qual")
+        )
+        and _promotion_policy_expression_is_exact(
+            _promotion_row_value(row, 5, "with_check")
+        )
+    )
+
+
+def _promotion_policy_sql(table: str) -> str:
+    """Canonical tenant-policy SQL shared with migration parity tests."""
+    return (
+        f"CREATE POLICY {_POSTGRES_PROMOTION_POLICY} ON {table} "
+        "FOR ALL TO PUBLIC "
+        "USING (tenant_id = "
+        "nullif(current_setting('maverick.tenant', true), '')) "
+        "WITH CHECK (tenant_id = "
+        "nullif(current_setting('maverick.tenant', true), ''))"
+    )
+
+
+def _promotion_role_is_safe(conn: Any) -> bool:
+    row = conn.execute(
+        "SELECT rolsuper, rolbypassrls, rolcreaterole, rolcreatedb, "
+        "rolreplication FROM pg_roles WHERE rolname=current_user"
+    ).fetchone()
+    return bool(
+        row is not None
+        and not bool(_promotion_row_value(row, 0, "rolsuper"))
+        and not bool(_promotion_row_value(row, 1, "rolbypassrls"))
+        and not bool(_promotion_row_value(row, 2, "rolcreaterole"))
+        and not bool(_promotion_row_value(row, 3, "rolcreatedb"))
+        and not bool(_promotion_row_value(row, 4, "rolreplication"))
+    )
+
+
+def _promotion_schema_access_is_exact(conn: Any) -> bool:
+    row = conn.execute(
+        "SELECT n.nspowner=(SELECT oid FROM pg_roles "
+        "WHERE rolname=current_user) AS role_owns, "
+        "pg_has_role(current_user, n.nspowner, 'MEMBER') AS owner_member, "
+        "has_schema_privilege(current_user, n.oid, 'USAGE') AS can_use, "
+        "has_schema_privilege(current_user, current_schema(), 'CREATE') "
+        "AS can_create FROM pg_namespace n "
+        "WHERE n.nspname=current_schema()"
+    ).fetchone()
+    return bool(
+        row is not None
+        and not bool(_promotion_row_value(row, 0, "role_owns"))
+        and not bool(_promotion_row_value(row, 1, "owner_member"))
+        and bool(_promotion_row_value(row, 2, "can_use"))
+        and not bool(_promotion_row_value(row, 3, "can_create"))
+    )
+
+
+def _promotion_database_access_is_exact(conn: Any) -> bool:
+    # TEMP would let the runtime shadow every unqualified ledger relation via
+    # pg_temp; database CREATE would let it provision an attacker-owned schema.
+    row = conn.execute(
+        "SELECT has_database_privilege(current_user, current_database(), "
+        "'CREATE') AS can_create, "
+        "has_database_privilege(current_user, current_database(), "
+        "'TEMP') AS can_temp"
+    ).fetchone()
+    return bool(
+        row is not None
+        and not bool(_promotion_row_value(row, 0, "can_create"))
+        and not bool(_promotion_row_value(row, 1, "can_temp"))
+    )
+
+
+def _promotion_database_identity(conn: Any) -> tuple[str, str, str]:
+    row = conn.execute(
+        "SELECT current_database() AS database_name, "
+        "current_schema() AS schema_name, current_user AS role_name"
+    ).fetchone()
+    values = tuple(
+        _promotion_row_value(row, index, name)
+        for index, name in enumerate(
+            ("database_name", "schema_name", "role_name")
+        )
+    )
+    if not all(isinstance(value, str) and value for value in values):
+        raise PromotionLedgerError(
+            "shared promotion database identity is unavailable"
+        )
+    return str(values[0]), str(values[1]), str(values[2])
+
+
+def _promotion_table_access_owner(
+    conn: Any,
+    table: str,
+) -> str | None:
+    privilege_columns = ", ".join(
+        "has_table_privilege(current_user, c.oid, "
+        f"'{privilege}') AS can_{privilege.lower()}"
+        for privilege in _POSTGRES_PROMOTION_ALL_TABLE_PRIVILEGES
+    )
+    grant_columns = ", ".join(
+        "has_table_privilege(current_user, c.oid, "
+        f"'{privilege} WITH GRANT OPTION') AS grant_{privilege.lower()}"
+        for privilege in _POSTGRES_PROMOTION_ALL_TABLE_PRIVILEGES
+    )
+    row = conn.execute(
+        "SELECT c.relowner::regrole::text AS owner_name, "
+        "c.relowner=(SELECT oid FROM pg_roles WHERE rolname=current_user) "
+        "AS role_owns, "
+        "pg_has_role(current_user, c.relowner, 'MEMBER') AS owner_member, "
+        f"{privilege_columns}, {grant_columns} "
+        "FROM pg_class c WHERE c.oid="
+        "to_regclass(current_schema() || '.' || %s)",
+        (table,),
+    ).fetchone()
+    if row is None:
+        return None
+    owner = _promotion_row_value(row, 0, "owner_name")
+    if (
+        not isinstance(owner, str)
+        or not owner
+        or bool(_promotion_row_value(row, 1, "role_owns"))
+        or bool(_promotion_row_value(row, 2, "owner_member"))
+    ):
+        return None
+    expected = _POSTGRES_PROMOTION_TABLE_PRIVILEGES[table]
+    offset = 3
+    for index, privilege in enumerate(_POSTGRES_PROMOTION_ALL_TABLE_PRIVILEGES):
+        granted = bool(
+            _promotion_row_value(
+                row,
+                offset + index,
+                f"can_{privilege.lower()}",
+            )
+        )
+        if granted != (privilege in expected):
+            return None
+    offset += len(_POSTGRES_PROMOTION_ALL_TABLE_PRIVILEGES)
+    if any(
+        bool(
+            _promotion_row_value(
+                row,
+                offset + index,
+                f"grant_{privilege.lower()}",
+            )
+        )
+        for index, privilege in enumerate(_POSTGRES_PROMOTION_ALL_TABLE_PRIVILEGES)
+    ):
+        return None
+    public = conn.execute(
+        "SELECT privilege_type FROM pg_class c, "
+        "LATERAL aclexplode(COALESCE(c.relacl, "
+        "acldefault('r', c.relowner))) acl "
+        "WHERE c.oid=to_regclass(current_schema() || '.' || %s) "
+        "AND acl.grantee=0",
+        (table,),
+    ).fetchall()
+    if public:
+        return None
+    return owner
+
+
+def _promotion_table_exists(conn: Any, table: str) -> bool:
+    row = conn.execute(
+        "SELECT to_regclass(current_schema() || '.' || %s) AS table_name",
+        (table,),
+    ).fetchone()
+    return _promotion_row_value(row, 0, "table_name") is not None
+
+
+def _promotion_table_schema_is_exact(conn: Any, table: str) -> bool:
+    rows = conn.execute(
+        "SELECT column_name, data_type, is_nullable "
+        "FROM information_schema.columns "
+        "WHERE table_schema=current_schema() AND table_name=%s "
+        "ORDER BY ordinal_position",
+        (table,),
+    ).fetchall()
+    columns = tuple(
+        (
+            str(_promotion_row_value(row, 0, "column_name")),
+            str(_promotion_row_value(row, 1, "data_type")).lower(),
+            str(_promotion_row_value(row, 2, "is_nullable")).upper(),
+        )
+        for row in rows
+    )
+    if columns != _POSTGRES_PROMOTION_COLUMNS[table]:
+        return False
+
+    primary = conn.execute(
+        "SELECT array_agg(a.attname ORDER BY keys.ordinality) AS columns "
+        "FROM pg_index i JOIN pg_class c ON c.oid=i.indrelid "
+        "JOIN unnest(i.indkey) WITH ORDINALITY AS keys(attnum, ordinality) "
+        "ON true JOIN pg_attribute a ON a.attrelid=c.oid "
+        "AND a.attnum=keys.attnum "
+        "WHERE c.oid=to_regclass(current_schema() || '.' || %s) "
+        "AND i.indisprimary GROUP BY i.indexrelid",
+        (table,),
+    ).fetchone()
+    if primary is None or _promotion_pg_array(
+        _promotion_row_value(primary, 0, "columns")
+    ) != _POSTGRES_PROMOTION_PRIMARY_KEYS[table]:
+        return False
+
+    checks = conn.execute(
+        "SELECT conname, pg_get_constraintdef(oid) AS definition, convalidated "
+        "FROM pg_constraint WHERE conrelid="
+        "to_regclass(current_schema() || '.' || %s) AND contype='c' "
+        "ORDER BY conname",
+        (table,),
+    ).fetchall()
+    if {
+        str(_promotion_row_value(row, 0, "conname")) for row in checks
+    } != set(_POSTGRES_PROMOTION_CHECKS[table]) or not all(
+        bool(_promotion_row_value(row, 2, "convalidated"))
+        and _promotion_check_is_exact(
+            str(_promotion_row_value(row, 0, "conname")),
+            _promotion_row_value(row, 1, "definition"),
+        )
+        for row in checks
+    ):
+        return False
+
+    foreign_keys = conn.execute(
+        "SELECT conname, pg_get_constraintdef(oid) AS definition, convalidated "
+        "FROM pg_constraint WHERE conrelid="
+        "to_regclass(current_schema() || '.' || %s) AND contype='f' "
+        "ORDER BY conname",
+        (table,),
+    ).fetchall()
+    if table == "promotion_ledger_heads":
+        if foreign_keys:
+            return False
+    else:
+        if len(foreign_keys) != 1:
+            return False
+        foreign = foreign_keys[0]
+        definition = " ".join(
+            str(_promotion_row_value(foreign, 1, "definition"))
+            .lower()
+            .replace('"', "")
+            .split()
+        )
+        if not (
+            str(_promotion_row_value(foreign, 0, "conname"))
+            == "fk_mvk_promotion_event_head"
+            and bool(_promotion_row_value(foreign, 2, "convalidated"))
+            and "foreign key (tenant_id)" in definition
+            and "references" in definition
+            and "promotion_ledger_heads(tenant_id)" in definition
+            and "on delete restrict" in definition
+        ):
+            return False
+
+    rls = conn.execute(
+        "SELECT relrowsecurity, relforcerowsecurity FROM pg_class "
+        "WHERE oid=to_regclass(current_schema() || '.' || %s)",
+        (table,),
+    ).fetchone()
+    if not rls or not (
+        bool(_promotion_row_value(rls, 0, "relrowsecurity"))
+        and bool(_promotion_row_value(rls, 1, "relforcerowsecurity"))
+    ):
+        return False
+    policies = conn.execute(
+        "SELECT policyname, permissive, roles, cmd, qual, with_check "
+        "FROM pg_policies WHERE schemaname=current_schema() "
+        "AND tablename=%s ORDER BY policyname",
+        (table,),
+    ).fetchall()
+    return _promotion_policy_rows_are_exact(list(policies))
+
+
+def _promotion_append_only_trigger_is_exact(
+    conn: Any,
+    *,
+    expected_owner: str,
+) -> bool:
+    rows = conn.execute(
+        "SELECT tgname, tgenabled, pg_get_triggerdef(t.oid) AS definition "
+        "FROM pg_trigger t "
+        "WHERE tgrelid=to_regclass(current_schema() || "
+        "'.promotion_ledger_events') AND NOT tgisinternal "
+        "ORDER BY tgname"
+    ).fetchall()
+    if len(rows) != 1:
+        return False
+    row = rows[0]
+    definition = " ".join(
+        str(_promotion_row_value(row, 2, "definition")).lower().split()
+    )
+    try:
+        trigger_events = {
+            item.strip()
+            for item in definition.split("before ", 1)[1]
+            .split(" on ", 1)[0]
+            .split(" or ")
+        }
+    except (IndexError, ValueError):
+        return False
+    if not (
+        str(_promotion_row_value(row, 0, "tgname"))
+        == "mvk_promotion_events_append_only"
+        and str(_promotion_row_value(row, 1, "tgenabled")) == "O"
+        and trigger_events == {"update", "delete", "truncate"}
+        and "promotion_ledger_events" in definition
+        and "for each statement execute function" in definition
+        and "mvk_reject_promotion_event_mutation()" in definition
+    ):
+        return False
+    function = conn.execute(
+        "SELECT p.prosecdef, p.proconfig, p.prosrc, l.lanname, "
+        "p.prorettype::regtype::text AS return_type, "
+        "p.proowner::regrole::text AS owner_name, "
+        "pg_has_role(current_user, p.proowner, 'MEMBER') AS owner_member, "
+        "has_function_privilege(current_user, p.oid, 'EXECUTE') "
+        "AS can_execute, "
+        "has_function_privilege(current_user, p.oid, "
+        "'EXECUTE WITH GRANT OPTION') AS grant_execute "
+        "FROM pg_proc p JOIN pg_language l ON l.oid=p.prolang "
+        "WHERE p.oid=to_regprocedure(%s)",
+        ("mvk_reject_promotion_event_mutation()",),
+    ).fetchone()
+    if function is None:
+        return False
+    config = _promotion_pg_array(
+        _promotion_row_value(function, 1, "proconfig")
+    )
+    body = " ".join(
+        str(_promotion_row_value(function, 2, "prosrc")).lower().split()
+    )
+    return (
+        not bool(_promotion_row_value(function, 0, "prosecdef"))
+        and config == ("search_path=pg_catalog",)
+        and body
+        == "begin raise exception 'promotion ledger events are append-only'; end"
+        and str(_promotion_row_value(function, 3, "lanname")) == "plpgsql"
+        and str(_promotion_row_value(function, 4, "return_type")) == "trigger"
+        and str(_promotion_row_value(function, 5, "owner_name"))
+        == expected_owner
+        and not bool(_promotion_row_value(function, 6, "owner_member"))
+        and not bool(_promotion_row_value(function, 7, "can_execute"))
+        and not bool(_promotion_row_value(function, 8, "grant_execute"))
+        and not conn.execute(
+            "SELECT privilege_type FROM pg_proc p, "
+            "LATERAL aclexplode(COALESCE(p.proacl, "
+            "acldefault('f', p.proowner))) acl "
+            "WHERE p.oid=to_regprocedure(%s) AND acl.grantee=0",
+            ("mvk_reject_promotion_event_mutation()",),
+        ).fetchall()
+    )
+
+
+def _promotion_schema_status(conn: Any) -> str:
+    if not _promotion_role_is_safe(conn):
+        return "unsafe-role"
+    if not _promotion_database_access_is_exact(conn):
+        return "unsafe-role"
+    if not _promotion_schema_access_is_exact(conn):
+        return "unsafe-role"
+    existence = tuple(
+        _promotion_table_exists(conn, table)
+        for table in _POSTGRES_PROMOTION_TABLES
+    )
+    if not any(existence):
+        return "missing"
+    if not all(existence):
+        return "incompatible"
+    if not all(
+        _promotion_table_schema_is_exact(conn, table)
+        for table in _POSTGRES_PROMOTION_TABLES
+    ):
+        return "incompatible"
+    owners = tuple(
+        _promotion_table_access_owner(conn, table)
+        for table in _POSTGRES_PROMOTION_TABLES
+    )
+    if any(owner is None for owner in owners) or len(set(owners)) != 1:
+        return "unsafe-role"
+    if not _promotion_append_only_trigger_is_exact(
+        conn,
+        expected_owner=str(owners[0]),
+    ):
+        return "incompatible"
+    return "ready"
+
+
+def _initialize_promotion_postgres_schema(conn: Any) -> None:
+    """Verify an owner-provisioned schema without granting runtime DDL."""
+    status = _promotion_schema_status(conn)
+    if status == "ready":
+        return
+    if status == "unsafe-role":
+        raise PromotionLedgerError(
+            "shared promotion authority requires a least-privilege runtime role"
+        )
+    if status == "missing":
+        raise PromotionLedgerError(
+            "shared promotion schema must be provisioned by a separate owner"
+        )
+    raise PromotionLedgerError("shared promotion schema is incompatible")
+
+
+def _promotion_tenant_lock_key(tenant: str) -> int:
+    digest = hashlib.blake2b(
+        f"maverick:promotion-ledger:{tenant}".encode(),
+        digest_size=8,
+    ).digest()
+    return int.from_bytes(digest, "big", signed=True)
+
+
+def _promotion_projection(
+    records: Mapping[str, PromotionRecord],
+    transactions: Mapping[str, PromotionTransaction],
+) -> dict[str, Any]:
+    return {
+        "version": _JOURNAL_VERSION,
+        "records": [
+            record.to_dict()
+            for record in sorted(
+                records.values(),
+                key=lambda item: (item.promoted_at, item.id),
+            )
+        ],
+        "transactions": [
+            transaction.to_dict()
+            for transaction in sorted(
+                transactions.values(),
+                key=lambda item: (item.prepared_at, item.id),
+            )
+        ],
+    }
+
+
+def _promotion_projection_state(
+    raw: Any,
+) -> tuple[dict[str, PromotionRecord], dict[str, PromotionTransaction]]:
+    if not isinstance(raw, dict) or raw.get("version") != _JOURNAL_VERSION:
+        raise PromotionLedgerError("shared promotion projection is malformed")
+    if set(raw) != {"version", "records", "transactions"}:
+        raise PromotionLedgerError("shared promotion projection is malformed")
+    raw_records = raw.get("records")
+    raw_transactions = raw.get("transactions")
+    if not isinstance(raw_records, list) or not isinstance(raw_transactions, list):
+        raise PromotionLedgerError("shared promotion projection is malformed")
+    records: dict[str, PromotionRecord] = {}
+    for item in raw_records:
+        record = _record_from_dict(item)
+        if record.id in records:
+            raise PromotionLedgerError("shared promotion projection has duplicate records")
+        records[record.id] = record
+    transactions: dict[str, PromotionTransaction] = {}
+    for item in raw_transactions:
+        transaction = _transaction_from_dict(item)
+        if transaction.id in transactions:
+            raise PromotionLedgerError(
+                "shared promotion projection has duplicate transactions"
+            )
+        transactions[transaction.id] = transaction
+    return records, transactions
+
+
+class _PostgresPromotionLedgerStore:
+    """Encrypted, tenant-scoped journal and projection in one DB transaction."""
+
+    def __init__(
+        self,
+        owner: PromotionLedger,
+        *,
+        legacy_path: Path | None,
+        authority_posture: _PromotionBackendPosture,
+        authority_token: str,
+        tenant: str,
+    ) -> None:
+        self._owner = owner
+        self._legacy_path = legacy_path
+        self._authority_posture = authority_posture
+        self._authority_token = authority_token
+        self._tenant = tenant
+        self._database_identity: tuple[str, str, str] | None = None
+        self._last_revision: tuple[str, str, int, str | None] | None = None
+
+    def assert_authority_current(self) -> None:
+        """Re-resolve deployment policy before touching a cached PG authority."""
+        try:
+            posture = _promotion_backend_posture()
+            token = _promotion_postgres_authority_token()
+            tenant = _promotion_tenant_key()
+        except PromotionLedgerError:
+            raise
+        except Exception:
+            raise PromotionLedgerError(
+                "shared promotion authority could not be revalidated"
+            ) from None
+        if (
+            not posture.postgres_selected
+            or posture != self._authority_posture
+            or token != self._authority_token
+            or tenant != self._tenant
+        ):
+            raise PromotionLedgerError(
+                "shared promotion authority changed after ledger construction"
+            )
+
+    @contextmanager
+    def _transaction(self, action: str):
+        self.assert_authority_current()
+        tenant = self._tenant
+        _require_promotion_encryption()
+        _assert_no_local_promotion_state(self._legacy_path)
+        conn = None
+        try:
+            conn = _connect_promotion_postgres(
+                expected_authority_token=self._authority_token,
+            )
+            self.assert_authority_current()
+            conn.execute("BEGIN")
+            observed_identity = _promotion_database_identity(conn)
+            if (
+                self._database_identity is not None
+                and observed_identity != self._database_identity
+            ):
+                raise PromotionLedgerError(
+                    "shared promotion database authority changed after "
+                    "ledger construction"
+                )
+            _initialize_promotion_postgres_schema(conn)
+            # Re-check every operation. PostgreSQL OR-combines permissive RLS
+            # policies, and a role can gain BYPASSRLS after process startup.
+            status = _promotion_schema_status(conn)
+            if status == "unsafe-role":
+                raise PromotionLedgerError(
+                    "shared promotion authority requires a least-privilege runtime role"
+                )
+            if status != "ready":
+                raise PromotionLedgerError(
+                    "shared promotion schema is unavailable or ambiguous"
+                )
+            if self._database_identity is None:
+                self._database_identity = observed_identity
+            conn.execute(
+                "SELECT set_config('maverick.tenant', %s, true)",
+                (tenant,),
+            )
+            conn.execute(
+                "SELECT pg_advisory_xact_lock(%s)",
+                (_promotion_tenant_lock_key(tenant),),
+            )
+            empty = _seal_promotion_payload(
+                _promotion_projection({}, {}),
+                label="projection",
+            )
+            conn.execute(
+                "INSERT INTO promotion_ledger_heads "
+                "(tenant_id, next_sequence, head_sha256, event_count, "
+                "record_count, prepared_count, projection_sealed, updated_at) "
+                "VALUES (%s, 1, NULL, 0, 0, 0, %s, %s) "
+                "ON CONFLICT (tenant_id) DO NOTHING",
+                (tenant, empty, time.time()),
+            )
+            head = conn.execute(
+                "SELECT next_sequence, head_sha256, event_count, record_count, "
+                "prepared_count, projection_sealed "
+                "FROM promotion_ledger_heads WHERE tenant_id=%s FOR UPDATE",
+                (tenant,),
+            ).fetchone()
+            if head is None:
+                raise PromotionLedgerError(
+                    "shared promotion tenant head could not be locked"
+                )
+            yield conn, tenant, head
+            conn.commit()
+        except PromotionLedgerError:
+            if conn is not None:
+                try:
+                    conn.rollback()
+                except Exception:  # pragma: no cover - preserve authority error
+                    pass
+            raise
+        except Exception as exc:
+            if conn is not None:
+                try:
+                    conn.rollback()
+                except Exception:  # pragma: no cover - preserve provider error
+                    pass
+            log.error(
+                "shared Postgres promotion %s failed (%s)",
+                action,
+                type(exc).__name__,
+            )
+            raise PromotionLedgerError(
+                f"shared Postgres promotion {action} failed"
+            ) from None
+        finally:
+            if conn is not None:
+                try:
+                    conn.close()
+                except Exception:  # pragma: no cover - best-effort close
+                    pass
+
+    def _read_state_locked(
+        self,
+        conn: Any,
+        tenant: str,
+        head_row: object,
+    ) -> tuple[
+        dict[str, PromotionRecord],
+        dict[str, PromotionTransaction],
+        str | None,
+        int,
+    ]:
+        rows = conn.execute(
+            "SELECT sequence, event_kind, prev_sha256, event_sha256, "
+            "event_sealed, created_at FROM promotion_ledger_events "
+            "WHERE tenant_id=%s ORDER BY sequence",
+            (tenant,),
+        ).fetchall()
+        records: dict[str, PromotionRecord] = {}
+        transactions: dict[str, PromotionTransaction] = {}
+        previous: str | None = None
+        handlers = {
+            "promote": self._owner._replay_promote,
+            "prepare": self._owner._replay_prepare,
+            "commit": self._owner._replay_commit,
+            "abort": self._owner._replay_abort,
+            "recovery_conflict": self._owner._replay_recovery_conflict,
+            "rollback": self._owner._replay_rollback,
+        }
+        for expected_sequence, row in enumerate(rows, start=1):
+            sequence = _promotion_row_value(row, 0, "sequence")
+            kind = str(_promotion_row_value(row, 1, "event_kind"))
+            row_previous = _promotion_row_value(row, 2, "prev_sha256")
+            claimed = _promotion_row_value(row, 3, "event_sha256")
+            created = _promotion_row_value(row, 5, "created_at")
+            if (
+                not isinstance(sequence, int)
+                or isinstance(sequence, bool)
+                or sequence != expected_sequence
+                or kind not in handlers
+                or row_previous != previous
+                or not isinstance(claimed, str)
+                or len(claimed) != 64
+            ):
+                raise PromotionLedgerError(
+                    "shared promotion journal sequence or metadata is invalid"
+                )
+            _event_time(created, "database event")
+            event = _open_promotion_payload(
+                _promotion_row_value(row, 4, "event_sealed"),
+                label="journal event",
+            )
+            if not isinstance(event, dict):
+                raise PromotionLedgerError(
+                    "shared promotion journal event is not an object"
+                )
+            unsigned = {key: value for key, value in event.items() if key != "sha256"}
+            try:
+                expected_hash = hashlib.sha256(
+                    _canonical_json(unsigned).encode("utf-8")
+                ).hexdigest()
+            except (TypeError, ValueError):
+                raise PromotionLedgerError(
+                    "shared promotion journal event is not canonical JSON"
+                ) from None
+            if (
+                event.get("version") != _JOURNAL_VERSION
+                or event.get("event") != kind
+                or event.get("prev_sha256") != previous
+                or event.get("sha256") != claimed
+                or expected_hash != claimed
+            ):
+                raise PromotionLedgerError(
+                    "shared promotion journal failed its hash-chain check"
+                )
+            handlers[kind](event, records, transactions, expected_sequence)
+            previous = claimed
+
+        event_count = len(rows)
+        expected_next = event_count + 1
+        expected_projection = _promotion_projection(records, transactions)
+        repair_projection = False
+        try:
+            projected_records, projected_transactions = _promotion_projection_state(
+                _open_promotion_payload(
+                    _promotion_row_value(head_row, 5, "projection_sealed"),
+                    label="projection",
+                )
+            )
+            repair_projection = not (
+                _records_match(records, projected_records)
+                and {
+                    key: value.to_dict()
+                    for key, value in transactions.items()
+                }
+                == {
+                    key: value.to_dict()
+                    for key, value in projected_transactions.items()
+                }
+            )
+        except PromotionLedgerError:
+            repair_projection = True
+
+        next_sequence = _promotion_row_value(head_row, 0, "next_sequence")
+        stored_head = _promotion_row_value(head_row, 1, "head_sha256")
+        stored_event_count = _promotion_row_value(head_row, 2, "event_count")
+        stored_record_count = _promotion_row_value(head_row, 3, "record_count")
+        stored_prepared_count = _promotion_row_value(
+            head_row, 4, "prepared_count"
+        )
+        prepared_count = sum(tx.in_doubt for tx in transactions.values())
+        metadata_drift = (
+            next_sequence != expected_next
+            or stored_head != previous
+            or stored_event_count != event_count
+            or stored_record_count != len(records)
+            or stored_prepared_count != prepared_count
+        )
+        if metadata_drift:
+            # The head row and journal rows are one atomic authority.  A
+            # shorter event stream must never be normalized into truth by
+            # rewriting the head after truncation, nor may count/hash drift be
+            # treated as a recoverable cache error.  Only the encrypted
+            # projection below is reconstructable metadata.
+            raise PromotionLedgerError(
+                "shared promotion journal head and event chain disagree"
+            )
+        if repair_projection:
+            sealed = _seal_promotion_payload(
+                expected_projection,
+                label="projection",
+            )
+            updated = conn.execute(
+                "UPDATE promotion_ledger_heads SET projection_sealed=%s, "
+                "updated_at=%s WHERE tenant_id=%s AND next_sequence=%s "
+                "AND ((head_sha256 IS NULL AND %s IS NULL) OR head_sha256=%s) "
+                "AND event_count=%s AND record_count=%s AND prepared_count=%s",
+                (
+                    sealed,
+                    time.time(),
+                    tenant,
+                    expected_next,
+                    previous,
+                    previous,
+                    event_count,
+                    len(records),
+                    prepared_count,
+                ),
+            )
+            if updated.rowcount != 1:
+                raise PromotionLedgerError(
+                    "shared promotion projection repair was not durable"
+                )
+        return records, transactions, previous, event_count
+
+    def _append_locked(
+        self,
+        conn: Any,
+        tenant: str,
+        *,
+        events: tuple[dict[str, Any], ...],
+        records: Mapping[str, PromotionRecord],
+        transactions: Mapping[str, PromotionTransaction],
+        previous: str | None,
+        event_count: int,
+    ) -> None:
+        if not events:
+            raise PromotionLedgerError(
+                "cannot commit an empty shared promotion transaction"
+            )
+        sequence = event_count + 1
+        chain_head = previous
+        for event in events:
+            if event.get("prev_sha256") != chain_head:
+                raise PromotionLedgerError(
+                    "shared promotion append broke the journal chain"
+                )
+            claimed = event.get("sha256")
+            if not isinstance(claimed, str) or len(claimed) != 64:
+                raise PromotionLedgerError(
+                    "shared promotion event digest is invalid"
+                )
+            sealed = _seal_promotion_payload(event, label="journal event")
+            inserted = conn.execute(
+                "INSERT INTO promotion_ledger_events "
+                "(tenant_id, sequence, event_kind, prev_sha256, event_sha256, "
+                "event_sealed, created_at) VALUES (%s, %s, %s, %s, %s, %s, %s) "
+                "ON CONFLICT (tenant_id, sequence) DO NOTHING",
+                (
+                    tenant,
+                    sequence,
+                    event.get("event"),
+                    chain_head,
+                    claimed,
+                    sealed,
+                    time.time(),
+                ),
+            )
+            if inserted.rowcount != 1:
+                raise PromotionLedgerError(
+                    "shared promotion journal append conflicted"
+                )
+            sequence += 1
+            chain_head = claimed
+
+        projection = _seal_promotion_payload(
+            _promotion_projection(records, transactions),
+            label="projection",
+        )
+        prepared_count = sum(tx.in_doubt for tx in transactions.values())
+        updated = conn.execute(
+            "UPDATE promotion_ledger_heads SET next_sequence=%s, "
+            "head_sha256=%s, event_count=%s, record_count=%s, "
+            "prepared_count=%s, projection_sealed=%s, updated_at=%s "
+            "WHERE tenant_id=%s AND next_sequence=%s "
+            "AND ((head_sha256 IS NULL AND %s IS NULL) OR head_sha256=%s)",
+            (
+                sequence,
+                chain_head,
+                event_count + len(events),
+                len(records),
+                prepared_count,
+                projection,
+                time.time(),
+                tenant,
+                event_count + 1,
+                previous,
+                previous,
+            ),
+        )
+        if updated.rowcount != 1:
+            raise PromotionLedgerError(
+                "shared promotion journal head changed concurrently"
+            )
+
+    def _cache(
+        self,
+        records: Mapping[str, PromotionRecord],
+        transactions: Mapping[str, PromotionTransaction],
+    ) -> None:
+        with self._owner._lock:
+            self._owner._records = dict(records)
+            self._owner._transactions = dict(transactions)
+
+    def refresh(self) -> None:
+        with self._transaction("refresh") as (conn, tenant, head):
+            records, transactions, previous, count = self._read_state_locked(
+                conn, tenant, head
+            )
+        self._last_revision = ("postgres", tenant, count, previous)
+        self._cache(records, transactions)
+
+    def authority_revision(
+        self,
+        *,
+        refresh: bool,
+    ) -> tuple[str, str, int, str | None]:
+        if refresh:
+            self.refresh()
+        if self._last_revision is None:
+            raise PromotionLedgerError(
+                "shared promotion authority revision is unavailable"
+            )
+        return self._last_revision
+
+    def add(self, record: PromotionRecord) -> None:
+        with self._transaction("receipt append") as (conn, tenant, head_row):
+            records, transactions, previous, event_count = self._read_state_locked(
+                conn, tenant, head_row
+            )
+            if (
+                record.id in records
+                or any(
+                    tx.record.id == record.id for tx in transactions.values()
+                )
+            ):
+                raise PromotionLedgerError(
+                    f"promotion record {record.id!r} already exists"
+                )
+            reservations = sum(tx.in_doubt for tx in transactions.values())
+            if len(records) + reservations >= self._owner.max_records:
+                raise PromotionLedgerError("promotion ledger retention limit reached")
+            event = self._owner._event("promote", previous, record=record)
+            records[record.id] = record
+            self._append_locked(
+                conn,
+                tenant,
+                events=(event,),
+                records=records,
+                transactions=transactions,
+                previous=previous,
+                event_count=event_count,
+            )
+        self._cache(records, transactions)
+
+    def prepare(self, intent: PromotionTransaction) -> PromotionTransaction:
+        with self._transaction("prepare") as (conn, tenant, head_row):
+            records, transactions, previous, event_count = self._read_state_locked(
+                conn, tenant, head_row
+            )
+            existing = transactions.get(intent.id)
+            if existing is not None:
+                if not _same_transaction_intent(existing, intent):
+                    raise PromotionLedgerError(
+                        f"promotion transaction {intent.id!r} was reused with different intent"
+                    )
+                result = existing
+            else:
+                if intent.record.id in records or any(
+                    tx.record.id == intent.record.id
+                    for tx in transactions.values()
+                ):
+                    raise PromotionLedgerError(
+                        f"promotion record {intent.record.id!r} already exists"
+                    )
+                if any(
+                    tx.in_doubt
+                    and tx.before.identity == intent.before.identity
+                    for tx in transactions.values()
+                ):
+                    raise PromotionLedgerError(
+                        f"artifact {intent.before.identity!r} has an unresolved promotion transaction"
+                    )
+                reservations = sum(tx.in_doubt for tx in transactions.values())
+                if len(records) + reservations >= self._owner.max_records:
+                    raise PromotionLedgerError(
+                        "promotion ledger retention limit reached"
+                    )
+                event = self._owner._event(
+                    "prepare", previous, transaction=intent
+                )
+                transactions[intent.id] = intent
+                self._append_locked(
+                    conn,
+                    tenant,
+                    events=(event,),
+                    records=records,
+                    transactions=transactions,
+                    previous=previous,
+                    event_count=event_count,
+                )
+                result = intent
+        self._cache(records, transactions)
+        return result
+
+    def commit(
+        self,
+        transaction_id: str,
+        *,
+        artifact: ArtifactRevision,
+        committed_at: float,
+    ) -> PromotionRecord:
+        with self._transaction("commit") as (conn, tenant, head_row):
+            records, transactions, previous, event_count = self._read_state_locked(
+                conn, tenant, head_row
+            )
+            transaction = transactions.get(transaction_id)
+            if transaction is None:
+                raise PromotionLedgerError(
+                    f"promotion transaction {transaction_id!r} does not exist"
+                )
+            if transaction.state == "committed":
+                record = records.get(transaction.record.id)
+                if record is None:
+                    raise PromotionLedgerError(
+                        "committed transaction has no promotion record"
+                    )
+                if artifact != transaction.after:
+                    raise PromotionLedgerError(
+                        "idempotent promotion commit used a mismatched artifact"
+                    )
+                result = record
+            else:
+                if transaction.state != "prepared":
+                    raise PromotionLedgerError(
+                        "cannot commit an aborted promotion transaction"
+                    )
+                if artifact != transaction.after:
+                    raise PromotionLedgerError(
+                        "runtime artifact does not match the prepared promotion revision"
+                    )
+                committed = replace(
+                    transaction.record,
+                    promoted_at=committed_at,
+                )
+                if committed.id in records:
+                    raise PromotionLedgerError(
+                        f"promotion record {committed.id!r} already exists"
+                    )
+                event = self._owner._event(
+                    "commit",
+                    previous,
+                    transaction_id=transaction_id,
+                    artifact=artifact,
+                    committed_at=committed_at,
+                )
+                records[committed.id] = committed
+                transactions[transaction_id] = replace(
+                    transaction,
+                    state="committed",
+                    resolved_at=committed_at,
+                    reason="",
+                    last_observed=artifact,
+                )
+                self._append_locked(
+                    conn,
+                    tenant,
+                    events=(event,),
+                    records=records,
+                    transactions=transactions,
+                    previous=previous,
+                    event_count=event_count,
+                )
+                result = committed
+        self._cache(records, transactions)
+        return result
+
+    def abort(
+        self,
+        transaction_id: str,
+        *,
+        artifact: ArtifactRevision,
+        aborted_at: float,
+        reason: str,
+    ) -> PromotionTransaction:
+        with self._transaction("abort") as (conn, tenant, head_row):
+            records, transactions, previous, event_count = self._read_state_locked(
+                conn, tenant, head_row
+            )
+            transaction = transactions.get(transaction_id)
+            if transaction is None:
+                raise PromotionLedgerError(
+                    f"promotion transaction {transaction_id!r} does not exist"
+                )
+            if transaction.state == "aborted":
+                if artifact != transaction.before:
+                    raise PromotionLedgerError(
+                        "idempotent promotion abort used a mismatched artifact"
+                    )
+                result = transaction
+            else:
+                if transaction.state != "prepared":
+                    raise PromotionLedgerError(
+                        "cannot abort a committed promotion transaction"
+                    )
+                if artifact != transaction.before:
+                    raise PromotionLedgerError(
+                        "cannot abort while the runtime artifact differs from prepared before state"
+                    )
+                event = self._owner._event(
+                    "abort",
+                    previous,
+                    transaction_id=transaction_id,
+                    artifact=artifact,
+                    aborted_at=aborted_at,
+                    reason=reason,
+                )
+                aborted = replace(
+                    transaction,
+                    state="aborted",
+                    resolved_at=aborted_at,
+                    reason=reason,
+                    last_observed=artifact,
+                )
+                transactions[transaction_id] = aborted
+                self._append_locked(
+                    conn,
+                    tenant,
+                    events=(event,),
+                    records=records,
+                    transactions=transactions,
+                    previous=previous,
+                    event_count=event_count,
+                )
+                result = aborted
+        self._cache(records, transactions)
+        return result
+
+    def transaction(self, transaction_id: str) -> PromotionTransaction | None:
+        with self._transaction("transaction read") as (conn, tenant, head_row):
+            records, transactions, _previous, _count = self._read_state_locked(
+                conn, tenant, head_row
+            )
+            result = transactions.get(transaction_id)
+        self._cache(records, transactions)
+        return result
+
+    def transactions(
+        self,
+        *,
+        artifact_identity: str | None,
+        state: str | None,
+    ) -> list[PromotionTransaction]:
+        with self._transaction("transaction listing") as (conn, tenant, head_row):
+            records, transactions, _previous, _count = self._read_state_locked(
+                conn, tenant, head_row
+            )
+            refreshed: dict[str, PromotionTransaction] = {}
+            for transaction_id, transaction in transactions.items():
+                current_record = records.get(transaction.record.id)
+                if transaction.state == "committed":
+                    if current_record is None:
+                        raise PromotionLedgerError(
+                            "committed promotion transaction has no current record"
+                        )
+                    transaction = replace(transaction, record=current_record)
+                elif current_record is not None:
+                    raise PromotionLedgerError(
+                        "uncommitted promotion transaction has a promotion record"
+                    )
+                refreshed[transaction_id] = transaction
+            result = sorted(
+                (
+                    transaction
+                    for transaction in refreshed.values()
+                    if (
+                        artifact_identity is None
+                        or transaction.before.identity == artifact_identity
+                    )
+                    and (state is None or transaction.state == state)
+                ),
+                key=lambda transaction: (transaction.prepared_at, transaction.id),
+            )
+        self._cache(records, refreshed)
+        return result
+
+    def in_doubt(
+        self,
+        *,
+        artifact_identity: str | None,
+    ) -> list[PromotionTransaction]:
+        with self._transaction("in-doubt listing") as (conn, tenant, head_row):
+            records, transactions, _previous, _count = self._read_state_locked(
+                conn, tenant, head_row
+            )
+            result = sorted(
+                (
+                    transaction
+                    for transaction in transactions.values()
+                    if transaction.in_doubt
+                    and (
+                        artifact_identity is None
+                        or transaction.before.identity == artifact_identity
+                    )
+                ),
+                key=lambda transaction: (transaction.prepared_at, transaction.id),
+            )
+        self._cache(records, transactions)
+        return result
+
+    def record_recovery_conflict(
+        self,
+        transaction_id: str,
+        *,
+        artifact: ArtifactRevision,
+        observed_at: float,
+        reason: str,
+    ) -> PromotionTransaction:
+        with self._transaction("recovery conflict") as (conn, tenant, head_row):
+            records, transactions, previous, event_count = self._read_state_locked(
+                conn, tenant, head_row
+            )
+            transaction = transactions.get(transaction_id)
+            if transaction is None:
+                raise PromotionLedgerError(
+                    f"promotion transaction {transaction_id!r} does not exist"
+                )
+            if transaction.state != "prepared":
+                result = transaction
+            elif (
+                artifact.identity != transaction.before.identity
+                or artifact in {transaction.before, transaction.after}
+            ):
+                raise PromotionLedgerError(
+                    "recovery conflict observation is invalid"
+                )
+            elif transaction.last_observed == artifact and transaction.reason == reason:
+                result = transaction
+            else:
+                event = self._owner._event(
+                    "recovery_conflict",
+                    previous,
+                    transaction_id=transaction_id,
+                    artifact=artifact,
+                    observed_at=observed_at,
+                    reason=reason,
+                )
+                conflicted = replace(
+                    transaction,
+                    reason=reason,
+                    last_observed=artifact,
+                    recovery_attempts=transaction.recovery_attempts + 1,
+                )
+                transactions[transaction_id] = conflicted
+                self._append_locked(
+                    conn,
+                    tenant,
+                    events=(event,),
+                    records=records,
+                    transactions=transactions,
+                    previous=previous,
+                    event_count=event_count,
+                )
+                result = conflicted
+        self._cache(records, transactions)
+        return result
+
+    def get(self, record_id: str) -> PromotionRecord | None:
+        with self._transaction("record read") as (conn, tenant, head_row):
+            records, transactions, _previous, _count = self._read_state_locked(
+                conn, tenant, head_row
+            )
+            result = records.get(record_id)
+        self._cache(records, transactions)
+        return result
+
+    def mark_rolled_back(self, record_id: str, *, at: float) -> bool:
+        with self._transaction("rollback") as (conn, tenant, head_row):
+            records, transactions, previous, event_count = self._read_state_locked(
+                conn, tenant, head_row
+            )
+            record = records.get(record_id)
+            if record is None or record.rolled_back:
+                result = False
+            else:
+                updated = PromotionRecord(
+                    **{
+                        **record.to_dict(),
+                        "rolled_back": True,
+                        "rolled_back_at": at,
+                    }
+                )
+                event = self._owner._event(
+                    "rollback",
+                    previous,
+                    record_id=record_id,
+                    rolled_back_at=at,
+                )
+                records[record_id] = updated
+                self._append_locked(
+                    conn,
+                    tenant,
+                    events=(event,),
+                    records=records,
+                    transactions=transactions,
+                    previous=previous,
+                    event_count=event_count,
+                )
+                result = True
+        self._cache(records, transactions)
+        return result
+
+    def all(self) -> list[PromotionRecord]:
+        with self._transaction("record listing") as (conn, tenant, head_row):
+            records, transactions, _previous, _count = self._read_state_locked(
+                conn, tenant, head_row
+            )
+            result = sorted(
+                records.values(),
+                key=lambda record: (record.promoted_at, record.id),
+                reverse=True,
+            )
+        self._cache(records, transactions)
+        return result
+
+
 _shared: dict[Path, SelfImprovementController] = {}
 _shared_lock = threading.Lock()
 
