+class GovernedSamlReplayStore:
+    """Atomic fleet-wide SAML replay claims over governed Postgres records."""
+
+    shared = True
+
+    def __init__(self, *, backend: GovernedRecordBackend | None = None) -> None:
+        self._document: AuthorityDocumentStore[bool] = AuthorityDocumentStore(
+            "saml_replay_claims",
+            "SRP",
+            "saml_replay_claims",
+            backend=backend,
+            required_backend="postgres",
+        )
+
+    @staticmethod
+    def _claims(document: dict) -> dict[str, float]:
+        raw = document.setdefault("claims", {})
+        if not isinstance(raw, dict):
+            raise ReplayStoreError("shared replay claims must be an object")
+        claims: dict[str, float] = {}
+        for claim_key, expiry in raw.items():
+            if (
+                not isinstance(claim_key, str)
+                or len(claim_key) != 64
+                or any(ch not in "0123456789abcdef" for ch in claim_key)
+                or isinstance(expiry, bool)
+                or not isinstance(expiry, (int, float))
+                or not math.isfinite(float(expiry))
+                or float(expiry) <= 0
+            ):
+                raise ReplayStoreError("shared SAML replay authority is malformed")
+            claims[claim_key] = float(expiry)
+        return claims
+
+    def consume(self, assertion_id: str, expires_at: float, *, now: float) -> bool:
+        import hashlib
+
+        claim_key = hashlib.sha256(assertion_id.encode("utf-8")).hexdigest()
+
+        def _consume(document: dict) -> bool:
+            claims = {
+                key: expiry
+                for key, expiry in self._claims(document).items()
+                if expiry > now
+            }
+            if claim_key in claims:
+                document["claims"] = claims
+                return False
+            if len(claims) >= _MAX_REPLAY_ENTRIES:
+                raise ReplayStoreError("shared SAML replay authority is full")
+            claims[claim_key] = expires_at
+            document["claims"] = claims
+            return True
+
+        return self._document.mutate(
+            _consume,
+            action="saml-replay.consume",
+            actor="saml-acs",
+        )
