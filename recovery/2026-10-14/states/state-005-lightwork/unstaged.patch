+class GovernedNonceStore:
+    """Atomic bounded replay claims in one encrypted tenant/run document."""
+
+    def __init__(
+        self,
+        *,
+        tenant_id: str,
+        run_id: str,
+        max_entries: int = HANDOFF_MAX_NONCES,
+        store: Any | None = None,
+    ) -> None:
+        self.tenant_id, self.run_id = _scope_parts(tenant_id, run_id)
+        try:
+            parsed_max = int(max_entries)
+        except (TypeError, ValueError, OverflowError) as exc:
+            raise ValueError("max_entries must be between 1 and 1000000") from exc
+        if isinstance(max_entries, bool) or not 1 <= parsed_max <= 1_000_000:
+            raise ValueError("max_entries must be between 1 and 1000000")
+        self.max_entries = parsed_max
+        try:
+            if store is None:
+                store = _new_authority_document_store(
+                    "nonces",
+                    tenant_id=self.tenant_id,
+                    run_id=self.run_id,
+                )
+            self._store = store
+            _require_postgres_store(self._store)
+        except HandoffAuthorityError:
+            raise
+        except Exception as exc:
+            raise HandoffAuthorityError(
+                "shared handoff replay authority is unavailable"
+            ) from exc
+
+    @staticmethod
+    def _nonce(nonce: str) -> str:
+        if not isinstance(nonce, str) or not nonce:
+            raise ValueError("nonce must be a non-empty string")
+        try:
+            size = len(nonce.encode("utf-8"))
+        except UnicodeEncodeError as exc:
+            raise ValueError("nonce must be valid UTF-8") from exc
+        if size > HANDOFF_MAX_NONCE_BYTES:
+            raise ValueError(f"nonce exceeds {HANDOFF_MAX_NONCE_BYTES} bytes")
+        return nonce
+
+    @staticmethod
+    def _now(value: float | None) -> float:
+        if isinstance(value, bool):
+            raise ValueError("now must be finite")
+        try:
+            current = time.time() if value is None else float(value)
+        except (TypeError, ValueError, OverflowError) as exc:
+            raise ValueError("now must be finite") from exc
+        if not math.isfinite(current):
+            raise ValueError("now must be finite")
+        return current
+
+    def authoritative_time(self) -> float:
+        """Return the shared replay authority's clock.
+
+        A signed envelope's freshness and nonce retention are fleet decisions.
+        Letting each receiver supply its node clock would make the same envelope
+        fresh on one replica and stale on another.  The Postgres-backed store
+        therefore exposes the selected backend clock and never falls back to
+        ``time.time()`` when it is the active replay authority.
+        """
+        _require_postgres_store(self._store)
+        try:
+            current = self._now(self._store.authoritative_time())
+        except HandoffAuthorityError:
+            raise
+        except Exception as exc:
+            raise HandoffAuthorityError(
+                "shared handoff replay clock is unavailable"
+            ) from exc
+        _require_postgres_store(self._store)
+        return current
+
+    def _claims(
+        self,
+        document: object,
+        *,
+        initialize: bool,
+    ) -> dict[str, float]:
+        if not isinstance(document, dict):
+            raise HandoffAuthorityError("shared handoff nonce document is invalid")
+        if not document:
+            if not initialize:
+                return {}
+            document.update(
+                {
+                    "max_entries": self.max_entries,
+                    "nonces": {},
+                    "run_id": self.run_id,
+                    "tenant_id": self.tenant_id,
+                }
+            )
+        if set(document) != _NONCE_DOCUMENT_FIELDS:
+            raise HandoffAuthorityError("shared handoff nonce document is invalid")
+        if (
+            document.get("tenant_id") != self.tenant_id
+            or document.get("run_id") != self.run_id
+        ):
+            raise HandoffAuthorityError("shared handoff nonce scope does not match")
+        if document.get("max_entries") != self.max_entries:
+            raise HandoffAuthorityError(
+                "shared handoff nonce capacity does not match this replica"
+            )
+        raw = document.get("nonces")
+        if not isinstance(raw, dict) or len(raw) > self.max_entries:
+            raise HandoffAuthorityError("shared handoff nonce claims are invalid")
+        claims: dict[str, float] = raw
+        for nonce, expiry in claims.items():
+            try:
+                self._nonce(nonce)
+            except ValueError as exc:
+                raise HandoffAuthorityError(
+                    "shared handoff nonce claims are invalid"
+                ) from exc
+            if (
+                isinstance(expiry, bool)
+                or not isinstance(expiry, (int, float))
+                or not math.isfinite(float(expiry))
+                or float(expiry) <= 0
+            ):
+                raise HandoffAuthorityError(
+                    "shared handoff nonce claims are invalid"
+                )
+        return claims
+
+    def seen(self, nonce: str, *, now: float | None = None) -> bool:
+        nonce = self._nonce(nonce)
+        _require_postgres_store(self._store)
+        try:
+            claims = self._claims(self._store.read(), initialize=False)
+            # ``now`` remains in the protocol for local/test stores, but a
+            # governed replay decision must use the backend clock even when a
+            # caller supplies a node timestamp.
+            current = self.authoritative_time()
+            expiry = claims.get(nonce)
+            return expiry is not None and float(expiry) > current
+        except HandoffAuthorityError:
+            raise
+        except Exception as exc:
+            raise HandoffAuthorityError(
+                "shared handoff replay authority is unavailable"
+            ) from exc
+
+    def remember(
+        self,
+        nonce: str,
+        *,
+        expires_at: float | None = None,
+        now: float | None = None,
+    ) -> bool:
+        nonce = self._nonce(nonce)
+        if isinstance(expires_at, bool):
+            return False
+        try:
+            requested_expiry = (
+                None if expires_at is None else float(expires_at)
+            )
+        except (TypeError, ValueError, OverflowError):
+            return False
+        if requested_expiry is not None and not math.isfinite(requested_expiry):
+            return False
+        _require_postgres_store(self._store)
+
+        def _claim(document: dict, current: float) -> bool:
+            current = self._now(current)
+            expiry = (
+                current + 300.0
+                if requested_expiry is None
+                else requested_expiry
+            )
+            if expiry <= current:
+                return False
+            claims = self._claims(document, initialize=True)
+            for claimed_nonce in [
+                item for item, claimed_expiry in claims.items()
+                if float(claimed_expiry) <= current
+            ]:
+                del claims[claimed_nonce]
+            if nonce in claims:
+                # ValueError is an explicitly preserved backend exception. It
+                # aborts the CAS transaction without writing an audit/revision
+                # for a denied replay, and is translated back to the protocol's
+                # False result below.
+                raise _NonceAlreadyClaimed
+            if len(claims) >= self.max_entries:
+                raise _NonceStoreFull
+            claims[nonce] = expiry
+            return True
+
+        try:
+            return bool(
+                self._store.mutate_with_authoritative_time(
+                    _claim,
+                    action="claim_nonce",
+                    actor="handoff-authority",
+                    max_retries=_GOVERNED_MUTATION_RETRIES,
+                )
+            )
+        except (_NonceAlreadyClaimed, _NonceStoreFull):
+            return False
+        except HandoffAuthorityError:
+            raise
+        except Exception as exc:
+            raise HandoffAuthorityError(
+                "shared handoff replay authority is unavailable"
+            ) from exc
+
