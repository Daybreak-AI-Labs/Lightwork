+def retire_private_file_snapshot(
+    path: str | Path,
+    snapshot: IdentityBoundFileSnapshot,
+    *,
+    mode: int = 0o600,
+) -> Path:
+    """Move the exact live source out of service without path-based deletion.
+
+    The visible leaf is moved to an unpredictable sibling retirement path, then
+    its identity and bytes are rechecked there.  The verified retired source is
+    intentionally preserved: POSIX has no portable conditional unlink-by-handle,
+    so checking a pathname and then unlinking it would still permit a late leaf
+    swap to redirect deletion onto an unverified replacement.  At most one
+    bounded source-sized recovery residue is retained per successful call.
+
+    Any mismatch recreates the exact validated snapshot at the active pathname
+    with create-only semantics (unless a replacement already exists there).
+    Consequently shared admission remains blocked and no unverified object is
+    deleted.  Callers must publish and read back their no-overwrite archive
+    before invoking this retirement primitive.
+    """
+    if not isinstance(snapshot, IdentityBoundFileSnapshot):
+        raise TypeError("snapshot must be an IdentityBoundFileSnapshot")
+    path = Path(path)
+    retired = None
+    try:
+        for _ in range(100):
+            candidate = path.with_name(
+                f".{path.name}-migration-retired-{secrets.token_hex(16)}.source"
+            )
+            try:
+                _move_private_file_no_replace(path, candidate)
+            except FileExistsError:
+                continue
+            else:
+                retired = candidate
+                break
+        if retired is None:  # pragma: no cover - cryptographically implausible
+            raise FileExistsError("could not allocate a migration retirement path")
+        observed = read_private_file_snapshot(
+            retired,
+            max_bytes=max(1, len(snapshot.data)),
+            mode=mode,
+        )
+        if (
+            (observed.device, observed.inode) != (snapshot.device, snapshot.inode)
+            or observed.data != snapshot.data
+        ):
+            raise PermissionError(
+                f"sensitive state source changed before retirement: {path}"
+            )
+        # Catch a replacement made after the descriptor-bound read.  There is
+        # deliberately no following unlink: the retained recovery object makes
+        # this check observational rather than a new destructive TOCTOU seam.
+        if not _visible_path_matches_snapshot(retired, observed):
+            raise PermissionError(
+                f"sensitive state retirement object changed after verification: {path}"
+            )
+        _fsync_directory(path.parent)
+        if os.path.lexists(path):
+            raise PermissionError(
+                f"a new sensitive state source appeared during retirement: {path}"
+            )
+        return retired
+    except BaseException:
+        try:
+            _preserve_failed_retirement_source(path, snapshot, mode=mode)
+            _fsync_directory(path.parent)
+        except BaseException as recovery_exc:
+            raise PermissionError(
+                f"sensitive state retirement failed without a durable blocker: {path}"
+            ) from recovery_exc
+        raise
+
