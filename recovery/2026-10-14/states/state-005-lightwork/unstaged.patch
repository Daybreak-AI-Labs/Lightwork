+def _validated_ledger_authority(value: object) -> dict[str, str]:
+    """Validate a non-secret, replica-stable promotion-ledger locator."""
+    if not isinstance(value, dict):
+        raise ValueError("adapter authority requires a durable ledger locator")
+    kind = value.get("kind")
+    if kind == "file":
+        if set(value) != {"kind", "path"}:
+            raise ValueError("adapter file-ledger locator is invalid")
+        raw_path = value.get("path")
+        if (not isinstance(raw_path, str) or not raw_path or len(raw_path) > 4096
+                or any(ord(ch) < 32 for ch in raw_path)):
+            raise ValueError("adapter file-ledger locator is invalid")
+        path = Path(raw_path).expanduser()
+        if not path.is_absolute():
+            raise ValueError("adapter file-ledger locator must be absolute")
+        return {"kind": "file", "path": str(path.resolve())}
+    if kind == "postgres":
+        if set(value) != {"kind", "store"} or value.get("store") != (
+            "promotion-ledger-v1"
+        ):
+            raise ValueError("adapter Postgres-ledger locator is invalid")
+        return {"kind": "postgres", "store": "promotion-ledger-v1"}
+    raise ValueError("adapter ledger locator has an unsupported backend")
+
