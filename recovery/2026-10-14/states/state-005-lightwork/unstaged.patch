+def _verdict_kind(path: Path | None) -> tuple[str, Path]:
+    general = _verdict_path()
+    risk = _risk_verdict_path()
+    selected = general if path is None else Path(path)
+    if _same_path(selected, general):
+        return "general", general
+    if _same_path(selected, risk):
+        return "risk", risk
+    raise CalibrationAuthorityError(
+        "shared calibration authority rejects custom local verdict paths"
+    )
+
