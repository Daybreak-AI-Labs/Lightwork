+def test_postgres_simultaneous_engines_execute_one_runner(tmp_path):
+    db = tmp_path / "postgres-race-seam.sqlite3"
+    started = threading.Event()
+    release = threading.Event()
+    calls: list[str] = []
+
+    def runner(text, **kwargs):
+        calls.append(text)
+        started.set()
+        release.wait(5)
+        return "settled"
+
+    owner = _engine_with_store(_postgres_store(db), runner)
+    contender = _engine_with_store(
+        _postgres_store(db),
+        lambda text, **kwargs: calls.append("duplicate") or "duplicate",
+    )
+
+    async def drive():
+        first = asyncio.create_task(owner.send(_msg(), "agent:alice"))
+        while not started.is_set():
+            await asyncio.sleep(0.001)
+        try:
+            await contender.send(_msg(), "agent:alice")
+        except _RpcError as error:
+            second = error
+        else:  # pragma: no cover - assertion below documents the invariant
+            second = None
+        finally:
+            release.set()
+        return await first, second
+
+    first, second = asyncio.run(drive())
+    assert first["status"]["state"] == "completed"
+    assert isinstance(second, _RpcError)
+    assert "indeterminate" in second.message
+    assert calls == ["charge once"]
+
