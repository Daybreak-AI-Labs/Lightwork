+REVOKE DELETE
+  ON job_queue_poll_leases FROM maverick_runtime;
+REVOKE UPDATE
+  ON job_queue_dispatch_claims FROM maverick_runtime;
+REVOKE SELECT, UPDATE
+  ON SEQUENCE job_queue_jobs_id_seq FROM maverick_runtime;
+
+REVOKE DELETE, TRUNCATE, REFERENCES, TRIGGER
+  ON promotion_ledger_heads FROM maverick_runtime;
+REVOKE UPDATE, DELETE, TRUNCATE, REFERENCES, TRIGGER
+  ON promotion_ledger_events FROM maverick_runtime;
+REVOKE ALL ON FUNCTION mvk_reject_promotion_event_mutation()
+  FROM PUBLIC, maverick_runtime;
