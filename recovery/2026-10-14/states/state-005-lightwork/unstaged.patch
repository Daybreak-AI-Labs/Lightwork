+def test_governed_replay_claim_is_atomic_under_contention(
+    monkeypatch,
+    _select_postgres_authority,
+):
+    monkeypatch.setattr("maverick.audit.record", lambda *_a, **_k: True)
+    backend = _MemoryBackend()
+    stores = [GovernedToolTokenReplayCache(backend=backend) for _ in range(16)]
+    barrier = threading.Barrier(len(stores))
+    outcomes: list[bool] = []
+    outcomes_lock = threading.Lock()
+    now = time.time()
+
+    def claim(store):
+        barrier.wait()
+        outcome = store.check_and_add("contended", now + 30, now)
+        with outcomes_lock:
+            outcomes.append(outcome)
+
+    threads = [
+        threading.Thread(target=claim, args=(store,))
+        for store in stores
+    ]
+    for thread in threads:
+        thread.start()
+    for thread in threads:
+        thread.join()
+
+    assert outcomes.count(True) == 1
+    assert outcomes.count(False) == len(stores) - 1
+
