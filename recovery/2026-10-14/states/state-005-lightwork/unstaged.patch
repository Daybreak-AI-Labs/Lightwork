+def _read_snapshot_descriptor(fd: int, *, max_bytes: int) -> bytes:
+    """Read one already-bound descriptor without consulting its pathname."""
+    os.lseek(fd, 0, os.SEEK_SET)
+    chunks: list[bytes] = []
+    total = 0
+    while True:
+        chunk = os.read(fd, min(1024 * 1024, max_bytes + 1 - total))
+        if not chunk:
+            break
+        chunks.append(chunk)
+        total += len(chunk)
+        if total > max_bytes:
+            raise ValueError("sensitive state file exceeds its snapshot bound")
+    return b"".join(chunks)
+
+
+def read_private_file_snapshot(
+    path: str | Path,
+    *,
+    max_bytes: int,
+    mode: int = 0o600,
+) -> IdentityBoundFileSnapshot:
+    """Read a stable, identity-bound snapshot of one private regular file.
+
+    The descriptor is opened once with no-follow semantics where available.
+    Both pathname and descriptor identities are checked around the read, but
+    the bytes themselves always come from the descriptor.  Consequently a
+    pathname replacement followed by restoration (an ABA race) cannot make a
+    caller validate one object and later archive another.
+    """
+    if isinstance(max_bytes, bool) or not isinstance(max_bytes, int) or max_bytes < 1:
+        raise ValueError("max_bytes must be a positive integer")
+    path = Path(path)
+    ensure_private_file(path, mode)
+    if os.name == "nt":
+        fd = _windows_open_snapshot_file(path)
+    else:
+        flags = os.O_RDONLY | getattr(os, "O_BINARY", 0)
+        flags |= getattr(os, "O_NOINHERIT", 0) | getattr(os, "O_NOFOLLOW", 0)
+        fd = os.open(os.fspath(path), flags)
+    try:
+        try:
+            visible = path.lstat()
+            opened = os.fstat(fd)
+        except OSError as exc:
+            raise PermissionError(
+                f"sensitive state file could not be identity-bound: {path}"
+            ) from exc
+        if (
+            _unsafe_lock_alias(path, visible)
+            or not stat.S_ISREG(visible.st_mode)
+            or not stat.S_ISREG(opened.st_mode)
+            or visible.st_nlink != 1
+            or opened.st_nlink != 1
+            or _snapshot_stat_identity(visible) != _snapshot_stat_identity(opened)
+        ):
+            raise PermissionError(
+                f"sensitive state file identity changed before snapshot: {path}"
+            )
+        initial = _snapshot_stat_version(opened)
+        if opened.st_size > max_bytes:
+            raise ValueError("sensitive state file exceeds its snapshot bound")
+        data = _read_snapshot_descriptor(fd, max_bytes=max_bytes)
+        after = os.fstat(fd)
+        try:
+            final_visible = path.lstat()
+        except OSError as exc:
+            raise PermissionError(
+                f"sensitive state file path changed during snapshot: {path}"
+            ) from exc
+        if (
+            _snapshot_stat_version(after) != initial
+            or len(data) != after.st_size
+            or _unsafe_lock_alias(path, final_visible)
+            or not stat.S_ISREG(final_visible.st_mode)
+            or final_visible.st_nlink != 1
+            or _snapshot_stat_identity(final_visible)
+            != _snapshot_stat_identity(after)
+        ):
+            raise PermissionError(
+                f"sensitive state file changed during snapshot: {path}"
+            )
+        return IdentityBoundFileSnapshot(
+            data=data,
+            device=int(after.st_dev),
+            inode=int(after.st_ino),
+            size=int(after.st_size),
+            mtime_ns=int(after.st_mtime_ns),
+        )
+    finally:
+        os.close(fd)
+
+
+def _visible_path_matches_snapshot(
+    path: Path,
+    snapshot: IdentityBoundFileSnapshot,
+) -> bool:
+    """Return whether one visible leaf still names the snapshotted object."""
+    try:
+        visible = path.lstat()
+    except OSError:
+        return False
+    return (
+        not _unsafe_lock_alias(path, visible)
+        and stat.S_ISREG(visible.st_mode)
+        and visible.st_nlink == 1
+        and _snapshot_stat_identity(visible) == (snapshot.device, snapshot.inode)
+        and int(visible.st_size) == snapshot.size
+        and int(visible.st_mtime_ns) == snapshot.mtime_ns
+    )
+
+
+def _preserve_failed_retirement_source(
+    path: Path,
+    snapshot: IdentityBoundFileSnapshot,
+    *,
+    mode: int,
+) -> None:
+    """Keep a failed retirement visibly fail-closed without deleting anything.
+
+    A replacement may already occupy ``path``; its mere presence is the desired
+    shared-cutover blocker and it must be left untouched.  Otherwise publish the
+    exact validated snapshot with exclusive-create semantics and prove durable
+    readback.  This also gives an operator a usable local recovery source.
+    """
+    if os.path.lexists(path):
+        return
+    try:
+        atomic_create_bytes(path, snapshot.data, mode=mode)
+    except FileExistsError:
+        return
+    restored = read_private_file_snapshot(
+        path,
+        max_bytes=max(1, len(snapshot.data)),
+        mode=mode,
+    )
+    if restored.data != snapshot.data:
+        raise PermissionError(
+            f"failed retirement source could not be restored exactly: {path}"
+        )
