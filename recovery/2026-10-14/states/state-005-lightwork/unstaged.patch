+def _report_shared_adapter_observation(
+    *,
+    release_authority,
+    node_id: str,
+    desired,
+    observed_digest: str | None,
+    health: str,
+    last_error: object = "",
+):
+    """CAS-report one node without contending on the desired release row."""
+    from .artifact_release_authority import ArtifactReleaseConflict
+
+    authority = _resolve_adapter_release_authority(release_authority)
+    generation = desired.generation if observed_digest is not None else 0
+    for _attempt in range(5):
+        current = authority.get_observation(
+            ADAPTER_RELEASE_DEPLOYMENT_ID,
+            node_id,
+        )
+        if (
+            current is not None
+            and current.observed_generation == generation
+            and current.observed_digest == observed_digest
+            and current.health == health
+            and (health == "healthy" or current.last_error)
+        ):
+            return current
+        try:
+            return authority.report_observation(
+                ADAPTER_RELEASE_DEPLOYMENT_ID,
+                node_id,
+                observed_generation=generation,
+                observed_digest=observed_digest,
+                health=health,
+                last_error=last_error,
+                expected_revision=current.revision if current is not None else 0,
+                actor=f"adapter-node/{node_id}",
+            )
+        except ArtifactReleaseConflict:
+            continue
+    raise SharedAdapterAuthorityError(
+        "adapter node observation CAS did not converge"
+    )
+
+
+def _converge_shared_adapter_release(
+    pointer: dict,
+    *,
+    store: AdapterStore,
+    ledger,
+    release_authority,
+    node_id: str,
+    verify_live: bool = True,
+    rollback_from_record_id: str | None = None,
+):
+    """Publish desired state, prove local activation, and report node health.
+
+    Only metadata is shared today. Adapter payload bytes intentionally remain
+    in ``AdapterStore``: a second node must already possess the exact immutable
+    staged payload (for example via an operator-managed volume) until governed
+    object-storage distribution is added. This function never copies or fetches
+    artifact bytes and therefore cannot manufacture readiness on another node.
+    """
+    authority = _resolve_adapter_release_authority(release_authority)
+    node = _adapter_release_node_id(node_id)
+    desired = _publish_shared_adapter_desired(
+        pointer,
+        ledger=ledger,
+        release_authority=authority,
+        rollback_from_record_id=rollback_from_record_id,
+    )
+    try:
+        _verify_serving_binding(pointer.get("serving"))
+        _verify_authoritative_pointer(
+            pointer,
+            artifact_identity=store.artifact_identity,
+        )
+        if verify_live:
+            _verify_live_deployment(pointer)
+    except Exception as exc:
+        observed_digest = None
+        try:
+            serving = pointer.get("serving")
+            if isinstance(serving, dict) and isinstance(
+                serving.get("adapter_dir"), str
+            ):
+                observed_digest = payload_digest_dir(serving["adapter_dir"])
+        except Exception:
+            observed_digest = None
+        try:
+            _report_shared_adapter_observation(
+                release_authority=authority,
+                node_id=node,
+                desired=desired,
+                observed_digest=observed_digest,
+                health="unhealthy",
+                last_error=exc,
+            )
+        except Exception as report_exc:
+            raise SharedAdapterAuthorityError(
+                "local adapter activation failed and shared health could not be recorded"
+            ) from report_exc
+        raise SharedAdapterAuthorityError(
+            "local adapter activation failed shared health verification"
+        ) from exc
+    observation = _report_shared_adapter_observation(
+        release_authority=authority,
+        node_id=node,
+        desired=desired,
+        observed_digest=str(pointer["payload_sha256"]),
+        health="healthy",
+    )
+    decision = _shared_adapter_release_decision(
+        pointer,
+        store=store,
+        release_authority=authority,
+        node_id=node,
+        local_verified=True,
+    )
+    if not decision.ready:
+        raise SharedAdapterAuthorityError(
+            f"adapter shared release is not serving-ready ({decision.action.value})"
+        )
+    return desired, observation, decision
+
+
+def _retire_shared_adapter_release(
+    rolled_back_record_id: str,
+    *,
+    store: AdapterStore,
+    ledger,
+    release_authority,
+    node_id: str,
+):
+    """Retire shared desired state when rollback restores the base model."""
+    from .artifact_release_authority import ArtifactReleaseConflict
+
+    authority = _resolve_adapter_release_authority(release_authority)
+    node = _adapter_release_node_id(node_id)
+    try:
+        record = ledger.get(rolled_back_record_id)
+    except Exception as exc:
+        raise SharedAdapterAuthorityError(
+            "rolled-back adapter receipt is unavailable"
+        ) from exc
+    if record is None or not record.rolled_back:
+        raise SharedAdapterAuthorityError(
+            "shared adapter retirement requires a committed rollback receipt"
+        )
+    for _attempt in range(10):
+        desired = authority.get_desired(ADAPTER_RELEASE_DEPLOYMENT_ID)
+        if desired is None or desired.promotion_record_id != rolled_back_record_id:
+            raise SharedAdapterAuthorityError(
+                "shared desired adapter changed before retirement"
+            )
+        if desired.rollout_state == "retired":
+            break
+        next_state = (
+            "failed"
+            if desired.rollout_state in {"canary", "rolling", "rollback"}
+            else "retired"
+        )
+        try:
+            desired = authority.transition_rollout(
+                ADAPTER_RELEASE_DEPLOYMENT_ID,
+                next_state,
+                expected_revision=desired.revision,
+                actor="adapter-rollback",
+            )
+        except ArtifactReleaseConflict:
+            continue
+    else:
+        raise SharedAdapterAuthorityError(
+            "adapter shared retirement CAS did not converge"
+        )
+    if desired.rollout_state != "retired":
+        raise SharedAdapterAuthorityError(
+            "adapter shared release did not reach retired state"
+        )
+    observation = _report_shared_adapter_observation(
+        release_authority=authority,
+        node_id=node,
+        desired=desired,
+        observed_digest=None,
+        health="offline",
+        last_error="adapter rollback restored the base model",
+    )
+    decision = _shared_adapter_release_decision(
+        None,
+        store=store,
+        release_authority=authority,
+        node_id=node,
+        local_verified=True,
+    )
+    if decision.action.value != "retire_local":
+        raise SharedAdapterAuthorityError(
+            "retired adapter release returned an inconsistent decision"
+        )
+    return desired, observation, decision
+
+
+def _shared_release_result(desired, observation, decision) -> dict:
+    """Bounded evidence returned to a successful promotion caller."""
+    return {
+        "deployment_id": desired.deployment_id,
+        "generation": desired.generation,
+        "desired_digest": desired.desired_digest,
+        "previous_digest": desired.previous_digest,
+        "promotion_record_id": desired.promotion_record_id,
+        "promotion_transaction_id": desired.promotion_transaction_id,
+        "rollout_state": desired.rollout_state,
+        "revision": desired.revision,
+        "node_id": observation.node_id,
+        "observation_revision": observation.revision,
+        "ready": decision.ready,
+    }
