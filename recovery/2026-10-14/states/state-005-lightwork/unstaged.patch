+def _finite_number(
+    value: object, *, label: str, minimum: float, maximum: float,
+) -> float:
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        raise CalibrationAuthorityError(f"shared calibration {label} is invalid")
+    number = float(value)
+    if not math.isfinite(number) or not minimum <= number <= maximum:
+        raise CalibrationAuthorityError(f"shared calibration {label} is invalid")
+    return number
+
+
+def _optional_finite_number(
+    value: object, *, label: str, minimum: float, maximum: float,
+) -> float | None:
+    if value is None:
+        return None
+    return _finite_number(value, label=label, minimum=minimum, maximum=maximum)
+
+
+def _validated_shared_verdict(raw: object, kind: str) -> dict[str, Any]:
+    if not isinstance(raw, Mapping):
+        raise CalibrationAuthorityError("shared calibration verdict is not an object")
+    expected = _RISK_VERDICT_FIELDS if kind == "risk" else _GENERAL_VERDICT_FIELDS
+    if set(raw) != expected:
+        raise CalibrationAuthorityError("shared calibration verdict fields are invalid")
+
+    ts = _finite_number(raw["ts"], label="timestamp", minimum=0.0, maximum=1e12)
+    counts: dict[str, int] = {}
+    for key in ("n", "n_correct", "n_incorrect"):
+        value = raw[key]
+        if (isinstance(value, bool) or not isinstance(value, int)
+                or not 0 <= value <= _MAX_CALIBRATION_SAMPLES):
+            raise CalibrationAuthorityError(
+                f"shared calibration {key} is invalid"
+            )
+        counts[key] = value
+    if counts["n_correct"] + counts["n_incorrect"] > counts["n"]:
+        raise CalibrationAuthorityError("shared calibration counts are inconsistent")
+    discrimination = _finite_number(
+        raw["discrimination"], label="discrimination", minimum=-1.0, maximum=1.0,
+    )
+    brier = _finite_number(raw["brier"], label="brier", minimum=0.0, maximum=1.0)
+    if not isinstance(raw["adequate"], bool):
+        raise CalibrationAuthorityError("shared calibration adequacy is invalid")
+    reason = raw["reason"]
+    if not isinstance(reason, str) or not 0 <= len(reason) <= 4096:
+        raise CalibrationAuthorityError("shared calibration reason is invalid")
+    adversarial = _optional_finite_number(
+        raw["adversarial_discrimination"],
+        label="adversarial discrimination", minimum=-1.0, maximum=1.0,
+    )
+    resistance = _optional_finite_number(
+        raw["resistance"], label="resistance", minimum=-1_000.0, maximum=1_000.0,
+    )
+    normalized: dict[str, Any] = {
+        "ts": ts,
+        **counts,
+        "discrimination": discrimination,
+        "brier": brier,
+        "adequate": raw["adequate"],
+        "reason": reason,
+        "adversarial_discrimination": adversarial,
+        "resistance": resistance,
+    }
+    if kind == "risk":
+        if raw["schema"] != "maverick-calibration-receipt-v2":
+            raise CalibrationAuthorityError(
+                "shared calibration receipt schema is invalid"
+            )
+        evaluator_id = raw["evaluator_id"]
+        if (not isinstance(evaluator_id, str)
+                or not 1 <= len(evaluator_id) <= 240
+                or evaluator_id != evaluator_id.strip()):
+            raise CalibrationAuthorityError(
+                "shared calibration evaluator identity is invalid"
+            )
+        evidence_since = _finite_number(
+            raw["evidence_since"], label="evidence boundary",
+            minimum=0.0, maximum=1e12,
+        )
+        sample_min = _optional_finite_number(
+            raw["sample_min_ts"], label="minimum sample timestamp",
+            minimum=0.0, maximum=1e12,
+        )
+        sample_max = _optional_finite_number(
+            raw["sample_max_ts"], label="maximum sample timestamp",
+            minimum=0.0, maximum=1e12,
+        )
+        if (sample_min is None) != (sample_max is None):
+            raise CalibrationAuthorityError(
+                "shared calibration sample window is inconsistent"
+            )
+        if sample_min is not None and (
+            sample_min < evidence_since or sample_min > sample_max or sample_max > ts
+        ):
+            raise CalibrationAuthorityError(
+                "shared calibration sample window is invalid"
+            )
+        normalized.update({
+            "schema": "maverick-calibration-receipt-v2",
+            "evaluator_id": evaluator_id,
+            "evidence_since": evidence_since,
+            "sample_min_ts": sample_min,
+            "sample_max_ts": sample_max,
+        })
+    return normalized
+
+
+def _validated_verdict_document(raw: object, kind: str) -> tuple[int, dict[str, Any]]:
+    if raw == {}:
+        return 0, {}
+    if not isinstance(raw, Mapping) or set(raw) != {
+        "schema", "kind", "generation", "verdict",
+    }:
+        raise CalibrationAuthorityError(
+            "shared calibration authority document fields are invalid"
+        )
+    if raw["schema"] != _AUTHORITY_SCHEMA or raw["kind"] != kind:
+        raise CalibrationAuthorityError(
+            "shared calibration authority schema or kind is invalid"
+        )
+    generation = raw["generation"]
+    if (isinstance(generation, bool) or not isinstance(generation, int)
+            or not 1 <= generation <= _MAX_AUTHORITY_GENERATION):
+        raise CalibrationAuthorityError(
+            "shared calibration authority generation is invalid"
+        )
+    return generation, _validated_shared_verdict(raw["verdict"], kind)
+
+
+def _shared_store(kind: str):
+    try:
+        if _active_tenant_id() is None:
+            raise CalibrationAuthorityError(
+                "shared calibration authority requires an active tenant"
+            )
+        store = _new_verdict_store(kind)
+        if store.backend_kind != "postgres":
+            raise CalibrationAuthorityError(
+                "shared calibration authority backend drifted from Postgres"
+            )
+        return store
+    except CalibrationAuthorityError:
+        raise
+    except Exception as exc:
+        raise CalibrationAuthorityError(
+            "shared calibration authority is unavailable"
+        ) from exc
+
+
+def _require_postgres_store(store: object) -> None:
+    try:
+        backend = store.backend_kind  # type: ignore[attr-defined]
+    except Exception as exc:
+        raise CalibrationAuthorityError(
+            "shared calibration authority is unavailable"
+        ) from exc
+    if backend != "postgres":
+        raise CalibrationAuthorityError(
+            "shared calibration authority backend drifted from Postgres"
+        )
+
+
+def _path_entry_exists(path: Path, *, label: str) -> bool:
+    try:
+        path.lstat()
+    except FileNotFoundError:
+        return False
+    except OSError as exc:
+        raise CalibrationAuthorityError(
+            f"cannot inspect {label}"
+        ) from exc
+    return True
+
+
+def _assert_no_live_legacy_verdict(path: Path) -> None:
+    if _path_entry_exists(path, label="the legacy calibration verdict"):
+        raise CalibrationAuthorityError(
+            "legacy calibration verdict exists; explicitly migrate it and archive "
+            "the local copy before enabling shared authority"
+        )
+
+
+def _write_shared_verdict(
+    kind: str,
+    path: Path,
+    payload: Mapping[str, Any],
+    *,
+    permit_legacy: bool = False,
+    require_empty: bool = False,
+) -> int:
+    if not permit_legacy:
+        _assert_no_live_legacy_verdict(path)
+    normalized = _validated_shared_verdict(payload, kind)
+    store = _shared_store(kind)
+    try:
+        start_generation, existing = _validated_verdict_document(store.read(), kind)
+        _require_postgres_store(store)
+    except CalibrationAuthorityError:
+        raise
+    except Exception as exc:
+        raise CalibrationAuthorityError(
+            "shared calibration authority is unavailable"
+        ) from exc
+    if require_empty and start_generation:
+        if existing == normalized:
+            _require_postgres_store(store)
+            return start_generation
+        raise CalibrationAuthorityError(
+            "shared calibration verdict already exists; migration refuses to replace it"
+        )
+    if start_generation >= _MAX_AUTHORITY_GENERATION:
+        raise CalibrationAuthorityError(
+            "shared calibration authority generation is exhausted"
+        )
+
+    target_generation = start_generation + 1
+
+    def _commit(document: dict[str, Any]) -> int:
+        current_generation, _current = _validated_verdict_document(document, kind)
+        if current_generation != start_generation:
+            raise CalibrationAuthorityConflict(
+                "calibration verdict changed after assessment; stale writer refused"
+            )
+        document.clear()
+        document.update({
+            "schema": _AUTHORITY_SCHEMA,
+            "kind": kind,
+            "generation": target_generation,
+            "verdict": dict(normalized),
+        })
+        return target_generation
+
+    try:
+        committed = store.mutate(
+            _commit,
+            action="set_calibration_verdict",
+            actor="calibration",
+        )
+        generation, readback = _validated_verdict_document(store.read(), kind)
+        _require_postgres_store(store)
+    except CalibrationAuthorityError:
+        raise
+    except Exception as exc:
+        raise CalibrationAuthorityError(
+            "shared calibration verdict could not be committed"
+        ) from exc
+    if committed != target_generation or generation != target_generation or readback != normalized:
+        raise CalibrationAuthorityError(
+            "shared calibration verdict failed durable readback"
+        )
+    if not permit_legacy:
+        _assert_no_live_legacy_verdict(path)
+    return generation
+
