+def _validate_shared_document(
+    document: object,
+    *,
+    tenant_id: str,
+    initialize: bool,
+    now: float | None = None,
+) -> dict[str, Any] | None:
+    if not isinstance(document, dict):
+        raise OAuthVaultAuthorityError("OAuth vault document is malformed")
+    if not document:
+        if not initialize:
+            return None
+        if now is None:
+            raise OAuthVaultAuthorityError("OAuth authority time is unavailable")
+        document.update({
+            "schema_version": _SHARED_SCHEMA_VERSION,
+            "tenant_id": tenant_id,
+            "providers": {},
+            "legacy_sha256": None,
+            "created_at": now,
+            "updated_at": now,
+        })
+    if set(document) != {
+        "created_at",
+        "legacy_sha256",
+        "providers",
+        "schema_version",
+        "tenant_id",
+        "updated_at",
+    } or document.get("schema_version") != _SHARED_SCHEMA_VERSION:
+        raise OAuthVaultAuthorityError("OAuth vault document schema is invalid")
+    if document.get("tenant_id") != tenant_id:
+        raise OAuthVaultAuthorityError("OAuth vault tenant scope is inconsistent")
+    providers = document.get("providers")
+    if not isinstance(providers, dict) or len(providers) > _MAX_PROVIDERS:
+        raise OAuthVaultAuthorityError("OAuth provider roster exceeds its bound")
+    for raw_provider, entry in providers.items():
+        try:
+            provider = _provider(raw_provider)
+        except ValueError as exc:
+            raise OAuthVaultAuthorityError("OAuth provider identity is invalid") from exc
+        if not isinstance(entry, dict) or set(entry) != {
+            "ciphertext",
+            "expires_at",
+            "generation",
+            "record_sha256",
+            "refresh",
+            "updated_at",
+            "write_fingerprint",
+        }:
+            raise OAuthVaultAuthorityError("OAuth provider record schema is invalid")
+        encoded = entry.get("ciphertext")
+        if not isinstance(encoded, str) or len(encoded) > _MAX_RECORD_BYTES * 2:
+            raise OAuthVaultAuthorityError("OAuth provider ciphertext is invalid")
+        try:
+            decoded = base64.b64decode(encoded, validate=True)
+        except Exception as exc:
+            raise OAuthVaultAuthorityError("OAuth provider ciphertext is invalid") from exc
+        if not decoded or len(decoded) > _MAX_RECORD_BYTES + 4096:
+            raise OAuthVaultAuthorityError("OAuth provider ciphertext exceeds its bound")
+        _valid_digest(entry.get("record_sha256"), label="OAuth record digest")
+        _valid_digest(entry.get("write_fingerprint"), label="OAuth write fingerprint")
+        generation = entry.get("generation")
+        if (
+            not isinstance(generation, int)
+            or isinstance(generation, bool)
+            or generation < 1
+            or generation > 2**63 - 1
+        ):
+            raise OAuthVaultAuthorityError("OAuth record generation is invalid")
+        expires_at = entry.get("expires_at")
+        if expires_at is not None:
+            _nonnegative_token_number(expires_at, label="OAuth token expiry")
+        _positive_time(entry.get("updated_at"), label="OAuth update time")
+        _validate_refresh_claim(entry.get("refresh"), generation=generation)
+        # Provider is intentionally touched so a malicious non-string mapping
+        # key cannot survive validation on alternative Mapping implementations.
+        if provider != raw_provider:  # pragma: no cover - _provider is exact
+            raise OAuthVaultAuthorityError("OAuth provider identity changed")
+    legacy = document.get("legacy_sha256")
+    if legacy is not None:
+        _valid_digest(legacy, label="legacy OAuth vault digest")
+    created_at = _positive_time(document.get("created_at"), label="OAuth creation time")
+    updated_at = _positive_time(document.get("updated_at"), label="OAuth update time")
+    if updated_at < created_at:
+        raise OAuthVaultAuthorityError("OAuth update predates creation")
+    _canonical_json(
+        document,
+        label="OAuth vault document",
+        max_bytes=_MAX_DOCUMENT_BYTES,
+    )
+    return copy.deepcopy(document)
+
+
+def _legacy_file(path: Path) -> tuple[bytes, str] | None:
+    try:
+        info = path.lstat()
+    except FileNotFoundError:
+        return None
+    except OSError as exc:
+        raise OAuthVaultAuthorityError("legacy OAuth vault cannot be inspected") from exc
+    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
+        raise OAuthVaultAuthorityError("legacy OAuth vault is not a regular file")
+    if info.st_size > _MAX_LEGACY_BYTES:
+        raise OAuthVaultAuthorityError("legacy OAuth vault exceeds its size bound")
+    try:
+        raw = atomic_read_bytes(path)
+    except OSError as exc:
+        raise OAuthVaultAuthorityError("legacy OAuth vault cannot be read") from exc
+    if len(raw) > _MAX_LEGACY_BYTES:
+        raise OAuthVaultAuthorityError("legacy OAuth vault exceeds its size bound")
+    return raw, _sha256(raw)
+
