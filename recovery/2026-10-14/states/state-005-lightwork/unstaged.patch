+class _DocumentStore:
+    def __init__(self):
+        self.document = {}
+        self.mutations = 0
+
+    def read(self):
+        return dict(self.document)
+
+    def mutate(self, callback, **_kwargs):
+        import copy
+
+        working = copy.deepcopy(self.document)
+        result = callback(working)
+        self.document = working
+        self.mutations += 1
+        return result
+
+
+def test_governed_managed_registry_has_atomic_admin_semantics():
