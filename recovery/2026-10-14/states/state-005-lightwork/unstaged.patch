+def _shared_adapter_release_decision(
+    pointer: dict | None,
+    *,
+    store: AdapterStore,
+    release_authority,
+    node_id: str,
+    local_verified: bool = False,
+):
+    """Read a stable shared decision and bind it back to the local pointer.
+
+    ``ArtifactReleaseAuthority`` owns rollout and observed-state semantics. This
+    adapter-specific layer only proves that the exact signed local pointer is
+    the promotion named by that shared decision. It deliberately never treats
+    local pointer/file state as a substitute for missing shared authority.
+    """
+    authority = _resolve_adapter_release_authority(release_authority)
+    node = _adapter_release_node_id(node_id)
+    try:
+        desired_before = authority.get_desired(ADAPTER_RELEASE_DEPLOYMENT_ID)
+        decision = authority.reconciliation_decision(
+            ADAPTER_RELEASE_DEPLOYMENT_ID,
+            node,
+        )
+        desired_after = authority.get_desired(ADAPTER_RELEASE_DEPLOYMENT_ID)
+    except Exception as exc:
+        raise SharedAdapterAuthorityError(
+            "adapter shared release readiness is unavailable"
+        ) from exc
+    before_revision = (
+        desired_before.revision if desired_before is not None else None
+    )
+    after_revision = desired_after.revision if desired_after is not None else None
+    if before_revision != after_revision:
+        raise SharedAdapterAuthorityError(
+            "adapter shared desired release changed during readiness inspection"
+        )
+    if desired_after is None:
+        if pointer is None and decision.action.value == "wait_for_desired":
+            return decision
+        raise SharedAdapterAuthorityError(
+            "local adapter pointer exists without shared desired authority"
+        )
+    if pointer is None:
+        if (
+            desired_after.rollout_state == "retired"
+            and decision.action.value == "retire_local"
