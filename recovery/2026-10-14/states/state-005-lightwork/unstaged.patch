+def _read_archive_snapshot(path: Path) -> bytes | None:
+    """Read one bounded regular-file identity without following aliases."""
+    try:
+        before = path.lstat()
+    except FileNotFoundError:
+        return None
+    except OSError as exc:
+        raise ArchiveIntegrityError("archive path cannot be inspected") from exc
+    is_reparse = bool(
+        getattr(before, "st_file_attributes", 0) & _REPARSE_ATTRIBUTE
+    )
+    if not stat.S_ISREG(before.st_mode) or is_reparse:
+        raise ArchiveIntegrityError("archive path is not a regular file")
+    if before.st_size > _MAX_ARCHIVE_BYTES:
+        raise ArchiveIntegrityError("archive exceeds the size limit")
+    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
+    flags |= getattr(os, "O_BINARY", 0)
+    try:
+        descriptor = os.open(path, flags)
+    except OSError as exc:
+        raise ArchiveIntegrityError("archive cannot be opened") from exc
+    try:
+        opened = os.fstat(descriptor)
+        if (
+            not stat.S_ISREG(opened.st_mode)
+            or (opened.st_dev, opened.st_ino) != (before.st_dev, before.st_ino)
+        ):
+            raise ArchiveIntegrityError("archive changed during read")
+        chunks: list[bytes] = []
+        remaining = _MAX_ARCHIVE_BYTES + 1
+        while remaining:
+            chunk = os.read(descriptor, min(64 * 1024, remaining))
+            if not chunk:
+                break
+            chunks.append(chunk)
+            remaining -= len(chunk)
+        payload = b"".join(chunks)
+        if len(payload) > _MAX_ARCHIVE_BYTES:
+            raise ArchiveIntegrityError("archive exceeds the size limit")
+        after_descriptor = os.fstat(descriptor)
+        if _archive_file_identity(after_descriptor) != _archive_file_identity(opened):
+            raise ArchiveIntegrityError("archive changed during read")
+        try:
+            after_path = path.lstat()
+        except OSError as exc:
+            raise ArchiveIntegrityError("archive changed during read") from exc
+        if _archive_file_identity(after_path) != _archive_file_identity(before):
+            raise ArchiveIntegrityError("archive changed during read")
