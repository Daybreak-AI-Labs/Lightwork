+def adapter_release_readiness(
+    *,
+    store: AdapterStore | None = None,
+    release_authority=None,
+    node_id: str | None = None,
+):
+    """Return shared adapter readiness, or ``None`` in local single-node mode.
+
+    A returned decision may be non-ready (for example no desired release or a
+    retired release). Shared authority outages and local/shared disagreement
+    raise :class:`SharedAdapterAuthorityError`; callers must not silently route
+    a local pointer in those cases.
+    """
+    if not _configured_shared_adapter_authority():
+        return None
+    authority = _resolve_adapter_release_authority(release_authority)
+    node = _adapter_release_node_id(node_id)
+    st = store or AdapterStore()
+    if st.tenant_id != _active_tenant_id():
+        raise SharedAdapterAuthorityError(
+            "adapter readiness store tenant does not match active context"
+        )
+    pointer = st.active()
+    return _shared_adapter_release_decision(
+        pointer,
+        store=st,
+        release_authority=authority,
+        node_id=node,
+    )
