+def test_postgres_snapshots_preserve_encryption_and_tombstone_cap(
+    tmp_path,
+    monkeypatch,
+):
+    import maverick.a2a_tasks as a2a_tasks
+    from maverick.crypto_at_rest import is_sealed_str
+
+    monkeypatch.setenv("MAVERICK_ENCRYPT_AT_REST", "1")
+    monkeypatch.setattr(a2a_tasks, "_MAX_DURABLE_RETAINED_BYTES", 1_200)
+    db = tmp_path / "postgres-encrypted-seam.sqlite3"
+    calls: list[str] = []
+    engine = _engine_with_store(
+        _postgres_store(db, require_sealing=True),
+        lambda text, **kwargs: calls.append(text) or ("private result " * 80),
+    )
+    first = asyncio.run(engine.send(_msg("private prompt"), "agent:alice"))
+    assert first["status"]["state"] == "completed"
+
+    with sqlite3.connect(db) as connection:
+        status, stored = connection.execute(
+            "SELECT status, snapshot_json FROM a2a_task_claims"
+        ).fetchone()
+        retained = connection.execute(
+            "SELECT snapshot_bytes FROM a2a_task_meta"
+        ).fetchone()[0]
+    assert status == "tombstone"
+    assert stored is None
+    assert retained == 0
+
+    restarted = _engine_with_store(
+        _postgres_store(db, require_sealing=True),
+        lambda text, **kwargs: calls.append("duplicate") or "duplicate",
+    )
+    with pytest.raises(_RpcError, match="already consumed"):
+        asyncio.run(restarted.send(_msg("private prompt"), "agent:alice"))
+    assert calls == ["private prompt"]
+
+    # A snapshot that does fit remains sealed; prove this independently of the
+    # tombstoned body above so encryption is not inferred from absence.
+    monkeypatch.setattr(a2a_tasks, "_MAX_DURABLE_RETAINED_BYTES", 64 * 1024 * 1024)
+    second = asyncio.run(
+        restarted.send(_msg("other secret", "encrypted-2"), "agent:alice")
+    )
+    assert second["status"]["state"] == "completed"
+    with sqlite3.connect(db) as connection:
+        sealed = connection.execute(
+            "SELECT snapshot_json FROM a2a_task_claims "
+            "WHERE status = 'terminal'"
+        ).fetchone()[0]
+    assert is_sealed_str(sealed)
+    assert "other secret" not in sealed
+
