+                            )
+                        try:
+                            info = entry.stat(follow_symlinks=False)
+                        except OSError as error:
+                            raise _A2ALegacyMigrationRequired(
+                                "legacy A2A tenant inventory is unreadable"
+                            ) from error
+                        if stat.S_ISLNK(info.st_mode) or bool(
