+def _verdict_satisfies_policy(
+    verdict: object,
+    settings: object,
+    *,
+    now: float | None = None,
+    max_age_hours_cap: float | None = None,
+    minimum_samples: int = 0,
+    minimum_discrimination: float = 0.0,
+    require_natural_sample_floor: bool = False,
+    future_clock_skew_seconds: float = 0.0,
+) -> bool:
+    """Requalify one persisted verdict against the policy effective *now*.
+
+    A verdict's historical ``adequate`` bit is necessary but not sufficient:
+    shared policy can tighten after assessment.  Both the general learning
+    freeze and the risk-limited promotion receipt call this seam so sample,
+    discrimination, resistance, and freshness rules cannot drift apart.
+    """
+    if not isinstance(verdict, Mapping) or not isinstance(settings, Mapping):
+        return False
+    if verdict.get("adequate") is not True:
+        return False
+    try:
+        policy_samples = settings["min_samples"]
+        if (
+            isinstance(policy_samples, bool)
+            or not isinstance(policy_samples, int)
+            or not 1 <= policy_samples <= _MAX_CALIBRATION_SAMPLES
+            or isinstance(minimum_samples, bool)
+            or not isinstance(minimum_samples, int)
+            or not 0 <= minimum_samples <= _MAX_CALIBRATION_SAMPLES
+        ):
+            return False
+        sample_floor = max(policy_samples, minimum_samples)
+
+        policy_discrimination = float(settings["min_discrimination"])
+        discrimination_floor = max(
+            policy_discrimination,
+            float(minimum_discrimination),
+        )
+        resistance_floor = float(settings.get("min_resistance", 0.0))
+        policy_age = float(settings["max_age_hours"])
+        skew = float(future_clock_skew_seconds)
+        if (
+            not math.isfinite(discrimination_floor)
+            or not 0.0 <= discrimination_floor <= 1.0
+            or not math.isfinite(resistance_floor)
+            or not 0.0 <= resistance_floor <= 1.0
+            or not math.isfinite(policy_age)
+            or policy_age <= 0.0
+            or not math.isfinite(skew)
+            or skew < 0.0
+        ):
+            return False
+        effective_age = policy_age
+        if max_age_hours_cap is not None:
+            cap = float(max_age_hours_cap)
+            if not math.isfinite(cap) or cap <= 0.0:
+                return False
+            effective_age = min(effective_age, cap)
+
+        sample_n = verdict["n"]
+        n_correct = verdict["n_correct"]
+        n_incorrect = verdict["n_incorrect"]
+        if any(
+            isinstance(value, bool)
+            or not isinstance(value, int)
+            or not 0 <= value <= _MAX_CALIBRATION_SAMPLES
+            for value in (sample_n, n_correct, n_incorrect)
+        ):
+            return False
+        natural_n = n_correct + n_incorrect
+        measured_n = natural_n if require_natural_sample_floor else sample_n
+        if (
+            natural_n > sample_n
+            or n_correct <= 0
+            or n_incorrect <= 0
+            or measured_n < sample_floor
+        ):
+            return False
+
+        discrimination = float(verdict["discrimination"])
+        brier = float(verdict["brier"])
+        current = float(time.time() if now is None else now)
+        stamp = float(verdict["ts"])
+        age_seconds = current - stamp
+        if (
+            not math.isfinite(discrimination)
+            or not discrimination_floor <= discrimination <= 1.0
+            or not math.isfinite(brier)
+            or not 0.0 <= brier <= 1.0
+            or not math.isfinite(current)
+            or not math.isfinite(stamp)
+            or age_seconds < -skew
+            or age_seconds > effective_age * 3600.0
+        ):
+            return False
+        if resistance_floor > 0.0:
+            resistance = verdict.get("resistance")
+            if isinstance(resistance, bool) or not isinstance(
+                resistance, (int, float)
+            ):
+                return False
+            resistance_value = float(resistance)
+            if (
+                not math.isfinite(resistance_value)
+                or resistance_value < resistance_floor
+            ):
+                return False
+    except (KeyError, OverflowError, TypeError, ValueError):
+        return False
+    return True
+
 
