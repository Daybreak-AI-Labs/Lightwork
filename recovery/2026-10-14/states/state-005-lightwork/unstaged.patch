+    registry.put({"id": "rigel", "max_risk": "medium"})
+    assert registry.set_revoked("vega", True) is True
+    assert registry.remove("rigel") is True
+    assert registry.remove("rigel") is False
+
+    assert registry.load() == [
+        {"id": "vega", "max_risk": "low", "revoked": True}
+    ]
+    assert store.mutations == 5
+
