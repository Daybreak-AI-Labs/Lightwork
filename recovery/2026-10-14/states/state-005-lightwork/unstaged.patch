+    if phase == "executing" and (started_at is None or ambiguous_at is not None):
+        raise OAuthVaultAuthorityError("executing OAuth refresh evidence is invalid")
+    if phase == "ambiguous" and (started_at is None or ambiguous_at is None):
+        raise OAuthVaultAuthorityError("ambiguous OAuth refresh evidence is invalid")
+    if started_at is not None and started_at < acquired_at:
+        raise OAuthVaultAuthorityError("OAuth refresh starts before acquisition")
+    if ambiguous_at is not None and ambiguous_at < (started_at or acquired_at):
+        raise OAuthVaultAuthorityError("OAuth ambiguity predates execution")
