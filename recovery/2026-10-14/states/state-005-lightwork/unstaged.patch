+def _fsync_directory(path: Path) -> None:
+    if os.name == "nt":
+        return
+    flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0)
+    parent_fd = os.open(os.fspath(path), flags)
+    try:
+        os.fsync(parent_fd)
+    finally:
+        os.close(parent_fd)
