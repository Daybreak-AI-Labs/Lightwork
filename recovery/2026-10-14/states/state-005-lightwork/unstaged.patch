+def _validated_managed_entries(data: object) -> list[dict]:
+    if not isinstance(data, list):
+        raise AgentTrustError("managed registry root must be a list")
+    if len(data) > _MAX_AGENTS or any(not isinstance(a, dict) for a in data):
+        raise AgentTrustError("managed registry has an invalid entry or size")
+    return [dict(entry) for entry in data]
+
+
+class GovernedAgentTrustRegistry:
+    """Fleet-shared managed-agent overlay with document-level CAS."""
+
+    def __init__(self, store=None) -> None:
+        if store is None:
+            from .authority_documents import AuthorityDocumentStore
+
+            store = AuthorityDocumentStore(
+                "agent_trust_registry",
+                "ATR",
+                "agent_trust_registry",
+                required_backend="postgres",
+            )
+        self._store = store
+
+    @staticmethod
+    def _entries(document: dict) -> list[dict]:
+        if not document:
+            return []
+        if set(document) != {"agents"}:
+            raise AgentTrustError("managed registry document is invalid")
+        return _validated_managed_entries(document.get("agents"))
+
+    def load(self) -> list[dict]:
+        try:
+            return self._entries(self._store.read())
+        except AgentTrustError:
+            raise
+        except Exception as exc:
+            raise AgentTrustError(
+                "managed registry shared authority is unavailable"
+            ) from exc
+
+    def authoritative_time(self) -> float:
+        """Return the shared authority clock used for lifecycle decisions."""
+        try:
+            value = float(self._store.authoritative_time())
+        except Exception as exc:
+            raise AgentTrustError(
+                "managed registry shared authority clock is unavailable"
+            ) from exc
+        if not math.isfinite(value) or value <= 0:
+            raise AgentTrustError(
+                "managed registry shared authority clock is invalid"
+            )
+        return value
+
+    def _mutate(self, callback, *, action: str):
+        def _apply(document: dict):
+            entries = self._entries(document)
+            result = callback(entries)
+            document.clear()
+            document["agents"] = entries
+            return result
+
+        try:
+            return self._store.mutate(
+                _apply,
+                action=action,
+                actor="agent-trust-admin",
+            )
+        except AgentTrustError:
+            raise
+        except Exception as exc:
+            raise AgentTrustError(
+                "managed registry shared update failed"
+            ) from exc
+
+    def put(self, entry: dict) -> None:
+        agent_id = str(entry.get("id") or "")
+
+        def _put(entries: list[dict]) -> None:
+            entries[:] = [
+                item for item in entries
+                if str(item.get("id") or "") != agent_id
+            ]
+            if len(entries) >= _MAX_AGENTS:
+                raise AgentTrustError("managed registry exceeds the agent limit")
+            entries.append(dict(entry))
+
+        self._mutate(_put, action="put_agent")
+
+    def remove(self, agent_id: str) -> bool:
+        def _remove(entries: list[dict]) -> bool:
+            kept = [
+                item for item in entries
+                if str(item.get("id") or "") != agent_id
+            ]
+            found = len(kept) != len(entries)
+            entries[:] = kept
+            return found
+
+        return bool(self._mutate(_remove, action="remove_agent"))
+
+    def set_revoked(self, agent_id: str, revoked: bool) -> bool:
+        def _set(entries: list[dict]) -> bool:
+            found = False
+            for entry in entries:
+                if str(entry.get("id") or "") == agent_id:
+                    entry["revoked"] = bool(revoked)
+                    found = True
+            return found
+
+        return bool(self._mutate(_set, action="set_agent_revoked"))
+
