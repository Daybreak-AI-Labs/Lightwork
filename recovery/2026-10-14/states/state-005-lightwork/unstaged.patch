+def _promotion_backend_posture() -> _PromotionBackendPosture:
+    """Resolve the promotion authority from deployment-global policy only."""
+    try:
+        from .config import config_source_errors, load_global_config
+
+        config = load_global_config()
+        source_errors = config_source_errors(include_tenant=False)
+    except Exception:
+        raise PromotionLedgerError(
+            "promotion-ledger deployment policy is unavailable"
+        ) from None
+    if source_errors or not isinstance(config, Mapping):
+        raise PromotionLedgerError(
+            "promotion-ledger deployment policy is unavailable"
+        )
+    world = config.get("world_model") or {}
+    if not isinstance(world, Mapping):
+        raise PromotionLedgerError("promotion-ledger deployment policy is invalid")
+
+    backend = str(
+        os.environ.get("MAVERICK_WORLD_BACKEND")
+        or world.get("backend")
+        or "sqlite"
+    ).strip().lower()
+    if backend not in {"sqlite", "postgres"}:
+        raise PromotionLedgerError("promotion-ledger world backend is invalid")
+    try:
+        from .enterprise import deployment_enterprise_enabled
+
+        enterprise = deployment_enterprise_enabled(
+            config=config,
+            source_errors=source_errors,
+        )
+    except Exception:
+        enterprise = True
+    raw_replicas = os.environ.get("MAVERICK_REPLICA_COUNT", "1").strip()
+    try:
+        replicas = int(raw_replicas)
+    except (TypeError, ValueError, OverflowError):
+        replicas = 0
+    if replicas < 1 or str(replicas) != raw_replicas:
+        raise PromotionLedgerError(
+            "promotion-ledger replica count must be a positive integer"
+        )
+    shared_required = bool(enterprise or replicas > 1)
+    selected = backend == "postgres"
+    if shared_required and not selected:
+        raise PromotionLedgerError(
+            "enterprise and multi-replica promotion authority requires Postgres"
+        )
+    return _PromotionBackendPosture(selected, shared_required)
