+        connection = sqlite3.connect(uri, uri=True, timeout=2.0)
+        try:
+            connection.execute("PRAGMA query_only=ON")
+            connection.execute("PRAGMA trusted_schema=OFF")
+            objects = dict(connection.execute(
+                "SELECT name, type FROM sqlite_master WHERE name IN "
+                "('a2a_task_claims', 'a2a_task_meta')"
+            ).fetchall())
+            if any(str(kind) != "table" for kind in objects.values()):
+                raise _A2ALegacyMigrationRequired(
+                    "legacy A2A claim object has an invalid schema"
+                )
+            if "a2a_task_claims" in objects and connection.execute(
+                "SELECT 1 FROM a2a_task_claims LIMIT 1"
+            ).fetchone() is not None:
+                return True
+            if "a2a_task_meta" in objects:
+                counters = connection.execute(
+                    "SELECT claim_count, snapshot_bytes FROM a2a_task_meta "
+                    "LIMIT 1"
+                ).fetchone()
+                if counters is not None and (
+                    int(counters[0]) != 0 or int(counters[1]) != 0
+                ):
