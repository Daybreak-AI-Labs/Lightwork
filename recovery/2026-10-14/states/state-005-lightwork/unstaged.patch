+            "JOIN pg_namespace n ON n.oid = t.relnamespace "
+            "WHERE n.nspname = current_schema() AND c.contype = 'c' "
+            "AND t.relname IN ('a2a_task_claims', 'a2a_task_meta')"
+        )
+        actual_checks = {
+            (str(row[0]), str(row[1])): (
+                cls._canonical_check_expression(row[2]),
+                bool(row[3]),
+            )
+            for row in cur.fetchall()
+        }
+        for table, constraints in _POSTGRES_A2A_CHECKS.items():
+            for name, expression in constraints.items():
+                actual = actual_checks.get((table, name))
+                expected = cls._canonical_check_expression(expression)
+                if actual != (expected, True):
+                    return False
+        return True
+
+    def _schema_shape_is_ready(self) -> bool:
+        with self._transaction_factory() as cur:
+            return self._schema_shape_is_ready_with_cursor(cur)
+
+    @staticmethod
+    def _rls_expression_is_exact(value: object) -> bool:
+        expression = "".join(str(value or "").lower().split())
+        expression = expression.replace("::text", "")
+        expected = (
+            "tenant_id=nullif(current_setting('maverick.tenant',true),'')"
+        )
+        return expression in {expected, f"({expected})"}
+
+    @classmethod
+    def _rls_rows_are_exact(cls, rows: list[Any]) -> bool:
+        if len(rows) != 1:
+            return False
+        row = rows[0]
+        return (
+            str(row[0]) == _POSTGRES_A2A_RLS_POLICY
+            and str(row[1]).upper() == "PERMISSIVE"
+            and str(row[2]).lower().replace(" ", "") == "{public}"
+            and str(row[3]).upper() == "ALL"
+            and cls._rls_expression_is_exact(row[4])
+            and cls._rls_expression_is_exact(row[5])
+        )
+
+    @staticmethod
+    def _current_role_is_rls_bound(cur: Any) -> bool:
+        cur.execute(
+            "SELECT rolsuper, rolbypassrls FROM pg_roles "
+            "WHERE rolname = current_user"
+        )
+        role = cur.fetchone()
+        return bool(role and not role[0] and not role[1])
+
+    def _assert_current_role_rls_bound(self) -> None:
+        try:
+            with self._transaction_factory() as cur:
+                safe = self._current_role_is_rls_bound(cur)
+        except Exception:
+            safe = False
+        if not safe:
+            raise _PostgresDurableStoreError(
+                "Postgres A2A runtime role is not constrained by RLS"
+            )
+
+    @classmethod
+    def _read_rls_state(cls, cur: Any, table: str) -> tuple[bool, bool, bool]:
+        role_ok = cls._current_role_is_rls_bound(cur)
+        cur.execute(
+            "SELECT relrowsecurity, relforcerowsecurity FROM pg_class "
+            "WHERE oid = %s::regclass",
+            (table,),
+        )
+        flags = cur.fetchone()
+        cur.execute(
+            "SELECT policyname, permissive, roles::text, cmd, qual, with_check "
+            "FROM pg_policies WHERE schemaname = current_schema() "
+            "AND tablename = %s ORDER BY policyname",
+            (table,),
+        )
+        rows = list(cur.fetchall())
+        return (
+            role_ok,
+            bool(flags and flags[0] and flags[1]),
+            cls._rls_rows_are_exact(rows),
+        )
+
+    def _ensure_exact_rls(self, table: str) -> None:
+        # A provisioned least-privilege runtime role needs catalog read access,
+        # not table ownership. Verify first and return without advisory locks or
+        # DDL when a migration owner already installed the exact policy.
+        try:
+            with self._transaction_factory() as cur:
+                role_ok, flags_ok, policy_ok = self._read_rls_state(cur, table)
+            if role_ok and flags_ok and policy_ok:
+                return
+        except Exception:
+            pass
+        try:
+            with self._transaction_factory() as cur:
+                cur.execute(
+                    "SELECT pg_advisory_xact_lock(%s)",
+                    (_A2A_SCHEMA_ADVISORY_LOCK,),
+                )
+                role_ok, flags_ok, policy_ok = self._read_rls_state(cur, table)
+                if not role_ok:
+                    raise ValueError("A2A Postgres role can bypass RLS")
+                if flags_ok and policy_ok:
+                    return
+                cur.execute(f"ALTER TABLE {table} ENABLE ROW LEVEL SECURITY")
+                cur.execute(f"ALTER TABLE {table} FORCE ROW LEVEL SECURITY")
+                cur.execute(
+                    "SELECT policyname, permissive, roles::text, cmd, qual, "
+                    "with_check FROM pg_policies "
+                    "WHERE schemaname = current_schema() AND tablename = %s "
+                    "ORDER BY policyname",
+                    (table,),
+                )
+                policies = list(cur.fetchall())
+                if not policies:
+                    cur.execute(
+                        f"CREATE POLICY {_POSTGRES_A2A_RLS_POLICY} ON {table} "
+                        "USING (tenant_id = nullif(current_setting("
+                        "'maverick.tenant', true), '')) "
+                        "WITH CHECK (tenant_id = nullif(current_setting("
+                        "'maverick.tenant', true), ''))"
+                    )
+                elif not self._rls_rows_are_exact(policies):
+                    raise ValueError(
+                        "A2A Postgres RLS has extra or non-exact policies"
+                    )
+                role_ok, flags_ok, policy_ok = self._read_rls_state(cur, table)
+                if not role_ok or not flags_ok or not policy_ok:
+                    raise ValueError("A2A Postgres RLS is not forced and exact")
+        except Exception:
+            # A runtime role may be unable to ALTER a table provisioned by a
+            # migration owner. It may proceed only when a fresh independent
+            # read proves forced RLS and exactly one fail-closed policy.
+            try:
+                with self._transaction_factory() as cur:
+                    role_ok, flags_ok, policy_ok = self._read_rls_state(cur, table)
+            except Exception:
+                role_ok = flags_ok = policy_ok = False
+            if not role_ok or not flags_ok or not policy_ok:
+                raise _PostgresDurableStoreError(
+                    "Postgres A2A tenant RLS is unavailable"
+                ) from None
+
+    def _verify_operation_authority(self, cur: Any) -> None:
+        """Re-prove the database boundary inside every claim transaction.
+
+        PostgreSQL combines permissive policies with OR.  A policy or schema
+        change after process startup therefore cannot be treated as static
+        configuration: accepting one transaction before noticing drift could
+        expose another tenant's task or admit a duplicate provider execution.
+        """
+        if self._verify_schema and not self._schema_shape_is_ready_with_cursor(cur):
+            raise _PostgresDurableStoreError(
+                "Postgres A2A authority schema drift was detected"
+            )
+        if self._configure_rls:
+            for table in _POSTGRES_A2A_RLS_TABLES:
+                role_ok, flags_ok, policy_ok = self._read_rls_state(cur, table)
+                if not role_ok or not flags_ok or not policy_ok:
+                    raise _PostgresDurableStoreError(
+                        "Postgres A2A tenant boundary drift was detected"
+                    )
+
+    def _operation_tenant(self, tenant: str) -> str:
+        """Bind stored scope to independently resolved request authority."""
+        try:
+            from .paths import canonical_tenant_id, current_tenant_id_strict
+
+            active = current_tenant_id_strict()
+            if active is None and _shared_a2a_authority_required():
+                raise ValueError("shared A2A authority requires a bound tenant")
+            expected = canonical_tenant_id(active) if active else ""
+            supplied = canonical_tenant_id(tenant) if tenant else ""
+            if not hmac.compare_digest(
+                expected.encode("utf-8"), supplied.encode("utf-8")
+            ):
+                raise ValueError("A2A operation tenant does not match request scope")
+            return supplied or _POSTGRES_A2A_UNBOUND_TENANT
+        except Exception:
+            raise _PostgresDurableStoreError(
+                "Postgres A2A tenant binding is unavailable"
+            ) from None
+
+    @staticmethod
+    def _validate_claim_identity(
+        *,
+        tenant_id: str,
+        principal: str,
+        task_id: str,
+        message_key: str | None = None,
+        request_digest: str | None = None,
+    ) -> None:
+        tenant_valid = tenant_id == _POSTGRES_A2A_UNBOUND_TENANT or (
+            isinstance(tenant_id, str)
+            and 0 < len(tenant_id.encode("utf-8")) <= _MAX_POSTGRES_TENANT_BYTES
+            and tenant_id not in {".", ".."}
+        )
+        if (
+            not tenant_valid
+            or not isinstance(principal, str)
+            or len(principal.encode("utf-8")) > _MAX_DURABLE_PRINCIPAL_BYTES
+            or _POSTGRES_A2A_PRINCIPAL_RE.fullmatch(principal) is None
+            or not isinstance(task_id, str)
+            or _POSTGRES_A2A_TASK_ID_RE.fullmatch(task_id) is None
+            or (
+                message_key is not None
+                and (
+                    not isinstance(message_key, str)
+                    or _POSTGRES_A2A_HEX_RE.fullmatch(message_key) is None
+                )
+            )
+            or (
+                request_digest is not None
+                and (
+                    not isinstance(request_digest, str)
+                    or _POSTGRES_A2A_HEX_RE.fullmatch(request_digest) is None
+                )
+            )
+        ):
+            raise _PostgresDurableStoreError(
+                "Postgres A2A claim identity is unavailable"
+            )
+
+    @staticmethod
+    def _set_operation_tenant(cur: Any, db_tenant: str) -> None:
+        cur.execute(
+            "SELECT set_config('maverick.tenant', %s, true)",
+            (db_tenant,),
+        )
+
+    @staticmethod
+    def _ensure_meta(cur: Any, tenant_id: str) -> tuple[int, int]:
+        # The INSERT covers a store created around pre-existing rows and also
+        # proves the exact UNIQUE(tenant_id) arbiter required by ON CONFLICT.
+        cur.execute(
+            "INSERT INTO a2a_task_meta(tenant_id, claim_count, snapshot_bytes) "
+            "SELECT %s, COUNT(*), COALESCE(SUM(CASE WHEN snapshot_json IS NULL "
+            "THEN 0 ELSE octet_length(snapshot_json) END), 0) "
+            "FROM a2a_task_claims WHERE tenant_id = %s "
+            "ON CONFLICT (tenant_id) DO NOTHING",
+            (tenant_id, tenant_id),
+        )
+        cur.execute(
+            "SELECT claim_count, snapshot_bytes FROM a2a_task_meta "
+            "WHERE tenant_id = %s FOR UPDATE",
+            (tenant_id,),
+        )
+        row = cur.fetchone()
+        if row is None:
+            raise ValueError("A2A durable task accounting unavailable")
+        count, retained = int(row[0]), int(row[1])
+        if count < 0 or retained < 0 or retained > _MAX_DURABLE_RETAINED_BYTES:
+            raise ValueError("invalid A2A durable task accounting")
+        return count, retained
+
+    @staticmethod
+    def _make_snapshot_room(
+        cur: Any,
+        tenant_id: str,
+        *,
+        retained: int,
+        old_size: int,
+        new_size: int,
+        exclude_task_id: str = "",
+    ) -> int | None:
+        target = retained - old_size + new_size
+        while target > _MAX_DURABLE_RETAINED_BYTES:
+            cur.execute(
+                "SELECT task_id, octet_length(snapshot_json) AS size "
+                "FROM a2a_task_claims WHERE tenant_id = %s "
+                "AND status = 'terminal' AND snapshot_json IS NOT NULL "
+                "AND task_id != %s ORDER BY updated_at ASC, task_id ASC "
+                "LIMIT 1 FOR UPDATE",
+                (tenant_id, exclude_task_id),
+            )
+            row = cur.fetchone()
+            if row is None:
+                return None
+            size = int(row[1] or 0)
+            cur.execute(
+                "UPDATE a2a_task_claims SET status = 'tombstone', "
+                "snapshot_json = NULL WHERE tenant_id = %s AND task_id = %s "
+                "AND status = 'terminal'",
+                (tenant_id, str(row[0])),
+            )
+            if cur.rowcount != 1:
+                raise ValueError("A2A durable tombstone arbitration failed")
+            retained = max(0, retained - size)
+            target = retained - old_size + new_size
+        return target
+
+    def _existing_claim(
+        self,
+        row: Any,
+        *,
+        tenant: str,
+        principal: str,
+        message_key: str,
+        request_digest: str,
+        owner_task_id: str,
+    ) -> tuple[str, _Task | None]:
+        original_digest = str(row[0])
+        if not hmac.compare_digest(original_digest, request_digest):
+            return "conflict", None
+        status = str(row[2])
+        if status == "in_progress":
+            # ``task_id`` is minted before the transaction starts and remains
+            # stable for this admission attempt.  If Postgres committed the
+            # INSERT but the commit acknowledgement was lost, the bounded
+            # retry below may safely recover only that exact owner.  A second
+            # request/replica has a different task id and remains
+            # indeterminate, so it can never execute the message twice.
+            if hmac.compare_digest(str(row[1]), owner_task_id):
+                return "owner", None
+            return "indeterminate", None
+        if status == "tombstone":
+            return "tombstone", None
+        if status != "terminal" or row[3] is None:
+            raise ValueError("invalid A2A durable task status")
+        snapshot = self._decode_snapshot(tenant, str(row[3]))
+        cached = _Task.from_durable_snapshot(
+            snapshot,
+            task_id=str(row[1]),
+            tenant=tenant,
+            principal=principal,
+            message_key=message_key,
+            request_digest=request_digest,
+        )
+        return "cached", cached
+
+    def claim(
+        self,
+        task: _Task,
+        *,
+        message_id: str,
+        request_digest: str,
+    ) -> tuple[str, _Task | None]:
+        db_tenant = self._operation_tenant(task.tenant)
+        message_key = self._message_key(message_id)
+        self._validate_claim_identity(
+            tenant_id=db_tenant,
+            principal=task.principal,
+            task_id=task.id,
+            message_key=message_key,
+            request_digest=request_digest,
+        )
+        if self._check_legacy:
+            _assert_no_legacy_a2a_claims(
+                path_override=self._legacy_path_override,
+                tenant=task.tenant,
+            )
+        snapshot = self._encode_snapshot(task.tenant, task.durable_snapshot())
+        snapshot_size = len(snapshot.encode("utf-8"))
+        now = time.time()
+        last_error: Exception | None = None
+        for _attempt in range(2):
+            try:
+                with self._transaction_factory() as cur:
+                    self._verify_operation_authority(cur)
+                    self._set_operation_tenant(cur, db_tenant)
+                    count, retained = self._ensure_meta(cur, db_tenant)
+                    cur.execute(
+                        "SELECT request_digest, task_id, status, snapshot_json "
+                        "FROM a2a_task_claims WHERE tenant_id = %s "
+                        "AND principal = %s AND message_key = %s FOR UPDATE",
+                        (db_tenant, task.principal, message_key),
+                    )
+                    row = cur.fetchone()
+                    if row is not None:
+                        return self._existing_claim(
+                            row,
+                            tenant=task.tenant,
+                            principal=task.principal,
+                            message_key=message_key,
+                            request_digest=request_digest,
+                            owner_task_id=task.id,
+                        )
+                    if count >= _MAX_DURABLE_CLAIMS:
+                        return "capacity", None
+                    cur.execute(
+                        "INSERT INTO a2a_task_claims("
+                        "tenant_id, principal, message_key, request_digest, "
+                        "task_id, status, snapshot_json, created_at, updated_at"
+                        ") VALUES (%s, %s, %s, %s, %s, 'in_progress', %s, %s, %s) "
+                        "ON CONFLICT (tenant_id, principal, message_key) "
+                        "DO NOTHING RETURNING task_id",
+                        (
+                            db_tenant,
+                            task.principal,
+                            message_key,
+                            request_digest,
+                            task.id,
+                            snapshot,
+                            now,
+                            now,
+                        ),
+                    )
+                    inserted = cur.fetchone()
+                    if inserted is None:
+                        # A writer that does not honor the tenant accounting
+                        # lock raced us. Re-read the authoritative unique-key
+                        # winner before anything can execute.
+                        cur.execute(
+                            "SELECT request_digest, task_id, status, snapshot_json "
+                            "FROM a2a_task_claims WHERE tenant_id = %s "
+                            "AND principal = %s AND message_key = %s FOR UPDATE",
+                            (db_tenant, task.principal, message_key),
+                        )
+                        winner = cur.fetchone()
+                        if winner is None:
+                            raise ValueError("A2A durable claim arbitration failed")
+                        return self._existing_claim(
+                            winner,
+                            tenant=task.tenant,
+                            principal=task.principal,
+                            message_key=message_key,
+                            request_digest=request_digest,
+                            owner_task_id=task.id,
+                        )
+                    # Insert before tombstoning. The new row is still inside
+                    # this transaction and cannot be observed until commit.
+                    next_retained = self._make_snapshot_room(
+                        cur,
+                        db_tenant,
+                        retained=retained,
+                        old_size=0,
+                        new_size=snapshot_size,
+                    )
+                    if next_retained is None:
+                        # Roll back the inserted claim and any tombstones
+                        # selected before discovering active rows fill the cap.
+                        raise _PostgresClaimCapacity
+                    cur.execute(
+                        "UPDATE a2a_task_meta SET claim_count = %s, "
+                        "snapshot_bytes = %s WHERE tenant_id = %s",
+                        (count + 1, next_retained, db_tenant),
+                    )
+                    if cur.rowcount != 1:
+                        raise ValueError("A2A durable accounting update failed")
+                    return "owner", None
+            except _PostgresClaimCapacity:
+                return "capacity", None
+            except (KeyboardInterrupt, SystemExit):
+                raise
+            except Exception as error:  # noqa: BLE001 - commit may have succeeded
+                last_error = error
+        assert last_error is not None
+        _raise_postgres_store_error("claim", last_error)
+
+    def save(self, task: _Task) -> str:
+        db_tenant = self._operation_tenant(task.tenant)
+        if self._check_legacy:
+            _assert_no_legacy_a2a_claims(
+                path_override=self._legacy_path_override,
+                tenant=task.tenant,
+            )
+        if task.idempotency_key is None or not task.request_digest:
+            raise ValueError("durable A2A task is missing its claim identity")
+        _tenant, _principal, message_id = task.idempotency_key
+        message_key = self._message_key(message_id)
+        self._validate_claim_identity(
+            tenant_id=db_tenant,
+            principal=task.principal,
+            task_id=task.id,
+            message_key=message_key,
+            request_digest=task.request_digest,
+        )
+        snapshot = self._encode_snapshot(task.tenant, task.durable_snapshot())
+        snapshot_size = len(snapshot.encode("utf-8"))
+        new_status = "terminal" if task.state in TERMINAL_STATES else "in_progress"
+        try:
+            with self._transaction_factory() as cur:
+                self._verify_operation_authority(cur)
+                self._set_operation_tenant(cur, db_tenant)
+                _count, retained = self._ensure_meta(cur, db_tenant)
+                cur.execute(
+                    "SELECT request_digest, status, snapshot_json "
+                    "FROM a2a_task_claims WHERE tenant_id = %s AND principal = %s "
+                    "AND message_key = %s AND task_id = %s FOR UPDATE",
+                    (db_tenant, task.principal, message_key, task.id),
+                )
+                row = cur.fetchone()
+                if row is None or not hmac.compare_digest(
+                    str(row[0]), task.request_digest,
+                ):
+                    raise ValueError("durable A2A claim identity mismatch")
+                old_status = str(row[1])
+                if old_status == "tombstone":
+                    return "tombstone"
+                if old_status == "terminal" and new_status != "terminal":
+                    raise ValueError("durable A2A terminal state cannot be reopened")
+                old_snapshot = row[2]
+                old_size = (
+                    len(str(old_snapshot).encode("utf-8"))
+                    if old_snapshot is not None else 0
+                )
+                next_retained = self._make_snapshot_room(
+                    cur,
+                    db_tenant,
+                    retained=retained,
+                    old_size=old_size,
+                    new_size=snapshot_size,
+                    exclude_task_id=task.id,
+                )
+                if next_retained is None:
+                    if new_status != "terminal":
+                        raise ValueError("A2A durable active-state capacity reached")
+                    cur.execute(
+                        "UPDATE a2a_task_claims SET status = 'tombstone', "
+                        "snapshot_json = NULL, updated_at = %s "
+                        "WHERE tenant_id = %s AND principal = %s "
+                        "AND message_key = %s AND task_id = %s",
+                        (
+                            time.time(),
+                            db_tenant,
+                            task.principal,
+                            message_key,
+                            task.id,
+                        ),
+                    )
+                    if cur.rowcount != 1:
+                        raise ValueError("A2A durable tombstone settlement failed")
+                    cur.execute(
+                        "SELECT COALESCE(SUM(CASE WHEN snapshot_json IS NULL "
+                        "THEN 0 ELSE octet_length(snapshot_json) END), 0) "
+                        "FROM a2a_task_claims WHERE tenant_id = %s",
+                        (db_tenant,),
+                    )
+                    actual_retained = int((cur.fetchone() or (0,))[0])
+                    cur.execute(
+                        "UPDATE a2a_task_meta SET snapshot_bytes = %s "
+                        "WHERE tenant_id = %s",
+                        (actual_retained, db_tenant),
+                    )
+                    if cur.rowcount != 1:
+                        raise ValueError("A2A durable accounting update failed")
+                    return "tombstone"
+                cur.execute(
+                    "UPDATE a2a_task_claims SET status = %s, "
+                    "snapshot_json = %s, updated_at = %s "
+                    "WHERE tenant_id = %s AND principal = %s "
+                    "AND message_key = %s AND task_id = %s",
+                    (
+                        new_status,
+                        snapshot,
+                        time.time(),
+                        db_tenant,
+                        task.principal,
+                        message_key,
+                        task.id,
+                    ),
+                )
+                if cur.rowcount != 1:
+                    raise ValueError("A2A durable settlement arbitration failed")
+                cur.execute(
+                    "UPDATE a2a_task_meta SET snapshot_bytes = %s "
+                    "WHERE tenant_id = %s",
+                    (next_retained, db_tenant),
+                )
+                if cur.rowcount != 1:
+                    raise ValueError("A2A durable accounting update failed")
+                return new_status
+        except Exception as error:
+            _raise_postgres_store_error("settlement", error)
+
+    def load(
+        self, *, tenant: str, principal: str, task_id: str,
+    ) -> tuple[str, _Task | None]:
+        db_tenant = self._operation_tenant(tenant)
+        if (
+            not isinstance(task_id, str)
+            or _POSTGRES_A2A_TASK_ID_RE.fullmatch(task_id) is None
+        ):
+            return "missing", None
+        self._validate_claim_identity(
+            tenant_id=db_tenant,
+            principal=principal,
+            task_id=task_id,
+        )
+        if self._check_legacy:
+            _assert_no_legacy_a2a_claims(
+                path_override=self._legacy_path_override,
+                tenant=tenant,
+            )
+        try:
+            with self._transaction_factory() as cur:
+                self._verify_operation_authority(cur)
+                self._set_operation_tenant(cur, db_tenant)
+                cur.execute(
+                    "SELECT message_key, request_digest, status, snapshot_json "
+                    "FROM a2a_task_claims WHERE tenant_id = %s AND principal = %s "
+                    "AND task_id = %s",
+                    (db_tenant, principal, task_id),
+                )
+                row = cur.fetchone()
+            if row is None:
+                return "missing", None
+            status = str(row[2])
+            if status != "terminal":
+                if status not in {"in_progress", "tombstone"}:
+                    raise ValueError("invalid A2A durable task status")
+                return status, None
+            if row[3] is None:
