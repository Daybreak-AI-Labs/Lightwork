+    candidates: list[Path] = []
+    if path_override is not None:
+        candidates.append(Path(path_override).expanduser())
+    if all_tenants:
+        home = maverick_home()
+        candidates.append(home / "a2a" / "tasks.sqlite3")
+        tenants_root = home / "tenants"
+        try:
+            root_info = tenants_root.lstat()
+        except FileNotFoundError:
+            root_info = None
+        except OSError as error:
+            raise _A2ALegacyMigrationRequired(
+                "legacy A2A ledger inventory is unreadable"
+            ) from error
+        if root_info is not None:
+            junction = getattr(tenants_root, "is_junction", None)
+            if (
+                stat.S_ISLNK(root_info.st_mode)
+                or bool(getattr(root_info, "st_file_attributes", 0) & 0x400)
+                or bool(callable(junction) and junction())
+                or not stat.S_ISDIR(root_info.st_mode)
+            ):
+                raise _A2ALegacyMigrationRequired(
+                    "legacy A2A tenant inventory is not a stable directory"
+                )
+            try:
+                with os.scandir(tenants_root) as entries:
+                    for index, entry in enumerate(entries, start=1):
+                        if index > _MAX_LEGACY_TENANT_DIRECTORIES:
+                            raise _A2ALegacyMigrationRequired(
