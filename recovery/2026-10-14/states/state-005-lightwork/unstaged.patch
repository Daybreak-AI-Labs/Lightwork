+        raise LearningStoreError("legacy learning state is not a regular file")
+    if before.st_size < 0 or before.st_size > limit:
+        raise LearningStoreError("legacy learning state exceeds its size limit")
+
+    flags = os.O_RDONLY | getattr(os, "O_BINARY", 0) | getattr(os, "O_NOFOLLOW", 0)
+    descriptor: int | None = None
+    chunks: list[bytes] | None = [] if include_data else None
+    digest = hashlib.sha256()
+    total = 0
+    try:
+        descriptor = os.open(path, flags)
+        opened = os.fstat(descriptor)
+        if not stat.S_ISREG(opened.st_mode) or not _same_file_identity(before, opened):
+            raise LearningStoreError("legacy learning state changed during inspection")
+        if include_data or compute_digest:
+            while True:
+                chunk = os.read(
+                    descriptor,
+                    min(_FILE_READ_CHUNK, limit + 1 - total),
+                )
+                if not chunk:
+                    break
+                total += len(chunk)
+                if total > limit:
+                    raise LearningStoreError(
+                        "legacy learning state exceeds its size limit"
+                    )
+                digest.update(chunk)
+                if chunks is not None:
+                    chunks.append(chunk)
+        else:
+            total = int(opened.st_size)
+        after_fd = os.fstat(descriptor)
+        if total != int(opened.st_size) or not _same_file_identity(opened, after_fd):
+            raise LearningStoreError("legacy learning state changed during inspection")
+    except LearningStoreError:
+        raise
+    except OSError:
+        raise LearningStoreError("legacy learning state cannot be inspected") from None
+    finally:
+        if descriptor is not None:
+            os.close(descriptor)
+    try:
+        after_path = os.lstat(path)
+    except OSError:
+        raise LearningStoreError("legacy learning state changed during inspection") from None
+    if not _same_file_identity(opened, after_path):
+        raise LearningStoreError("legacy learning state changed during inspection")
+    fingerprint = _FileFingerprint(
+        marker=_path_marker(path),
+        path=Path(os.path.abspath(os.fspath(path))),
+        device=int(opened.st_dev),
+        inode=int(opened.st_ino),
+        size=int(opened.st_size),
+        mtime_ns=_mtime_ns(opened),
+        digest=digest.hexdigest(),
+    )
+    return _LegacyFileSnapshot(
+        fingerprint=fingerprint,
+        data=b"".join(chunks or ()),
+    )
+
+
+def _fingerprint_is_allowed(
+    fingerprint: _FileFingerprint,
+    *,
+    tenant: str | None,
+) -> bool:
+    allowance = _LEGACY_MIGRATION_ALLOWANCE.get()
+    if allowance is None or allowance.tenant != tenant:
+        return False
+    return any(
+        allowed == fingerprint
+        for allowed in allowance.fingerprints
+    )
+
+
+def _snapshot_json(snapshot: _LegacyFileSnapshot) -> object:
+    if not snapshot.data.strip():
+        return {}
+    try:
+        from .crypto_at_rest import unseal
+
+        return json.loads(unseal(snapshot.data).decode("utf-8"))
+    except Exception:
+        raise LearningStoreError("legacy learning JSON is malformed") from None
+
+
+def _file_has_legacy_state(path: Path, *, tenant: str | None = None) -> bool:
+    snapshot = _capture_regular_file(
+        path,
+        limit=_MAX_LEGACY_FILE_BYTES,
+        include_data=True,
+    )
+    if snapshot is None:
+        return False
+    parsed = _snapshot_json(snapshot)
+    has_state = parsed not in ({}, [])
+    return has_state and not _fingerprint_is_allowed(
+        snapshot.fingerprint,
+        tenant=tenant,
+    )
+
+
+def _sqlite_has_legacy_state(path: Path) -> bool:
+    first = _capture_regular_file(
+        path,
+        limit=_MAX_LEGACY_DB_BYTES,
+        include_data=False,
+        compute_digest=False,
+    )
+    if first is None:
+        return False
+    try:
+        uri = first.fingerprint.path.as_uri() + "?mode=ro"
+        with sqlite3.connect(uri, uri=True, timeout=2.0) as conn:
+            for table in _LEGACY_POSTGRES_TABLES:
+                exists = conn.execute(
+                    "SELECT 1 FROM sqlite_master WHERE type='table' "
+                    "AND name=? LIMIT 1",
+                    (table,),
+                ).fetchone()
+                if exists and conn.execute(
+                    f"SELECT 1 FROM {table} LIMIT 1"
+                ).fetchone() is not None:
+                    return True
+    except Exception:
+        raise LearningStoreError(
+            "legacy learning database cannot be verified for Postgres cutover"
+        ) from None
+    second = _capture_regular_file(
+        path,
+        limit=_MAX_LEGACY_DB_BYTES,
+        include_data=False,
+        compute_digest=False,
+    )
+    if second is None or second.fingerprint != first.fingerprint:
+        raise LearningStoreError("legacy learning database changed during inspection")
+    return False
+
+
+def _legacy_bases() -> Iterator[Path]:
+    from .paths import maverick_home
+
+    home = maverick_home()
+    try:
+        home_status = os.lstat(home)
+    except FileNotFoundError:
+        yield home
+        return
+    except OSError:
+        raise LearningStoreError("legacy learning root cannot be inspected") from None
+    if not stat.S_ISDIR(home_status.st_mode):
+        raise LearningStoreError("legacy learning root is not a regular directory")
+    yield home
+    tenant_root = home / "tenants"
+    try:
+        tenant_status = os.lstat(tenant_root)
+    except FileNotFoundError:
+        return
+    except OSError:
+        raise LearningStoreError("legacy tenant state cannot be inspected") from None
+    if not stat.S_ISDIR(tenant_status.st_mode):
+        raise LearningStoreError("legacy tenant state root is not a regular directory")
+    count = 0
+    try:
+        with os.scandir(tenant_root) as entries:
+            for entry in entries:
+                count += 1
+                if count > _MAX_TENANT_DIRS:
+                    raise LearningStoreError(
+                        "legacy tenant state exceeds the bounded Postgres cutover scan"
+                    )
+                if entry.is_symlink() or not entry.is_dir(follow_symlinks=False):
+                    raise LearningStoreError(
+                        "legacy tenant state root contains an untrusted entry"
+                    )
+                yield Path(entry.path)
+    except LearningStoreError:
+        raise
+    except OSError:
+        raise LearningStoreError(
+            "legacy tenant state cannot be verified for Postgres cutover"
+        ) from None
+
+
+def _legacy_base_for_tenant(tenant: str | None) -> Path:
+    """Return one tenant's legacy root after strict path admission.
+
+    A Postgres row is tenant-scoped, so cutover is tenant-scoped too.  Scanning
+    every other tenant made two non-empty tenants mutually impossible to
+    migrate.  Resolve only the active tenant's existing namespace here, while
+    retaining the bounded all-tenant enumerator above for diagnostics.
+    """
+    from .paths import data_dir
+
+    try:
+        base = data_dir(tenant=tenant)
+    except Exception:
+        raise LearningStoreError(
+            "legacy learning migration could not resolve the tenant boundary"
+        ) from None
+    home = base if tenant is None else base.parent.parent
+    candidates = (home,) if tenant is None else (home, base.parent, base)
+    for candidate in candidates:
+        try:
+            status = os.lstat(candidate)
+        except FileNotFoundError:
+            continue
+        except OSError:
+            raise LearningStoreError(
+                "legacy tenant state cannot be inspected"
+            ) from None
+        if not stat.S_ISDIR(status.st_mode):
+            raise LearningStoreError(
+                "legacy tenant state root is not a regular directory"
+            )
+    return base
+
+
+def _configured_corpus_paths() -> tuple[Path, ...]:
+    try:
+        from .self_harness import settings
+        from .self_harness_eval import pending_corpus_path, rejected_corpus_path
+
+        configured = settings().get("eval_corpus")
+        if not configured:
+            return ()
+        base = Path(str(configured)).expanduser()
+        return (base, pending_corpus_path(base), rejected_corpus_path(base))
+    except Exception:
+        raise LearningStoreError(
+            "legacy corpus location cannot be verified for Postgres cutover"
+        ) from None
+
+
+def _optional_tenant_key() -> str | None:
+    try:
+        from .paths import canonical_tenant_id, current_tenant_id_strict
+
+        raw = current_tenant_id_strict()
+        return canonical_tenant_id(raw) if raw is not None else None
+    except Exception:
+        raise LearningStoreError(
+            "legacy learning migration could not resolve the tenant boundary"
+        ) from None
+
+
+def _prepare_legacy_file_migration(
+    paths: Sequence[Path],
+) -> _LegacyMigrationPlan:
+    """Capture a one-shot, tenant-bound migration plan for exact source files."""
+    snapshots: list[_LegacyFileSnapshot] = []
+    markers: set[str] = set()
+    for raw_path in paths:
+        path = Path(raw_path)
+        marker = _path_marker(path)
+        if marker in markers:
+            continue
+        markers.add(marker)
+        snapshot = _capture_regular_file(
+            path,
+            limit=_MAX_LEGACY_FILE_BYTES,
+            include_data=True,
+        )
+        if snapshot is not None:
+            snapshots.append(snapshot)
+    return _LegacyMigrationPlan(
+        tenant=_optional_tenant_key(),
+        snapshots=tuple(snapshots),
+    )
+
+
+def _plan_snapshot(
+    plan: _LegacyMigrationPlan,
+    path: Path,
+) -> _LegacyFileSnapshot | None:
+    marker = _path_marker(Path(path))
+    return next(
+        (
+            snapshot
+            for snapshot in plan.snapshots
+            if snapshot.fingerprint.marker == marker
+        ),
+        None,
+    )
+
+
+def _migration_json(plan: _LegacyMigrationPlan, path: Path) -> object:
+    snapshot = _plan_snapshot(plan, path)
+    return {} if snapshot is None else _snapshot_json(snapshot)
+
+
+def _verify_migration_fingerprints(plan: _LegacyMigrationPlan) -> None:
+    for snapshot in plan.snapshots:
+        current = _capture_regular_file(
+            snapshot.fingerprint.path,
+            limit=_MAX_LEGACY_FILE_BYTES,
+            include_data=False,
+        )
+        if current is None or current.fingerprint != snapshot.fingerprint:
+            raise LearningStoreError(
+                "legacy learning migration source changed after authorization"
+            )
+
+
+@contextlib.contextmanager
+def _legacy_file_migration_scope(plan: _LegacyMigrationPlan):
+    """Allow only a one-shot plan's exact fingerprints through cutover scans."""
+    if not isinstance(plan, _LegacyMigrationPlan) or plan.used:
+        raise LearningStoreError("legacy learning migration plan is invalid or used")
+    if _LEGACY_MIGRATION_ALLOWANCE.get() is not None:
+        raise LearningStoreError("nested legacy learning migration is forbidden")
+    plan.used = True
+    if plan.tenant != _optional_tenant_key():
+        raise LearningStoreError("legacy learning migration tenant changed")
+    _verify_migration_fingerprints(plan)
+    fingerprints = tuple(snapshot.fingerprint for snapshot in plan.snapshots)
+    token = _LEGACY_MIGRATION_ALLOWANCE.set(_LegacyMigrationAllowance(
+        tenant=plan.tenant,
+        fingerprints=fingerprints,
+    ))
+    try:
+        yield
+    finally:
+        _LEGACY_MIGRATION_ALLOWANCE.reset(token)
+
+
+def _same_fingerprint_content(
+    left: _FileFingerprint,
+    right: _FileFingerprint,
+) -> bool:
+    return (
+        left.device == right.device
+        and left.inode == right.inode
+        and left.size == right.size
+        and left.mtime_ns == right.mtime_ns
+        and left.digest == right.digest
+    )
+
+
+def _finalize_legacy_file_migration(plan: _LegacyMigrationPlan) -> None:
+    """Reverify every source, then rename only those authorized exact files."""
+    allowed = _LEGACY_MIGRATION_ALLOWANCE.get()
+    expected = tuple(snapshot.fingerprint for snapshot in plan.snapshots)
+    if (
+        allowed is None
+        or allowed.tenant != plan.tenant
+        or allowed.fingerprints != expected
+        or plan.tenant != _optional_tenant_key()
+    ):
+        raise LearningStoreError("legacy learning migration scope is not active")
+    _verify_migration_fingerprints(plan)
+    destinations: list[tuple[_LegacyFileSnapshot, Path]] = []
+    for snapshot in plan.snapshots:
+        source = snapshot.fingerprint.path
+        destination = source.with_name(source.name + ".migrated")
+        try:
+            os.lstat(destination)
+        except FileNotFoundError:
+            pass
+        except OSError:
+            raise LearningStoreError(
+                "legacy learning migration backup cannot be inspected"
+            ) from None
+        else:
+            raise LearningStoreError(
+                "legacy learning migration backup already exists"
+            )
+        destinations.append((snapshot, destination))
+    for snapshot, destination in destinations:
+        try:
+            os.rename(snapshot.fingerprint.path, destination)
+        except OSError:
+            raise LearningStoreError(
+                "legacy learning migration source could not be archived"
+            ) from None
+        archived = _capture_regular_file(
+            destination,
+            limit=_MAX_LEGACY_FILE_BYTES,
+            include_data=False,
+        )
+        if archived is None or not _same_fingerprint_content(
+            archived.fingerprint,
+            snapshot.fingerprint,
+        ):
+            raise LearningStoreError(
+                "legacy learning migration archive verification failed"
+            )
+
+
+def _assert_no_legacy_state(*, tenant: str | None) -> None:
+    """Refuse a split-brain cutover for the active tenant's local authority."""
+    seen: set[str] = set()
+
+    def inspect(path: Path) -> None:
+        marker = _path_marker(path)
+        if marker in seen:
+            return
+        seen.add(marker)
+        if _file_has_legacy_state(path, tenant=tenant):
+            raise LearningStoreError(
+                "legacy learning state exists; migrate it before Postgres cutover"
+            )
+
+    bases = [_legacy_base_for_tenant(None)]
+    if tenant is not None:
+        bases.append(_legacy_base_for_tenant(tenant))
+    for base in bases:
+        if _sqlite_has_legacy_state(base / "world.db"):
+            raise LearningStoreError(
+                "legacy learning state exists; migrate it before Postgres cutover"
+            )
+        addenda = base / "harness" / "addenda.json"
+        inspect(addenda)
+        inspect(addenda.with_suffix(".meta.json"))
+        inspect(addenda.with_suffix(".transfer.json"))
+    for path in _configured_corpus_paths():
+        inspect(path)
+
+
+def _row_value(row: object, index: int, key: str) -> object:
+    if isinstance(row, Mapping):
+        return row.get(key)
+    if isinstance(row, (tuple, list)) and len(row) > index:
+        return row[index]
+    return None
+
+
+def _fetchone(result: Any) -> object | None:
+    return result.fetchone()
+
+
+def _fetchall(result: Any) -> list[object]:
+    return list(result.fetchall())
+
+
+def _pg_array(value: object) -> tuple[str, ...]:
+    if isinstance(value, (tuple, list)):
+        return tuple(str(item) for item in value)
+    return tuple(
+        item.strip().strip("\"'")
+        for item in str(value or "").strip("{}").split(",")
+        if item.strip()
+    )
+
+
+_SQL_TOKEN = re.compile(
+    r"\s*(>=|<=|<>|!=|::|'(?:''|[^'])*'|"
+    r"[A-Za-z_][A-Za-z0-9_.$]*|[0-9]+|[(),\[\]=<>])"
+)
+
+
+def _canonical_sql_tokens(value: object) -> tuple[str, ...] | None:
+    """Tokenize one catalog expression and reject every unknown byte.
+
+    Parentheses vary across supported Postgres versions, so they are erased.
+    Casts are deliberately retained: erasing ``::integer`` or ``::bigint``
+    would make a tenant-collapsing numeric comparison look identical to the
+    required text identity predicate (for example, tenants ``1`` and ``01``).
+    Security checks compare the resulting tuple to a closed set of complete
+    expected expressions; no substring or unapproved cast can alter semantics.
+    """
+    text = str(value or "")
+    tokens: list[str] = []
+    position = 0
+    while position < len(text):
+        match = _SQL_TOKEN.match(text, position)
+        if match is None:
+            if not text[position:].strip():
+                break
+            return None
+        token = match.group(1)
+        position = match.end()
+        lowered = token if token.startswith("'") else token.lower()
+        if lowered in {"(", ")", "[", "]", ","}:
+            continue
+        if lowered == "::":
+            cast = _SQL_TOKEN.match(text, position)
+            if cast is None:
+                return None
+            cast_name = cast.group(1).lower()
+            if not re.fullmatch(r"[a-z_][a-z0-9_.$]*", cast_name):
+                return None
+            position = cast.end()
+            tokens.extend(("::", cast_name))
+            continue
+        tokens.append(lowered)
+    return tuple(tokens)
+
+
+def _range_expressions(function: str, column: str, high: int) -> set[tuple[str, ...]]:
+    return {
+        (
+            "check", function, column, "between", "1", "and", str(high),
+        ),
+        (
+            "check", function, column, ">=", "1", "and",
+            function, column, "<=", str(high),
+        ),
+    }
+
+
+def _check_definition_is_exact(name: str, definition: object) -> bool:
+    tokens = _canonical_sql_tokens(definition)
+    if tokens is None:
+        return False
+    if name.endswith("tenant_len"):
+        return tokens in _range_expressions("char_length", "tenant_id", 201)
+    if name.endswith(("key_len", "id_len")):
+        column = "line_id" if name.endswith("id_len") else "key"
+        return tokens in _range_expressions(
+            "octet_length", column, _MAX_KEY_BYTES,
+        )
+    if name.endswith("block_size"):
+        return tokens == (
+            "check", "octet_length", "block", "<=", str(_MAX_PAYLOAD_BYTES),
+        )
+    if name.endswith("record_size"):
+        return tokens == (
+            "check", "octet_length", "record", "<=", str(_MAX_PAYLOAD_BYTES),
+        )
+    if name.endswith("row_size"):
+        return tokens == (
+            "check", "octet_length", "row", "<=", str(_MAX_PAYLOAD_BYTES),
+        )
+    if name.endswith("harness_corpus_seq"):
+        return tokens == ("check", "seq", ">=", "0")
+    if name.endswith("harness_corpus_kind"):
+        values = ("'live'", "'pending'", "'rejected'", "'extra'")
+        text_values = tuple(
+            token
+            for value in values
+            for token in (value, "::", "text")
+        )
+        return tokens in {
+            ("check", "kind", "in", *values),
+            ("check", "kind", "=", "any", "array", *values),
+            ("check", "kind", "in", *text_values),
+            ("check", "kind", "=", "any", "array", *text_values),
+        }
+    return False
+
+
+def _policy_rows_are_exact(rows: object) -> bool:
+    if not isinstance(rows, (tuple, list)) or len(rows) != 1:
+        return False
+    row = rows[0]
+    name = _row_value(row, 0, "policyname")
+    permissive = _row_value(row, 1, "permissive")
+    roles = _row_value(row, 2, "roles")
+    command = _row_value(row, 3, "cmd")
+    qual = _row_value(row, 4, "qual")
+    check = _row_value(row, 5, "with_check")
+    if str(name) != _POSTGRES_POLICY:
+        return False
+    # A sole Postgres RESTRICTIVE policy grants no rows at all; the one exact
+    # PERMISSIVE policy is therefore required for operation.  Rejecting every
+    # additional policy prevents the OR-composition bypass that "permissive"
+    # otherwise permits.
+    if str(permissive).strip().lower() != "permissive":
+        return False
+    if _pg_array(roles) != ("public",):
+        return False
+    if str(command).strip().lower() != "all":
+        return False
+
+    expected_plain = (
+        "tenant_id", "=", "nullif", "current_setting",
+        "'maverick.tenant'", "true", "''",
+    )
+    expected_catalog = (
+        "tenant_id", "=", "nullif", "current_setting",
+        "'maverick.tenant'", "::", "text", "true",
+        "''", "::", "text",
+    )
+    expected = {expected_plain, expected_catalog}
+    return (
+        _canonical_sql_tokens(qual) in expected
+        and _canonical_sql_tokens(check) in expected
+    )
+
+
+def _table_exists(conn: Any, table: str) -> bool:
+    row = _fetchone(conn.execute(
+        "SELECT to_regclass(current_schema() || '.' || %s) AS table_name",
+        (table,),
+    ))
+    return _row_value(row, 0, "table_name") is not None
+
+
+def _assert_no_legacy_postgres_state(conn: Any) -> None:
+    """Permit released v25/v26 tables to coexist only when they are empty.
+
+    Those tables have no tenant column, so assigning an existing row to a
+    tenant would be an irreversible authority guess.  The check is read-only
+    and happens before bootstrap or serving from the additive shared tables.
+    """
+    try:
+        for table in _LEGACY_POSTGRES_TABLES:
+            if not _table_exists(conn, table):
+                continue
+            row = _fetchone(conn.execute(
+                f"SELECT EXISTS (SELECT 1 FROM {table} LIMIT 1) AS has_rows"
+            ))
+            if row is None:
+                raise LearningStoreError(
+                    "legacy Postgres learning state cannot be verified"
+                )
+            if bool(_row_value(row, 0, "has_rows")):
+                raise LearningStoreError(
+                    "legacy Postgres learning state exists; migrate it before "
+                    "shared learning storage can serve"
+                )
+    except LearningStoreError:
+        raise
+    except Exception:
+        raise LearningStoreError(
+            "legacy Postgres learning state cannot be verified"
+        ) from None
+
+
+def _role_is_safe(conn: Any) -> bool:
+    row = _fetchone(conn.execute(
+        "SELECT rolsuper, rolbypassrls FROM pg_roles WHERE rolname=current_user"
+    ))
+    return bool(
+        row is not None
+        and not bool(_row_value(row, 0, "rolsuper"))
+        and not bool(_row_value(row, 1, "rolbypassrls"))
+    )
+
+
+def _table_schema_is_exact(conn: Any, table: str) -> bool:
+    rows = _fetchall(conn.execute(
+        "SELECT column_name, data_type, is_nullable "
+        "FROM information_schema.columns "
+        "WHERE table_schema=current_schema() AND table_name=%s "
+        "ORDER BY ordinal_position",
+        (table,),
+    ))
+    columns = tuple(
+        (
+            str(_row_value(row, 0, "column_name")),
+            str(_row_value(row, 1, "data_type")),
+            str(_row_value(row, 2, "is_nullable")),
+        )
+        for row in rows
+    )
+    if columns != _POSTGRES_COLUMNS[table]:
+        return False
+    primary = _fetchone(conn.execute(
+        "SELECT array_agg(a.attname ORDER BY keys.ordinality) AS columns "
+        "FROM pg_index i JOIN pg_class c ON c.oid=i.indrelid "
+        "JOIN unnest(i.indkey) WITH ORDINALITY AS keys(attnum, ordinality) "
+        "ON true JOIN pg_attribute a ON a.attrelid=c.oid "
+        "AND a.attnum=keys.attnum "
+        "WHERE c.oid=to_regclass(current_schema() || '.' || %s) "
+        "AND i.indisprimary GROUP BY i.indexrelid",
+        (table,),
+    ))
+    if primary is None or _pg_array(
+        _row_value(primary, 0, "columns")
+    ) != _POSTGRES_PRIMARY_KEYS[table]:
+        return False
+    constraint_rows = _fetchall(conn.execute(
+        "SELECT conname, pg_get_constraintdef(oid) AS definition "
+        "FROM pg_constraint WHERE conrelid="
+        "to_regclass(current_schema() || '.' || %s) AND contype='c' "
+        "ORDER BY conname",
+        (table,),
+    ))
+    checks = {
+        str(_row_value(row, 0, "conname")): _row_value(row, 1, "definition")
+        for row in constraint_rows
+    }
