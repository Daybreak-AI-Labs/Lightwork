+                        if any(prior[key] != validated[key] for key in logical_fields):
+                            raise TriggerAuthorityConflict(
+                                "legacy webhook trigger conflicts with shared state"
+                            )
+                        return False
+                    triggers[validated["name"]] = validated
+                    _publish_shared_document(document, triggers)
+                    return True
+
+                changed = _shared_document().mutate(
+                    _mutate,
+                    action="webhook_trigger_legacy_import",
+                )
+                imported += int(bool(changed))
+            finally:
+                reset_tenant(token)
+        archive = archive_legacy(_path(), digest)
+    return {
+        "rows": len(rows),
+        "imported": imported,
+        "archive": str(archive) if archive is not None else "",
+    }
+
+
