+            desired = authority.publish_desired(
+                ADAPTER_RELEASE_DEPLOYMENT_ID,
+                artifact_kind=ADAPTER_RELEASE_ARTIFACT_KIND,
+                desired_digest=digest,
+                promotion_record_id=record_id,
+                promotion_transaction_id=transaction_id,
