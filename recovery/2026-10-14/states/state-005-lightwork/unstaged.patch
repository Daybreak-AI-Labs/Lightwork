diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index f6ca66fde5e7c0dd5fc1c5d189539bb333ac78e4..ab05a914e3695794face8b4cb5e452bffc7cdc7d 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -198,6 +198,77 @@ jobs:
             --source-revision "$revision" \
             --output-dir dist
           (cd dist && sha256sum --check "lightwork-standalone-skus-${version}.sha256")
+      - name: Extract and smoke-test every standalone source archive
+        shell: bash
+        timeout-minutes: 15
+        run: |
+          set -euo pipefail
+          python -m pip install --upgrade pip pytest
+          smoke_root="$(mktemp -d)"
+          trap 'rm -rf -- "$smoke_root"' EXIT
+          mapfile -t archives < <(
+            find dist -maxdepth 1 -type f -name 'lightwork-*.zip' -print | sort
+          )
+          test "${#archives[@]}" -eq 6
+          for archive in "${archives[@]}"; do
+            python - "$archive" "$smoke_root" <<'PY'
+          import hashlib
+          import json
+          import sys
+          import zipfile
+          from pathlib import Path, PurePosixPath
+
+          archive_path = Path(sys.argv[1])
+          destination = Path(sys.argv[2]).resolve()
+          with zipfile.ZipFile(archive_path) as archive:
+              names = archive.namelist()
+              paths = [PurePosixPath(name) for name in names]
+              if not paths or any(path.is_absolute() or ".." in path.parts for path in paths):
+                  raise SystemExit(f"unsafe archive member in {archive_path.name}")
+              roots = {path.parts[0] for path in paths if path.parts}
+              if len(roots) != 1:
+                  raise SystemExit(f"archive must contain one root: {archive_path.name}")
+              root = next(iter(roots))
+              metadata_name = f"{root}/RELEASE-METADATA.json"
+              try:
+                  metadata = json.loads(archive.read(metadata_name))
+              except (KeyError, json.JSONDecodeError) as exc:
+                  raise SystemExit(
+                      f"missing or invalid release metadata: {archive_path.name}"
+                  ) from exc
+              declared = metadata.get("files")
+              if not isinstance(declared, dict) or not declared:
+                  raise SystemExit(f"empty release manifest: {archive_path.name}")
+              for relative, expected in declared.items():
+                  payload = archive.read(f"{root}/{relative}")
+                  if (
+                      not isinstance(expected, dict)
+                      or expected.get("size") != len(payload)
+                      or expected.get("sha256") != hashlib.sha256(payload).hexdigest()
+                  ):
+                      raise SystemExit(
+                          f"release metadata mismatch for {archive_path.name}:{relative}"
+                      )
+              archive.extractall(destination)
+          PY
+          done
+          mapfile -t sku_dirs < <(
+            find "$smoke_root" -mindepth 1 -maxdepth 1 -type d -print | sort
+          )
+          test "${#sku_dirs[@]}" -eq 6
+          for sku_dir in "${sku_dirs[@]}"; do
+            test -s "$sku_dir/requirements.txt"
+            python -m pip install -r "$sku_dir/requirements.txt"
+            mapfile -t smoke_tests < <(
+              find "$sku_dir" -maxdepth 1 -type f -name 'test_*standalone.py' -print
+            )
+            test "${#smoke_tests[@]}" -eq 1
+            (
+              cd "$sku_dir"
+              unset PYTHONPATH
+              python -m pytest -q "${smoke_tests[0]}" -k forced_standalone
+            )
+          done
       - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7
         with:
           name: standalone-sku-source
@@ -238,18 +309,64 @@ jobs:
         # exactly the artifacts published here (audit M19). Installs the 8
         # workspace packages so the SBOM reflects the real dependency tree,
         # then emits one CycloneDX JSON named for the release tag.
+        timeout-minutes: 20
         run: |
+          set -euo pipefail
           python -m pip install --upgrade pip cyclonedx-bom
-          for p in packages/maverick-core packages/maverick-shield \
-                   packages/maverick-channels packages/maverick-dashboard \
-                   packages/maverick-mcp packages/maverick-evolve \
-                   packages/maverick-knowledge; do
-            pip install --no-deps -e "$p" || true
-          done
-          pip install -e packages/maverick-core || true
-          cyclonedx-py environment \
-            -o "dist/maverick-sbom-${{ needs.validate-release-tag.outputs.tag }}.cdx.json" \
-            || echo "SBOM generation failed (non-fatal); release continues"
+          python -m venv .release-sbom-environment
+          sbom_python="$PWD/.release-sbom-environment/bin/python"
+          "$sbom_python" -m pip install --upgrade pip
+          "$sbom_python" -m pip install \
+            -e packages/maverick-core \
+            -e packages/maverick-shield \
+            -e packages/maverick-channels \
+            -e packages/maverick-dashboard \
+            -e packages/maverick-mcp \
+            -e packages/maverick-evolve \
+            -e packages/maverick-knowledge \
+            -e apps/installer-cli
+          cyclonedx-py environment "$sbom_python" \
+            --output-reproducible \
+            -o "dist/maverick-sbom-${{ needs.validate-release-tag.outputs.tag }}.cdx.json"
+          sbom="dist/maverick-sbom-${{ needs.validate-release-tag.outputs.tag }}.cdx.json"
+          test -s "$sbom"
+          python - "$sbom" <<'PY'
+          import json
+          import sys
+          from pathlib import Path
+
+          payload = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
+          if payload.get("bomFormat") != "CycloneDX":
+              raise SystemExit("release SBOM is not CycloneDX")
+          names = {
+              str(component.get("name") or "").casefold()
+              for component in payload.get("components", [])
+              if isinstance(component, dict)
+          }
+          required = {
+              "maverick-agent",
+              "maverick-shield",
+              "maverick-channels",
+              "maverick-dashboard",
+              "maverick-mcp-server",
+              "maverick-evolve",
+              "maverick-knowledge",
+              "maverick-installer",
+              "fastapi",
+              "jinja2",
+              "pywhispercpp",
+              "python-multipart",
+              "questionary",
+              "rich",
+              "uvicorn",
+          }
+          missing = sorted(required - names)
+          if missing:
+              raise SystemExit(
+                  "release SBOM is missing shipped distributions or direct runtime "
+                  f"dependencies: {', '.join(missing)}"
+              )
+          PY
       - name: Install cosign
         uses: sigstore/cosign-installer@6f9f17788090df1f26f669e9d70d6ae9567deba6 # v4.1.2
       - name: Sign release artifacts (keyless, Sigstore)
