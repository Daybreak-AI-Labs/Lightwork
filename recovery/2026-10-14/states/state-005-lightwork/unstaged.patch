+def test_registered_production_factory_uses_tenant_scoped_live_certification(
+    _isolated_security_suite,
+):
+    import hashlib
+
+    from cryptography.hazmat.primitives import serialization
+    from cryptography.hazmat.primitives.asymmetric import ed25519
+    from maverick import config, env_hunt
+    from maverick_dashboard import security_api
+
+    _isolated_security_suite["config"].write_text(
+        """[connectors.certification]
+certified_only = true
+
+[env_hunt]
+enable = true
+
+[env_hunt.connectors.cloudtrail]
+enable = true
+push_enable = false
+pivot_enable = false
+""",
+        encoding="utf-8",
+    )
+    config.reset_config_cache()
+
+    def transport(_request):
+        return [{
+            "eventID": "certified-production-event",
+            "eventTime": 1_000,
+            "eventName": "ConsoleLogin",
+        }]
+
+    binding = env_hunt.build_transport_binding(
+        "cloudtrail",
+        transport,
+        endpoint_url="https://cloudtrail.us-east-1.amazonaws.com",
+        api_version="2013-11-01",
+        auth_mode="aws_workload_identity",
+        granted_scopes=("cloudtrail:LookupEvents",),
+        tenant="",
+    )
+    private = ed25519.Ed25519PrivateKey.generate()
+    public = private.public_key().public_bytes(
+        serialization.Encoding.Raw,
+        serialization.PublicFormat.Raw,
+    ).hex()
+    key_id = hashlib.sha256(bytes.fromhex(public)).hexdigest()[:16]
+
+    def signer(payload):
+        return {
+            "alg": "ed25519",
+            "key_id": key_id,
+            "pubkey": public,
+            "sig": private.sign(payload).hex(),
+        }
+
+    def probe(_manifest):
+        return env_hunt.LiveProbeObservation(
+            endpoint_url="https://cloudtrail.us-east-1.amazonaws.com",
+            api_version="2013-11-01",
+            auth_mode="aws_workload_identity",
+            granted_scopes=("cloudtrail:LookupEvents",),
+            status_code=200,
+            response_bytes=512,
+            elapsed_ms=20,
+            pages=1,
+            cursor_observed=False,
+            rate_limit=env_hunt.normalize_rate_limit(200, {}),
+        )
+
+    receipt = env_hunt.run_live_probe(
+        "cloudtrail",
+        probe,
+        signer=signer,
+        now=time.time(),
+        ttl_seconds=3_600,
+        transport_binding=binding,
+    )
+    security_api.register_environment_connector_transport(
+        "cloudtrail",
+        transport,
+        certification_receipt=receipt,
+        trusted_certification_key=public,
+        certification_allowed_hosts=(),
+        transport_binding=binding,
+    )
+
+    factory = security_api._configured_environment_connector_factory(env_hunt)
+    assert factory.available_names() == ("cloudtrail",)
+    assert factory.certification_decision("cloudtrail").certification_status == (
+        env_hunt.LIVE_CERTIFIED
+    )
+    connector = factory.build_connector("cloudtrail")
+    events = connector.fetch(env_hunt.QueryRequest(900, 1_100, limit=10))
+    assert [event.event_id for event in events] == ["certified-production-event"]
+
