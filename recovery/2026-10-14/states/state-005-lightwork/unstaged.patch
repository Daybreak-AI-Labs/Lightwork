+def _validated_settings(raw: object) -> dict[str, Any]:
+    if not isinstance(raw, Mapping):
+        raise CalibrationAuthorityError(
+            "calibration authority policy is not an object"
+        )
+    required = {
+        "enforce", "min_samples", "min_discrimination",
+        "collect_from_coding", "min_resistance", "max_age_hours",
+    }
+    if not required.issubset(raw):
+        raise CalibrationAuthorityError(
+            "calibration authority policy is incomplete"
+        )
+    enforce = raw["enforce"]
+    collect = raw["collect_from_coding"]
+    samples = raw["min_samples"]
+    if not isinstance(enforce, bool) or not isinstance(collect, bool):
+        raise CalibrationAuthorityError(
+            "calibration authority boolean policy is invalid"
+        )
+    if (
+        isinstance(samples, bool)
+        or not isinstance(samples, int)
+        or not 1 <= samples <= _MAX_CALIBRATION_SAMPLES
+    ):
+        raise CalibrationAuthorityError(
+            "calibration authority sample policy is invalid"
+        )
+    discrimination = _finite_number(
+        raw["min_discrimination"],
+        label="minimum discrimination",
+        minimum=0.0,
+        maximum=1.0,
+    )
+    resistance = _finite_number(
+        raw["min_resistance"],
+        label="minimum resistance",
+        minimum=0.0,
+        maximum=1.0,
+    )
+    max_age = _finite_number(
+        raw["max_age_hours"],
+        label="maximum verdict age",
+        minimum=1e-9,
+        maximum=10 * 365 * 24.0,
+    )
+    return {
+        "enforce": enforce,
+        "min_samples": samples,
+        "min_discrimination": discrimination,
+        "collect_from_coding": collect,
+        "min_resistance": resistance,
+        "max_age_hours": max_age,
+    }
+
+
+def _strict_settings() -> dict[str, Any]:
+    """Load the policy used by shared authority or raise fail closed."""
+    try:
+        from .config import config_source_errors, load_config
+
+        loaded = load_config()
+        if config_source_errors():
+            raise CalibrationAuthorityError(
+                "shared calibration authority policy source is unreadable"
+            )
+        if not isinstance(loaded, Mapping):
+            raise CalibrationAuthorityError(
+                "shared calibration authority configuration is invalid"
+            )
+        configured = loaded.get("calibration", {})
+        if not isinstance(configured, Mapping):
+            raise CalibrationAuthorityError(
+                "shared calibration authority policy is not an object"
+            )
+        # Missing values retain documented defaults. Present values are never
+        # coerced or clamped in shared mode: a typo must freeze/refuse instead
+        # of silently changing the fleet's learning threshold.
+        return _validated_settings({**_DEFAULTS, **dict(configured)})
+    except CalibrationAuthorityError:
+        raise
+    except Exception as exc:
+        raise CalibrationAuthorityError(
+            "shared calibration authority policy is unavailable"
+        ) from exc
+
+
+def _settings_for_authority() -> dict[str, Any]:
+    """Return strict policy once Postgres is selected; local remains fail-soft."""
+    return _strict_settings() if _authority_backend() == "postgres" else _settings()
