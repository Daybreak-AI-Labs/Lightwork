+class _DocumentStore:
+    def __init__(self):
+        self.document = {}
+
+    def read(self):
+        return dict(self.document)
+
+    def mutate(self, callback, **_kwargs):
+        working = dict(self.document)
+        result = callback(working)
+        self.document = working
+        return result
+
+
+def test_governed_registry_preserves_revocation_semantics():
+    store = _DocumentStore()
+    reg = GovernedRevocationRegistry(store)
+
+    assert reg.is_revoked("agent:x") is False
+    reg.revoke("agent:x", reason="leaked", now=10)
+    assert reg.revoked()["agent:x"].reason == "leaked"
+    assert reg.unrevoke("agent:x") is True
+    assert reg.unrevoke("agent:x") is False
+
+
+def test_governed_subtree_is_one_document_mutation():
+    class CountingStore(_DocumentStore):
+        calls = 0
+
+        def mutate(self, callback, **kwargs):
+            self.calls += 1
+            return super().mutate(callback, **kwargs)
+
+    store = CountingStore()
+    reg = GovernedRevocationRegistry(store)
+    order = reg.revoke_subtree(
+        "root",
+        {"root": ["a", "b"], "a": ["leaf"]},
+        reason="incident",
+        now=11,
+    )
+
+    assert set(order) == {"root", "a", "b", "leaf"}
+    assert store.calls == 1
+    assert set(reg.revoked()) == set(order)
+
