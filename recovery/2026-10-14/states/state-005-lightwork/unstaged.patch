+class GovernedIssuerProvider:
+    """Postgres-governed issuer authority shared by all replicas in one run.
+
+    The software Ed25519 private seed is stored in the governed document only
+    because the Postgres governed-record backend requires application-level
+    at-rest encryption before every operation. Deployments with a KMS/HSM should
+    still inject a non-exporting :class:`IssuerProvider`; this class is a secure
+    convergence bridge, not a substitute for hardware-backed key custody.
+    """
+
+    def __init__(
+        self,
+        *,
+        store_factory: Callable[[str, str], Any] | None = None,
+    ) -> None:
+        self._store_factory = store_factory
+
+    def _store_for(self, tenant_id: str, run_id: str):
+        if self._store_factory is not None:
+            return self._store_factory(tenant_id, run_id)
+        return _new_authority_document_store(
+            "issuer",
+            tenant_id=tenant_id,
+            run_id=run_id,
+        )
+
+    def issuer_for(self, *, tenant_id: str, run_id: str) -> IssuerMaterial:
+        tenant_id, run_id = _scope_parts(tenant_id, run_id)
+        try:
+            store = self._store_for(tenant_id, run_id)
+            _require_postgres_store(store)
+            existing = store.read()
+            if existing:
+                return _issuer_material_from_document(
+                    existing,
+                    tenant_id=tenant_id,
+                    run_id=run_id,
+                )
+
+            # Generate once outside the retried callback. A CAS loser validates
+            # and returns the winner's document instead of rotating the issuer.
+            private_hex, public_hex = _new_issuer_keypair()
+            candidate = {
+                "algorithm": "ed25519",
+                "key_id": _issuer_key_id(public_hex),
+                "private_hex": private_hex,
+                "public_hex": public_hex,
+                "run_id": run_id,
+                "tenant_id": tenant_id,
+            }
+
+            def _resolve(document: dict) -> IssuerMaterial:
+                if not document:
+                    document.update(candidate)
+                return _issuer_material_from_document(
+                    document,
+                    tenant_id=tenant_id,
+                    run_id=run_id,
+                )
+
+            return store.mutate(
+                _resolve,
+                action="resolve_issuer",
+                actor="handoff-authority",
+                max_retries=_GOVERNED_MUTATION_RETRIES,
+            )
+        except HandoffAuthorityError:
+            raise
+        except Exception as exc:
+            raise HandoffAuthorityError(
+                "shared handoff issuer authority is unavailable"
+            ) from exc
+
+
+class _NonceAlreadyClaimed(ValueError):
+    pass
+
+
+class _NonceStoreFull(ValueError):
+    pass
