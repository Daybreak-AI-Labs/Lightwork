+def test_local_poll_scope_fences_postgres_cutover_and_tracks_real_lock(
+    monkeypatch,
+    tmp_path,
+):
+    _isolate(monkeypatch, tmp_path)
+    import maverick.job_queue_postgres as pg
+    from maverick_dashboard import automation_queue as aq
+
+    selection = {"value": pg._Selection(False, False)}
+    monkeypatch.setattr(pg, "_selection", lambda: selection["value"])
+    entered = threading.Event()
+    release = threading.Event()
+    root = aq._db_path().parent
+    marker = pg._cutover_marker_path(aq._db_path())
+
+    def local_poll():
+        with aq._poll_guard():
+            entered.set()
+            assert release.wait(5.0)
+
+    def cutover(token):
+        with pg._postgres_cutover_guard(
+            aq._db_path(),
+            poll_artifacts=(root / "automation-poll", root / "automation-poll.lock"),
+            dsn_sha256=token.dsn_sha256,
+        ):
+            pass
+
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        poll_future = pool.submit(local_poll)
+        assert entered.wait(2.0)
+        # The lock target is the marker directory, so its real sidecar is the
+        # artifact the production selector checks (not ``.lock.lock``).
+        assert (root / "automation-poll.lock").is_file()
+        assert not (root / "automation-poll.lock.lock").exists()
+
+        selection["value"] = pg._Selection(
+            True,
+            True,
+            "postgres://authority",
+        )
+        token = pg._authority_token(selection["value"])
+        cutover_future = pool.submit(cutover, token)
+        assert not cutover_future.done()
+        release.set()
+        poll_future.result(timeout=5.0)
+        with pytest.raises(pg.JobQueueMigrationRequired, match="poll lock"):
+            cutover_future.result(timeout=5.0)
+
+    assert not marker.exists()
+    # Even if an already-cached local queue selected the local branch before
+    # the flip, a new local poll scope revalidates policy and fails closed.
+    with pytest.raises(pg.SharedJobQueueUnavailable, match="no longer the selected"):
+        with aq._poll_guard():
+            raise AssertionError("stale local poll was admitted")
+
