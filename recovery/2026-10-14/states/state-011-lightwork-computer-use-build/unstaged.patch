+            execution_cell_url=str(form.get("execution_cell_url") or ""),
+            execution_cell_id=str(form.get("execution_cell_id") or ""),
+            execution_cell_token=str(form.get("execution_cell_token") or ""),
+            clear_execution_cell_token="clear_execution_cell_token" in form,
+            enroll_evidence_sealing_key="enroll_evidence_sealing_key" in form,
+            monitor=form.get("monitor", "1"),
+            device=str(form.get("device") or ""),
+            consent_mode=str(form.get("consent_mode") or ""),
+            max_sessions=form.get("max_sessions", "4"),
+            session_timeout_seconds=form.get("session_timeout_seconds", "3600"),
+            heartbeat_timeout_seconds=form.get("heartbeat_timeout_seconds", "60"),
+            require_evidence="require_evidence" in form,
+            evidence_retention_days=form.get("evidence_retention_days", "30"),
+        )
+    except settings_store.SecuritySuiteConfigUnavailable as exc:
+        raise HTTPException(
+            status_code=503,
+            detail="computer-use settings are temporarily unavailable",
+        ) from exc
+    except (OSError, RuntimeError) as exc:
+        raise HTTPException(
+            status_code=503,
+            detail="computer-use settings could not be saved",
+        ) from exc
+    except ValueError as exc:
