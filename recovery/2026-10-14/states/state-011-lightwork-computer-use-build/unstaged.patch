+
+def _upload_descriptor(path: Path) -> tuple[int, str]:
+    """Hash one stable staged file, rejecting mutation during inspection."""
+    before = path.stat()
+    digest = _file_sha256(path)
+    after = path.stat()
+    before_identity = (
+        before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns,
+    )
+    after_identity = (
+        after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns,
+    )
+    if before_identity != after_identity:
+        raise ValueError("staged upload changed while it was inspected")
+    return after.st_size, digest
+
