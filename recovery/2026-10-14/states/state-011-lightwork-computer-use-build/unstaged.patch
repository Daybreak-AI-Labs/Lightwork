+fn ensure_dashboard(runtime: &DashboardRuntime) -> bool {
+    if runtime.shutting_down.load(Ordering::Acquire) {
+        return false;
+    }
+    let Ok(mut guard) = runtime.child.lock() else {
+        return false;
+    };
+    if let Some(child) = guard.as_mut() {
+        match child.try_wait() {
+            Ok(None) => return true,
+            Ok(Some(_)) | Err(_) => {
+                *guard = None;
+            }
+        }
+    }
+    *guard = spawn_dashboard(runtime.port, &runtime.token);
+    guard.is_some()
+}
