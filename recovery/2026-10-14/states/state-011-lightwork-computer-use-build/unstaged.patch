+def _upload_path(file_id: str) -> Path:
+    root_raw = str(os.environ.get("MAVERICK_BROWSER_UPLOAD_DIR") or "").strip()
+    if not root_raw:
+        raise ValueError("MAVERICK_BROWSER_UPLOAD_DIR is not configured")
+    if not file_id or Path(file_id).name != file_id or file_id in {".", ".."}:
+        raise ValueError("file_id must be one pre-staged filename, not a path")
+    root = Path(os.path.expanduser(root_raw)).resolve(strict=True)
+    require_private_directory(root)
+    lexical = root / file_id
+    info = lexical.lstat()
+    is_junction = getattr(lexical, "is_junction", None)
+    if (
+        stat.S_ISLNK(info.st_mode)
+        or bool(getattr(info, "st_file_attributes", 0) & 0x400)
+        or bool(callable(is_junction) and is_junction())
+        or int(getattr(info, "st_nlink", 1)) != 1
+    ):
+        raise ValueError("file_id must not be a link or reparse-point alias")
+    candidate = lexical.resolve(strict=True)
