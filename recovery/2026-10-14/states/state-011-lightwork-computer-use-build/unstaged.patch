+        candidate.relative_to(root)
+    except ValueError as exc:
+        raise ValueError("file_id escapes the configured upload directory") from exc
+    if not candidate.is_file():
+        raise ValueError("file_id must identify a regular staged file")
+    if candidate.stat().st_size > _MAX_UPLOAD_BYTES:
+        raise ValueError("staged upload exceeds 25 MiB")
+    return candidate
