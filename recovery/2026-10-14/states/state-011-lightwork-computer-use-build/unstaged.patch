+def _validated_storage_state(data: object) -> dict:
+    """Validate the small Playwright storage-state envelope we persist.
+
+    Browser state is still untrusted serialized input even though it is
+    authenticated at rest.  Keeping the accepted shape narrow prevents a
+    corrupt or accidentally misnamed vault entry from being handed wholesale
+    to Playwright as configuration.
+    """
+    if not isinstance(data, dict):
+        raise ValueError("browser storage state must be an object")
+    if set(data) - {"cookies", "origins"}:
+        raise ValueError("browser storage state has unsupported fields")
+    cookies = data.get("cookies", [])
+    origins = data.get("origins", [])
+    if not isinstance(cookies, list) or not isinstance(origins, list):
+        raise ValueError("browser storage state cookies/origins must be lists")
+    # The limits are intentionally generous but finite. A normal session is a
+    # few KiB; megabytes here usually means the wrong object was stored.
+    encoded = json.dumps(data, separators=(",", ":"), ensure_ascii=False)
+    if len(encoded.encode("utf-8")) > 4 * 1024 * 1024:
+        raise ValueError("browser storage state exceeds 4 MiB")
+    return {"cookies": cookies, "origins": origins}
+
