+        1.0,
+        max_edge / max(width, height),
+        math.sqrt(max_pixels / max(1, width * height)),
+    )
+    target_width = max(1, int(math.floor(width * ratio)))
+    target_height = max(1, int(math.floor(height * ratio)))
