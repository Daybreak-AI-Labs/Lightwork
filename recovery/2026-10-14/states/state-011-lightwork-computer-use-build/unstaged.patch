+class BrowserStateVault:
+    """Authority-bound encrypted adapter used by the live browser runtime."""
+
+    def __init__(self, vault: Vault, entry: str):
+        if not _BROWSER_STATE_ENTRY_RE.fullmatch(entry or ""):
+            raise ValueError("invalid browser state entry name")
+        self._vault = vault
+        self.entry = entry
+
+    def load(self) -> dict | None:
+        try:
+            data = self._vault.load(self.entry)
+        except KeyError:
+            return None
+        return _validated_storage_state(data)
+
+    def save(self, state: object) -> None:
+        self._vault.store(self.entry, _validated_storage_state(state))
+
+    def delete(self) -> bool:
+        return self._vault.delete(self.entry)
+
+
+def browser_state_vault(entry: str) -> BrowserStateVault:
+    """Open an encrypted browser-state entry for the active authority.
+
+    Both default paths are resolved in one tenant/principal ContextVar scope.
+    The returned adapter captures those paths and the key, so a Playwright
+    worker thread cannot accidentally resolve a different ambient authority.
+    """
+    key_file, data_file = _default_paths()
+    ensure_private_directory(key_file.parent)
+    key = _resolve_key(key_file, owned_parent=True)
+    return BrowserStateVault(
+        Vault(key, data_file, _owned_parent=True),
+        entry,
+    )
