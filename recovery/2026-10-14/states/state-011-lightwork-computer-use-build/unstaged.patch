+def _safe_audit_url(value: Any) -> str | None:
+    """Origin plus an opaque path commitment; never URL-borne credentials."""
+    try:
+        parsed = urlsplit(str(value or ""))
+        if parsed.scheme.lower() not in {"http", "https"} or not parsed.hostname:
+            return None
+        host = parsed.hostname.lower()
+        port = f":{parsed.port}" if parsed.port is not None else ""
+        path = parsed.path or "/"
+        segments = sum(bool(part) for part in path.split("/"))
+        path_digest = hashlib.sha256(path.encode("utf-8")).hexdigest()[:16]
+        return (
+            f"{parsed.scheme.lower()}://{host}{port}/"
+            f"[path:{segments}:{path_digest}]"
+        )
+    except (TypeError, ValueError):
+        return None
+
+
