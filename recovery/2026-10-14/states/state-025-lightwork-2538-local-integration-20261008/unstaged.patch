+                     else 2 if needle in title_key else 3 if needle in description.casefold() else 4)
+        priority = list(_FINANCE_WORK_AREAS).index(name) if broad and name in _FINANCE_WORK_AREAS else 99
+        matches.append(((priority if broad else relevance, relevance if broad else priority, label.casefold()),
+                        {"value": name, "label": label}))
