+    assert review_events[-1][1]["patch_sha256"] == candidate.patch_sha256
+    assert "patch" not in review_events[-1][1]
+    assert client.get(f"{LO}/self-modify/results/not-an-id").status_code == 404
+    candidate.patch = ""
