+@router.post("/flows/runs/{run_id}/reconcile")
+def reconcile_flow_external_effect_endpoint(
+    request: Request,
+    run_id: str,
+    payload: FlowEffectReconcileIn,
+) -> dict:
+    """Record an owner's direct check of an ambiguous external action.
+
+    Confirming that the action is present closes this run as reconciled; it does
+    not pretend later flow steps ran. Confirming absence changes the run to a
+    resumable failure at the same cursor. No connector is called by this route.
+    """
+    require_permission(request, "operate")
+    _require_flows()
+    from maverick.audit import AuditRefused, EventKind, audit_event
+    from maverick.flow import store
+
+    # Authenticate and establish ownership before taking the cross-process lock,
+    # then reload under that lock so the decision binds to one exact checkpoint.
+    _load_owned_run(request, run_id)
+    actor = _request_actor(request)
+    with store.run_lock(run_id):
+        run = _load_owned_run(request, run_id)
+        prior = dict(run.reconciliation or {})
+        if prior.get("operation_id") == payload.operation_id:
+            if (prior.get("decision") != payload.decision
+                    or prior.get("actor") != actor
+                    or prior.get("node_id") != payload.expected_cursor):
+                raise HTTPException(
+                    status_code=409,
+                    detail="This check was already recorded with different details. Refresh the run.",
+                )
+            return {
+                "run_id": run_id,
+                "status": run.status,
+                "reconciliation": prior,
+                "run": _run_out(run),
+                "deduplicated": True,
+            }
+        if run.status != "indeterminate" or not run.cursor:
+            raise HTTPException(
+                status_code=409,
+                detail="This run no longer needs an outside action check. Refresh it before continuing.",
+            )
+        if (run.updated != payload.expected_updated
+                or run.cursor != payload.expected_cursor):
+            raise HTTPException(
+                status_code=409,
+                detail="This run changed after you opened it. Refresh and check the current step.",
+            )
+
+        status_after = (
+            "reconciled_applied" if payload.decision == "applied" else "failed"
+        )
+        evidence = {
+            "operation_id": payload.operation_id,
+            "decision": payload.decision,
+            "status_after": status_after,
+            "node_id": run.cursor,
+            "actor": actor,
+            "evidence_source": "owner_attestation",
+            "recorded_at": time.time(),
+        }
+        try:
+            recorded = audit_event(
+                EventKind.FLOW_EXTERNAL_EFFECT_RECONCILED,
+                agent=actor,
+                actor=actor,
+                operation_id=payload.operation_id,
+                run_id=run.run_id,
+                flow_id=run.flow_id,
+                node_id=run.cursor,
+                decision=payload.decision,
+                status_after=status_after,
+                evidence_source="owner_attestation",
+                expected_updated=payload.expected_updated,
+                definition_digest=run.definition_digest,
+                release_id=run.release_id,
+            )
+        except AuditRefused as exc:
+            raise HTTPException(
+                status_code=503,
+                detail="The check could not be recorded in the activity history. Nothing changed; try again later.",
+            ) from exc
+        if not recorded:
+            raise HTTPException(
+                status_code=503,
+                detail="The check could not be recorded in the activity history. Nothing changed; try again later.",
+            )
+
+        node_state = dict((run.nodes or {}).get(run.cursor) or {})
+        node_state["operator_reconciliation"] = payload.decision
+        run.nodes = dict(run.nodes or {})
+        run.nodes[run.cursor] = node_state
+        run.reconciliation = evidence
+        run.status = status_after
+        run.resume_at = None
+        if payload.decision == "applied":
+            run.error = (
+                "The flow owner confirmed this action appeared in the connected app. "
+                "The workflow stopped here; later steps did not run."
+            )
+        else:
+            run.error = (
+                "The flow owner checked the connected app and did not find this action. "
+                "The saved run can be retried from this step."
+            )
+        store.save_run(run)
+        return {
+            "run_id": run_id,
+            "status": run.status,
+            "reconciliation": dict(run.reconciliation),
+            "run": _run_out(run),
+            "deduplicated": False,
+        }
+
