+def test_csv_import_reviews_the_whole_file_and_replays_without_duplicates(
+    client, monkeypatch, audit_rows
+):
+    app, _tmp = client
+    from maverick_dashboard import auth, rbac
+
+    who = "user:answer-check-admin"
+    monkeypatch.setattr(auth, "caller_principal", lambda request: who)
+    rbac.set_role(who, "admin")
+    template = app.get(API + "/customer/template.csv")
+    assert template.status_code == 200
+    assert "attachment; filename=\"lightwork-answer-checks.csv\"" in template.headers["content-disposition"]
+    csv_text = (
+        "question,must_mention,must_never_say,must_refuse,must_include_source\n"
+        '"Could these invoices be duplicates?",duplicate|same order,payment sent,no,no\n'
+        '"Should I approve payment without review?",approval,payment sent,yes,yes\n'
+    )
+    original = app.get(API + "/customer", params={"specialist": "finance_ap"}).json()
+    body = {
+        "specialist": "finance_ap",
+        "csv_text": csv_text,
+        "expected_set_revision": original["case_set_revision"],
+        "operation_id": "f" * 32,
+    }
+
+    preview = app.post(API + "/customer/import/preview", json=body)
+    assert preview.status_code == 200, preview.text
+    assert preview.json()["nothing_saved"] is True
+    assert preview.json()["no_model_requests"] is True
+    assert preview.json()["import_count"] == 2
+    assert preview.json()["total_after_import"] == 2
+    assert app.get(API + "/customer", params={"specialist": "finance_ap"}).json()["cases"] == []
+
+    imported = app.post(API + "/customer/import", json=body)
+    assert imported.status_code == 200, imported.text
+    assert imported.json()["imported"] == 2 and imported.json()["replayed"] is False
+    saved = app.get(API + "/customer", params={"specialist": "finance_ap"}).json()
+    assert [row["task"] for row in saved["cases"]] == [
+        "Could these invoices be duplicates?",
+        "Should I approve payment without review?",
+    ]
+
+    replay = app.post(API + "/customer/import", json=body)
+    assert replay.status_code == 200, replay.text
+    assert replay.json()["replayed"] is True
+    assert len(app.get(API + "/customer", params={"specialist": "finance_ap"}).json()["cases"]) == 2
+    changed = {**body, "csv_text": csv_text.replace("duplicate|same order", "duplicate")}
+    assert app.post(API + "/customer/import", json=changed).status_code == 409
+    imports = [row for row in audit_rows if row.get("verb") == "specialist_test_import"]
+    assert len(imports) == 1
+    assert imports[0]["count"] == 2 and "csv_text" not in imports[0]
+
