+def test_execution_custody_keyring_is_sealed_and_migrates_legacy_file(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    instance = build_composition(tmp_path, monkeypatch)
+    state = instance._state_for("tenant-a")
+    current = state._read_keyring()
+    saved = json.loads(state.keyring_path.read_text(encoding="utf-8"))
+
+    assert saved["schema"] == composition._SEALED_KEYRING_SCHEMA
+    assert saved["tenant"] == "tenant-a"
+    assert "keys" not in saved and "current" not in saved
+    assert all(key.encode("ascii") not in state.keyring_path.read_bytes()
+               for key in current["keys"].values())
+
+    # Upgrade a pre-change private plaintext keyring in place without changing
+    # its active key: existing escrowed tokens must remain recoverable.
+    state.keyring_path.write_bytes(composition._canonical(current))
+    assert state._read_keyring() == current
+    migrated = json.loads(state.keyring_path.read_text(encoding="utf-8"))
+    assert migrated["schema"] == composition._SEALED_KEYRING_SCHEMA
+    assert "keys" not in migrated
+
+
+def test_execution_custody_keyring_cannot_be_copied_across_tenants(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    instance = build_composition(tmp_path, monkeypatch)
+    first, second = instance._state_for("tenant-a"), instance._state_for("tenant-b")
+    first._read_keyring()
+    second._read_keyring()
+    second.keyring_path.write_bytes(first.keyring_path.read_bytes())
+
+    with pytest.raises(
+        composition.GovernanceAgentsCompositionError,
+        match="belongs to another workspace",
+    ):
+        second._read_keyring()
+
