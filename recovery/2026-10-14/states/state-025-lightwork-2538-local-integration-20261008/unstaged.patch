+@router.post("/flows/{flow_id}/test-inputs/outcomes")
+def flow_test_input_outcomes_endpoint(
+    request: Request,
+    flow_id: str,
+    payload: FlowTestInputOutcomesIn,
+) -> dict:
+    """Read safe per-step summaries for exact runs from one comparison batch.
+
+    This deliberately returns no workflow inputs, step outputs, prompts,
+    connector arguments, or error text. It describes execution paths; it does
+    not grade whether either result is correct or useful.
+    """
+    _flow_test_input_context(request, flow_id)
+    from maverick.flow import store
+
+    pairs = payload.pairs
+    case_ids = [pair.case_id for pair in pairs]
+    run_ids = [identity for pair in pairs for identity in (pair.published_run_id, pair.draft_run_id)]
+    if len(set(case_ids)) != len(case_ids) or len(set(run_ids)) != len(run_ids):
+        raise HTTPException(status_code=422, detail="Refresh the examples and choose each comparison only once.")
+
+    active = {"queued", "claimed", "running", "resuming", "paused_approval", "paused_delay", "paused_event"}
+    terminal = {"completed", "reconciled_applied", "failed", "rejected", "cancelled", "budget_limited", "indeterminate"}
+    label_by_kind = {
+        "agent": "AI task", "action": "Connected action", "branch": "Decision",
+        "switch": "Choose a path", "foreach": "Repeat for each item", "while": "Repeat while",
+        "parallel": "Run together", "approval": "Approval", "delay": "Wait",
+        "wait_event": "Wait for another app", "scope": "Handle a failure",
+        "subflow": "Run another workflow", "setvar": "Update data",
     }
+    snapshots: dict[str, dict] = {}
+
+    def summarize_run(identity: str, *, case_id: str, side: str) -> dict:
+        run = _load_owned_run(request, identity)
+        if run.flow_id != flow_id or not run.dry_run:
+            raise HTTPException(status_code=404, detail="No matching safe comparison was found.")
+        prefix = f"flow-test:{payload.batch_id}:{case_id}:"
+        suffix = ":" + side
+        key = str(run.idem_key or "")
+        if not key.startswith(prefix) or not key.endswith(suffix):
+            raise HTTPException(status_code=404, detail="No matching safe comparison was found.")
+        revision = key[len(prefix):-len(suffix)]
+        if not revision.isdecimal() or int(revision) < 1:
+            raise HTTPException(status_code=404, detail="No matching safe comparison was found.")
+
+        digest = str(run.definition_digest or "")
+        if digest and digest not in snapshots:
+            try:
+                pinned = store.load_flow_snapshot(digest)
+                snapshots[digest] = pinned.nodes if pinned is not None else {}
+            except (OSError, ValueError, store.FlowSnapshotError):
+                snapshots[digest] = {}
+        definition = snapshots.get(digest, {})
+
+        node_states = run.nodes if isinstance(run.nodes, dict) else {}
+        entries = list(node_states.items())
+        trace_complete = len(entries) <= 256
+        steps = []
+        signature = []
+        for index, (node_id, state) in enumerate(entries[:256], start=1):
+            if not isinstance(node_id, str) or not isinstance(state, dict):
+                trace_complete = False
+                continue
+            raw_status = state.get("status")
+            if not isinstance(raw_status, str):
+                trace_complete = False
+                raw_status = ""
+            status = raw_status[:40]
+            outcome = state.get("outcome")
+            if outcome is not None:
+                try:
+                    numeric_outcome = float(outcome) if type(outcome) in (int, float) else math.nan
+                except (OverflowError, TypeError, ValueError):
+                    numeric_outcome = math.nan
+                if not math.isfinite(numeric_outcome) or not -1.0 <= numeric_outcome <= 1.0:
+                    trace_complete = False
+                    outcome = None
+                else:
+                    outcome = numeric_outcome
+            node = definition.get(node_id) if isinstance(definition, dict) else None
+            label = str(getattr(node, "label", "") or "").strip()
+            if not label:
+                kind = str(getattr(node, "kind", "") or "")
+                label = label_by_kind.get(kind, f"Step {index}")
+            label = label[:160]
+            steps.append({"label": label, "status": status, "outcome": outcome})
+            signature.append((node_id, status, outcome))
+
+        status = str(run.status or "")[:40]
+        return {
+            "run_id": run.run_id,
+            "status": status,
+            "finished": status in terminal,
+            "waiting": status in active and status.startswith("paused_"),
+            "steps": steps,
+            "steps_complete": trace_complete,
+            "_signature": signature,
+            "_case_revision": revision,
+        }
+
+    results = []
+    for pair in pairs:
+        published = summarize_run(pair.published_run_id, case_id=pair.case_id, side="published")
+        draft = summarize_run(pair.draft_run_id, case_id=pair.case_id, side="draft")
+        if published["_case_revision"] != draft["_case_revision"]:
+            raise HTTPException(status_code=404, detail="No matching safe comparison was found.")
+        published_signature = published.pop("_signature")
+        draft_signature = draft.pop("_signature")
+        published.pop("_case_revision")
+        draft.pop("_case_revision")
+        settled = published["finished"] and draft["finished"]
+        complete_trace = published["steps_complete"] and draft["steps_complete"]
+        results.append({
+            "case_id": pair.case_id,
+            "published": published,
+            "draft": draft,
+            "statuses_match": published["status"] == draft["status"] if settled else None,
+            "paths_match": published_signature == draft_signature if settled and complete_trace else None,
+        })
+
+    return {"flow_id": flow_id, "batch_id": payload.batch_id, "results": results}
 
 
