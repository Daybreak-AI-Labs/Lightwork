+    # transport after isolating the owner store; production keeps the check.
+    monkeypatch.setattr(local_owner, "_local", lambda _request: None)
+    config.reset_config_cache()
+    client = _client(monkeypatch, tmp_path)
+    page = client.get("/overview")
