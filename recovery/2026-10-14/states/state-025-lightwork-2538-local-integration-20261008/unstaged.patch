+def test_queue_acceptance_is_visible_and_an_uncertain_handoff_is_never_retried(environment, monkeypatch):
+    client, world, runs = environment
+
+    async def queued(goal_id, **kwargs):
+        runs.append((goal_id, SubmissionStore(world).for_goal(goal_id), []))
+        return "queued"
+
+    monkeypatch.setattr("maverick.runner.run_goal_in_background_async", queued)
+    accepted = client.post("/chat/send", data={"title": "Queue this task", "submission_key": "queue-receipt"},
+                           follow_redirects=False)
+    assert accepted.status_code == 303
+    accepted_goal = world.list_goals()[0]
+    accepted_receipt = SubmissionStore(world).for_goal(accepted_goal.id)
+    assert accepted_receipt["state"] == "dispatched"
+    assert accepted_receipt["detail"]["dispatch_outcome"] == "queued"
+    accepted_page = client.get(f"/chat/goal/{accepted_goal.id}")
+    assert "Task accepted and waiting for a worker" in accepted_page.text
+    activity = client.get(f"/api/v1/goals/{accepted_goal.id}/events").json()["events"]
+    handoffs = [event for event in activity if event["kind"] == "handoff"]
+    assert [event["content"] for event in handoffs][-2:] == [
+        "Lightwork is sending this task to a worker. Check task status before submitting it again.",
+        accepted_receipt["detail"]["dispatch_message"],
+    ]
+
+    async def uncertain(goal_id, **kwargs):
+        runs.append((goal_id, SubmissionStore(world).for_goal(goal_id), []))
+        return None
+
+    monkeypatch.setattr("maverick.runner.run_goal_in_background_async", uncertain)
+    first = client.post("/chat/send", data={"title": "Recover status", "submission_key": "uncertain-receipt"},
+                        follow_redirects=False)
+    assert first.status_code == 303
+    uncertain_goal = world.list_goals()[-1]
+    receipt = SubmissionStore(world).for_goal(uncertain_goal.id)
+    assert receipt["state"] == "reconciliation_required"
+    assert receipt["detail"]["dispatch_outcome"] == "unconfirmed"
+    page = client.get(f"/chat/goal/{uncertain_goal.id}")
+    assert "Task handoff needs a status check" in page.text
+    assert "do not submit a duplicate" in page.text.lower()
+    assert f'href="/chat/goal/{uncertain_goal.id}"' in page.text
+    assert "Refresh task status" in page.text
+
+    retry = client.post("/chat/send", data={"title": "Recover status", "submission_key": "uncertain-receipt"},
