+def test_is_same_origin_accepts_https_and_only_trusted_proxy_tls(monkeypatch):
+    from maverick_dashboard import auth
+    from maverick_dashboard.app import _is_same_origin
+    from starlette.requests import Request
+
+    def request(scheme, *, forwarded=""):
+        headers = [(b"host", b"testserver"), (b"origin", b"https://testserver")]
+        if forwarded:
+            headers.append((b"x-forwarded-proto", forwarded.encode()))
+        return Request({
+            "type": "http", "method": "POST", "scheme": scheme, "path": "/chat/send",
+            "client": ("10.0.0.5", 1234), "server": ("testserver", 80),
+            "headers": headers,
+        })
+
+    monkeypatch.setattr(auth, "proxy_trusts", lambda _host: False)
+    assert _is_same_origin(request("https")) is True
+    assert _is_same_origin(request("http", forwarded="https")) is False
+    monkeypatch.setattr(auth, "proxy_trusts", lambda host: host == "10.0.0.5")
+    assert _is_same_origin(request("http", forwarded="https")) is True
+    assert _is_same_origin(request("https", forwarded="http")) is True
+
