+) -> None:
+    store, lifecycle, _, principal = authority
+    independent_question = {
+        **questions()[0],
+        "question_id": "business_continuity",
+        "domain": "operational",
+        "prompt_ref": "prompt.business_continuity",
+    }
+    principal.value = "author"
+    lifecycle.create_template_version(
+        "tenant-a",
+        "multi-respondent",
+        title_ref="title.multi-respondent",
+        questions=[questions()[0], independent_question],
+        mitigation_rules=[],
+        expected_latest_version=0,
+        idempotency_key="multi-template-create",
+    )
+    principal.value = "reviewer"
+    lifecycle.approve_template_version(
+        "tenant-a",
+        "multi-respondent",
+        1,
+        expected_revision=1,
+        idempotency_key="multi-template-approve",
+    )
+    principal.value = "creator"
+    lifecycle.create_assessment(
+        "tenant-a",
+        "assessment-multi-respondent",
+        vendor_ref="vendor-multi-respondent",
+        template_id="multi-respondent",
+        template_version=1,
+        owner_ref="owner",
+        respondent_assignments={
+            "security_control": "vendor-security-respondent",
+            "business_continuity": "vendor-continuity-respondent",
+        },
+        retention_seconds=DAY * 10,
+        idempotency_key="multi-assessment-create",
+    )
+    principal.value = "portal-admin"
+
+    tokens: dict[str, str] = {}
+    for invitation_id, respondent_ref, question_id in (
+        ("invite-security", "vendor-security-respondent", "security_control"),
+        ("invite-continuity", "vendor-continuity-respondent", "business_continuity"),
+    ):
+        issued = store.issue_invitation(
+            "tenant-a",
+            invitation_id,
+            assessment_id="assessment-multi-respondent",
+            respondent_ref=respondent_ref,
+            allowed_question_ids=[question_id],
+            notice_ref="notice.vendor-assessment.v1",
+            notice_sha256=DIGEST_A,
+            artifact_policy=policy(),
+            expires_in_seconds=DAY,
+            retention_seconds=DAY * 2,
+            idempotency_key=f"{invitation_id}-issue",
+        )
+        assert issued.token is not None
+        tokens[question_id] = issued.token
+
+    receipts = []
+    for question_id, value in (("security_control", True), ("business_continuity", False)):
+        token = tokens[question_id]
+        evidence = measured(store, token)
+        answer = {question_id: {"value": value, "artifact_ids": [str(evidence[0]["artifact_id"])]}}
+        receipts.append(
+            store.finalize_submission(
+                "tenant-a",
+                token,
+                answers=answer,
+                artifacts=evidence,
+                attested=True,
+                expected_draft_revision=0,
+                idempotency_key=f"{question_id}-final",
+            )
+        )
+
+    assessment = lifecycle.get_assessment("tenant-a", "assessment-multi-respondent")
+    assert assessment.revision == 3
+    assert set(assessment.responses) == {"security_control", "business_continuity"}
+    assert [receipt.question_ids for receipt in receipts] == [
+        ("security_control",),
+        ("business_continuity",),
+    ]
+    assert store.get_invitation("tenant-a", "invite-security")["status"] == "finalized"
+    assert store.get_invitation("tenant-a", "invite-continuity")["status"] == "finalized"
+
