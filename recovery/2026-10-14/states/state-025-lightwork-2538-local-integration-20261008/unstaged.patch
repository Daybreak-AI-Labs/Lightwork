+def test_bridge_preserves_acknowledgements_from_grouped_subscriptions(tmp_path) -> None:
+    preferences, delivery = _stores(tmp_path)
+    _seed(preferences, delivery)
+    bridge = ConsentDeliveryBridge(preferences, delivery)
+    legacy_subscription, legacy_digest = bridge._subscription(("crm", "warehouse"))  # noqa: SLF001
+    page = preferences.read_outbox("tenant-a", legacy_subscription)
+    for event in page["events"]:
+        event_id = event["event_id"]
+        if event["event_type"] == "preferences.changed":
+            delivery.enqueue_change(
+                "tenant-a",
+                bridge._change("tenant-a", event),  # noqa: SLF001
+                destination_ids=("crm", "warehouse"),
+                idempotency_key=f"bridge.enqueue.{event_id}.{legacy_digest[:32]}",
+            )
+        preferences.ack_outbox(
+            "tenant-a",
+            legacy_subscription,
+            event_id,
+            f"bridge.ack.{event_id}",
+        )
+
+    result = bridge.sync_once("tenant-a", ["crm", "warehouse"])
+
+    assert result["events_read"] == 0
+    assert result["messages_queued"] == 0
+    assert delivery.counts("tenant-a")["queued"] == 2
