+def _redact_private_webhook_path(path: str) -> tuple[str, bool]:
+    """Hide one-time trigger credentials anywhere a concrete path is exposed."""
+    raw = str(path or "")
+    decoded = unquote(raw)
+    marker = "/webhook/trigger/"
+    start = decoded.rfind(marker)
+    if start < 0:
+        return raw, False
+    suffix = decoded[start + len(marker):]
+    if not suffix:
+        return raw, False
+    has_extra_path = "/" in suffix.rstrip("/")
+    trailing_slash = suffix == suffix.split("/", 1)[0] + "/"
+    redacted = decoded[:start + len(marker)] + "[redacted]"
+    if has_extra_path:
+        redacted += "/[redacted]"
+    elif trailing_slash:
+        redacted += "/"
+    return redacted, True
+
+
+def _safe_local_return_path(request: Request) -> str:
+    path, private_webhook = _redact_private_webhook_path(request.url.path)
+    if request.url.query and not private_webhook:
+        return f"{path}?{request.url.query}"
+    return path
+
