+@app.post("/webhook/trigger/{token}")
+async def webhook_trigger_direct(request: Request, bg: BackgroundTasks, token: str) -> JSONResponse:
+    """Start one registered workflow from a high-entropy, per-trigger URL.
+
+    The address is issued once by the authenticated workflow UI and only its
+    SHA-256 digest is stored. JSON (including vendor ``+json`` types) and
+    URL-encoded forms are accepted, with the same strict body-size ceiling as
+    other webhooks. ``data`` envelopes are unwrapped; other objects are passed
+    through intact. An event ID, when supplied, gives bounded at-most-once
+    delivery protection without retaining the provider's raw identifier.
+    """
+    from maverick.config import get_features
+
+    if not get_features().get("triggers", True):
+        raise HTTPException(status_code=404, detail="workflow starts are unavailable")
+    try:
+        from maverick_dashboard import triggers_store
+
+        trigger = triggers_store.trigger_for_direct_token(token, strict=True)
+    except RuntimeError as exc:
+        raise HTTPException(status_code=503, detail="workflow starts could not be checked") from exc
+    if trigger is None:
+        raise HTTPException(status_code=404, detail="workflow start is unavailable")
+
+    require_provider_or_400()
+    body = await _read_limited_webhook_body(request)
+    content_type = request.headers.get("content-type", "").split(";", 1)[0].strip().lower()
+    try:
+        if content_type == "application/json" or content_type.endswith("+json"):
+            def reject_nonstandard_constant(value: str):
+                raise ValueError(f"invalid JSON constant: {value}")
+
+            payload = json.loads(body or b"{}", parse_constant=reject_nonstandard_constant)
+        elif content_type == "application/x-www-form-urlencoded":
+            pairs = parse_qsl(
+                body.decode("utf-8"), keep_blank_values=True, strict_parsing=False,
+                max_num_fields=512, encoding="utf-8", errors="strict",
+            )
+            payload = {}
+            for key, value in pairs:
+                if key in payload:
+                    raise ValueError("repeated form fields are ambiguous")
+                payload[key] = value
+        else:
+            raise HTTPException(
+                status_code=415,
+                detail="send a JSON or URL-encoded form body",
+            )
+    except HTTPException:
+        raise
+    except (ValueError, UnicodeDecodeError, RecursionError) as exc:
+        raise HTTPException(status_code=400, detail="body must be a valid JSON object or form") from exc
+    if not isinstance(payload, dict):
+        raise HTTPException(status_code=400, detail="body must be a JSON object or form")
+
+    check_goal_rate_limit(request, source="webhook")
+    data = payload.get("data")
+    if not isinstance(data, dict):
+        data = payload
+    delivery = (
+        request.headers.get("idempotency-key")
+        or request.headers.get("x-event-id")
+        or request.headers.get("x-github-delivery")
+        or payload.get("id")
+        or payload.get("event_id")
+    )
+    if not delivery and isinstance(payload.get("event"), dict):
+        delivery = payload["event"].get("id")
+    normalized = {"data": data}
+    if delivery is not None and str(delivery).strip():
+        # Never write a provider's customer/event identifier to the replay
+        # ledger or flow idempotency key.
+        delivery_digest = hashlib.sha256(str(delivery).strip()[:200].encode("utf-8")).hexdigest()
+        normalized["id"] = delivery_digest
+        replay_id = hashlib.sha256(
+            f"{trigger['name']}\0{delivery_digest}".encode()
+        ).hexdigest()
+        if _webhook_duplicate_delivery(f"direct-{trigger['name']}", {"id": replay_id}):
+            raise HTTPException(status_code=409, detail="this event was already received")
+    return _fire_stored_trigger(request, bg, normalized, trigger["name"], trigger)
+
