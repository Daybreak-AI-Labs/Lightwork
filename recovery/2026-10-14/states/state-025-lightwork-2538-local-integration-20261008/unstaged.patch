+def test_interrupted_dsar_rectification_is_resolved_without_replay(monkeypatch):
+    from maverick import dsar, dsar_rectification
+
+    world = dsar._resolve_world(None, strict=True)
+    alice = world.get_or_create_conversation("email", "recover@example.test")
+    world.append_turn(alice.id, "user", "My name is Jon Smith.")
+    request = client.post("/api/v1/privacy/dsar", json={
+        "subject_id": "recover@example.test", "kind": "correction", "channel": "email",
+    })
+    assert request.status_code == 201, request.text
+    request_id = request.json()["id"]
+    assert client.post(f"/api/v1/privacy/dsar/{request_id}/verify", json={
+        "method": "document_check", "reference": "identity receipt 18",
+    }).status_code == 200
+    search = client.post(f"/api/v1/privacy/dsar/{request_id}/rectification/search", json={
+        "channel": "email", "incorrect_text": "Jon Smith",
+    })
+    assert search.status_code == 200, search.text
+    match = search.json()["matches"][0]
+    details = {
+        "channel": "email", "incorrect_text": "Jon Smith",
+        "replacement_text": "John Smith", "reference": match["reference"],
+        "expected_sha256": match["current_sha256"], "operation_id": "b" * 32,
+    }
+    apply_url = f"/api/v1/privacy/dsar/{request_id}/rectification/apply"
+    original_apply = dsar_rectification.apply_subject_correction
+
+    def lose_reply_after_write(*args, **kwargs):
+        original_apply(*args, **kwargs)
+        raise dsar_rectification.DsarRectificationError("simulated lost response")
+
+    monkeypatch.setattr(dsar_rectification, "apply_subject_correction", lose_reply_after_write)
+    interrupted = client.post(apply_url, json=details)
+    assert interrupted.status_code == 409
+    assert world.recent_turns(alice.id, limit=1)[0].content == "My name is John Smith."
+
+    closed = client.post(f"/api/v1/privacy/dsar/{request_id}/close")
+    assert closed.status_code == 409
+    assert "last correction result" in closed.json()["detail"].lower()
+
+    resolved = client.post(
+        f"/api/v1/privacy/dsar/{request_id}/rectification/original/{details['operation_id']}/resolve",
+        json={},
+    )
+    assert resolved.status_code == 200, resolved.text
+    assert resolved.json()["status"] == "reconciled_after"
+    assert "did not submit" in resolved.json()["message"].lower()
+    # This operation id is terminal and cannot cause a second write.
+    assert client.post(apply_url, json=details).status_code == 409
+    assert world.recent_turns(alice.id, limit=1)[0].content == "My name is John Smith."
+    assert client.post(f"/api/v1/privacy/dsar/{request_id}/close").status_code == 200
