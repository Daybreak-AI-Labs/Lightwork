+def test_expired_alert_leases_consume_attempt_budget_and_dead_letter(store, clock) -> None:
+    vendor = create_vendor(store)
+    _source, snapshot = enroll_source(store, "breach_intelligence")
+    monitor = store.create_monitor(
+        "tenant-a",
+        monitor_id="lease-expiry-monitor",
+        vendor_id=vendor.vendor_id,
+        source_bindings={"breach_intelligence": "source-breach_intelligence"},
+        destination_ref="third-party-alert-sink",
+        cadence_seconds=60,
+        created_by="monitor-admin",
+        idempotency_key="create-lease-expiry-monitor",
+    )
+    baseline = store.record_monitor_observation(
+        "tenant-a",
+        monitor.monitor_id,
+        snapshot_bindings={"breach_intelligence": snapshot.snapshot_id},
+        observation_sha256=digest("lease-baseline"),
+        evidence_sha256=digest("lease-baseline-evidence"),
+        citations=citation("lease-baseline"),
+        expected_revision=monitor.revision,
+        actor_ref="monitor-worker",
+        idempotency_key="lease-baseline",
+    )
+    clock.advance(60)
+    changed = store.record_monitor_observation(
+        "tenant-a",
+        monitor.monitor_id,
+        snapshot_bindings={"breach_intelligence": snapshot.snapshot_id},
+        observation_sha256=digest("lease-change"),
+        evidence_sha256=digest("lease-change-evidence"),
+        citations=citation("lease-change"),
+        expected_revision=baseline.monitor.revision,
+        actor_ref="monitor-worker",
+        idempotency_key="lease-change",
+    )
+    assert changed.alert is not None
+
+    previous_token = None
+    delivery = None
+    for expected_attempt in range(1, 6):
+        claims = store.claim_outbox(
+            "tenant-a", worker_id="crashing-worker", lease_seconds=10
+        )
+        assert len(claims) == 1
+        delivery = claims[0]
+        assert delivery.attempt == expected_attempt
+        assert delivery.lease_token is not None and len(delivery.lease_token) == 64
+        if previous_token is not None:
+            assert delivery.lease_token != previous_token
+        previous_token = delivery.lease_token
+        clock.advance(11)  # The worker dies while holding a lease, before send.
+
+    assert store.claim_outbox(
+        "tenant-a", worker_id="crashing-worker", lease_seconds=10
+    ) == ()
+    assert delivery is not None
+    exhausted = store.get_outbox("tenant-a", delivery.delivery_id)
+    assert exhausted.state == "dead_letter"
+    assert exhausted.attempt == exhausted.maximum_attempts == 5
+    assert exhausted.last_error_code == "worker_lease_expired"
+    assert exhausted.lease_token is None and exhausted.lease_until is None
+
+
+def test_due_monitor_scan_pages_past_one_thousand_and_ignores_inactive_rows(store, clock) -> None:
+    vendor = create_vendor(store)
+    due_ids = [f"monitor-{index:04d}" for index in range(1_005)]
+    rows = []
+    for monitor_id in due_ids + ["monitor-z-future", "monitor-z-revoked"]:
+        state = "revoked" if monitor_id.endswith("revoked") else "active"
+        next_run = clock.value + 3_600 if monitor_id.endswith("future") else clock.value
+        payload = {
+            "tenant_id": "tenant-a",
+            "monitor_id": monitor_id,
+            "vendor_id": vendor.vendor_id,
+            "source_bindings": {},
+            "destination_ref": "reviewed-alert-sink",
+            "cadence_seconds": 60,
+            "next_run_at": next_run,
+            "state": state,
+            "last_observation_sha256": None,
+            "revision": 1,
+            "created_by": "monitor-admin",
+            "created_at": clock.value,
+            "updated_at": clock.value,
+        }
+        rows.append(("tenant-a", monitor_id, vendor.vendor_id,
+                     intelligence._canonical(payload).decode("ascii"),
+                     intelligence._sha256(payload)))
+    with store._connect() as connection:
+        connection.executemany("INSERT INTO monitors VALUES(?,?,?,?,?)", rows)
+
+    selected = []
+    cursor = None
+    while True:
+        page = store.due_monitors("tenant-a", limit=500, after_id=cursor)
+        if not page:
+            break
+        selected.extend(item.monitor_id for item in page)
+        cursor = page[-1].monitor_id
+        if len(page) < 500:
+            break
+
+    assert selected == due_ids
+
+
