+            status_code=400,
+            detail="Choose one of the available decisions for this approval.",
+        )
+    if "attributable approver identity" in reason:
+        return HTTPException(
+            status_code=403,
+            detail="Sign in with an authorized account to review this approval.",
+        )
+    if "approver is not the declared assignee" in reason:
+        return HTTPException(
+            status_code=403,
+            detail="This approval is assigned to someone else. Ask the assigned reviewer to decide.",
+        )
+    if "authority is unavailable" in reason:
+        return HTTPException(
+            status_code=503,
+            detail="Lightwork could not verify who may review this approval. Refresh or ask your administrator.",
+        )
+    if "approval" in reason:
+        return HTTPException(
+            status_code=409,
+            detail="This approval changed or expired. Refresh the run and review it again.",
+        )
+    return HTTPException(
+        status_code=409,
+        detail="This workflow changed or is no longer available. Refresh it before continuing.",
+    )
