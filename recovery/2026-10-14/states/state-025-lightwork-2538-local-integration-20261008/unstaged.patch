+        {"Location": "https://attacker.example/collect"},
+        BytesIO(b"redirect"),
+    )
+    open_calls = 0
+
+    class FakeOpener:
+        def open(self, _request: Any, *, timeout: float) -> Any:
+            nonlocal open_calls
+            open_calls += 1
+            assert timeout == 2.0
+            raise redirect_error
+
+    def build_opener(*handlers: Any) -> FakeOpener:
+        assert len(handlers) == 1
+        no_redirect = handlers[0]
+        assert no_redirect.redirect_request(
+            None,
+            None,
+            302,
+            "Found",
+            {"Location": "https://attacker.example/collect"},
+            "https://attacker.example/collect",
+        ) is None
+        return FakeOpener()
+
+    monkeypatch.setattr(urllib.request, "build_opener", build_opener)
+    response = _DefaultAzureHttpTransport().post(
+        "https://management.azure.com/subscriptions/example/query",
+        headers={"Authorization": "Bearer azure-token"},
+        json_body={},
+        timeout=2.0,
+    )
+
+    assert response.status_code == 302
+    assert open_calls == 1
