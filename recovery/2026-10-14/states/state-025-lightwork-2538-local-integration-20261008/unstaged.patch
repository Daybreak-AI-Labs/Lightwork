+def research_experiment_toggle_prepare(request, selection, arguments):
+    state = _research_experiment_state(request)
+    if state["blocked"]:
+        raise HTTPException(409, state["blocked"])
+    target = arguments["enabled"]
+    current = state["status"]["requested"]
+    if target is current:
+        raise HTTPException(409, "The research experiment is already in that state. Refresh Learning and review again.")
+    before = "On" if current else "Off"
+    after = "On" if target else "Off"
+    summary = (
+        f"Turn the installation-wide research experiment {after.lower()}? This does not start an experiment cycle. "
+        "When on, Lightwork can only test changes in its isolated practice area; results still need human review, "
+        "and nothing is installed automatically."
+    )
+    return Preview(summary, changes=[{"label": "Research experiment", "before": before, "after": after}],
+                   native={"context": state["context"], "revision": state["revision"], "target": target})
+
