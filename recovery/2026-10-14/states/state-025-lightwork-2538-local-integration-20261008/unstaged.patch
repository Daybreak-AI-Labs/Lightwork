+            ) from None
+        except Exception:
+            raise EventSourceError(
+                "IMAP server could not be safely resolved"
+            ) from None
+
+        raw_socket = socket.create_connection(
+            (address, selected_port),
+            timeout=selected_timeout,
+        )
+        try:
+            tls_socket = self.ssl_context.wrap_socket(
+                raw_socket,
