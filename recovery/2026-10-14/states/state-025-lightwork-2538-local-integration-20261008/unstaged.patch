+def _flow_test_published_bundle(request: Request, flow_id: str, payload):
+    from maverick.flow import store
+
+    if not payload.compare_to_published:
+        if payload.expected_published_release_id is not None:
+            raise HTTPException(status_code=422, detail="Choose whether to compare with the published workflow.")
+        return None
+    try:
+        bundle = store.load_published_bundle(flow_id)
+    except store.FlowSnapshotError as exc:
+        raise HTTPException(status_code=409, detail="The published workflow could not be checked. Refresh before comparing.") from exc
+    if bundle is None:
+        raise HTTPException(status_code=409, detail="Publish a workflow version before comparing it with this draft.")
+    _assert_flow_access(request, bundle[0])
+    if payload.expected_published_release_id != str(bundle[1].get("release_id") or ""):
+        raise HTTPException(status_code=409, detail="The published workflow changed. Refresh and review the comparison again.")
+    return bundle
+
+
+def _flow_test_draft(payload, flow_id: str, prior):
+    from maverick.flow import Flow
+
+    try:
+        draft = Flow.from_dict(payload.flow)
+    except Exception as exc:
+        raise HTTPException(status_code=400, detail="The current workflow draft could not be tested.") from exc
+    if draft.id != flow_id:
+        raise HTTPException(status_code=409, detail="The workflow changed. Refresh before testing these examples.")
+    draft.owner = prior.owner
+    draft.version = int(prior.version) + 1
+    draft.revision = prior.revision
+    errors = draft.validate()
+    if errors:
+        raise HTTPException(status_code=400, detail="Fix the workflow before testing: " + "; ".join(errors[:5]))
+    return draft
+
+
+def _coerce_flow_test_data(flow, raw_data: dict, label: str) -> dict:
+    if flow.learned_recipe is not None:
+        from maverick.flow import action_recipe
+
+        if type(raw_data) is not dict or set(raw_data) != {"input"}:
+            raise HTTPException(status_code=422, detail=f"{label}: use the workflow's saved input form.")
+        try:
+            inputs = action_recipe.validate_inputs(flow.learned_recipe, raw_data["input"])
+        except (ValueError, TypeError, RecursionError, UnicodeError) as exc:
+            raise HTTPException(
+                status_code=422,
+                detail=f"{label}: these inputs no longer match the workflow's saved fields. Refresh and review them.",
+            ) from exc
+        return {"input": inputs}
+
+    from maverick.flow.ir import coerce_inputs
+
+    data, errors = coerce_inputs(flow, dict(raw_data))
+    if errors:
+        raise HTTPException(status_code=422, detail=f"{label}: " + "; ".join(errors))
+    return data
+
+
+def _prepare_flow_test_inputs(draft, published_bundle, selected):
+    prepared = []
+    for case in selected:
+        data = _coerce_flow_test_data(draft, dict(case["data"]), case["name"])
+        published_data = None
+        if published_bundle is not None:
+            published_data = _coerce_flow_test_data(
+                published_bundle[0], dict(case["data"]),
+                f"{case['name']} cannot be used with the published workflow",
+            )
+        prepared.append((case, data, published_data))
+    return prepared
+
