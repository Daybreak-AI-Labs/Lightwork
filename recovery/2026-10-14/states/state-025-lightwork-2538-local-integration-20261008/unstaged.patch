+                 "/content-access", "/my-data"):
+        assert f'href="{href}"' not in account.text
+    assert 'href="/account/api-keys"' in account.text
+    assert 'href="/auth/local-owner"' in account.text
+    assert client.get("/auth/local-owner").status_code == 200
