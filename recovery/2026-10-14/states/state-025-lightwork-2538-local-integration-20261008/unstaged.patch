+def test_taught_release_accepts_governed_actions_and_keeps_high_risk_approval():
+    from maverick.candidate_promotion import CandidatePromotionDenied
+    from maverick_dashboard.local_flow_promotions import _action_review, _pure_definition
+
+    flow = Flow(id="connected-release", name="Prepare and send an update", owner=OWNER,
+                start="calculate", nodes={
+        "calculate": FlowNode(id="calculate", kind="agent", brief="Prepare the update",
+                              output="draft", next="review"),
+        "review": FlowNode(id="review", kind="approval", prompt="Review before sending",
+                           next="send"),
+        "send": FlowNode(id="send", kind="action", tool="email",
+                         params={"to": "customer@example.com", "body": "{{draft}}"}),
+    })
+    flow = attach_learned_operator(flow, "calculate", _artifact(False))
+    flow.nodes["calculate"].learned_fallback = False
+
+    # Email is a classified high-risk action. Flow validation permits it only
+    # behind the explicit approval above; the release practice itself is dry-run.
+    assert _pure_definition(flow, permit_approval=True) == 1
+    assert _action_review(flow.nodes["send"]) == {
+        "connected_service": "Email",
+        "connected_action_settings": {"to": "customer@example.com", "body": "{{draft}}"},
+    }
+    flow.nodes["send"].params = {"api_key": "sk_live_" + "a" * 24}
+    with pytest.raises(CandidatePromotionDenied, match="credential-like"):
+        _action_review(flow.nodes["send"])
+
+    ungated = Flow(id="ungated-connected-release", name="Prepare and send an update",
+                   owner=OWNER, start="calculate", nodes={
+        "calculate": FlowNode(id="calculate", kind="agent", brief="Prepare the update",
+                              output="draft", next="send"),
+        "send": FlowNode(id="send", kind="action", tool="email",
+                         params={"to": "customer@example.com", "body": "{{draft}}"}),
+    })
+    ungated = attach_learned_operator(ungated, "calculate", _artifact(False))
+    ungated.nodes["calculate"].learned_fallback = False
+    with pytest.raises(CandidatePromotionDenied, match="complete routes"):
+        _pure_definition(ungated, permit_approval=True)
+
