+def research_experiment_toggle_execute(request, _selection, arguments, prepared, _operation):
+    target = arguments["enabled"]
+    if prepared.get("target") is not target or not prepared.get("context"):
+        raise HTTPException(409, "The reviewed experiment setting changed. Refresh Learning and review again.")
+    current = _research_experiment_state(request)
+    if current["revision"] != prepared.get("revision") or current["blocked"]:
+        raise HTTPException(409, "The research experiment settings changed. Refresh Learning and review again.")
+
+    from .api import set_dgm_endpoint
+    from .api_schemas import DgmToggleIn
+
+    result = set_dgm_endpoint(
+        request,
+        DgmToggleIn(enabled=target, acknowledge_research_only=target),
+    )
+    status = result.get("dgm") if isinstance(result, dict) else None
+    if not isinstance(status, dict) or status.get("requested") is not target:
+        raise HTTPException(503, "Lightwork could not confirm the research experiment setting. Check Learning before trying again.")
+    message = _research_experiment_summary({
+        "requested": target,
+        "state": status.get("state", "unavailable"),
+    })
+    return Outcome("confirmed", message, {
+        "research_experiment": {
+            "requested": target,
+            "state": status.get("state", "unavailable"),
+            "ready": status.get("ready") is True,
+            "blockers": status.get("blockers", []),
+            "research_only": True,
+            "live_adoption": False,
+        },
+        "open_learning": {"href": "/learning#lrn-dgm", "label": "Review Learning experiment status"},
+    })
