+def encryption_key_identity(tenant_id: str | None) -> dict[str, str]:
+    """Describe the key selected by the real tenant KMS resolver, without secrets."""
+    import os
+
+    from maverick.tenant import kms as tenant_kms
+
+    try:
+        cfg = tenant_kms._kms_config_for(tenant_id)
+        provider = str(cfg.get("provider") or "local").strip().lower()
+        own_key_id = tenant_kms._tenant_own_key_id(tenant_id)
+    except Exception:  # noqa: BLE001 -- render a clear unknown state, never a false key
+        return {"status": "unknown", "provider": "", "key_id": "", "source": ""}
+    if provider in {"", "local"}:
+        return {
+            "status": "local",
+            "provider": "Local protection",
+            "key_id": "",
+            "source": "This installation",
+        }
+    environment_key_id = os.environ.get("MAVERICK_KMS_KEY_ID", "").strip()
+    configured_key_id = str(cfg.get("key_id") or "").strip()
+    provider_label = {
+        "aws": "AWS KMS",
+        "gcp": "Google Cloud KMS",
+        "vault": "Vault Transit",
+    }.get(provider, "Cloud key service")
+    try:
+        backend = tenant_kms.get_kms(tenant_id)
+        key_id = str(getattr(backend, "key_id", "") or "").strip()
+        if not key_id:
+            raise ValueError("effective key identity is unavailable")
+    except Exception:  # noqa: BLE001 -- show unknown rather than leak provider setup
+        return {
+            "status": "unknown",
+            "provider": provider_label,
+            "key_id": "",
+            "source": "",
+        }
+    if own_key_id:
+        if key_id != own_key_id:
+            return {"status": "unknown", "provider": provider_label, "key_id": "", "source": ""}
+        source = "This workspace's settings"
+    elif environment_key_id:
+        if key_id != environment_key_id:
+            return {"status": "unknown", "provider": provider_label, "key_id": "", "source": ""}
+        source = "The installation's environment setting"
+    elif configured_key_id and key_id == configured_key_id:
+        source = "The installation's saved settings"
+    else:
+        return {"status": "unknown", "provider": provider_label, "key_id": "", "source": ""}
+    return {
+        "status": "configured",
+        "provider": provider_label,
+        "key_id": key_id,
+        "source": source,
+    }
+
+
+__all__ = [
+    "ATTACK_NAMES",
+    "CURATED_TITLES",
+    "FRAMEWORK_LABELS",
+    "attack_choices",
+    "encryption_key_identity",
+    "SOC_CONNECTOR_LABELS",
+    "soc_connector_choices",
+]
