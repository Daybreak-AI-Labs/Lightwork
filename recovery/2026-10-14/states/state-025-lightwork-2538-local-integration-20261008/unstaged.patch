+def _copilot_visible_task(
+    request: Request, message: str, permissions: frozenset[str], *, exact_only: bool = False,
+):
+    """Find one exact, curated task answer on any page visible to this caller."""
+    from . import ui_visibility
+    from .app import _account_pages_unavailable, _page_role, _switched_off_pages
+    from .copilot_tasks import TASKS, match
+
+    hidden_paths = _switched_off_pages() | _account_pages_unavailable(request)
+    scope_roles = {
+        "workspace": _page_role(request),
+        "global": _page_role(request, global_scope=True),
+    }
+    visible_paths = {
+        link["href"]
+        for group in ui_visibility.finder_pages(None, scope_roles=scope_roles)
+        for link in group["links"]
+    } - hidden_paths
+    def navigation_words(value: str) -> tuple[str, ...]:
+        words = re.findall(r"[a-z0-9]+", value.casefold())
+        if tuple(words[:3]) in {
+            ("where", "do", "i"), ("how", "do", "i"),
+            ("where", "can", "i"), ("how", "can", "i"),
+        }:
+            words = words[3:]
+        return tuple(word for word in words if word != "the")
+
+    requested_control = navigation_words(message)
+    matches = [
+        task
+        for path, _tasks in TASKS.items()
+        if path in visible_paths
+        if (task := match(path, message, permissions)) is not None
+        if not exact_only or navigation_words(task.label) == requested_control
+    ]
+    # A broad phrase can fit several different page tasks. Leave those to the
+    # normal page guide so Copilot never sends someone to an arbitrary control.
+    return matches[0] if len(matches) == 1 else None
+
