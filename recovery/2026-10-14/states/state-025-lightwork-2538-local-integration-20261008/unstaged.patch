+def rotate_trigger_direct_address(request: Request, name: str) -> dict:
+    """Issue a new one-time copyable address for an existing trigger.
+
+    Only the digest is retained. Rotation immediately invalidates the previous
+    address, and owner-scoped users can rotate only their own trigger.
+    """
+    require_permission(request, "operate")
+    _require_triggers()
+    from maverick_dashboard import triggers_store
+
+    token = secrets.token_urlsafe(32)
+    digest = hashlib.sha256(token.encode("ascii")).hexdigest()
+    _audit_trigger_change(request, "workflow_webhook_address_rotation_requested", trigger_name=name)
+    if not triggers_store.rotate_direct_token(name, digest, owner=goal_owner_filter(request)):
+        raise HTTPException(status_code=404, detail="no trigger with that name")
+    return {"name": name, "direct_webhook_url": f"/webhook/trigger/{token}"}
