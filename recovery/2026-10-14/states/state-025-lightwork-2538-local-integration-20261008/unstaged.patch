+def browser_origin_matches(connection, value: str, host: str) -> bool:
+    """Compare a browser Origin/Referer with the externally served origin.
+
+    ASGI already supplies the public scheme when its proxy-header middleware
+    trusts the peer. Proxy-SSO deliberately disables that middleware to keep
+    the real peer IP, so in that case accept X-Forwarded-Proto only from an
+    explicitly trusted proxy. Never let an arbitrary client header upgrade an
+    HTTP request to HTTPS for this CSRF/CSWSH decision.
+    """
+    scheme = str(connection.scope.get("scheme") or "").lower()
+    scheme = {"ws": "http", "wss": "https"}.get(scheme, scheme)
+    if scheme not in {"http", "https"}:
+        return False
+    client = getattr(connection, "client", None)
+    if scheme == "http" and proxy_trusts(getattr(client, "host", None)):
+        forwarded = connection.headers.get("x-forwarded-proto", "").strip().lower()
+        if forwarded == "https":
+            scheme = "https"
+    try:
+        parsed = urlparse(value)
+        return parsed.scheme == scheme and parsed.netloc == host
+    except ValueError:
+        return False
+
