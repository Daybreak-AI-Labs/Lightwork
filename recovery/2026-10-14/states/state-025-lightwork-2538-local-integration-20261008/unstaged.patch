+def _install_studio_handoff_fakes(monkeypatch, client, *, active_version=2, approved=True):
+    from importlib import import_module
+
+    from maverick_dashboard import auth, no_code_grc_studio_api, no_code_grc_studio_composition
+
+    dashboard_app = import_module("maverick_dashboard.app")
+    context = {"tenant_id": "tenant-a", "principal_ref": "operator", "workspace_generation": 3,
+               "workspace_authority": "principal_selection"}
+    digest = "a" * 64
+    binding = {
+        "binding_id": "cloud-evidence", "collector_id": "aws_config_posture_v1",
+        "collector_version": 4, "collector_integrity_sha256": digest, "object_id": "supplier",
+        "control_refs": ["supplier-security"],
+        "field_mappings": [{"source_path": ["findings", "severity"], "target_field_id": "severity"}],
+    }
+    blueprint = {
+        "name_ref": "Supplier assurance", "objects": [{"object_id": "supplier", "label_ref": "Supplier",
+            "fields": [{"field_id": "severity", "label_ref": "Risk level"}]}],
+        "collector_bindings": [binding],
+    }
+    pointer = SimpleNamespace(active_version=active_version, integrity_sha256="b" * 64)
+    current = SimpleNamespace(version=2, state="published", integrity_sha256="c" * 64,
+                              blueprint_sha256="d" * 64, blueprint=blueprint)
+
+    class Store:
+        def get_active(self, tenant, studio):
+            assert tenant == "tenant-a" and studio == "supplier-review"
+            return pointer, current
+
+    store = Store()
+    client.app.state.grc_studio_store_factory = lambda **_kwargs: store
+    source = {
+        "collector_id": binding["collector_id"], "collector_version": binding["collector_version"],
+        "collector_integrity_sha256": digest,
+        "controls": [{"value": "supplier-security", "label": "Supplier security"}],
+        "outputs": [{"path": ["findings", "severity"], "label": "Severity"}],
+    }
+    monkeypatch.setattr(setup, "_source_access", lambda _request, **_kwargs: (None, "tenant-a", "operator", context))
+    monkeypatch.setattr(setup, "_source_controls", lambda: {"supplier-security": "Supplier security"})
+    monkeypatch.setattr(auth, "require_page_permission", lambda *_args: None)
+    monkeypatch.setattr(dashboard_app, "require_page_visible", lambda *_args: None)
+    monkeypatch.setattr(no_code_grc_studio_composition, "grc_studio_enabled", lambda _tenant: True)
+    monkeypatch.setattr(no_code_grc_studio_composition, "principal_ref", lambda *_args: "studio-principal")
+    monkeypatch.setattr(no_code_grc_studio_api, "validate_collector_bindings", lambda *_args: [source] if approved else [])
+    return pointer, context
+
