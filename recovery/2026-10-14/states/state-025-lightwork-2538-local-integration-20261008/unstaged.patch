+    assert engine.ledger.record_event("hit", "wire_transfer", card_id="c1", ts=1.0)
+    assert engine.ledger.record_event("graduate", "wire_transfer", ts=2.0)
+    assert engine.ledger.state("wire_transfer").graduated is True
+
+    path = tmp_path / "trust.ndjson"
+    rows = path.read_text(encoding="utf-8").splitlines()
+    row = json.loads(rows[0])
+    row["kind"] = "miss"  # same byte length, but the saved link no longer matches
+    rows[0] = json.dumps(row, sort_keys=True)
+    path.write_text("\n".join(rows) + "\n", encoding="utf-8")
+
+    decision = engine.decide("wire_transfer", risk="low")
+    assert decision.auto is False
+    assert "could not be verified" in decision.reason
+    assert engine.tracking_integrity() == {
+        "intact": False, "cards_intact": True, "trust_records_intact": False,
