+def test_evidence_for_actions_reduces_one_log_snapshot(tmp_path, monkeypatch):
+    ledger = ea.TrustLedger(path=tmp_path / "trust.ndjson")
+    ledger.record_event("hit", "send_invoice", card_id="c1", predicted=0.9,
+                        actual=1.0, evidence_source="human_feedback", ts=1.0)
+    ledger.record_event("miss", "send_invoice", card_id="c2", predicted=0.9,
+                        actual=0.0, evidence_source="reported_business", ts=2.0)
+    ledger.record_event("hit", "update_record", card_id="c3", predicted=0.8,
+                        actual=1.0, evidence_source="execution_verdict", ts=3.0)
+
+    original_rows = ledger._log.rows
+    reads = 0
+
+    def counted_rows():
+        nonlocal reads
+        reads += 1
+        return original_rows()
+
+    monkeypatch.setattr(ledger._log, "rows", counted_rows)
+    result = ledger.evidence_for_actions(("send_invoice", "update_record"), limit=1)
+
+    assert reads == 1
+    assert result["send_invoice"]["summary"] == {
+        "reported_business": 1, "human_feedback": 1, "execution_verdict": 0,
+        "source_not_recorded": 0, "scored": 2,
