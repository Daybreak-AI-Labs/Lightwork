+    assert retry.status_code == 303
+    assert len([row for row in runs if row[1] and row[1]["detail"].get("dispatch_outcome") == "sending"]) == 2
+    assert SubmissionStore(world).for_goal(uncertain_goal.id)["state"] == "reconciliation_required"
