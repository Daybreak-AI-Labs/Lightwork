+def _json_error_literals(response):
+    status = next((item.value for item in response.keywords if item.arg == "status_code"), None)
+    if status is None and len(response.args) > 1:
+        status = response.args[1]
+    if not isinstance(status, ast.Constant) or not isinstance(status.value, int) or status.value < 400:
+        return ()
+    return tuple(
+        part.value for part in ast.walk(response)
+        if isinstance(part, ast.Constant) and isinstance(part.value, str)
+    )
+
+
+def test_api_error_copy_does_not_send_people_to_host_configuration():
+    package = Path(__file__).parents[1] / "maverick_dashboard"
+    forbidden = feature_gate._HOST_SETUP_SYNTAX
+    leaks = []
+
+    def message_parts(expression):
+        if isinstance(expression, ast.Constant) and isinstance(expression.value, str):
+            yield expression.value
+        elif isinstance(expression, ast.JoinedStr):
+            yield from (
+                part.value for part in expression.values
+                if isinstance(part, ast.Constant) and isinstance(part.value, str)
+            )
+        elif isinstance(expression, ast.IfExp):
+            yield from message_parts(expression.body)
+            yield from message_parts(expression.orelse)
+        elif isinstance(expression, ast.BinOp) and isinstance(expression.op, ast.Add):
+            yield from message_parts(expression.left)
+            yield from message_parts(expression.right)
+
+    for path in package.rglob("*.py"):
+        tree = ast.parse(path.read_text(encoding="utf-8"))
+        for node in ast.walk(tree):
+            if not isinstance(node, ast.Call):
+                continue
+            call_name = ast.unparse(node.func).split(".")[-1]
+            if call_name == "JSONResponse":
+                for value in _json_error_literals(node):
+                    if forbidden.search(value):
+                        leaks.append(f"{path.relative_to(package)}:{node.lineno}: {value}")
+                continue
+            if call_name not in {"HTTPException", "StarletteHTTPException"}:
+                continue
+            detail = next((item.value for item in node.keywords if item.arg == "detail"), None)
+            if detail is None and len(node.args) > 1:
+                detail = node.args[1]
+            if detail is None:
+                continue
+            for part in ast.walk(detail):
+                if (
+                    isinstance(part, ast.Attribute)
+                    and part.attr == "__name__"
+                    and isinstance(part.value, ast.Call)
+                    and ast.unparse(part.value.func) == "type"
+                ):
+                    leaks.append(f"{path.relative_to(package)}:{node.lineno}: exception type in detail")
+            for value in message_parts(detail):
+                if forbidden.search(value):
+                    leaks.append(f"{path.relative_to(package)}:{node.lineno}: {value}")
+    assert not leaks, "Customer-facing API errors expose host setup details:\n" + "\n".join(leaks)
+
