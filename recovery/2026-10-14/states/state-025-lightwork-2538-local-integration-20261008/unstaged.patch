+def _code_practice_outcome(result, *, replay=False):
+    job = result.get("job") if isinstance(result, dict) else None
+    if not isinstance(job, dict):
+        raise HTTPException(503, "The practice task could not be confirmed. Read its original on Learning before retrying.")
+    task_id = job.get("id")
+    if not isinstance(task_id, str) or not re.fullmatch(r"[a-f0-9]{16}", task_id):
+        raise HTTPException(503, "The practice task could not be confirmed. Read its original on Learning before retrying.")
+    state = job.get("state", "unknown")
+    status = "replayed" if replay else "queued" if state in {"queued", "running"} else "confirmed"
+    details = {"practice_task": {"href": "/learning?learning_task=" + task_id + "#learning-job-history",
+                                  "label": "Read practice progress and results"},
+               "objective": (result.get("review") or {}).get("objective"),
+               "practice_rounds": (result.get("review") or {}).get("cycles"),
+               "model": (result.get("review") or {}).get("model"),
+               "spending_limit": (result.get("review") or {}).get("spending_limit"),
+               "installed_automatically": False}
+    summary = "The practice task is saved. Follow its progress in Learning; results are not installed automatically."
+    if isinstance(job.get("result"), dict):
+        output = job["result"]
+        practice_result = {key: output[key] for key in ("ran", "tested", "spent", "problem")
+                           if key in output}
+        rounds = output.get("rounds")
+        if isinstance(rounds, list):
+            practice_result["rounds"] = [
+                {"round": index + 1, "ideas_considered": row["ideas"], "changes_checked": row["tested"]}
+                for index, row in enumerate(rounds[:20])
+                if isinstance(row, dict) and type(row.get("ideas")) is int and row["ideas"] >= 0
+                and type(row.get("tested")) is int and row["tested"] >= 0
+            ]
+        details["practice_result"] = practice_result
+        if job.get("state") in {"done", "failed", "stopped", "not_started"}:
+            status = "replayed" if replay else "confirmed"
+            summary = "The practice task finished. Review its saved proposals and test results in Learning; no code was installed."
+    return Outcome(status, summary, details)
+
+
+def code_practice_run(request, _selection, _arguments, prepared, _operation):
+    from . import learning_ops_api
+
+    body = learning_ops_api.ModifyRunIn(**prepared["body"], token=prepared["token"], confirm=True)
+    result = asyncio.run(learning_ops_api.modify_run(request, body))
+    if "job" not in result:
+        result = {"job": result.get("job")}
+    return _code_practice_outcome(result)
+
+
+def code_practice_recover(request, _selection, _arguments, prepared, _operation, *, read_only=False):
+    from . import learning_ops_api
+
+    try:
+        job = learning_ops_api.jobs.get(prepared["job_id"])
+    except learning_ops_api.jobs.JobRefused as exc:
+        raise HTTPException(503, "The original practice task could not be checked. No work was repeated.") from exc
+    if job is None:
+        return None
+    original = learning_ops_api._modify_original(request, prepared["job_id"])
+    result = {"job": original["job"], "review": original["review"]}
+    return _code_practice_outcome(result, replay=not read_only)
