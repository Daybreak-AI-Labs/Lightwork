 _KEY_CHARS = 512
+_RLS_REVIEW_TTL = 30 * 60
+_RLS_REVIEW_LOCK = threading.Lock()
+_RLS_REVIEWS: dict[str, dict[str, Any]] = {}
+
+_RLS_AREA_LABELS = {
+    "goals": "Work and customer records",
+    "facts": "Saved knowledge",
