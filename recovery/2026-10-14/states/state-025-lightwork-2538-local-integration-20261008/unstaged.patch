+def _flow_test_input_audit(request: Request, action: str, flow_id: str, case_id: str, name: str) -> None:
+    from maverick.audit import EventKind, audit_event
+
+    audit_event(
+        EventKind.FLOW_TEST_INPUT_CHANGED,
+        agent=caller_principal(request) or "local operator",
+        action=action,
+        flow_id=flow_id,
+        case_id=case_id,
+        name=name[:80],
+    )
