+    return flow_id, flow, cases, case_revision, open_href, revision
+
+
+def workflow_test_examples_snapshot(request, selection):
+    flow_id, flow, cases, case_revision, open_href, revision = _test_examples_material(request, selection)
+    count = len(cases)
+    summary = (
+        f"{count} saved example{'s' if count != 1 else ''} for “{str(flow.get('name') or 'this workflow')[:160]}”. "
+        "Open the examples to add or remove one. Runs use a safe simulation and do not contact an AI service or connected app."
+    )
+    blocked = "" if count else "Save an example in Test examples before asking Copilot to run one."
+    return Snapshot(
+        revision,
+        "Current saved workflow and examples",
+        summary,
+        details={"open": {"href": open_href, "label": "Open Test examples"}},
+        blocked=blocked,
+    )
+
+
+def workflow_test_examples_prepare(request, selection, _arguments):
+    state = workflow_test_examples_snapshot(request, selection)
+    return Preview(state.summary, native=state.details)
+
+
+def workflow_test_examples_run_snapshot(request, selection):
+    flow_id, flow, cases, case_revision, open_href, revision = _test_examples_material(request, selection)
+    title = str(flow.get("name") or "this workflow")[:160]
+    if not cases:
+        return Snapshot(
+            revision,
+            "Current saved workflow",
+            "There are no saved examples for “" + title + "” yet.",
+            details={"open": {"href": open_href, "label": "Open Test examples"}},
+            blocked="Save an example in Test examples before asking Copilot to run one.",
+        )
+    choices = [{"label": row["name"], "value": row["id"]} for row in cases]
+    fields = [{"name": "case_ids", "label": "Saved examples", "kind": "multiselect",
+               "presentation": "checkboxes", "choices": choices,
+               "value": [row["id"] for row in cases]}]
+    if flow.get("published") and flow.get("published_revision"):
+        fields.append({"name": "compare_to_published", "label": "Compare with the published workflow too",
+                       "kind": "boolean", "value": False})
+    return Snapshot(
+        revision,
+        "Current saved workflow and examples",
+        "Choose saved examples to test against “" + title + "”. Safe simulations do not contact an AI service or connected app, and do not prove the answers are correct.",
+        details={"open": {"href": open_href, "label": "Review or change saved examples"}},
+        fields=fields,
+    )
+
+
+def workflow_test_examples_run_prepare(request, selection, arguments):
+    flow_id, flow, cases, case_revision, _open_href, revision = _test_examples_material(request, selection)
+    if not cases:
+        raise HTTPException(409, "Save an example in Test examples before asking Copilot to run one.")
+    selected_ids = arguments.get("case_ids")
+    if (not isinstance(selected_ids, list) or not 1 <= len(selected_ids) <= 20
+            or any(not isinstance(identity, str) for identity in selected_ids)
+            or len(set(selected_ids)) != len(selected_ids)):
+        raise HTTPException(422, "Choose each saved example once.")
+    compare_to_published = arguments.get("compare_to_published", False)
+    if type(compare_to_published) is not bool:
+        raise HTTPException(422, "Choose whether to compare with the published workflow.")
+    expected_release_id = str(flow.get("published_revision") or "") if compare_to_published else ""
+    if compare_to_published and (not flow.get("published") or not expected_release_id):
+        raise HTTPException(409, "Publish a workflow version before comparing it with this draft.")
+    by_id = {row["id"]: row for row in cases}
+    selected = [by_id.get(identity) for identity in selected_ids]
+    if any(row is None for row in selected):
+        raise HTTPException(409, "A saved example changed. Refresh and review the current list.")
+    if not isinstance(flow.get("version"), int) or flow["version"] < 0 or not isinstance(flow.get("revision", ""), str):
+        raise HTTPException(409, "The saved workflow version could not be confirmed. Reopen it and try again.")
+    names = [row["name"] for row in selected]
+    return Preview(
+        (f"Compare {len(selected)} saved example{'s' if len(selected) != 1 else ''} against the published workflow and current draft. Both are safe simulations; no AI service or connected app is contacted, and Lightwork does not decide whether a difference is a regression."
+         if compare_to_published else
+         f"Run {len(selected)} saved example{'s' if len(selected) != 1 else ''} through the current saved draft. This is a safe simulation; it does not contact an AI service or connected app and does not prove answer quality."),
+        [{"item": "Examples", "effect": ", ".join(names)},
+         *([{"item": "Compare with published workflow", "effect": "Yes; exact release reviewed"}] if compare_to_published else [])],
+        native={
+            "flow_id": flow_id,
+            "flow_version": flow["version"],
+            "flow_revision": flow.get("revision", ""),
+            "case_set_revision": case_revision,
+            "case_ids": selected_ids,
+            "batch_id": secrets.token_hex(16),
+            "compare_to_published": compare_to_published,
+            "expected_published_release_id": expected_release_id,
+            "snapshot_revision": revision,
+        },
+    )
+
+
+def workflow_test_examples_run_execute(request, selection, _arguments, prepared, _operation_id):
+    flow_id = _flow_id(selection)
+    required = {"flow_id", "flow_version", "flow_revision", "case_set_revision", "case_ids", "batch_id",
+                "compare_to_published", "expected_published_release_id", "snapshot_revision"}
+    if (not isinstance(prepared, dict) or set(prepared) != required or prepared["flow_id"] != flow_id
+            or not isinstance(prepared["flow_version"], int) or prepared["flow_version"] < 0
+            or not isinstance(prepared["flow_revision"], str)
+            or not isinstance(prepared["case_set_revision"], str)
+            or not isinstance(prepared["case_ids"], list) or not 1 <= len(prepared["case_ids"]) <= 20
+            or type(prepared["compare_to_published"]) is not bool
+            or not isinstance(prepared["expected_published_release_id"], str)
+            or any(not isinstance(identity, str) or not re.fullmatch(r"[0-9a-f]{32}", identity)
+                   for identity in prepared["case_ids"])
+            or len(set(prepared["case_ids"])) != len(prepared["case_ids"])
+            or not re.fullmatch(r"[0-9a-f]{64}", prepared["case_set_revision"])
+            or not isinstance(prepared["batch_id"], str) or not re.fullmatch(r"[0-9a-f]{32}", prepared["batch_id"])):
+        raise HTTPException(409, "This test review could not be confirmed. Refresh and review the examples again.")
+    current = workflow_test_examples_run_snapshot(request, selection)
+    flow = native.get_flow_endpoint(request, flow_id)
+    from . import flow_test_inputs
+
+    cases, case_revision = flow_test_inputs.case_snapshot(
+        flow_id, flow_revision=flow["revision"], owner=flow.get("owner") or ""
+    )
+    selected_ids = prepared["case_ids"]
+    if (current.revision != prepared["snapshot_revision"]
+            or flow.get("version") != prepared["flow_version"]
+            or (flow.get("revision") or "") != prepared["flow_revision"]
+            or case_revision != prepared["case_set_revision"]
+            or (prepared["compare_to_published"] and flow.get("published_revision") != prepared["expected_published_release_id"])
+            or (not prepared["compare_to_published"] and prepared["expected_published_release_id"] != "")
+            or any(identity not in {row["id"] for row in cases} for identity in selected_ids)):
+        raise HTTPException(409, "The workflow or its saved examples changed. Refresh and review them before testing.")
+    body = native.FlowTestInputRunIn(
+        flow=flow,
+        case_ids=selected_ids,
+        case_set_revision=case_revision,
+        batch_id=prepared["batch_id"],
+        expected_flow_version=prepared["flow_version"],
+        expected_flow_revision=prepared["flow_revision"],
+        compare_to_published=prepared["compare_to_published"],
+        expected_published_release_id=(prepared["expected_published_release_id"] or None),
+    )
+    result = native.run_flow_test_inputs_endpoint(request, flow_id, body)
+    rows = result.get("results", [])
+    if result.get("dry_run") is not True or len(rows) != len(selected_ids):
+        return Outcome("unconfirmed", "The test results could not all be confirmed. Check workflow progress before trying again.")
+    links = []
+    for row in rows:
+        if prepared["compare_to_published"]:
+            published_run = row.get("published") if isinstance(row, dict) else None
+            draft_run = row.get("draft") if isinstance(row, dict) else None
+            if (not isinstance(published_run, dict) or not isinstance(draft_run, dict)
+                    or row.get("dry_run") is not True or published_run.get("dry_run") is not True
+                    or draft_run.get("dry_run") is not True or not published_run.get("run_id")
+                    or not draft_run.get("run_id")):
+                return Outcome("unconfirmed", "The paired test results could not all be confirmed. Check workflow progress before trying again.")
+            for label, run in (("published", published_run), ("draft", draft_run)):
+                links.append({"label": "Review " + str(row["name"])[:60] + " — " + label,
+                              "href": "/flows/" + quote(flow_id, safe="") + "/runs/" + quote(str(run["run_id"]), safe="")})
+        else:
+            if not isinstance(row, dict) or row.get("dry_run") is not True or not row.get("run_id"):
+                return Outcome("unconfirmed", "The test results could not all be confirmed. Check workflow progress before trying again.")
+            links.append({"label": "Review " + str(row["name"])[:80],
+                          "href": "/flows/" + quote(flow_id, safe="") + "/runs/" + quote(str(row["run_id"]), safe="")})
+    return Outcome(
+        "confirmed",
+        (f"Started {len(rows)} pairs of safe tests. Review the published and draft runs to compare their paths."
+         if prepared["compare_to_published"] else
+         f"Started {len(links)} safe workflow test{'s' if len(links) != 1 else ''}. Review each run to see which steps it reached."),
+        {"runs": links},
+    )
+
+
+def workflow_draft_snapshot(request, selection):
