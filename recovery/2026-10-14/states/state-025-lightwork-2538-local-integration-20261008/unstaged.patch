+    "goal_domain_profile_snapshots": "Work details",
+}
+
+
+def _rls_store():
+    from maverick.world_model_backends import pg_rls
+    return pg_rls
+
+
+def _rls_dsn() -> str:
+    from maverick.world_model_backends.postgres import is_postgres_configured
+
+    if not is_postgres_configured():
+        raise HTTPException(409, "The shared database is not set up as this installation's record store.")
+    dsn = _rls_store().resolve_dsn()
+    if not dsn:
+        raise HTTPException(409, "The shared database is not configured for this installation.")
+    return dsn
+
+
+def _rls_preflight_report(dsn: str) -> dict[str, Any]:
+    module = _rls_store()
+    connection = module.connect(dsn, autocommit=True)
+    try:
+        return module.preflight(connection)
+    finally:
+        connection.close()
+
+
+def _rls_preview_counts(dsn: str, workspace_id: str) -> dict[str, int]:
+    module = _rls_store()
+    connection = module.connect(dsn, autocommit=False)
+    try:
+        return module.preview_backfill(connection, workspace_id)
+    except module.ProtectionAlreadyActive as exc:
+        raise HTTPException(
+            409, "Database protection is already active. Older records hidden by its policies "
+                 "cannot be safely reviewed here. Ask your database administrator to verify them."
+        ) from exc
+    finally:
+        connection.close()
+
+
+def _active_workspace(workspace_id: str):
+    from maverick.tenant.registry import get_tenant
+    workspace = get_tenant(workspace_id)
+    if workspace is None or workspace.status != "active":
+        raise HTTPException(422, "Choose an active workspace. No records were changed.")
+    return workspace
+
+
+def _rls_areas(counts: dict[str, int] | None = None,
+               report: dict[str, Any] | None = None) -> list[dict[str, Any]]:
+    from maverick.world_model_backends.postgres import _RLS_TABLES
+
+    grouped: dict[str, dict[str, Any]] = {}
+    for table in _RLS_TABLES:
+        label = _RLS_AREA_LABELS.get(table, "Other saved records")
+        area = grouped.setdefault(label, {"name": label, "records": 0,
+                                          "needs_attention": False, "counts_visible": True})
+        if counts is not None:
+            area["records"] += int(counts.get(table, 0))
+        if report is not None:
+            table_report = report.get("tables", {}).get(table, {})
+            null_rows = table_report.get("null_tenant_rows", 0)
+            empty_rows = table_report.get("empty_tenant_rows", 0)
+            if null_rows is None or empty_rows is None:
+                area["counts_visible"] = False
+            else:
+                area["records"] += int(null_rows) + int(empty_rows)
+            area["needs_attention"] = bool(
+                area["needs_attention"] or table_report.get("missing")
+                or (not table_report.get("rls_active")
+                    and not table_report.get("owned_by_current_role", False))
+                or (null_rows is not None and null_rows)
+                or (empty_rows is not None and empty_rows)
+            )
+        if counts is not None and area["records"]:
+            area["needs_attention"] = True
+    areas = []
+    for area in grouped.values():
+        if not area["counts_visible"]:
+            area["records"] = None
+        if area["records"] or area["needs_attention"] or not area["counts_visible"]:
+            areas.append(area)
+    return areas
+
+
+def _plain_rls_preflight(report: dict[str, Any]) -> dict[str, Any]:
+    areas = _rls_areas(report=report)
+    legacy = sum(int(area["records"] or 0) for area in areas)
+    missing = sum(bool(item.get("missing")) for item in report.get("tables", {}).values())
+    ownership = sum(not bool(item.get("owned_by_current_role")) and not item.get("missing")
+                    for item in report.get("tables", {}).values())
+    ready = bool(report.get("ready"))
+    protection_active = bool(report.get("protection_active"))
+    counts_visible = bool(report.get("legacy_counts_visible", True))
+    if protection_active:
+        summary = ("Workspace-level database protection is active. The protected connection cannot count "
+                   "older records hidden by its active policies.")
+    elif not counts_visible:
+        summary = ("Some older-record counts are hidden by a partially active database policy. Ask the "
+                   "database administrator to review protection before assigning records.")
+    elif ready:
+        summary = "Every saved area is ready for workspace-level database protection."
+    else:
+        parts = []
+        if legacy:
+            parts.append(f"{legacy:,} older record{'s' if legacy != 1 else ''} need a workspace")
+        if missing:
+            parts.append("some saved areas have not been set up yet")
