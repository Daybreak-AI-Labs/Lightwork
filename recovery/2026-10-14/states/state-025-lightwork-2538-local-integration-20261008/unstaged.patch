+    })
+    token = review.json()["token"]
+    claimed = {"value": False}
+    original_claim = SubmissionStore.claim_dispatch
+    original_check = api._check_effect_guard
+
+    def remember_claim(self, key, **kwargs):
+        result = original_claim(self, key, **kwargs)
+        claimed["value"] = claimed["value"] or result
+        return result
+
+    def refuse_after_claim(guard):
+        if claimed["value"]:
+            raise HTTPException(409, "Access changed before the task was dispatched.")
+        return original_check(guard)
+
+    monkeypatch.setattr(SubmissionStore, "claim_dispatch", remember_claim)
+    monkeypatch.setattr(api, "_check_effect_guard", refuse_after_claim)
+    refused = client.post(BASE + "/execute", json={"token": token, "confirmed": True})
+    assert refused.status_code == 409
+    assert refused.json()["detail"]["code"] == "task_not_started"
+    goal = world.list_goals()[0]
+    receipt = SubmissionStore(world).for_goal(goal.id)
+    assert goal.status == "draft"
+    assert receipt["state"] == "ready"
+    assert not runs
+
+    monkeypatch.setattr(api, "_check_effect_guard", original_check)
+    replayed = client.post(BASE + "/execute", json={"token": token, "confirmed": True})
+    assert replayed.status_code == 200, replayed.text
+    assert replayed.json()["status"] == "queued"
