+def _successful_execution(run, *, definitions=()):
+    """Accept completed native control steps without mistaking them for failure.
+
+    Branches, switches and approvals report their chosen path as the node status;
+    they do not use the generic ``done`` status. The saved run's definition bundle
+    tells us which path statuses are valid for each node.
+    """
+    if run.status != runner.STATUS_COMPLETED or run.error or not run.nodes:
+        return False
+    nodes_by_id = {}
+    ambiguous_ids = set()
+    for flow in definitions:
+        for node in flow.nodes.values():
+            if node.id in nodes_by_id:
+                ambiguous_ids.add(node.id)
+            else:
+                nodes_by_id[node.id] = node
+    for node_id, row in run.nodes.items():
+        if not isinstance(row, dict):
+            return False
+        status, outcome = row.get("status"), row.get("outcome")
+        if node_id in ambiguous_ids:
+            if status == "done" and outcome in (None, 1.0):
+                continue
+            return False
+        node = nodes_by_id.get(node_id)
+        if node is None:
+            return False
+        if (
+            node.kind not in {NODE_BRANCH, NODE_SWITCH, NODE_APPROVAL}
+            and status == "done"
+            and outcome in (None, 1.0)
+        ):
+            continue
+        if node.kind == NODE_BRANCH and status in {"true", "false"} and outcome is None:
+            continue
+        if (
+            node.kind == NODE_SWITCH
+            and outcome is None
+            and (
+                status == "default"
+                or isinstance(status, str) and status.startswith("case:")
+            )
+        ):
+            continue
+        if node.kind == NODE_APPROVAL:
+            if status == "approved" and outcome == 1.0:
+                continue
+            if status in node.choices and status != "rejected" and outcome is None:
+                continue
+        return False
+    return True
 
 
