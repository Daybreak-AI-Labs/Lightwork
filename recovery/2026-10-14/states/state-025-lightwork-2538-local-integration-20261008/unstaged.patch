+def test_authority_change_after_claim_leaves_task_recoverable_without_dispatch(task_actions, monkeypatch):
+    from maverick.attachment_submissions import SubmissionStore
+
+    client, world, runs, _principal = task_actions
+    catalog = _catalog(client)
