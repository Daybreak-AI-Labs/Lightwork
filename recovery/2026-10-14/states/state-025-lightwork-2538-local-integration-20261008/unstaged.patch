+def page_for_api_path(path: str) -> dict | None:
+    """Return the registered page whose role floor protects a backing API.
+
+    The app-wide authorization dependency uses this for every HTTP method, so
+    a new read or mutation added below one of these known API families inherits
+    a page floor automatically. API aliases are normalized first, then the
+    most-specific registered subpage wins; unrecognized subpaths inherit their
+    protected family root. Unrelated APIs and public/self-authenticated routes
+    return ``None``.
+    """
+    if not isinstance(path, str) or not path.startswith("/api/v1/"):
+        return None
+    page_path = path[len("/api/v1"):]
+    for alias, canonical in _API_PAGE_ALIASES:
+        if page_path == alias or page_path.startswith(alias + "/"):
+            page_path = canonical + page_path[len(alias):]
+            break
+    root = next((candidate for candidate in _API_PAGE_ROOTS
+                 if page_path == candidate or page_path.startswith(candidate + "/")), None)
+    if root is None:
+        return None
+    return page_for(page_path) or page_for(root)
+
