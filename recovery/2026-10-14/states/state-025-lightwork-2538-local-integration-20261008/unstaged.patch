+def test_enforcement_checks_the_receipt_chain_even_when_the_changed_row_is_resealed(
+    store: ConsentPreferenceStore,
+) -> None:
+    _policy(store)
+    _profile(store)
+    _record(store)
+    second = _record(
+        store, action="deny", expected_revision=1, idem="preference-002"
+    )
+    tampered = dict(second)
+    tampered["previous_receipt_sha256"] = DIGEST_D
+    body = {key: value for key, value in tampered.items() if key != "receipt_sha256"}
+    tampered_sha = hashlib.sha256(
+        json.dumps(
+            body, sort_keys=True, separators=(",", ":"), ensure_ascii=True, allow_nan=False
+        ).encode("ascii")
+    ).hexdigest()
+
+    with sqlite3.connect(store.path) as connection:
+        connection.execute("DROP TRIGGER consent_receipts_no_update")
+        connection.execute(
+            "UPDATE consent_receipts SET previous_receipt_sha256 = ?, receipt_sha256 = ? "
+            "WHERE tenant = ? AND receipt_id = ?",
+            (DIGEST_D, tampered_sha, "tenant-a", second["receipt_id"]),
+        )
+
+    # The edited row's own digest is internally consistent; only checking its
+    # position in the per-profile chain exposes the rewrite.
+    assert store.get_receipt("tenant-a", second["receipt_id"])["receipt_sha256"] == tampered_sha
+    decision = store.decide(
+        "tenant-a", "profile-001", "analytics", policy_id="privacy-notice"
+    )
+    assert decision.allowed is False
+    assert decision.reason == "untrusted_receipt"
