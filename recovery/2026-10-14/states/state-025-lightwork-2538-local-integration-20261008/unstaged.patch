+def test_private_flow_assessments_follow_exact_owner_even_for_admins(monkeypatch, tmp_path):
+    import importlib
+
+    from maverick import assessments, config
+    from maverick.flow import store
+    from maverick.flow.ir import Flow, FlowNode
+    from maverick_dashboard import rbac
+
+    _isolate(monkeypatch, tmp_path)
+    monkeypatch.setenv("MAVERICK_FLOWS", "1")
+    config.reset_config_cache()
+    for flow_id, owner in (("alice-private", "user:alice"), ("bob-private", "user:bob")):
+        store.save_flow(Flow(
+            id=flow_id, name=f"{owner}'s confidential workflow", start="a", owner=owner,
+            nodes={"a": FlowNode(id="a", kind="agent", brief="Private work")},
+        ))
+        assert assessments.refresh("flow", flow_id) is not None
+
+    def client_as(principal):
+        for module in ("maverick_dashboard.app", "maverick_dashboard.api", "maverick_dashboard.auth"):
+            monkeypatch.setattr(importlib.import_module(module), "caller_principal", lambda _request: principal)
+        rbac.set_role(principal, "admin")
+        return _client()
+
+    alice = client_as("user:alice")
+    assert "alice-private" in alice.get("/assessments").text
+    assert "bob-private" not in alice.get("/assessments").text
+    listing = alice.get("/api/v1/assessments").json()
+    assert {row["subject"] for row in listing["assessments"] if row["kind"] == "flow"} == {"alice-private"}
+    assert {row["subject"] for row in listing["due"] if row["kind"] == "flow"} == {"alice-private"}
+    assert "bob-private" not in alice.get("/api/v1/assessments/export?format=csv").text
+    assert "bob-private" not in alice.get("/api/v1/assessments/export").text
+    assert alice.get("/api/v1/assessments/flow/bob-private").status_code == 404
+    assert alice.post("/api/v1/assessments/flow/bob-private/refresh", json={"expected_revision": 1}).status_code == 404
+    assert alice.post("/api/v1/assessments/flow/bob-private/review", json={
+        "expected_revision": 1, "lens": "privacy", "decision": "accepted",
+    }).status_code == 404
+    assert alice.delete("/api/v1/assessments/flow/bob-private", params={"expected_revision": 1}).status_code == 404
+    before_bob = assessments.get_assessment("flow", "bob-private")["revision"]
+    assert alice.post("/api/v1/assessments/sweep").status_code == 200
+    assert assessments.get_assessment("flow", "bob-private")["revision"] == before_bob
+
+    bob = client_as("user:bob")
+    assert "bob-private" in bob.get("/assessments").text
+    assert bob.get("/api/v1/assessments/flow/bob-private").status_code == 200
+    assert bob.get("/api/v1/assessments/flow/alice-private").status_code == 404
+
+    # A saved assessment outlives a deleted definition; reusing the ID must
+    # never make its old title, findings, or review evidence the new owner's.
+    prior_key = assessments._key("flow", "bob-private")
+    assert store.delete_flow("bob-private") is True
+    store.save_flow(Flow(
+        id="bob-private", name="Alice's newly named flow", start="a", owner="user:alice",
+        nodes={"a": FlowNode(id="a", kind="agent", brief="New work")},
+    ))
+    alice = client_as("user:alice")
+    assert "bob-private" not in alice.get("/api/v1/assessments").text
+    assert "bob-private" not in alice.get("/api/v1/assessments/export").text
+    assert alice.get("/api/v1/assessments/flow/bob-private").status_code == 404
+    assert alice.post("/api/v1/assessments/flow/bob-private/refresh", json={
+        "expected_revision": 0,
+    }).status_code == 200
+    assert assessments.get_assessment("flow", "bob-private")["owner"] == "user:alice"
+    assert assessments._load_all()[prior_key]["owner"] == "user:bob"
+    assert prior_key != assessments._key("flow", "bob-private")
+    active_revision = assessments.get_assessment("flow", "bob-private")["revision"]
+    assessments.sweep_due()
+    assert assessments.get_assessment("flow", "bob-private")["revision"] > active_revision
+    assert assessments._load_all()[prior_key]["revision"] == before_bob
+
+    # Old unbound records stay in the register for audit recovery, but are
+    # neither shown nor merged into a new generation's assessment.
+    legacy = assessments._load_all()
+    legacy["flow:bob-private"] = dict(legacy[prior_key])
+    legacy["flow:bob-private"].pop("owner")
+    legacy["flow:bob-private"].pop("flow_revision")
+    assessments._save_all(legacy)
+    listing = alice.get("/api/v1/assessments").json()["assessments"]
+    assert len([row for row in listing if row["subject"] == "bob-private"]) == 1
+    assert len([row for row in assessments.list_assessments() if row["subject"] == "bob-private"]) == 1
+
+
+def test_flow_assessment_write_stops_when_same_owner_recreates_the_flow(monkeypatch, tmp_path):
+    import importlib
+
+    from maverick import assessments, config
+    from maverick.flow import store
+    from maverick.flow.ir import Flow, FlowNode
+    from maverick_dashboard import rbac
+
+    _isolate(monkeypatch, tmp_path)
+    monkeypatch.setenv("MAVERICK_FLOWS", "1")
+    config.reset_config_cache()
+
+    def flow():
+        return Flow(id="replaced-flow", name="Replacement", start="a", owner="user:alice",
+                    nodes={"a": FlowNode(id="a", kind="agent", brief="Private work")})
+
+    store.save_flow(flow())
+    old_key = assessments._key("flow", "replaced-flow")
+    assessments.refresh("flow", "replaced-flow")
+    for module in ("maverick_dashboard.app", "maverick_dashboard.api", "maverick_dashboard.auth"):
+        monkeypatch.setattr(importlib.import_module(module), "caller_principal", lambda _request: "user:alice")
+    rbac.set_role("user:alice", "admin")
+
+    original_refresh = assessments.refresh
+
+    def recreate_then_refresh(*args, **kwargs):
+        assert store.delete_flow("replaced-flow") is True
+        store.save_flow(flow())
+        return original_refresh(*args, **kwargs)
+
+    monkeypatch.setattr(assessments, "refresh", recreate_then_refresh)
+    response = _client().post("/api/v1/assessments/flow/replaced-flow/refresh", json={
+        "expected_revision": 0,
+    })
+    assert response.status_code == 409
+    assert assessments._key("flow", "replaced-flow") != old_key
+    assert assessments.get_assessment("flow", "replaced-flow") is None
+    assert old_key in assessments._load_all()
+
