+_API_PAGE_ALIASES: tuple[tuple[str, str], ...] = (
+    ("/dashboards/security", "/security"),
+    ("/dashboards/privacy", "/privacy"),
+    ("/dashboards/finance", "/finance"),
+    ("/finance-operations", "/finance"),
