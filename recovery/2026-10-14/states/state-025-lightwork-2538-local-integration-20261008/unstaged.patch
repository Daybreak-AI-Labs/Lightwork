+def test_domain_filter_reads_one_fresh_grant_snapshot_per_operation(monkeypatch):
+    from maverick import domain
+    from maverick_dashboard import auth
+
+    snapshots = [frozenset({"finance"}), frozenset({"privacy"})]
+    reads = []
+
+    def current_grant(request):
+        reads.append(request)
+        return snapshots.pop(0)
+
+    monkeypatch.setattr(auth, "caller_suites", current_grant)
+    monkeypatch.setattr(domain, "suites_for_domain", lambda name: {
+        "finance": frozenset({"finance"}),
+        "privacy": frozenset({"privacy"}),
+        "hybrid": frozenset({"finance", "privacy"}),
+        "generic": frozenset(),
+    }[name])
+
+    first_request = object()
+    first_operation = auth.domain_suites_filter(first_request)
+    assert first_operation("finance")
+    assert not first_operation("privacy")
+    assert not first_operation("hybrid")
+    assert first_operation("generic")
+    assert reads == [first_request]
+
+    second_request = object()
+    second_operation = auth.domain_suites_filter(second_request)
+    assert second_operation("privacy")
+    assert not second_operation("finance")
+    assert reads == [first_request, second_request]
+
+
+def test_goal_access_filter_reuses_scope_for_copied_sources(monkeypatch):
+    from types import SimpleNamespace
+
+    from maverick import chat_message_actions, domain
+    from maverick_dashboard import _shared, auth
+    from starlette.requests import Request
+
+    request = Request({"type": "http", "method": "GET", "path": "/chat/goal/1", "headers": []})
+    current = SimpleNamespace(id=1, owner="user:alice", domain="finance_ap")
+    copied_source = SimpleNamespace(id=2, owner="user:alice", domain="finance_ap")
+
+    class World:
+        @staticmethod
+        def list_attachments(_goal_id):
+            return []
+
+    grant_reads = []
+    monkeypatch.setattr(auth, "_authorization_principal", lambda _request: "user:alice")
+    monkeypatch.setattr(auth, "caller_suites", lambda _request: grant_reads.append(True) or frozenset({"finance"}))
+    monkeypatch.setattr(domain, "suites_for_domain", lambda _name: frozenset({"finance"}))
+    monkeypatch.setattr(_shared, "_world", lambda: World())
+    monkeypatch.setattr(chat_message_actions, "require_copy_sources",
+                        lambda _world, _goal_id, *, authorize: authorize(copied_source))
+
+    allowed = auth.goal_access_filter(request)
+
+    assert allowed(current)
+    assert grant_reads == [True]
+
