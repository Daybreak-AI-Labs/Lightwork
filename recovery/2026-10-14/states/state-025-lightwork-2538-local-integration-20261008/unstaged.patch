+test("a workspace change in another tab invalidates workspace-scoped page data", async () => {
+  const dom = new JSDOM(`<!doctype html><html><head>
+    <meta name="lightwork-workspace-tenant" content="workspace-a">
+  </head><body><main id="content"><p>Private workspace data</p></main></body></html>`, {
+    url: "https://lightwork.test/overview", runScripts: "outside-only"
+  });
+  const { window: w } = dom;
+  w.matchMedia = () => ({ matches: false, addEventListener() {}, removeEventListener() {} });
+  w.Request = Request;
+  w.Headers = Headers;
+  const calls = [];
+  w.fetch = async (url, options) => { calls.push({ url, options }); return { ok: true, status: 204 }; };
+  w.eval(source);
+  let genericChanges = 0;
+  let workspaceChanges = 0;
+  w.addEventListener("lightwork:context-changed", () => genericChanges++);
+  w.document.addEventListener("lightwork:workspace-changed", () => workspaceChanges++);
+
+  await w.fetch("/api/v1/example", { method: "POST", body: "first" });
+  assert.equal(calls[0].options.headers.get("X-Lightwork-Expected-Tenant"), "workspace-a");
+  w.dispatchEvent(new w.StorageEvent("storage", {
+    key: "lightwork-workspace-changed", newValue: "1730000000000"
+  }));
+
+  assert.equal(genericChanges, 1);
+  assert.equal(workspaceChanges, 1);
+  assert.match(w.document.querySelector('[role="alert"]').textContent, /workspace changed in another tab/i);
+  await assert.rejects(w.fetch("/api/v1/example", { method: "POST", body: "second" }), /Workspace changed/);
+  assert.equal(calls.length, 1, "no write reaches the network after the workspace changes");
+  w.close();
+});
