+async function setCopilotActions(page, enabled) {
+  await page.goto('/settings#settings-features');
+  await page.locator('#feature-copilot_operations').getByRole('link', {name: 'Review choice'}).click();
+  const row = page.locator('[data-setting-id="features.copilot_operations"]');
+  const toggle = row.getByRole('switch');
+  const before = await toggle.isChecked();
+  if (before !== enabled) {
+    if (enabled) await toggle.check(); else await toggle.uncheck();
+    await row.locator('[data-save]').click();
+    const review = page.getByRole('dialog', {name: 'Review setting changes'});
+    await review.getByRole('button', {name: 'Use reviewed changes'}).click();
+    await expect(row.locator('[data-row-status]')).toHaveText('Saved.');
+  }
+  return before;
+}
+
+test('Copilot can read and safely change the self-improvement experiment from Learning', async ({page, context, baseURL}) => {
+  const origin = new URL(baseURL).origin;
+  await context.route('**/*', route => new URL(route.request().url()).origin === origin
+    ? route.continue() : route.abort());
+  const priorCopilotSetting = await setCopilotActions(page, true);
+  try {
+    await page.goto('/learning');
+    await page.locator('#mv-copilot-fab').click();
+    const controls = page.locator('#mv-product-operation-buttons');
+    const form = page.locator('#mv-product-operation-form');
+    await controls.getByRole('button', {name: 'Check Lightwork improvement experiment', exact: true}).click();
+    await form.getByRole('button', {name: 'Check current status', exact: true}).click();
+    await expect(form).toContainText('The Lightwork improvement research experiment is');
+
+    const change = async target => {
+      await controls.getByRole('button', {name: 'Turn the Lightwork improvement experiment on or off', exact: true}).click();
+      const setting = form.getByRole('checkbox', {name: target ? 'Turn on the research experiment' : 'Turn off the research experiment', exact: true});
+      if (target) await setting.check(); else await setting.uncheck();
+      await form.getByRole('button', {name: 'Review change', exact: true}).click();
+      await expect(form).toContainText('does not start an experiment cycle');
+      await expect(form).toContainText('nothing is installed automatically');
+      await form.getByRole('checkbox', {name: 'I reviewed these exact changes and want to apply them.', exact: true}).check();
+      await form.getByRole('button', {name: 'Apply reviewed change', exact: true}).click();
+      await expect(form).toContainText(target ? 'research experiment is on' : 'research experiment is off');
+      await expect(form).toContainText(target ? /never installs changes automatically|Nothing has been installed/i : 'Nothing is running');
+    };
+
+    await controls.getByRole('button', {name: 'Turn the Lightwork improvement experiment on or off', exact: true}).click();
+    const initialSetting = await form.getByRole('checkbox').isChecked();
+    await change(!initialSetting);
+    await change(initialSetting);
+  } finally {
+    await setCopilotActions(page, priorCopilotSetting);
+  }
+});
