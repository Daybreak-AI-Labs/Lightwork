+    state = {
+        "requested": False,
+        "state": "off",
+        "ready": False,
+        "control_managed": False,
+        "managed_by": None,
+        "blockers": [{"code": "editable_surface_missing", "message": "internal config detail"}],
+    }
+    calls = []
+    auth_checks = []
+
+    def set_experiment(_request, payload):
+        calls.append(payload.enabled)
+        state["requested"] = payload.enabled
+        state["state"] = "blocked" if state["blockers"] else ("ready" if payload.enabled else "off")
+        state["ready"] = state["state"] == "ready"
+        return {"dgm": {
+            "requested": state["requested"], "state": state["state"],
+            "ready": state["ready"], "blockers": [
+                {"message": "Choose which parts of Lightwork it may practise changing in Settings."}
+                for _ in state["blockers"]
+            ],
+        }}
+
+    monkeypatch.setattr(learning.auth, "require_global_permission",
+                        lambda _request, permission: auth_checks.append(permission))
+    monkeypatch.setattr(dashboard_app, "require_page_visible", lambda _request, page: page == "/learning")
+    monkeypatch.setattr("maverick.self_modify.production_status", lambda: dict(state))
+    monkeypatch.setattr(api, "set_dgm_endpoint", set_experiment)
+    monkeypatch.setattr(ops, "_same_origin", lambda _request: None)
+    monkeypatch.setattr(ops, "_read_gate", lambda _request: None)
+    monkeypatch.setattr(ops, "_gate", lambda _request: None)
+    monkeypatch.setattr(ops, "_writes_enabled", lambda _request: True)
+    monkeypatch.setattr(ops, "_context", lambda _request: "a" * 64)
+    monkeypatch.setattr(ops, "enabled_families", lambda: {"learning"})
+    monkeypatch.setattr(ops, "adapters", lambda: {row.id: row for row in learning.entries()})
+    app = FastAPI()
+    app.include_router(ops.router)
+    return TestClient(app), state, calls, auth_checks
