+def refresh_pilot_evidence(
+    request,
+    pilot_id: str,
+    *,
+    context: str,
+    actor: str,
+    owner_id: str,
+    resolve,
+    service: OutcomeAccounting | None = None,
+) -> dict:
+    """Explicitly finish a pilot's admissions and refresh this owner's sources.
+
+    Call only from a context-bound mutation route. Report GETs must not repair
+    admissions or append observations and costs as a side effect of viewing.
+    """
+    from . import outcome_pilots
+
+    accounting = service or default_service
+    record = outcome_pilots.prepare_admission(
+        pilot_id, context=context, resolve=resolve,
+    )
+    manifest = admit_pilot(record, resolve=resolve, service=accounting)
+    record = outcome_pilots.complete_admission(
+        record["id"], manifest, context=context, actor=actor, resolve=resolve,
+    )
+    admissions = require_complete_admission(record, service=accounting)
+    checked = unavailable = skipped = 0
+    for admission in admissions.values():
+        if admission.get("owner_id") != owner_id:
+            skipped += 1
+            continue
+        checked += 1
+        try:
+            reconcile_record(
+                request,
+                context,
+                admission["id"],
+                service=accounting,
+                owner_id=owner_id,
+            )
+        except Exception:
+            unavailable += 1
+    return {
+        "report": outcome_pilots.report(record, resolve=resolve),
+        "refresh": {
+            "checked": checked,
+            "unavailable": unavailable,
+            "skipped": skipped,
+        },
+    }
+
