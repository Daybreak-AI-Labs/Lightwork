+def test_consent_projection_repair_is_available_in_the_privacy_screen():
+    from maverick import consent_registry as cr
+
+    created = client.post("/api/v1/consent/records", json={
+        "subject_ref": "alice@example.com", "purpose": "marketing",
+        "status": "withdrawn", "policy_version": "2026-02", "channel": "web",
+    })
+    assert created.status_code == 201, created.text
+    record = created.json()
+    future = {**record["history"][-1], "status": "granted",
+              "recorded_at": record["history"][-1]["recorded_at"] + 86400 * 365}
+
+    def legacy(value):
+        value["history"].append(future)
+        value["current_status"] = "granted"
+        value["last_recorded_at"] = future["recorded_at"]
+
+    damaged = cr._RECEIPTS.update(
+        record["id"], legacy, expected_revision=record["revision"],
+        action="legacy_fixture", actor="test",
+    )
+    page = client.get("/privacy")
+    assert page.status_code == 200
+    assert "Repair saved summary" in page.text
+    assert "Original receipt history is kept" in page.text
+
+    looked_up = client.post("/api/v1/consent/preferences", json={
+        "subject_ref": "alice@example.com",
+    })
+    detail = looked_up.json()["purposes"]["marketing"]
+    assert detail["needs_repair"] is True
+    repaired = client.post("/api/v1/consent/repair", json={
+        "subject_ref": "alice@example.com", "purpose": "marketing",
+        "expected_revision": detail["revision"],
+    })
+    assert repaired.status_code == 200, repaired.text
+    assert repaired.json()["status"] == "withdrawn"
+    assert repaired.json()["history_preserved"] is True
+
+    stale = client.post("/api/v1/consent/repair", json={
+        "subject_ref": "alice@example.com", "purpose": "marketing",
+        "expected_revision": damaged["revision"],
+    })
+    assert stale.status_code == 409
+
+    export = client.get("/api/v1/consent/export").json()["receipts"][0]
+    assert len(export["history"]) == 2
+    assert export["history"][-1]["status"] == "granted"
+
