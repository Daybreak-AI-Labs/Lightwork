index 51cc0d6a2daafbcf554cfa6ab9fe64a723fc43b5..9bfd82d718333d8a1be3c85834237f08278db53e 100644
--- a/deploy/aws/terraform/ecs.tf
+++ b/deploy/aws/terraform/ecs.tf
@@ -56,6 +56,9 @@ resource "aws_ecs_task_definition" "app" {
           # at-rest key ever rotates. The value is a one-way hash, not the key.
           { name = "MAVERICK_ENCRYPTION_KEY_DIGEST", value = "sha256:08e3a482c52e752bb7a1765bcc622508e8decafca4c1a8d5a01c2d5d0630b156" },
         ],
+        var.executor_managed_credentials ? [
+          { name = "MAVERICK_EXECUTOR_KUBECONFIG_SECRET_ARN", value = var.executor_kubeconfig_secret_arn },
+        ] : [],
         # Browser login via Auth0 (OIDC). Added only when an issuer is set, so
         # an unconfigured stack stays on static-token auth. redirect_uri and
         # audience are derived so there is one place to configure this.
@@ -147,6 +150,15 @@ resource "aws_ecs_task_definition" "app" {
   skip_destroy = true
 
   lifecycle {
+    precondition {
+      condition = !var.executor_managed_credentials || (
+        data.aws_caller_identity.current.account_id == "589997396906" &&
+        data.aws_region.current.name == "us-east-2" &&
+        var.executor_namespace == "lightwork-execution" &&
+        can(regex("^arn:aws:secretsmanager:us-east-2:589997396906:secret:lightwork-prod/executor-kubeconfig-[A-Za-z0-9]{6}$", var.executor_kubeconfig_secret_arn))
+      )
+      error_message = "Managed credential refresh is restricted to the qualified Ohio production executor identity. See deploy/aws/EXECUTOR.md."
+    }
     precondition {
       condition     = var.executor_kubeconfig_secret_arn != "" && can(regex("@sha256:[a-f0-9]{64}$", var.executor_image))
       error_message = "Provision and qualify the separate Kubernetes executor first: set executor_kubeconfig_secret_arn and a digest-pinned executor_image. See deploy/aws/EXECUTOR.md."
diff --git a/deploy/aws/terraform/iam.tf b/deploy/aws/terraform/iam.tf
index 88dd80d581667beb2b1fe053080e62445210381e..33dd669d3985982c6ac9a0f056ea7702478a326a 100644
--- a/deploy/aws/terraform/iam.tf
+++ b/deploy/aws/terraform/iam.tf
@@ -56,6 +56,28 @@ resource "aws_iam_role" "task" {
   assume_role_policy = data.aws_iam_policy_document.ecs_assume.json
 }
 
+# Unlike startup-only ECS injection, managed renewal reads one exact secret at
+# runtime. No DescribeSecret, write, listing or other existing app-secret access.
+data "aws_iam_policy_document" "executor_managed_read" {
+  count = var.executor_managed_credentials ? 1 : 0
+  statement {
+    actions   = ["secretsmanager:GetSecretValue"]
+    resources = [var.executor_kubeconfig_secret_arn]
+    condition {
+      test     = "StringEquals"
+      variable = "secretsmanager:VersionStage"
+      values   = ["AWSCURRENT"]
+    }
+  }
+}
+
+resource "aws_iam_role_policy" "executor_managed_read" {
+  count  = var.executor_managed_credentials ? 1 : 0
+  name   = "executor-managed-read-current"
+  role   = aws_iam_role.task.id
+  policy = data.aws_iam_policy_document.executor_managed_read[0].json
+}
+
 # The app sends platform email (invite links) through the Amazon SES API using
 # this task role — no stored SMTP credential. Send-only; the verified identity
 # (daybreakailabs.com) is enforced by SES itself.
