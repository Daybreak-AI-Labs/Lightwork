+            "run_id": run.run_id,
+            "claim_id": claim_id,
+            "request_fingerprint": request_fingerprint,
+            "owner": owner,
+            "tenant": tenant,
+        }
+        raw_bound_job_id = existing_claim.get("job_id")
+        try:
+            bound_job_id = int(raw_bound_job_id or 0)
+        except (TypeError, ValueError, OverflowError) as exc:
