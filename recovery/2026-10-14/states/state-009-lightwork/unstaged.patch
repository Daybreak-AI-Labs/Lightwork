+def build_store(backend: str | None = None) -> Any | None:
+    """Construct the configured vector store, or None if unavailable.
+
+    Never raises: a missing extra, backend error, corrupt tenant/client binding,
+    or unresolved at-rest policy returns None so the caller falls back to
+    lexical/embedding recall without touching a global or plaintext vector path.
+
+    Multi-tenant isolation: the SHARED external backends (chroma/qdrant/weaviate)
+    run similarity SEARCH across every row in a collection -- id-namespacing
+    isolates get/delete-by-id but NOT search -- so one tenant's recall would
+    surface another tenant's goals. Give each tenant its OWN collection (the
+    standard vector-DB multi-tenancy pattern; a wrong name errors loudly rather
+    than leaking). No-op single-tenant. pgvector already scopes by a tenant_id
+    column, so it keeps the shared collection.
+
+    Under at-rest encryption (:func:`_sealed_recall`) the collection gets a
+    ``_s`` suffix so the sealed, client-embedded vectors live apart from any
+    legacy plaintext-embedded data.
+    """
+    resolved_backend = backend or backend_name()
+    if resolved_backend is None:
+        return None
+    cached_posture = _RESOLVED_POSTURE.get()
+    posture = (
+        _resolve_isolation_posture()
+        if cached_posture is _POSTURE_UNSET
+        else cached_posture
+    )
+    if posture is None:
+        return None
+    namespace, sealed = posture
+    return _construct_store(
+        resolved_backend,
+        namespace=namespace,
+        sealed=sealed,
+    )
+
+
+def _build_store_with_posture(
+    posture: tuple[str | None, bool],
+) -> Any | None:
+    """Call the public factory seam without resolving policy a second time."""
+    token = _RESOLVED_POSTURE.set(posture)
+    try:
+        return build_store()
+    finally:
+        _RESOLVED_POSTURE.reset(token)
+
+
+def _close_owned_store(store: Any) -> None:
+    """Best-effort cleanup for a store constructed by this module.
+
+    The public helpers intentionally never raise on an optional semantic
+    backend failure.  Cleanup follows the same contract, but emits a warning so
+    a persistent client/connection shutdown problem is operationally visible.
+    Caller-injected stores never pass through this helper; their lifecycle
+    remains owned by the caller.
+    """
+    close = getattr(store, "close", None)
+    if not callable(close):
+        return
+    try:
+        close()
+    except Exception as exc:  # pragma: no cover -- backend-specific cleanup
+        log.warning("semantic recall store cleanup failed: %s", exc)
