+    except IndeterminateCaseAlreadyResolved as exc:
+        raise HTTPException(status_code=409, detail=str(exc)) from exc
+    except (AuditRefused, AuditRequiredWriteFailed) as exc:
+        raise HTTPException(
+            status_code=503,
