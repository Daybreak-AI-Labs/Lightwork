+def test_vault_stdlib_https_wrap_unwrap(monkeypatch):
+    calls = []
+    responses = iter(
+        [
+            {"data": {"ciphertext": "vault:v1:test-ciphertext"}},
+            {"data": {"plaintext": base64.b64encode(b"d" * 32).decode()}},
+        ]
+    )
+
+    def fake_urlopen(request, *, timeout, context):
+        calls.append((request, timeout, context))
+        return _FakeHttpResponse(next(responses))
+
+    monkeypatch.setattr(urllib.request, "urlopen", fake_urlopen)
+    kms = kms_backends.VaultTransitKMS(
+        key_id="tenant/key",
+        address="https://vault.example.test:8200",
+        token="provider-token",
+        mount="tenant-transit",
+    )
+
+    wrapped = kms.wrap(b"d" * 32, context=b"tenant:acme")
+    assert kms.unwrap(wrapped, context=b"tenant:acme") == b"d" * 32
+
+    assert len(calls) == 2
+    encrypt_request, timeout, tls_context = calls[0]
+    assert encrypt_request.full_url.endswith(
+        "/v1/tenant-transit/encrypt/tenant%2Fkey"
+    )
+    assert encrypt_request.get_header("X-vault-token") == "provider-token"
+    assert timeout == 10.0
+    assert tls_context.check_hostname is True
+    encrypt_payload = json.loads(encrypt_request.data)
+    assert base64.b64decode(encrypt_payload["plaintext"]) == b"d" * 32
+    assert base64.b64decode(encrypt_payload["context"]) == b"tenant:acme"
