+def test_indeterminate_run_requires_audited_admin_resolution_before_replacement(
+    monkeypatch, tmp_path,
+):
+    _isolate(monkeypatch, tmp_path)
+    from maverick.flow import store
+
+    store.save_run(store.FlowRun(
+        run_id="ambiguous", flow_id="missing-flow", status="indeterminate",
+        cursor="charge", error="external acknowledgement was lost",
+        owner="",
+    ))
+    audit_calls = []
+    monkeypatch.setattr(
+        "maverick.audit.required_audit_event",
+        lambda kind, **payload: audit_calls.append((kind, payload)) or True,
+    )
+    c = _client()
+
+    unresolved = c.get("/api/v1/flows/runs/ambiguous")
+    assert unresolved.status_code == 200
+    case = unresolved.json()["indeterminate_case"]
+    assert case["resolution"] is None
+    assert case["reconciliation_overdue"] is False
+    assert any("without repeating" in action for action in case["operator_actions"])
+
+    payload = {
+        "resolution_id": "1" * 32,
+        "disposition": "not_committed",
+        "reconciliation_method": "provider.lookup",
+        "reconciliation_summary": "Provider ledger has no matching operation.",
+        "evidence_references": ["provider:ledger/inv-1"],
+        "evidence_sha256": "a" * 64,
+        "external_reference": "",
+        "compensating_action": "No compensation required because no effect exists.",
+        "replacement_authorized": True,
+    }
+    resolved = c.post(
+        "/api/v1/flows/runs/ambiguous/resolve-indeterminate", json=payload,
+    )
+    assert resolved.status_code == 200, resolved.text
+    assert resolved.json()["resolution"]["adjudicated_by"] == "local:dashboard"
+    assert resolved.json()["resolution"]["replacement_authorized"] is True
+    assert len(audit_calls) == 1
+
+    after = c.get("/api/v1/flows/runs/ambiguous").json()["indeterminate_case"]
+    assert after["resolution"]["resolution_id"] == "1" * 32
+    # The permanent not-committed finding unlocks the quarantine, but this run
+    # references no live flow; reaching 404 proves retry passed the old 409 gate.
+    assert c.post("/api/v1/flows/runs/ambiguous/retry").status_code == 404
+
+    conflicting = dict(payload, resolution_id="2" * 32)
+    assert c.post(
+        "/api/v1/flows/runs/ambiguous/resolve-indeterminate", json=conflicting,
+    ).status_code == 409
+
