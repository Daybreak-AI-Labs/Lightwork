+        if not str(vault_token or "").strip():
+            violations.append("Vault KMS token is unavailable from provider custody")
+
+    try:
+        from .world_model_backends.postgres import (
+            _connect_timeout_seconds,
+            _lock_timeout_ms,
+            _pool_size,
+            _resolve_dsn,
+            _statement_timeout_ms,
+            _validate_production_dsn,
+        )
