+def _validate_run_transition(record: Mapping[str, object]) -> dict:
+    """Validate the exact immutable transition envelope and its hash.
+
+    Receipt signature/context validation happens at the governed tool boundary.
+    This layer preserves that exact signed object and binds it into the run's
+    own append-only chain; it never reinterprets display text as receipt state.
+    """
+    if not isinstance(record, Mapping) or set(record) != _RUN_TRANSITION_FIELDS:
+        raise FlowSnapshotError(
+            "flow node transition has missing or unexpected fields"
+        )
+    normalized = dict(record)
+    if normalized["schema"] != _RUN_TRANSITION_SCHEMA:
+        raise FlowSnapshotError("flow node transition schema is unsupported")
+    for field_name, maximum, empty in (
+        ("run_id", 512, False),
+        ("flow_id", 512, False),
+        ("segment_id", 160, False),
+        ("definition_revision", 256, True),
+        ("node_id", 512, False),
+        ("node_kind", 80, False),
+        ("tool_name", 256, True),
+        ("node_status", 80, False),
+    ):
+        normalized[field_name] = _bounded_transition_text(
+            normalized[field_name], field_name, maximum=maximum, empty=empty
