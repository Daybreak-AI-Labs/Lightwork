+    rls_forced: bool = True,
+) -> bool:
+    world = PostgresWorldModel.__new__(PostgresWorldModel)
+    inventory = policies if policies is not None else [_policy_tuple(table, expression)]
+    cur = _PolicyCursor(
+        inventory,
+        rls_enabled=rls_enabled,
+        rls_forced=rls_forced,
+    )
+
+    @contextmanager
+    def tx():
+        yield cur
+
+    monkeypatch.setattr(world, "_tx", tx)
+    return world._rls_policy_is_active(table)
