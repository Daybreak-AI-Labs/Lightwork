+def _read_public_key(path: str | Path, expected_fingerprint: str):
+    expected = _validate_digest(expected_fingerprint, "recipient key fingerprint")
+    source = Path(path).expanduser()
+    try:
+        from cryptography.hazmat.primitives import serialization
+        from cryptography.hazmat.primitives.asymmetric.x25519 import X25519PublicKey
+
+        from .file_lock import read_verified_bytes
+
+        pem = read_verified_bytes(source, root=source.parent, max_bytes=MAX_KEY_BYTES)
+        key = serialization.load_pem_public_key(pem)
+        if not isinstance(key, X25519PublicKey):
+            raise TypeError("wrong key type")
