+        FailureKind.CANCELLATION,
+        "cancelled by an operator",
+        origin="operator",
+    )
+
+    async def cancel_then_error(self):
+        with goal_lifecycle_lock(gid):
+            world.set_goal_status(gid, "cancelled", result="operator cancelled")
+            persist_goal_state(world, gid, cancellation)
+        return AgentResult(
+            error="late deterministic failure",
+            role=self.role,
+            name=self.name,
+        )
+
+    monkeypatch.setattr(Agent, "run", cancel_then_error)
