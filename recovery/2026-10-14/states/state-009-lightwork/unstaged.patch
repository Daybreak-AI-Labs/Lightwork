+def test_primary_key_cache_refuses_post_read_replacement(monkeypatch):
+    """Bound bytes can never be paired with a replacement path's identity."""
+    original_key = b"o" * 32
+    replacement_key = b"r" * 32
+    car._write_new_key_file(original_key)
+    replacement = car._KEY_PATH.with_name("replacement.key")
+    real_read = file_lock.read_custodied_text_with_identity
+    calls = 0
+
+    def _swap_after_bound_read(*args, **kwargs):
+        nonlocal calls
+        encoded, identity = real_read(*args, **kwargs)
+        calls += 1
+        if calls == 1:
+            file_lock.atomic_create_text(
+                replacement, replacement_key.hex(), mode=0o600
+            )
+            car.os.replace(replacement, car._KEY_PATH)
+        return encoded, identity
+
+    monkeypatch.setattr(
+        file_lock, "read_custodied_text_with_identity", _swap_after_bound_read
+    )
+
+    assert car._load_or_create_key() == original_key
+    with pytest.raises(car.EncryptionUnavailable, match="immutable at-rest key changed"):
+        car._load_or_create_key()
+    assert calls == 2
+
