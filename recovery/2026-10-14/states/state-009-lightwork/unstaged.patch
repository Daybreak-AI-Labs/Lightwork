+def _postgres_erasure_report(tenant_id="acme"):
+    import hashlib
+
+    from maverick import postgres_tenant_lifecycle as lifecycle
+    from maverick.world_model_backends.postgres import (
+        _PG_SCHEMA_VERSION,
+        _RLS_POLICY_TABLES,
+    )
+
+    counts = dict.fromkeys(_RLS_POLICY_TABLES, 0)
+    return lifecycle._seal_report({
+        "schema": lifecycle.REPORT_SCHEMA,
+        "scope": lifecycle.LIFECYCLE_SCOPE,
+        "not_covered": list(lifecycle.SEPARATE_POSTGRES_SURFACES),
+        "operation": "erase",
+        "tenant_sha256": hashlib.sha256(tenant_id.encode()).hexdigest(),
+        "migration_role_sha256": "0" * 64,
+        "database_schema_version": _PG_SCHEMA_VERSION,
+        "schema_source_sha256": lifecycle.schema_source_sha256(),
+        "table_manifest_sha256": lifecycle.table_manifest_sha256(),
+        "completed_at": "2026-08-03T00:00:00Z",
+        "counts": counts,
+        "rows_total": 0,
+        "deleted": counts,
+        "residuals": counts,
+        "retained_erasure_receipts": 0,
+        "scope_complete": True,
+        "complete": False,
+        "committed": True,
+    })
+
+
