+    claimed = aq.queue().claim()
+    assert claimed is not None and claimed.id == job_id
+
+    worker = Worker(queue=aq.queue())
+    worker.register(aq.DASHBOARD_SCHEDULE_KIND, aq._handle_dashboard_schedule)
+    worker._maybe_rearm(claimed)
+    assert any(
+        job.kind == aq.DASHBOARD_SCHEDULE_KIND
+        for job in aq.queue().list(status="pending", limit=100)
+    )
+
+    response = _client().delete(f"/api/v1/schedules/{job_id}")
+
+    assert response.status_code == 200, response.text
+    assert response.json()["in_flight"] is True
+    assert response.json()["pending_cancelled"] == 1
+    assert aq.schedule_is_cancelled("cancel-race") is True
+    assert aq.queue().list(status="pending", limit=100) == []
+
+    # The in-flight handler observes the durable marker and creates no goal.
+    aq._handle_dashboard_schedule(claimed)
+    assert aq.queue().get(job_id).status == "failed"
+    assert aq._world().goals_for_origin("schedule", "cancel-race") == []
+
+    # Reopening the process-local queue handle does not lose cancellation.
+    monkeypatch.setattr(aq, "_queue", None)
+    assert aq.schedule_is_cancelled("cancel-race") is True
+
