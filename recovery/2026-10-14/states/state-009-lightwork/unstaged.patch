+        "tool_name": tool_name,
+        "node_status": node_status,
+        "input_revision_sha256": input_revision_sha256,
+        "receipt": receipt_document,
+        "receipt_sha256": receipt_sha256,
+        "output_sha256": output_sha256,
+        "next_cursor": next_cursor,
