+            )
+        candidate = evolve.apply_proposal(
+            current,
+            "a",
+            "agent",
+            brief="handle the variable case",
+        )
+
+        def transition_after_load(flow_id):
+            loaded = real_load(flow_id)
+            monkeypatch.setenv("MAVERICK_REQUIRE_PRODUCTION_SURFACE", "1")
