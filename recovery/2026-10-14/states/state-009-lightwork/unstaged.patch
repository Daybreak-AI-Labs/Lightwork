+        policy_source="test-policy",
+        policy_actor="approver:receipt",
+        policy_evidence_sha256="4" * 64,
+        external_reference="provider:operation/forged",
+        reconciliation_method="provider_status_by_operation_id",
+        previous_receipt_sha256="5" * 64,
+        provenance_provider="provider-api",
+        provenance_authority="provider-signed-response",
+        provenance_subject="account:1",
+        provenance_evidence_sha256="6" * 64,
+        provenance_authenticated=True,
+        now=datetime.now(timezone.utc),
+    )
+    returned_receipt = receipt
+    if tamper_signature:
+        tampered = receipt.as_dict()
+        tampered["signature"] = "00" * 64
+        returned_receipt = ConsequentialReceipt.from_mapping(tampered)
+    flow = Flow(id=f"receipt-auth-{tamper_signature}", name="receipt", start="gate", nodes={
+        "gate": FlowNode(
