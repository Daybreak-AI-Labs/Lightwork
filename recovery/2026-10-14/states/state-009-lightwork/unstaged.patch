+def _reconcile_known_tenant_authority_audits(automation_queue) -> dict[str, int]:
+    """Drain bounded authority outbox pages in every recoverable namespace."""
+    from maverick.paths import reset_tenant, set_tenant
+
+    from .authority_audit_delivery import reconcile_pending_authority_audits
+
+    total = {
+        "approval_delivered": 0,
+        "signoff_effective": 0,
+        "signoff_stale": 0,
+        "pending": 0,
+        "failed": 0,
+    }
+    for tenant in _startup_recovery_tenants(automation_queue):
+        token = set_tenant(tenant or None)
+        try:
+            result = reconcile_pending_authority_audits(_world())
+        except Exception:
+            # Visit every remaining namespace before reporting the incomplete
+            # pass. Production startup will fail closed after this inventory;
+            # periodic/shutdown recovery can retry healthy tenants meanwhile.
+            total["failed"] += 1
+            log.exception(
+                "authority audit recovery failed for tenant %s",
+                tenant or "<shared>",
+            )
+        else:
+            for state in (
+                "approval_delivered",
+                "signoff_effective",
+                "signoff_stale",
+                "pending",
+            ):
+                total[state] += int(result[state])
+        finally:
+            reset_tenant(token)
+    return total
+
+
+async def _flush_pending_authority_audits() -> None:
+    """Best-effort bounded shutdown flush after the recurring worker stops."""
+    from maverick.production_scope import production_surface_required
+
+    if not production_surface_required():
+        return
+    raw_timeout = os.environ.get("MAVERICK_AUTHORITY_AUDIT_FLUSH_TIMEOUT", "5")
+    try:
+        timeout = float(raw_timeout)
+        if not math.isfinite(timeout):
+            raise ValueError
+        timeout = max(0.1, min(timeout, 30.0))
+    except (TypeError, ValueError, OverflowError):
+        timeout = 5.0
+    try:
+        from maverick_dashboard import automation_queue
+
+        result = await asyncio.wait_for(
+            run_in_threadpool(
+                _reconcile_known_tenant_authority_audits,
+                automation_queue,
+            ),
+            timeout=timeout,
+        )
+        if result["pending"] or result["failed"]:
+            log.warning(
+                "shutdown: authority audit recovery incomplete "
+                "(pending=%d failed_tenants=%d)",
+                result["pending"],
+                result["failed"],
+            )
+    except TimeoutError:
+        log.warning(
+            "shutdown: authority audit recovery exceeded %.1fs; durable intents "
+            "remain retryable on restart",
+            timeout,
+        )
+    except Exception:  # pragma: no cover - shutdown must remain bounded
+        log.exception("shutdown: authority audit recovery failed")
+
