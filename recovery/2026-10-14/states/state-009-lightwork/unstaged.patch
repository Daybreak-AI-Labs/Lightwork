+def test_copied_stale_async_context_cannot_bypass_closed_admission():
+    async def exercise() -> list[bool]:
+        start_child = asyncio.Event()
+        accepted: list[bool] = []
+
+        async def child() -> None:
+            await start_child.wait()
+            with runner.work_admission() as child_accepted:
+                accepted.append(child_accepted)
+
+        with runner.work_admission() as outer:
+            assert outer is True
+            task = asyncio.create_task(child())
+        # The task copied the outer ContextVar, but its permit lifetime ended
+        # before it attempted work. It must make a fresh admission decision.
+        assert runner.begin_draining() == 0
+        start_child.set()
+        await task
+        return accepted
+
+    assert asyncio.run(exercise()) == [False]
+    assert runner.admitted_work() == 0
+
