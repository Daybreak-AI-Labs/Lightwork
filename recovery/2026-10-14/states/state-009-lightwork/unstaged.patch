+def _production_data_boundary_violations(
+    constraints: dict,
+    cfg: dict,
+) -> list[str]:
+    """Validate secret, KMS, DEK-cache, and Postgres confidentiality policy."""
+    violations: list[str] = []
+    if os.environ.get("MAVERICK_SECRETS_BACKEND", "").strip().lower() != "file":
+        violations.append("production secrets backend must be the mounted file provider")
+    secret_dir = os.environ.get("MAVERICK_SECRETS_DIR", "").strip()
+    if not secret_dir or not Path(secret_dir).is_dir():
+        violations.append("production secrets directory is absent or unavailable")
