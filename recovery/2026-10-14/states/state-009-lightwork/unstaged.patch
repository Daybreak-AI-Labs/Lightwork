+    dependency_name = f"lightwork-dependency-failure-contract-{version}.json"
+    dependency = _json_object_asset(
+        root,
+        dependency_name,
+        label="dependency-failure-contract",
+    )
+    dependency_rows = dependency.get("dependencies")
+    response_contract = dependency.get("response_contract")
+    if (
+        dependency.get("schema") != "lightwork.dependency-failure-contract.v1"
+        or dependency.get("source_version") != version
+        or dependency.get("profile_id") != profile_id
