+@requires_crypto
+@pytest.mark.parametrize("version", ("v1", "v2"))
+def test_transient_injected_source_never_enters_batch_cache(monkeypatch, version):
+    """A key seen only inside resolution must retain its injected provenance."""
+    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
+
+    injected_key = b"a" * 32
+    disk_key = b"d" * 32
+
+    def _blob(nonce_byte: int, plaintext: bytes) -> bytes:
+        nonce = bytes((nonce_byte,)) * car._NONCE_BYTES
+        encrypted = AESGCM(injected_key).encrypt(nonce, plaintext, None)
+        if version == "v2":
+            return car._MAGIC_V2 + car._key_fingerprint(injected_key) + nonce + encrypted
+        return car._MAGIC + nonce + encrypted
+
+    first = _blob(1, b"first")
+    second = _blob(2, b"second")
+    car._write_new_key_file(disk_key)
+    monkeypatch.setattr(car, "_PRIMARY_KEY_CACHE", None)
+    monkeypatch.delenv("MAVERICK_ENCRYPTION_KEY", raising=False)
+
+    # First blob: the caller's cache-bypass hint sees no injection, but the
+    # resolver sees injected_key. Second blob: both observations see no
+    # injection, so it must resolve disk_key and fail authentication/key-id
+    # lookup rather than reuse an incorrectly cached injected AES object.
+    observations = iter((None, injected_key.hex(), None, None))
+    environment_type = type(car.os.environ)
+    real_get = environment_type.get
+
+    def _staged_get(environment, name, default=None):
+        if name == car._KEY_ENV:
+            try:
+                return next(observations)
+            except StopIteration:
+                return None
+        return real_get(environment, name, default)
+
+    monkeypatch.setattr(environment_type, "get", _staged_get)
+    real_load = car._load_or_create_key_with_validation
+    loads = 0
+
+    def _counted_load():
+        nonlocal loads
+        loads += 1
+        return real_load()
+
+    monkeypatch.setattr(car, "_load_or_create_key_with_validation", _counted_load)
+    key_cache = {}
+
+    assert car._unseal_with_key_cache(first, key_cache) == b"first"
+    with pytest.raises(car.EncryptionUnavailable, match="wrong at-rest key|no at-rest key"):
+        car._unseal_with_key_cache(second, key_cache)
+    assert loads == 2
+
+
