+class _FakeHttpResponse:
+    def __init__(self, body: dict):
+        self._raw = json.dumps(body).encode("utf-8")
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *_args):
+        return False
+
+    def read(self, size: int) -> bytes:
+        assert size == 1024 * 1024 + 1
+        return self._raw
