+def _verify_governance_assets(
+    root: Path,
+    *,
+    version: str,
+    production_surface_name: str,
+    tagged_source_root: Path | None = None,
+) -> set[str]:
+    """Parse every non-readiness governance asset and bind their identities."""
+    surface = _json_object_asset(
+        root,
+        production_surface_name,
+        label="production-surface",
+    )
+    profile_id = surface.get("profile_id")
+    surface_digest = production_surface_sha256(root / production_surface_name)
+    source_contract_names = _verify_source_contract_assets(
+        root,
+        version=version,
+        profile_id=profile_id,
+        tagged_source_root=tagged_source_root,
+    )
+
+    claim_name = f"lightwork-claim-evidence-ledger-{version}.json"
+    claim = _json_object_asset(root, claim_name, label="claim-evidence-ledger")
+    approval = claim.get("approval")
+    approvers = approval.get("approvers") if isinstance(approval, Mapping) else None
+    if (
+        claim.get("schema") != "lightwork.claim-evidence-ledger.v1"
+        or claim.get("source_version") != version
+        or claim.get("profile_id") != profile_id
+        or claim.get("status") != "approved"
+        or not isinstance(approval, Mapping)
+        or approval.get("status") != "approved"
+        or not isinstance(approvers, list)
+        or any(
+            not isinstance(approver, str) or not approver.strip()
+            for approver in approvers
+        )
+        or len(set(approvers)) < 2
+        or not approval.get("approved_at")
+        or not approval.get("external_reference")
+        or not isinstance(claim.get("claims"), list)
+        or not claim.get("claims")
+        or not isinstance(claim.get("buyer_documents"), list)
+        or not claim.get("buyer_documents")
+    ):
+        raise ValueError("claim-evidence-ledger release asset is not approved and bound")
+
+    inventory_name = f"lightwork-production-code-inventory-{version}.json"
+    inventory = _json_object_asset(
+        root,
+        inventory_name,
+        label="production-code-inventory",
+    )
+    if (
+        inventory.get("schema") != "lightwork.production-code-inventory.v1"
+        or inventory.get("repository") != "Daybreak-AI-Labs/Lightwork"
+        or inventory.get("source_version") != version
+        or inventory.get("profile_id") != profile_id
+        or not isinstance(inventory.get("tests"), Mapping)
+        or not isinstance(inventory.get("packages"), Mapping)
+        or not isinstance(inventory.get("dashboard_routes"), Mapping)
+    ):
+        raise ValueError("production-code-inventory release asset is not release-bound")
+
+    migration_name = f"lightwork-production-migration-contract-{version}.json"
+    migration = _json_object_asset(
+        root,
+        migration_name,
+        label="production-migration-contract",
+    )
+    if (
+        migration.get("schema_version") != 1
+        or migration.get("profile_id") != profile_id
+        or migration.get("admitted_backend") != "postgres"
+        or migration.get("artifact_status")
+        != "repository-contract-not-live-qualification-evidence"
+        or not isinstance(migration.get("external_qualification_required"), list)
+        or not migration.get("external_qualification_required")
+    ):
+        raise ValueError("production-migration-contract release asset is not bound")
+
+    rotation_name = f"lightwork-secret-rotation-contract-{version}.json"
+    rotation = _json_object_asset(
