+def _cancel_schedule_successors(job) -> None:
+    payload = job.payload or {}
+    schedule_id = str(payload.get("schedule_id") or "")
+    tenant = str(payload.get("tenant") or "")
+    if not schedule_id:
+        return
+    for pending in queue().list(status="pending", limit=100_000):
+        other = pending.payload or {}
+        if (
+            pending.kind == DASHBOARD_SCHEDULE_KIND
+            and str(other.get("schedule_id") or "") == schedule_id
+            and str(other.get("tenant") or "") == tenant
+        ):
+            queue().cancel(pending.id)
+
+
+def _terminalize_schedule_job(
+    job,
+    detail: str,
+    *,
+    cancel_schedule: bool = False,
+) -> None:
+    """Fail an occurrence row without letting Worker.complete overwrite it."""
+    if cancel_schedule:
+        _cancel_schedule_successors(job)
+    queue().fail(
+        job.id,
+        detail,
+        retry_after=None,
+        max_attempts=0,
+        expected_attempts=job.attempts,
+    )
