+{{/* Validate the complete fixed identity value schema and selected provider. */}}
+{{- define "maverick.validateIdentityConfig" -}}
+{{- $identity := .Values.identity -}}
+{{- if not (kindIs "map" $identity) -}}
+{{- fail "production.enforce requires identity to be a table." -}}
+{{- end -}}
+{{- range $key, $_ := $identity -}}
+{{- if not (has $key (list "mode" "config")) -}}
+{{- fail (printf "production.enforce identity contains unsupported or secret-shaped field %s." $key) -}}
+{{- end -}}
+{{- end -}}
+{{- $config := get $identity "config" -}}
+{{- if not (kindIs "map" $config) -}}
+{{- fail "production.enforce requires identity.config to be a table." -}}
+{{- end -}}
+{{- range $key, $_ := $config -}}
+{{- if not (has $key (list "oidc" "trustedProxy" "dashboard" "kernel")) -}}
+{{- fail (printf "production.enforce identity.config contains unsupported or secret-shaped field %s." $key) -}}
+{{- end -}}
+{{- end -}}
+
+{{- $oidc := get $config "oidc" -}}
+{{- if not (kindIs "map" $oidc) -}}
+{{- fail "production.enforce requires identity.config.oidc to be a table." -}}
+{{- end -}}
+{{- range $key, $_ := $oidc -}}
+{{- if not (has $key (list "issuer" "audience" "jwksUri" "algorithms" "clientId" "redirectUri" "authorizationEndpoint" "tokenEndpoint")) -}}
+{{- fail (printf "production.enforce identity.config.oidc contains unsupported or credential field %s." $key) -}}
+{{- end -}}
+{{- end -}}
+{{- range $field := list "issuer" "audience" "jwksUri" "clientId" "redirectUri" "authorizationEndpoint" "tokenEndpoint" -}}
+{{- include "maverick.validateIdentityString" (list (printf "identity.config.oidc.%s" $field) (get $oidc $field) false) -}}
+{{- end -}}
+{{- $algorithms := get $oidc "algorithms" -}}
+{{- if not (kindIs "slice" $algorithms) -}}
+{{- fail "production.enforce requires identity.config.oidc.algorithms to be a string list." -}}
+{{- end -}}
+{{- $seenAlgorithms := dict -}}
+{{- range $algorithm := $algorithms -}}
+{{- include "maverick.validateIdentityString" (list "identity.config.oidc.algorithms entry" $algorithm true) -}}
+{{- if not (has $algorithm (list "RS256" "RS384" "RS512" "ES256" "ES384" "ES512" "PS256" "PS384" "PS512" "EdDSA")) -}}
+{{- fail "production.enforce requires only supported asymmetric OIDC algorithms." -}}
+{{- end -}}
+{{- if hasKey $seenAlgorithms $algorithm -}}
+{{- fail "production.enforce rejects duplicate OIDC algorithms." -}}
+{{- end -}}
+{{- $_ := set $seenAlgorithms $algorithm true -}}
+{{- end -}}
+
+{{- $proxy := get $config "trustedProxy" -}}
+{{- if not (kindIs "map" $proxy) -}}
+{{- fail "production.enforce requires identity.config.trustedProxy to be a table." -}}
+{{- end -}}
+{{- range $key, $_ := $proxy -}}
+{{- if not (has $key (list "header" "trustedProxies" "trustLoopback")) -}}
+{{- fail (printf "production.enforce identity.config.trustedProxy contains unsupported or credential field %s." $key) -}}
+{{- end -}}
+{{- end -}}
+{{- include "maverick.validateIdentityString" (list "identity.config.trustedProxy.header" (get $proxy "header") false) -}}
+{{- $trustedProxies := get $proxy "trustedProxies" -}}
+{{- if not (kindIs "slice" $trustedProxies) -}}
+{{- fail "production.enforce requires identity.config.trustedProxy.trustedProxies to be a string list." -}}
+{{- end -}}
+{{- $seenProxies := dict -}}
+{{- range $peer := $trustedProxies -}}
+{{- include "maverick.validateIdentityString" (list "identity.config.trustedProxy.trustedProxies entry" $peer true) -}}
+{{- if not (regexMatch "^[0-9A-Fa-f:.]+(/[0-9]{1,3})?$" $peer) -}}
+{{- fail "production.enforce trusted-proxy peers must be explicit IP addresses or CIDR networks." -}}
+{{- end -}}
+{{- if hasKey $seenProxies $peer -}}
+{{- fail "production.enforce rejects duplicate trusted-proxy peers." -}}
+{{- end -}}
+{{- $_ := set $seenProxies $peer true -}}
+{{- end -}}
+{{- if not (kindIs "bool" (get $proxy "trustLoopback")) -}}
+{{- fail "production.enforce requires identity.config.trustedProxy.trustLoopback to be boolean." -}}
+{{- end -}}
+{{- if get $proxy "trustLoopback" -}}
+{{- fail "production.enforce forbids trusted-proxy loopback fallback; pin exact peers." -}}
+{{- end -}}
+
+{{- $dashboard := get $config "dashboard" -}}
+{{- if not (kindIs "map" $dashboard) -}}
+{{- fail "production.enforce requires identity.config.dashboard to be a table." -}}
+{{- end -}}
+{{- range $key, $_ := $dashboard -}}
+{{- if not (has $key (list "defaultRole" "admins" "defaultSuites" "groupRoles" "groupSuites")) -}}
+{{- fail (printf "production.enforce identity.config.dashboard contains unsupported or secret-shaped field %s." $key) -}}
+{{- end -}}
+{{- end -}}
+{{- include "maverick.validateIdentityString" (list "identity.config.dashboard.defaultRole" (get $dashboard "defaultRole") true) -}}
+{{- if ne (get $dashboard "defaultRole") "viewer" -}}
+{{- fail "production.enforce requires identity.config.dashboard.defaultRole=viewer." -}}
+{{- end -}}
+{{- $admins := get $dashboard "admins" -}}
+{{- if or (not (kindIs "slice" $admins)) (not $admins) -}}
+{{- fail "production.enforce requires at least one identity.config.dashboard.admins principal." -}}
+{{- end -}}
+{{- $seenAdmins := dict -}}
+{{- range $admin := $admins -}}
+{{- include "maverick.validateIdentityString" (list "identity.config.dashboard.admins entry" $admin true) -}}
+{{- if not (regexMatch "^user:[^,[:space:]]+$" $admin) -}}
+{{- fail "production.enforce dashboard admins must be exact non-empty user: principals without whitespace or commas." -}}
+{{- end -}}
+{{- if hasKey $seenAdmins $admin -}}
+{{- fail "production.enforce rejects duplicate dashboard admins." -}}
+{{- end -}}
+{{- $_ := set $seenAdmins $admin true -}}
+{{- end -}}
+{{- $defaultSuites := get $dashboard "defaultSuites" -}}
+{{- if not (kindIs "slice" $defaultSuites) -}}
+{{- fail "production.enforce requires identity.config.dashboard.defaultSuites to be a string list." -}}
+{{- end -}}
+{{- $seenDefaultSuites := dict -}}
+{{- range $suite := $defaultSuites -}}
+{{- include "maverick.validateIdentityString" (list "identity.config.dashboard.defaultSuites entry" $suite true) -}}
+{{- if hasKey $seenDefaultSuites $suite -}}
+{{- fail "production.enforce rejects duplicate dashboard default suites." -}}
+{{- end -}}
+{{- $_ := set $seenDefaultSuites $suite true -}}
+{{- end -}}
+{{- $groupRoles := get $dashboard "groupRoles" -}}
+{{- if not (kindIs "map" $groupRoles) -}}
+{{- fail "production.enforce requires identity.config.dashboard.groupRoles to be a table." -}}
+{{- end -}}
+{{- range $group, $role := $groupRoles -}}
+{{- include "maverick.validateIdentityString" (list "identity.config.dashboard.groupRoles group" $group true) -}}
+{{- include "maverick.validateIdentityString" (list (printf "identity.config.dashboard.groupRoles[%s]" $group) $role true) -}}
+{{- if not (has $role (list "admin" "operator" "auditor" "viewer")) -}}
+{{- fail "production.enforce dashboard group roles must be admin, operator, auditor, or viewer." -}}
+{{- end -}}
+{{- end -}}
+{{- $groupSuites := get $dashboard "groupSuites" -}}
+{{- if not (kindIs "map" $groupSuites) -}}
+{{- fail "production.enforce requires identity.config.dashboard.groupSuites to be a table." -}}
+{{- end -}}
+{{- range $group, $suites := $groupSuites -}}
+{{- include "maverick.validateIdentityString" (list "identity.config.dashboard.groupSuites group" $group true) -}}
+{{- if not (kindIs "slice" $suites) -}}
+{{- fail "production.enforce dashboard group suites must be string lists." -}}
+{{- end -}}
+{{- range $suite := $suites -}}
+{{- include "maverick.validateIdentityString" (list (printf "identity.config.dashboard.groupSuites[%s] entry" $group) $suite true) -}}
+{{- end -}}
+{{- end -}}
+
+{{- $kernel := get $config "kernel" -}}
+{{- if not (kindIs "map" $kernel) -}}
+{{- fail "production.enforce requires identity.config.kernel to be a table." -}}
+{{- end -}}
+{{- range $key, $_ := $kernel -}}
+{{- if not (has $key (list "roles" "roleAssignments")) -}}
+{{- fail (printf "production.enforce identity.config.kernel contains unsupported or secret-shaped field %s." $key) -}}
