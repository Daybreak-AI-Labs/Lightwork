+def reconcile_schedule_jobs() -> dict[str, int]:  # noqa: C901
+    """Quarantine schedule occurrences abandoned at a process boundary."""
+    q = queue()
+    counts = {
+        "pending": 0,
+        "worker_lost": 0,
+        "delivery_failed": 0,
+        "invalid": 0,
+        "cancelled": 0,
+    }
+    for status in ("pending", "running", "failed", "done"):
+        for job in q.list(status=status, limit=100_000):
+            if job.kind != DASHBOARD_SCHEDULE_KIND:
+                continue
+            payload = job.payload or {}
+            valid = (
+                payload.get("schema") == _DASHBOARD_SCHEDULE_TASK_SCHEMA
+                and bool(str(payload.get("text") or "").strip())
+                and 0 < len(str(payload.get("schedule_id") or "").strip()) <= 128
+            )
+            if not valid:
+                if status == "pending":
+                    q.cancel(job.id)
+                elif status == "running":
+                    _terminalize_schedule_job(
+                        job,
+                        "dashboard schedule task is invalid",
+                        cancel_schedule=True,
+                    )
+                counts["invalid"] += 1
+                continue
+            schedule_id = str(payload.get("schedule_id") or "").strip()
+            tenant = str(payload.get("tenant") or "")
+            if schedule_is_cancelled(schedule_id, tenant=tenant):
+                if status == "pending":
+                    q.cancel(job.id)
+                    counts["cancelled"] += 1
+                elif status == "running":
+                    _terminalize_schedule_job(
+                        job,
+                        "schedule was cancelled before restart recovery",
+                        cancel_schedule=True,
+                    )
+                    counts["cancelled"] += 1
+                continue
+            try:
+                goal_id = int(payload.get("goal_id") or 0)
+            except (TypeError, ValueError, OverflowError):
+                goal_id = 0
+
+            cancel_pending = [False]
+            invalid_owner = [False]
+
+            def _reconcile(
+                goal_id: int = goal_id,
+                status: str = status,
+                cancel_pending: list[bool] = cancel_pending,
+                invalid_owner: list[bool] = invalid_owner,
+                job=job,
+            ) -> None:
+                if goal_id <= 0:
+                    return
+                world = _world()
+                goal = world.get_goal(goal_id)
+                if goal is None or goal.status not in {"pending", "active"}:
+                    if status == "pending":
+                        cancel_pending[0] = True
+                    return
+                if not _job_owner_matches(
+                    job,
+                    str(getattr(goal, "owner", "") or ""),
+                ):
+                    invalid_owner[0] = True
+                    return
+                if status == "pending" and goal.status == "pending":
+                    world.set_goal_status(goal_id, "pending", result=goal.result)
+                    counts["pending"] += 1
+                    return
+                if status == "failed" and goal.status == "pending":
+                    _mark_goal_delivery_failed(
+                        world,
+                        goal_id,
+                        "scheduled goal delivery stopped before execution began",
+                    )
+                    counts["delivery_failed"] += 1
+                    return
+                _mark_goal_indeterminate(
+                    world,
+                    goal_id,
+                    "scheduled goal worker state was lost after delivery claim; "
+                    "external effects may have committed",
+                )
+                counts["worker_lost"] += 1
+                if status == "pending":
+                    cancel_pending[0] = True
+
+            _run_in_payload_tenant_control(payload, _reconcile)
+            if invalid_owner[0]:
+                if status == "pending":
+                    q.cancel(job.id)
+                elif status == "running":
+                    _terminalize_schedule_job(
+                        job,
+                        "dashboard schedule resource authority is invalid",
+                        cancel_schedule=True,
+                    )
+                counts["invalid"] += 1
+                continue
+            if status == "running":
+                _terminalize_schedule_job(
+                    job,
+                    "schedule worker disappeared during control-plane restart",
+                )
+                counts["worker_lost"] += int(goal_id <= 0)
+            elif status == "pending" and cancel_pending[0]:
+                q.cancel(job.id)
+    return counts
+
+
+def reconcile_dashboard_tasks() -> dict[str, dict[str, int]]:
+    """Reconcile every dashboard-owned durable task before workers start."""
+    return {
+        "goals": reconcile_goal_jobs(),
+        "schedules": reconcile_schedule_jobs(),
+    }
