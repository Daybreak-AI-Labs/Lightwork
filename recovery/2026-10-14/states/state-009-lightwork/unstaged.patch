+        and str(claim.get("claim_id") or "") == claim_id
+        and str(claim.get("flow_id") or "") == str(run.flow_id or "")
+        and str(claim.get("owner") or "") == str(run.owner or "")
+        and str(claim.get("tenant") or "")
+        == str(payload.get("tenant") or "")
+        and str(claim.get("pause_fingerprint") or "") == pause_fingerprint
+        and str(claim.get("request_fingerprint") or "")
+        == request_fingerprint
+    )
