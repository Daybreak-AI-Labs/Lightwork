+    monkeypatch.setenv("MAVERICK_ENCRYPTION_KEY", second_key.hex())
+    second = car.seal_to_str("second")
+    real_unseal = car._unseal_with_key_cache
+    calls = 0
+
+    def _switch_key(blob, cache):
+        nonlocal calls
+        value = real_unseal(blob, cache)
+        calls += 1
+        if calls == 1:
+            monkeypatch.setenv("MAVERICK_ENCRYPTION_KEY", second_key.hex())
+        return value
+
+    monkeypatch.setenv("MAVERICK_ENCRYPTION_KEY", first_key.hex())
+    monkeypatch.setattr(car, "_unseal_with_key_cache", _switch_key)
+    assert car.unseal_many_from_str([first, second]) == ["first", "second"]
+
+    malformed_calls = 0
+
+    def _break_key(blob, cache):
+        nonlocal malformed_calls
+        value = real_unseal(blob, cache)
+        malformed_calls += 1
+        if malformed_calls == 1:
+            monkeypatch.setenv("MAVERICK_ENCRYPTION_KEY", "00")
+        return value
+
+    monkeypatch.setenv("MAVERICK_ENCRYPTION_KEY", first_key.hex())
+    monkeypatch.setattr(car, "_unseal_with_key_cache", _break_key)
+    with pytest.raises(
+        car.EncryptionUnavailable, match="not valid hex or base64|must decode to 32 bytes"
+    ):
