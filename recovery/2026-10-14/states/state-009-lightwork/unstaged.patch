+        or qa.get("profile_id") != profile_id
+        or qa.get("release_eligible") is not True
+        or qa.get("status") != "repository-assurance-not-live-or-external-evidence"
+        or qa.get("gate_statuses") != expected_gates
+        or not isinstance(mappings, list)
+        or len(mappings) != 16
+        or not isinstance(supply_chain, list)
+        or len(supply_chain) != 11
+        or not isinstance(regimes, list)
+        or len(regimes) != 3
+        or any(
+            not isinstance(row, Mapping)
+            or row.get("certified") is not False
+            or row.get("external_assessment_required") is not True
+            for row in regimes
+        )
+        or not isinstance(processes, list)
+        or len(processes) != 3
+        or any(
+            not isinstance(row, Mapping)
+            or row.get("staffing_verified") is not False
+            or row.get("live_drill_required") is not True
+            for row in processes
+        )
+        or limitations != expected_limitations
+        or not _source_bindings_are_exact(qa.get("source_bindings"), count=99)
+    ):
+        raise ValueError("production QA assurance release asset is not conservative")
+
+    return {
+        api_name,
+        identity_name,
+        openapi_name,
+        onboarding_name,
+        qa_name,
+    } | boundary_names
