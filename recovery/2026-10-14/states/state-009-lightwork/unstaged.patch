+def select_production_packages(
+    packages: list[CohortPackage],
+    manifest_path: Path,
+    version: str,
+) -> list[CohortPackage]:
+    """Select the exact package subset authorized by the production manifest.
+
+    Unknown or unclassified cohort packages are rejected.  This prevents a new
+    research package from drifting into the production image merely because it
+    was added to ``release-cohort.toml`` or the build context.
+    """
+    try:
+        document = json.loads(manifest_path.read_text(encoding="utf-8"))
+    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
+        raise ValueError("production surface manifest is unreadable") from exc
+    if (
+        not isinstance(document, dict)
+        or document.get("schema") != "lightwork.production-surface.v1"
+        or document.get("default_status") != "unsupported"
+        or document.get("source_version") != version
+    ):
+        raise ValueError("production surface manifest does not match the cohort")
+    surfaces = document.get("surfaces")
+    if not isinstance(surfaces, list):
+        raise ValueError("production surface manifest has no surface inventory")
+
+    prefix = "package:"
+    classifications: dict[str, tuple[str, bool]] = {}
+    for surface in surfaces:
+        if not isinstance(surface, dict) or surface.get("category") != "package":
+            continue
+        surface_id = surface.get("id")
+        status = surface.get("status")
+        included = surface.get("included")
+        if (
+            not isinstance(surface_id, str)
+            or not surface_id.startswith(prefix)
+            or not isinstance(status, str)
+            or not isinstance(included, bool)
+        ):
+            raise ValueError("production package classification is malformed")
+        distribution = surface_id[len(prefix):]
+        # Non-Python artifacts share the cross-language surface manifest but
+        # have their own cohort/verifier.  Namespaced ids keep them explicit
+        # without weakening the exact eight-distribution Python inventory.
+        if distribution.startswith(("npm:", "pypi:")):
+            continue
+        if not distribution or distribution in classifications:
+            raise ValueError("production package classification is duplicated")
+        classifications[distribution] = (status, included)
+
+    cohort_names = {package.distribution for package in packages}
+    if set(classifications) != cohort_names:
+        missing = sorted(cohort_names - set(classifications))
+        unknown = sorted(set(classifications) - cohort_names)
+        raise ValueError(
+            "production package inventory must exactly match the release cohort "
+            f"(missing={missing}, unknown={unknown})"
+        )
+    selected_names = {
+        distribution
+        for distribution, (status, included) in classifications.items()
+        if included and status in {"ga", "supported_beta"}
+    }
+    if "maverick-agent" not in selected_names:
+        raise ValueError("production package subset must include maverick-agent")
+    return [
+        package for package in packages if package.distribution in selected_names
+    ]
+
