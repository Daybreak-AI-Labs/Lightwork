+def test_cross_process_resume_executes_downstream_action_once(
+    tmp_path, monkeypatch,
+):
+    """The approval claim must serialize separate control-plane processes."""
+    monkeypatch.setenv("MAVERICK_HOME", str(tmp_path))
+    flow = Flow(id="resume-race-process", name="resume race", start="gate", nodes={
+        "gate": FlowNode(id="gate", kind="approval", prompt="approve?", next="act"),
+        "act": FlowNode(id="act", kind=NODE_ACTION, tool="stripe"),
+    })
+    store.save_flow(flow)
+    paused = execution.execute(
+        flow,
+        agent_runner=_noop_agent,
+        action_runner=lambda *args: ("unused", 1.0),
+    )
+    assert paused.status == "paused_approval"
+
+    command = [
+        sys.executable,
+        "-c",
+        _PROCESS_RESUME_SCRIPT,
+        str(tmp_path),
+        paused.run_id,
+    ]
+    first = subprocess.Popen(
+        command,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+    )
+    second = None
+    try:
+        deadline = time.monotonic() + 10
+        while not (tmp_path / "effect-started").exists():
+            if first.poll() is not None:
+                stdout, stderr = first.communicate()
+                pytest.fail(f"first resume exited early: {stdout}\n{stderr}")
+            assert time.monotonic() < deadline, "first process never reached the side effect"
+            time.sleep(0.01)
+        second = subprocess.Popen(
+            command,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        time.sleep(0.2)
+        (tmp_path / "release-effect").write_text("release", encoding="utf-8")
+        first_stdout, first_stderr = first.communicate(timeout=15)
+        second_stdout, second_stderr = second.communicate(timeout=15)
+        assert first.returncode == 0, first_stderr
+        assert second.returncode == 0, second_stderr
+    finally:
+        (tmp_path / "release-effect").touch(exist_ok=True)
+        for process in (first, second):
+            if process is not None and process.poll() is None:
+                process.terminate()
+                process.wait(5)
+
+    outcomes = {first_stdout.strip(), second_stdout.strip()}
+    effects = list((tmp_path / "effects").glob("*.txt"))
+    assert outcomes == {"completed", "not-resumable"}
+    assert len(effects) == 1
+    assert effects[0].read_text(encoding="utf-8") == "stripe"
+    completed = store.load_run(paused.run_id)
+    assert completed is not None
+    assert completed.status == "completed"
+    assert completed.decided_by == "system:direct"
+
