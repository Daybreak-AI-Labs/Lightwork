+        assert run.cursor == "write"
+        assert run.failure is not None
+        assert run.failure.origin == "checkpoint"
+        assert store.list_run_transitions(run.run_id) == []
+    else:
+        assert run.status == "completed"
+        transition = store.list_run_transitions(run.run_id)[0]
+        assert transition["receipt_sha256"] == receipt.receipt_sha256
