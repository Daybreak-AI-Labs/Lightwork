+def test_terminal_failure_callback_runs_only_after_durable_dead_letter(tmp_path):
+    from maverick.job_queue import JobQueue
+    from maverick.worker import Worker
+
+    q = JobQueue(db_path=tmp_path / "jobs.db")
+    job_id = q.enqueue("fail", {})
+    worker = Worker(
+        queue=q, idle_sleep=0.0, retry_after=0.0, max_attempts=2,
+    )
+    observed = []
+
+    def fail(_job):
+        raise RuntimeError("no delivery")
+
+    worker.register("fail", fail)
+    worker.register_terminal_failure(
+        "fail",
+        lambda job, error: observed.append((job.status, job.attempts, error)),
+    )
+
+    assert worker.run_once() is True
+    assert q.get(job_id).status == "pending"
+    assert observed == []
+    assert worker.run_once() is True
+    assert q.get(job_id).status == "failed"
+    assert len(observed) == 1
+    assert observed[0][0:2] == ("failed", 2)
+    assert "no delivery" in observed[0][2]
+
