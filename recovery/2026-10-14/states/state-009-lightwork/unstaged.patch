+    rls = _resolved_bool("MAVERICK_PG_RLS", world.get("rls"))
+    if constraints["world_model_rls_required"] and rls is not True:
+        violations.append("explicit Postgres RLS enforcement is required")
+    tenancy = cfg.get("tenancy") or {}
+    if _resolved_bool("MAVERICK_TENANT_BY_USER", tenancy.get("by_user")) is not True:
+        violations.append("principal-isolated tenant binding is required")
+
+    sandbox_cfg = cfg.get("sandbox") or {}
+    sandbox = (
+        os.environ.get("MAVERICK_SANDBOX_BACKEND")
+        or str(sandbox_cfg.get("backend") or "")
+    ).strip().lower()
+    if sandbox not in constraints["sandbox_backends"]:
+        violations.append("sandbox backend is absent or outside the production manifest")
+
+    model_spec = os.environ.get("MAVERICK_MODEL_OVERRIDE", "").strip()
+    if _model_provider(model_spec) not in constraints["model_providers"]:
+        violations.append("a provider-qualified admitted production model is required")
