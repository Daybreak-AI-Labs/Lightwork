+def _purge_tenant_tree(
+    tenant_id: str, *, preserve_top_level: frozenset[str] = frozenset()
+) -> int:
+    """Delete one tenant tree without following symlinks/junctions.
+
+    ``preserve_top_level`` supports legally retained stores such as ``audit``.
+    The root remains when anything is preserved. Returns the number of removed
+    filesystem entries.
+    """
+    from pathlib import Path
+
+    from ..workspace import Workspace
+
+    tenants_root = Path(os.path.abspath(maverick_home() / "tenants"))
+    root = Path(os.path.abspath(Workspace(tenant_id).root))
+    if root.parent != tenants_root or not root.name:
+        raise TenantRegistryError("refusing tenant purge outside the tenants root")
+    if not os.path.lexists(root):
+        return 0
+    root_info = root.lstat()
+    if _purge_path_is_alias(root, root_info) or not stat.S_ISDIR(root_info.st_mode):
+        raise TenantRegistryError("refusing aliased or non-directory tenant root")
+    if preserve_top_level:
+        removed = 0
+        preserved_identities: dict[str, tuple[int, int]] = {}
+        with os.scandir(root) as entries:
+            children = [Path(entry.path) for entry in entries]
+        for child in children:
+            if child.name in preserve_top_level:
+                info = child.lstat()
+                if _purge_path_is_alias(child, info) or not stat.S_ISDIR(info.st_mode):
+                    raise TenantRegistryError(
+                        "refusing an aliased or non-directory retained tenant store"
+                    )
+                preserved_identities[child.name] = (info.st_dev, info.st_ino)
+                continue
+            removed += _remove_tenant_path(child)
+        with os.scandir(root) as entries:
+            residuals = [Path(entry.path) for entry in entries]
+        unexpected = [child.name for child in residuals if child.name not in preserve_top_level]
+        if unexpected:
+            raise TenantRegistryError("tenant purge left unexpected local residuals")
+        for child in residuals:
+            info = child.lstat()
+            if (
+                _purge_path_is_alias(child, info)
+                or not stat.S_ISDIR(info.st_mode)
+                or preserved_identities.get(child.name) != (info.st_dev, info.st_ino)
+            ):
+                raise TenantRegistryError("retained tenant store identity changed")
+        return removed
+    return _remove_tenant_path(root)
