+def test_drain_atomically_refuses_new_dispatch_and_waits_for_accepted_work(
+    monkeypatch,
+):
+    entered = threading.Event()
+    release = threading.Event()
+    calls: list[int] = []
+
+    class BlockingDispatcher:
+        def submit(self, goal_id, **_kwargs):
+            calls.append(goal_id)
+            entered.set()
+            assert release.wait(timeout=5.0)
+            return "queued"
+
+    monkeypatch.setattr(runner, "_dispatcher", BlockingDispatcher())
+    result: list[str | None] = []
+    first = threading.Thread(
+        target=lambda: result.append(runner.run_goal_in_background(1)),
+        daemon=True,
+    )
+    first.start()
+    assert entered.wait(timeout=2.0)
+    assert runner.admitted_work() == 1
+
+    drained: list[int] = []
+    shutdown = threading.Thread(
+        target=lambda: drained.append(runner.drain_inflight(timeout=5.0)),
+        daemon=True,
+    )
+    shutdown.start()
+    deadline = time.monotonic() + 2.0
+    while runner.admissions_open() and time.monotonic() < deadline:
+        time.sleep(0.01)
+    assert runner.admissions_open() is False
+
+    # This call races after shutdown closed the door. It never reaches the
+    # dispatcher and therefore cannot enqueue behind the observed drain.
+    assert runner.run_goal_in_background(2) is None
+    assert calls == [1]
+    assert shutdown.is_alive()
+
+    release.set()
+    first.join(timeout=2.0)
+    shutdown.join(timeout=2.0)
+    assert result == ["queued"]
+    assert drained == [0]
+    assert runner.admitted_work() == 0
+
