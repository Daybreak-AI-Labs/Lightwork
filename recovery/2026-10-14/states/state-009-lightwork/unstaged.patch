+        violations.extend(runtime_policy_violations(model_spec))
+
+    violations.extend(_production_identity_violations(cfg))
+
+    plugins = cfg.get("plugins") or {}
+    plugin_env = os.environ.get("MAVERICK_PLUGINS_ALLOW")
+    plugin_allow = plugin_env if plugin_env is not None else plugins.get("enabled")
+    if plugin_allow not in (None, "", [], (), {}):
+        violations.append("third-party plugins are outside the production manifest")
+    channels = cfg.get("channels") or {}
+    if any(
+        name != "routing" and isinstance(value, dict) and value.get("enabled")
+        for name, value in channels.items()
+    ):
+        violations.append("messaging channels are outside the production manifest")
+
+    self_modify = cfg.get("self_modify") or {}
+    self_modify_explicit = (
+        "MAVERICK_SELF_MODIFY" in os.environ or "enable" in self_modify
+    )
+    if (
+        not self_modify_explicit
+        or _resolved_bool("MAVERICK_SELF_MODIFY", self_modify.get("enable")) is not False
+    ):
+        violations.append("code DGM must be explicitly disabled")
+    try:
+        from .flow import auto_apply_enabled
+
+        flow_auto_apply = auto_apply_enabled()
+    except Exception:
+        flow_auto_apply = True
+    if flow_auto_apply:
+        violations.append("flow auto-apply is outside the production manifest")
+    knowledge = cfg.get("knowledge") or {}
+    if _resolved_bool("MAVERICK_KNOWLEDGE_ENABLED", knowledge.get("enabled")) is True:
+        violations.append("knowledge/RAG is outside the production manifest")
+    return violations
+
