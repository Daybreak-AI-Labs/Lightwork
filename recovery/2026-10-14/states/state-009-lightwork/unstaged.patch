+def test_worker_shutdown_settles_claim_then_restart_resumes_without_duplicate(
+    tmp_path,
+):
+    from maverick.job_queue import JobQueue
+    from maverick.worker import Worker
+
+    queue = JobQueue(db_path=tmp_path / "jobs.db")
+    first_id = queue.enqueue("hold", {})
+    second_id = queue.enqueue("hold", {})
+    entered = threading.Event()
+    release = threading.Event()
+    seen: list[int] = []
+
+    def handle(job):
+        seen.append(job.id)
+        if job.id == first_id:
+            entered.set()
+            assert release.wait(timeout=5.0)
+
+    worker = Worker(queue=queue, idle_sleep=0.01, reclaim_lease=2.0)
+    worker.register("hold", handle)
+    daemon = threading.Thread(target=worker.run_forever, daemon=True)
+    daemon.start()
+    assert entered.wait(timeout=2.0)
+
+    worker.stop()
+    assert runner.admissions_open() is False
+    assert queue.get(first_id).status == "running"
+    assert queue.get(second_id).status == "pending"
+    assert queue.get(second_id).attempts == 0
+
+    release.set()
+    daemon.join(timeout=5.0)
+    assert daemon.is_alive() is False
+    assert queue.get(first_id).status == "done"
+    assert queue.get(second_id).status == "pending"
+    assert runner.admitted_work() == 0
+
+    # A fresh process lifecycle re-opens admission and claims only the durable
+    # pending row. The settled first attempt is not replayed.
+    restarted = Worker(queue=queue, idle_sleep=0.01, reclaim_lease=2.0)
+    restarted.register("hold", handle)
+    assert restarted.drain() == 1
+    assert queue.get(second_id).status == "done"
+    assert seen == [first_id, second_id]
