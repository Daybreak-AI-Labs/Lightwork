+            else row.get("qualification") != "live_drill_required"
+        )
+        for row in dependency_rows
+    ):
+        raise ValueError("dependency-failure-contract inventory is not conservative")
+
+    objectives_name = f"lightwork-service-objectives-{version}.json"
+    objectives = _json_object_asset(root, objectives_name, label="service-objectives")
+    if (
+        objectives.get("schema") != "lightwork.service-objectives.v1"
+        or objectives.get("source_version") != version
+        or objectives.get("profile_id") != profile_id
+        or objectives.get("status") != "approved"
+    ):
+        raise ValueError("service-objectives release asset is not approved and bound")
+
+    change_name = f"lightwork-production-change-control-{version}.json"
+    change_control = _json_object_asset(
+        root,
+        change_name,
+        label="production-change-control",
+    )
+    if (
+        change_control.get("schema")
+        != "lightwork.production-change-control-policy.v2"
+        or change_control.get("repository") != "Daybreak-AI-Labs/Lightwork"
+        or change_control.get("source_version") != version
+    ):
+        raise ValueError("production-change-control release asset is not release-bound")
+
+    exceptions_name = f"lightwork-pytest-exceptions-{version}.json"
+    exceptions = _json_object_asset(root, exceptions_name, label="pytest-exceptions")
+    records = exceptions.get("exceptions")
+    if (
+        set(exceptions) != {"schema", "reviewed_on", "policy", "exceptions"}
+        or exceptions.get("schema") != "lightwork.pytest-exceptions.v1"
+        or re.fullmatch(r"\d{4}-\d{2}-\d{2}", str(exceptions.get("reviewed_on")))
+        is None
+        or not isinstance(exceptions.get("policy"), Mapping)
+        or not isinstance(records, list)
+        or not records
+    ):
+        raise ValueError("pytest-exceptions release asset is malformed")
+    ids = [record.get("id") if isinstance(record, Mapping) else None for record in records]
+    expected_ids = [f"QA03-{index:04d}" for index in range(1, len(records) + 1)]
+    if ids != expected_ids:
+        raise ValueError("pytest-exceptions release asset IDs are not exact")
+
+    state_name = f"lightwork-release-state-{version}.json"
+    state = _json_object_asset(root, state_name, label="release-state")
+    expected_manifests = {
+        "claim_evidence_ledger": "release/claim-evidence-ledger.json",
+        "dependency_failure_contract": "release/dependency-failure-contract.json",
+        "release_cohort": "release-cohort.toml",
+        "production_change_control": "release/production-change-control-policy.json",
+        "production_api_contract": "release/production-api-contract.json",
+        "production_code_inventory": "release/production-code-inventory.json",
+        "production_data_boundary": "release/production-data-boundary.json",
+        "production_identity_posture_contract": (
+            "release/production-identity-posture-contract.json"
+        ),
+        "production_migration_contract": "release/production-migration-contract.json",
+        "production_model_policy": "release/production-model-policy.json",
+        "production_onboarding_contract": (
+            "release/production-onboarding-contract.json"
+        ),
+        "production_openapi_schema": "release/production-openapi-schema.json",
+        "production_operations_contract": (
+            "release/production-operations-contract.json"
+        ),
+        "production_qa_assurance": "release/production-qa-assurance.json",
+        "production_runtime_contract": "release/production-runtime-contract.json",
+        "production_surface": "release/production-surface-manifest.json",
+        "production_support_matrix": "release/production-support-matrix.json",
+        "production_readiness": "release/production-readiness-evidence.json",
+        "pytest_exceptions": "qa/pytest-exceptions.json",
+        "secret_rotation_contract": "release/secret-rotation-contract.json",
+        "tenant_quota_contract": "release/tenant-quota-contract.json",
+        "service_objectives": "release/service-objectives.json",
+    }
+    if (
+        state.get("schema") != "lightwork.release-state.v1"
+        or state.get("repository") != "Daybreak-AI-Labs/Lightwork"
+        or state.get("source_version") != version
+        or state.get("source_state") != "release_candidate"
+        or state.get("manifests") != expected_manifests
+    ):
+        raise ValueError("release-state asset does not bind the governance packet")
+
+    return {
+        claim_name,
+        inventory_name,
+        migration_name,
+        rotation_name,
+        quota_name,
+        dependency_name,
+        model_name,
+        support_name,
+        objectives_name,
+        change_name,
+        exceptions_name,
+        state_name,
+    } | source_contract_names
