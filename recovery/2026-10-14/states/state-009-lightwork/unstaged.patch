+def _handle_dashboard_schedule(job) -> None:
+    """Create and run one cron occurrence without ambiguous goal replay."""
+    payload = job.payload or {}
+    if payload.get("schema") != _DASHBOARD_SCHEDULE_TASK_SCHEMA:
+        _terminalize_schedule_job(
+            job,
+            "dashboard schedule task schema is invalid",
+            cancel_schedule=True,
+        )
+        return
+    text = str(payload.get("text") or "").strip()
+    if not text:
+        _terminalize_schedule_job(
+            job,
+            "dashboard schedule task text is empty",
+            cancel_schedule=True,
+        )
+        return
+    schedule_id = str(payload.get("schedule_id") or "").strip()
+    if not schedule_id or len(schedule_id) > 128:
+        _terminalize_schedule_job(
+            job,
+            "dashboard schedule id is invalid",
+            cancel_schedule=True,
+        )
+        return
+    tenant = str(payload.get("tenant") or "")
+    if schedule_is_cancelled(schedule_id, tenant=tenant):
+        _terminalize_schedule_job(
+            job,
+            "schedule was cancelled before this occurrence began",
+            cancel_schedule=True,
+        )
+        return
+    owner = str(payload.get("owner") or "").strip()
+    if owner:
+        try:
+            from maverick_dashboard.auth import stored_automation_identity
+
+            stored_automation_identity(owner)
+        except Exception:
+            _terminalize_schedule_job(
+                job,
+                "schedule owner is unavailable or no longer authorized",
+                cancel_schedule=True,
+            )
+            return
+    try:
+        goal_id = int(payload.get("goal_id") or 0)
+    except (TypeError, ValueError, OverflowError):
+        _terminalize_schedule_job(job, "dashboard schedule goal id is invalid")
+        return
+
+    if goal_id <= 0:
+        # This durable marker is written *before* goal creation. A later retry
+        # that sees it without a goal id cannot know whether create_goal
+        # committed before a crash, so it fails closed instead of minting a
+        # duplicate paid run.
+        if payload.get("delivery_claimed") is True:
+            _terminalize_schedule_job(
+                job,
+                "schedule occurrence stopped at an indeterminate creation boundary",
+            )
+            return
+        payload["delivery_claimed"] = True
+        if not queue().set_payload(job.id, payload):
+            raise RuntimeError("could not persist schedule delivery claim")
+
+        def _create() -> None:
+            nonlocal goal_id
+            world = _world()
+            goal_id = world.create_goal(
+                str(payload.get("title") or text)[:200],
+                text,
+                owner=owner,
+            )
+            world.record_goal_origin(goal_id, "schedule", schedule_id)
+            payload["goal_id"] = goal_id
+            if not queue().set_payload(job.id, payload):
+                _mark_goal_delivery_failed(
+                    world,
+                    goal_id,
+                    "schedule occurrence could not persist its goal identity",
+                )
+                raise RuntimeError("could not persist scheduled goal identity")
+
+        _run_in_payload_tenant(payload, _create)
+        if goal_id <= 0:
+            return
+
+    _run_goal_delivery(job, payload, goal_id)
+
