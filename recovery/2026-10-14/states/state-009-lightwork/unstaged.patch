+        raise ValueError("secret-rotation-contract release asset is not bound")
+
+    quota_name = f"lightwork-tenant-quota-contract-{version}.json"
+    quota = _json_object_asset(root, quota_name, label="tenant-quota-contract")
+    quota_deployment = quota.get("deployment")
+    if (
+        quota.get("schema") != "lightwork.tenant-quota-contract.v1"
+        or quota.get("source_version") != version
+        or quota.get("profile_id") != profile_id
+        or not isinstance(quota_deployment, Mapping)
+        or quota_deployment.get("production_required") is not True
+        or not isinstance(quota.get("resources"), list)
+        or len(quota["resources"]) != 6
+        or not isinstance(quota.get("external_qualification_required"), list)
+        or not quota.get("external_qualification_required")
+    ):
+        raise ValueError("tenant-quota-contract release asset is not bound")
+
+    model_name = f"lightwork-production-model-policy-{version}.json"
+    model = _json_object_asset(root, model_name, label="production-model-policy")
+    if (
+        model.get("schema") != "lightwork.production-model-policy.v1"
+        or model.get("source_version") != version
+        or model.get("profile_id") != profile_id
+        or model.get("status") != "approved"
+        or model.get("production_surface_digest_mode")
+        != PRODUCTION_SURFACE_DIGEST_MODE
+        or model.get("production_surface_sha256") != surface_digest
+    ):
+        raise ValueError("production-model-policy release asset is not approved and bound")
+
+    support_name = f"lightwork-production-support-matrix-{version}.json"
+    support = _json_object_asset(root, support_name, label="production-support-matrix")
+    if (
+        support.get("schema") != "lightwork.production-support-matrix.v1"
+        or support.get("source_version") != version
+        or support.get("profile_id") != profile_id
+        or support.get("release_eligible") is not True
+        or not isinstance(support.get("matrix"), list)
