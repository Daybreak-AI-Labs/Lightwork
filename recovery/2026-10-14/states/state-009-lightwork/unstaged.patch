+    actual_identity = (
+        str(existing_claim.get("claim_id") or ""),
+        str(existing_claim.get("flow_id") or ""),
+        str(existing_claim.get("run_id") or ""),
+        str(existing_claim.get("owner") or ""),
+        str(existing_claim.get("tenant") or ""),
+        str(existing_claim.get("pause_fingerprint") or ""),
