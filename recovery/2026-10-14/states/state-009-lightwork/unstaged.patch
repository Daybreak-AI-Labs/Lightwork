+@pytest.mark.asyncio
+async def test_operator_cancel_during_quota_preflight_remains_authoritative(
+    tmp_path: Path, fake_llm, monkeypatch,
+):
+    from maverick import quotas
+    from maverick.failure_taxonomy import (
+        FailureKind,
+        failure_state,
+        load_goal_state,
+        persist_goal_state,
+    )
+    from maverick.goal_lifecycle import goal_lifecycle_lock
+
+    world = WorldModel(path=tmp_path / "world.db")
+    gid = world.create_goal("cancel during preflight", "do not resurrect")
+    cancellation = failure_state(
+        FailureKind.CANCELLATION,
+        "cancelled by an operator",
+        origin="operator",
+    )
+
+    def cancel_then_refuse(_principal: str) -> str:
+        with goal_lifecycle_lock(gid):
+            world.set_goal_status(gid, "cancelled", result="operator cancelled")
+            persist_goal_state(world, gid, cancellation)
+        return "daily quota exceeded"
+
+    monkeypatch.setattr(quotas, "quotas_enforced", lambda: True)
+    monkeypatch.setattr(quotas, "over_quota", cancel_then_refuse)
+
+    out = await run_goal(
+        llm=fake_llm,
+        world=world,
+        budget=Budget(max_dollars=1.0),
+        goal_id=gid,
+        sandbox=LocalBackend(workdir=tmp_path),
+        max_depth=1,
+    )
+
+    assert "cancelled by an operator" in out
+    assert fake_llm.calls == []
+    goal = world.get_goal(gid)
+    assert goal.status == "cancelled"
+    assert goal.result == "operator cancelled"
+    assert load_goal_state(world, gid) == cancellation
+
+
