+def _bounded_transition_text(
+    value: object,
+    field_name: str,
+    *,
+    maximum: int,
+    empty: bool = False,
+) -> str:
+    if not isinstance(value, str):
+        raise FlowSnapshotError(f"flow node transition {field_name} must be a string")
+    if (not empty and not value) or len(value) > maximum:
+        raise FlowSnapshotError(f"flow node transition {field_name} is invalid")
+    if any(ord(char) < 32 or ord(char) == 127 for char in value):
+        raise FlowSnapshotError(
+            f"flow node transition {field_name} contains control characters"
+        )
+    return value
