+    )
+    rotation_deployment = rotation.get("deployment_contract")
+    if (
+        rotation.get("schema") != "lightwork.secret-rotation-contract.v1"
+        or rotation.get("source_version") != version
+        or rotation.get("profile_id") != profile_id
+        or not isinstance(rotation_deployment, Mapping)
+        or rotation_deployment.get("external_drill_required") is not True
+        or not isinstance(rotation.get("secrets"), list)
