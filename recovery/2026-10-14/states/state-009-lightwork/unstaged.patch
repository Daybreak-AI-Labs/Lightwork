+def test_custodied_read_is_safe_across_ancestor_aba(tmp_path, monkeypatch):
+    """A remove/replace/restore ABA never redirects the already-open handle."""
+    import maverick.file_lock as file_lock
+
+    root = ensure_private_directory(tmp_path / "custody")
+    replacement_root = ensure_private_directory(tmp_path / "replacement-custody")
+    displaced_root = tmp_path / "displaced-custody"
+    replacement_displaced = tmp_path / "replacement-displaced"
+    path = root / "signing.key"
+    atomic_create_text(path, "original", mode=0o600)
+    atomic_create_text(
+        replacement_root / path.name,
+        "attacker",
+        mode=0o600,
+    )
+    real_read = file_lock.os.read
+    swapped = False
+
+    def _aba_after_open(fd, size):
+        nonlocal swapped
+        if not swapped:
+            swapped = True
+            try:
+                os.replace(root, displaced_root)
+            except PermissionError:
+                if os.name == "nt":
+                    pytest.skip("Windows pins the opened ancestor against rename")
+                raise
+            os.replace(replacement_root, root)
+            os.replace(root, replacement_displaced)
+            os.replace(displaced_root, root)
+        return real_read(fd, size)
+
+    monkeypatch.setattr(file_lock.os, "read", _aba_after_open)
+    assert read_custodied_bytes(path, custody_root=root) == b"original"
+    assert (replacement_displaced / path.name).read_text() == "attacker"
+
