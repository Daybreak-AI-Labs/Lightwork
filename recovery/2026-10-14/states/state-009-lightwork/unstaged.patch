+def reconcile_goal_jobs() -> dict[str, int]:  # noqa: C901
+    """Reconcile durable goal deliveries before generic orphan reclamation.
+
+    Pending rows remain executable and refresh their goal's queue marker.  A
+    row that was ``running`` when this process started proves the prior worker
+    disappeared, so it is terminalized and its goal is quarantined rather than
+    replayed.  This function runs before worker threads are created.
+    """
+    q = queue()
+    counts = {
+        "pending": 0,
+        "worker_lost": 0,
+        "inconsistent": 0,
+        "delivery_failed": 0,
+        "invalid": 0,
+    }
+    for status in ("pending", "running", "failed", "done"):
+        for job in q.list(status=status, limit=100_000):
+            if job.kind != DASHBOARD_GOAL_RUN_KIND:
+                continue
+            payload = job.payload or {}
+            if payload.get("schema") != _DASHBOARD_GOAL_TASK_SCHEMA:
+                if status == "pending":
+                    q.cancel(job.id)
+                elif status == "running":
+                    q.fail(
+                        job.id,
+                        "dashboard goal task schema is invalid",
+                        retry_after=None,
+                        max_attempts=0,
+                        expected_attempts=job.attempts,
+                    )
+                counts["invalid"] += 1
+                continue
+            try:
+                goal_id = int(payload.get("goal_id") or 0)
+            except (TypeError, ValueError):
+                goal_id = 0
+            if goal_id <= 0:
+                if status == "pending":
+                    q.cancel(job.id)
+                elif status == "running":
+                    q.fail(
+                        job.id,
+                        "dashboard goal task id is invalid",
+                        retry_after=None,
+                        max_attempts=0,
+                        expected_attempts=job.attempts,
+                    )
+                counts["invalid"] += 1
+                continue
+            cancel_pending = [False]
+            invalid_owner = [False]
+
+            def _reconcile(
+                goal_id: int = goal_id,
+                status: str = status,
+                cancel_pending: list[bool] = cancel_pending,
+                invalid_owner: list[bool] = invalid_owner,
+                job=job,
+            ) -> None:
+                world = _world()
+                goal = world.get_goal(goal_id)
+                if goal is None or goal.status not in {"pending", "active"}:
+                    return
+                if not _job_owner_matches(
+                    job,
+                    str(getattr(goal, "owner", "") or ""),
+                ):
+                    invalid_owner[0] = True
+                    return
+                if status == "pending" and goal.status == "pending":
+                    # The queue row is the authority; touching the row keeps the
+                    # generic stale-orphan repair from misclassifying backlog.
+                    world.set_goal_status(goal_id, "pending", result=goal.result)
+                    counts["pending"] += 1
+                    return
+                if status == "failed" and goal.status == "pending":
+                    _mark_goal_delivery_failed(
+                        world,
+                        goal_id,
+                        "durable goal delivery exhausted before execution began",
+                    )
+                    counts["delivery_failed"] += 1
+                    return
+                _mark_goal_indeterminate(
+                    world,
+                    goal_id,
+                    "goal worker state was lost during control-plane restart; "
+                    "external effects may have committed",
+                )
+                counts[
+                    "worker_lost" if status == "running" else "inconsistent"
+                ] += 1
+                if status == "pending":
+                    cancel_pending[0] = True
+
+            _run_in_payload_tenant_control(payload, _reconcile)
+            if invalid_owner[0]:
+                if status == "pending":
+                    q.cancel(job.id)
+                elif status == "running":
+                    q.fail(
+                        job.id,
+                        "dashboard goal resource authority is invalid",
+                        retry_after=None,
+                        max_attempts=0,
+                        expected_attempts=job.attempts,
+                    )
+                counts["invalid"] += 1
+                continue
+            if status == "running":
+                q.fail(
+                    job.id,
+                    "worker disappeared during control-plane restart",
+                    retry_after=None,
+                    max_attempts=0,
+                    expected_attempts=job.attempts,
+                )
+            elif status == "pending" and cancel_pending[0]:
+                # A pending row paired with an active goal cannot be replayed.
+                q.cancel(job.id)
+    return counts
+
