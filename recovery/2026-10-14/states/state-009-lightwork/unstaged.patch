+def test_qdrant_two_tenant_count_and_reset_are_server_scoped(
+    monkeypatch, tmp_path,
+):
+    fake_client = _install_fake_qdrant(monkeypatch)
+    monkeypatch.delenv("MAVERICK_QDRANT_URL", raising=False)
+    import maverick.vector_store.qdrant_store as qs
+
+    active = ["tenant-a"]
+    monkeypatch.setattr(qs, "_active_tenant", lambda: active[0])
+    rows = []
+
+    def _filter_tenant(value):
+        [condition] = value.must
+        assert condition.key == qs._TENANT_KEY
+        return condition.match.value
+
+    def _add(**kwargs):
+        rows.extend(
+            {"id": item_id, "document": document, "metadata": dict(metadata)}
+            for item_id, document, metadata in zip(
+                kwargs["ids"],
+                kwargs["documents"],
+                kwargs["metadata"],
+                strict=True,
+            )
+        )
+
+    def _count(**kwargs):
+        tenant = _filter_tenant(kwargs["count_filter"])
+        return SimpleNamespace(
+            count=sum(row["metadata"][qs._TENANT_KEY] == tenant for row in rows)
+        )
+
+    def _query(**kwargs):
+        tenant = _filter_tenant(kwargs["query_filter"])
+        return [
+            SimpleNamespace(
+                id=row["id"],
+                document=row["document"],
+                score=0.9,
+                metadata=dict(row["metadata"]),
+            )
+            for row in rows
+            if row["metadata"][qs._TENANT_KEY] == tenant
+        ]
+
+    def _delete(**kwargs):
+        selector = kwargs["points_selector"]
+        if hasattr(selector, "filter"):
+            tenant = _filter_tenant(selector.filter)
+            rows[:] = [
+                row
+                for row in rows
+                if row["metadata"][qs._TENANT_KEY] != tenant
+            ]
+
+    fake_client.add.side_effect = _add
+    fake_client.count.side_effect = _count
+    fake_client.query.side_effect = _query
+    fake_client.delete.side_effect = _delete
