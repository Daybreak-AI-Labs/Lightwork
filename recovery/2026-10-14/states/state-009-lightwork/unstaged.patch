+{{/* Validate numeric values decoded from the bounded tenant quota JSON. */}}
+{{- define "maverick.validateTenantQuotaJSONLimits" -}}
+{{- $limits := index . 0 -}}
+{{- $label := index . 1 -}}
+{{- range $resource, $value := $limits -}}
+{{- if not (has $resource (list "concurrent_runs" "queued_jobs" "daily_tokens" "daily_spend_dollars" "tool_calls" "storage_bytes")) -}}
+{{- fail (printf "production.enforce tenant quota %s contains unknown resource %s." $label $resource) -}}
+{{- end -}}
+{{- if not (kindIs "float64" $value) -}}
+{{- fail (printf "production.enforce tenant quota %s.%s must be a JSON number." $label $resource) -}}
+{{- end -}}
+{{- if lt (float64 $value) 0.0 -}}
+{{- fail (printf "production.enforce tenant quota %s.%s must be non-negative." $label $resource) -}}
+{{- end -}}
+{{- if eq $resource "daily_spend_dollars" -}}
+{{- if gt (float64 $value) 999999999.999999 -}}
+{{- fail (printf "production.enforce tenant quota %s.%s exceeds the reviewed JSON spend range." $label $resource) -}}
+{{- end -}}
+{{- else -}}
+{{- if ne (float64 $value) (floor (float64 $value)) -}}
+{{- fail (printf "production.enforce tenant quota %s.%s must be an integer." $label $resource) -}}
+{{- end -}}
+{{- if gt (float64 $value) 9007199254740991.0 -}}
+{{- fail (printf "production.enforce tenant quota %s.%s exceeds the exact JSON integer range; use scalar mode for a larger deployment-wide ceiling." $label $resource) -}}
+{{- end -}}
+{{- end -}}
+{{- end -}}
+{{- end -}}
