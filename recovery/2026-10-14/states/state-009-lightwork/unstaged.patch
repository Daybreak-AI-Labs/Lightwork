+        raise TenantPolicyError(
+            "principal identity has ambiguous edge whitespace"
+        )
+    try:
+        canonical = canonical_tenant_id(candidate)
+    except InvalidTenantError as exc:
+        raise TenantPolicyError(
+            "principal identity cannot be represented as a tenant namespace"
+        ) from exc
+    if canonical != candidate:
+        raise TenantPolicyError(
+            "principal identity would change under tenant canonicalization"
+        )
+    return candidate
