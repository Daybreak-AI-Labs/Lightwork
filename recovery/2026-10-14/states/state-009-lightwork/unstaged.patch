+            raise ValueError(f"production-readiness gate is not closed: {gate_id!r}")
+        seen.add(str(gate_id))
+    if seen != required:
+        raise ValueError(
+            "production-readiness release asset does not enumerate every P0/P1 gate"
+        )
+    return name
