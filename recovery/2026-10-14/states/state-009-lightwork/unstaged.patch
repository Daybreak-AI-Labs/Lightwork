+def test_terminal_failure_callback_error_preserves_dead_letter(
+    tmp_path, caplog,
+):
+    from maverick.job_queue import JobQueue
+    from maverick.worker import Worker
+
+    q = JobQueue(db_path=tmp_path / "jobs.db")
+    job_id = q.enqueue("fail", {})
+    worker = Worker(
+        queue=q, idle_sleep=0.0, retry_after=0.0, max_attempts=1,
+    )
+
+    def fail(_job):
+        raise RuntimeError("handler failed")
+
+    def callback_failed(_job, _error):
+        raise RuntimeError("callback detail must not replace queue outcome")
+
+    worker.register("fail", fail)
+    worker.register_terminal_failure("fail", callback_failed)
+
+    assert worker.run_once() is True
+    assert q.get(job_id).status == "failed"
+    assert "handler failed" in q.get(job_id).last_error
+    assert "terminal-failure callback failed" in caplog.text
+    assert "callback detail must not replace queue outcome" not in caplog.text
+
