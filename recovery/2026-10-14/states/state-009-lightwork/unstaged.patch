+{{- define "maverick.identityConfigSha256" -}}
+{{- include "maverick.identityConfigToml" . | sha256sum -}}
+{{- end -}}
+
+{{- define "maverick.identityConfigName" -}}
+{{- printf "%s-identity-%s" ((include "maverick.fullname" .) | trunc 40 | trimSuffix "-") ((include "maverick.identityConfigSha256" .) | trunc 12) | trunc 63 | trimSuffix "-" -}}
+{{- end -}}
