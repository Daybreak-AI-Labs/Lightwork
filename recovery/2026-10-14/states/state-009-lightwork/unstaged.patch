+        "must not be mounted in a serving pod."
+    ),
+)
+@click.option(
+    "--confirm-drained",
+    is_flag=True,
+    required=True,
+    help="Confirm all serving writers are drained before taking exclusive locks.",
+)
+def tenant_rls_apply(dsn_file: str, confirm_drained: bool) -> None:
+    """Atomically install the complete direct and child-table RLS policy set."""
+    import json
+
+    from ..world_model_backends import pg_rls
+
+    # Click enforces the required flag; retain the explicit guard so direct
+    # invocation cannot bypass the operational acknowledgement.
+    if not confirm_drained:
+        raise click.ClickException(
+            "refusing RLS apply until --confirm-drained is supplied"
+        )
+    resolved = _resolve_tenant_migration_dsn(dsn_file=dsn_file, dsn=None)
+    try:
+        conn = pg_rls.connect(resolved, autocommit=False)
+    except Exception as exc:
+        raise click.ClickException(
+            "could not connect with the migration-owner DSN file"
+        ) from exc
+    try:
+        report = pg_rls.apply(conn)
+    except (RuntimeError, ValueError) as exc:
+        raise click.ClickException(str(exc)) from exc
+    except Exception as exc:
+        raise click.ClickException("Postgres RLS policy installation failed") from exc
+    finally:
+        conn.close()
+    click.echo(json.dumps(report, sort_keys=True, separators=(",", ":")))
+
+
+def _resolve_tenant_migration_dsn(
+    *, dsn_file: str | None, dsn: str | None
+) -> str:
+    """Resolve an operations DSN without ever echoing its value."""
+    if dsn_file and dsn:
+        raise click.ClickException("use only one of --dsn-file or --dsn")
+    if dsn_file:
+        from pathlib import Path
+
+        from ..file_lock import read_custodied_text
+
+        path = Path(dsn_file)
+        try:
+            value = read_custodied_text(
+                path,
+                custody_root=path.parent,
+                max_bytes=16 * 1024,
+            ).strip()
+        except Exception as exc:
+            raise click.ClickException(
+                "migration-owner DSN file failed private custody validation"
+            ) from exc
+        if not value:
+            raise click.ClickException("migration-owner DSN file is empty")
+        return value
+    from ..world_model_backends import pg_rls
+
+    return pg_rls.resolve_dsn(dsn)
+
