+        raise FlowSnapshotError("flow node transition sequence is invalid") from exc
+    if isinstance(normalized["sequence"], bool) or sequence < 1:
+        raise FlowSnapshotError("flow node transition sequence is invalid")
+    normalized["sequence"] = sequence
+    try:
+        recorded_at = float(normalized["recorded_at"])
+    except (OverflowError, TypeError, ValueError) as exc:
+        raise FlowSnapshotError("flow node transition timestamp is invalid") from exc
