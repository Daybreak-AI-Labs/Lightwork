+def _verify_exact_tagged_source_contracts(
+    root: Path,
+    *,
+    version: str,
+    tagged_source_root: Path,
+) -> None:
+    """Reject even checksum-recomputed semantic substitutions.
+
+    The public-release verifier runs from the exact checked-out tag. These
+    governance assets are byte-for-byte copies made by the release workflow,
+    so the checkout is the independent authority; an asset and checksum file
+    cannot redefine the reviewed semantics together.
+    """
+
+    if not tagged_source_root.is_dir():
+        raise ValueError("exact tagged-source contract root is missing")
+    for stem, relative_source in _EXACT_SOURCE_CONTRACTS.items():
+        source = tagged_source_root / relative_source
+        asset = root / f"lightwork-{stem}-{version}.json"
+        if (
+            source.is_symlink()
+            or not source.is_file()
+            or asset.is_symlink()
+            or not asset.is_file()
+        ):
+            raise ValueError(f"{stem} exact tagged-source bytes are unavailable")
+        if _sha256(asset) != _sha256(source) or asset.read_bytes() != source.read_bytes():
+            raise ValueError(f"{stem} differs from exact tagged-source bytes")
+
