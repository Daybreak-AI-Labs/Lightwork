+def _json_object_asset(root: Path, name: str, *, label: str) -> Mapping[str, object]:
+    path = root / name
+    try:
+        document = json.loads(
+            path.read_text(encoding="utf-8"),
+            object_pairs_hook=_strict_object,
+            parse_constant=_reject_constant,
+        )
+    except (OSError, UnicodeDecodeError, json.JSONDecodeError, ValueError) as exc:
+        raise ValueError(f"{label} release asset is unreadable") from exc
+    if not isinstance(document, Mapping):
+        raise ValueError(f"{label} release asset is malformed")
+    return document
+
+
+def _source_bindings_are_exact(value: object, *, count: int) -> bool:
+    if not isinstance(value, list) or len(value) != count:
+        return False
+    paths: list[str] = []
+    for raw in value:
+        if not isinstance(raw, Mapping) or set(raw) != {
+            "path",
+            "sha256",
+            "digest_mode",
+        }:
+            return False
+        path = raw.get("path")
+        digest = raw.get("sha256")
+        if (
+            not isinstance(path, str)
+            or not path
+            or PurePosixPath(path).is_absolute()
+            or ".." in PurePosixPath(path).parts
+            or not isinstance(digest, str)
+            or _DIGEST_RE.fullmatch(digest) is None
+            or digest == "0" * 64
+            or raw.get("digest_mode") != "utf8-lf-sha256"
+        ):
+            return False
+        paths.append(path)
+    return len(paths) == len(set(paths))
+
