+        _dek_cache_ttl()
+    except Exception:
+        violations.append("production DEK cache TTL is absent, invalid, or unbounded")
+
+    try:
+        from .secret_provider import get_secret
+
+        key_id = get_secret("MAVERICK_KMS_KEY_ID")
+        vault_token = get_secret("VAULT_TOKEN") if provider == "vault" else "not-required"
+    except Exception:
+        key_id = None
+        vault_token = None
+    if not str(key_id or "").strip():
+        violations.append("off-host KMS key identity is unavailable from provider custody")
+    if provider == "vault":
+        from urllib.parse import urlparse
+
+        address = (
+            os.environ.get("VAULT_ADDR")
+            or str(kms_cfg.get("address") or "")
+        ).strip()
+        parsed = urlparse(address)
+        try:
+            _ = parsed.port
+            valid_port = True
+        except ValueError:
+            valid_port = False
+        if (
+            parsed.scheme.lower() != "https"
+            or not parsed.hostname
+            or not valid_port
+            or any(char.isspace() for char in address)
+            or parsed.username is not None
+            or parsed.password is not None
+            or parsed.query
+            or parsed.fragment
