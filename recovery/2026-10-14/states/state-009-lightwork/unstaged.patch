+            payload.get("inputs"), field="flow resume inputs"
+        )
+        expected_request = _flow_resume_request_fingerprint(
+            flow_id=str(payload.get("flow_id") or ""),
+            run_id=str(payload.get("run_id") or ""),
+            pause_fingerprint=pause_fingerprint,
+            decision=str(payload.get("decision") or "").strip(),
+            decided_by=str(payload.get("decided_by") or "").strip(),
+            inputs=normalized_inputs,
+            expired=bool(payload.get("expired")),
+            from_failure=bool(payload.get("from_failure")),
+            tenant=str(payload.get("tenant") or ""),
+            owner=str(payload.get("owner") or ""),
