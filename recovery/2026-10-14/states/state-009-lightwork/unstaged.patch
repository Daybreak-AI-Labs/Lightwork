+def test_copied_live_async_context_keeps_outer_admission_counted():
+    async def exercise() -> None:
+        child_entered = asyncio.Event()
+        release_child = asyncio.Event()
+
+        async def child() -> None:
+            with runner.work_admission() as accepted:
+                assert accepted is True
+                child_entered.set()
+                await release_child.wait()
+
+        with runner.work_admission() as outer:
+            assert outer is True
+            task = asyncio.create_task(child())
+            await child_entered.wait()
+        # The outer scope ended, but the copied child holder keeps the same
+        # single admission live and therefore visible to shutdown.
+        assert runner.begin_draining() == 1
+        assert runner.admitted_work() == 1
+        release_child.set()
+        await task
+
+    asyncio.run(exercise())
+    assert runner.admitted_work() == 0
