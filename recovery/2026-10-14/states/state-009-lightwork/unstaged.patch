+def connector_support_catalog() -> list[dict[str, str]]:
+    """Classify every known external integration without implying support.
+
+    This inventory covers the long-tail REST/GraphQL definitions, derived
+    read-only variants, public-data adapters, dedicated modules offered by the
+    installer, and every remaining credential-bearing integration known to the
+    authenticated-enterprise deny gate. It deliberately contains no
+    ``certified`` or ``supported_beta`` entries: the repository has no retained
+    upstream conformance evidence for them, and the first production profile
+    admits no connectors.
+    """
+    entries: dict[str, dict[str, str]] = {}
+
+    def add(
+        name: str,
+        *,
+        label: str,
+        source_class: str,
+        support_tier: str,
+    ) -> None:
+        if support_tier not in CONNECTOR_SUPPORT_TIERS:  # pragma: no cover
+            raise ValueError(f"invalid connector support tier: {support_tier}")
+        current = entries.get(name)
+        proposed = {
+            "name": name,
+            "label": label,
+            "source_class": source_class,
+            "support_tier": support_tier,
+            "production_status": PRODUCTION_CONNECTOR_STATUS,
+        }
+        if current is not None and current != proposed:
+            raise ValueError(f"connector support classification collision: {name}")
+        entries[name] = proposed
+
+    for spec in _SPECS + _GRAPHQL_SPECS:
+        add(
+            spec["name"],
+            label=_label_from_desc(spec["description"]),
+            source_class="long_tail_rest_graphql",
+            support_tier="generated_experimental",
+        )
+    public_names = set(PUBLIC_DATA_CONNECTOR_NAMES)
+    for spec in _READ_SPECS:
+        add(
+            spec["name"],
+            label=_label_from_desc(spec["description"]),
+            source_class=(
+                "public_data_read" if spec["name"] in public_names
+                else "derived_read"
+            ),
+            support_tier="generated_experimental",
+        )
+    for entry in _BESPOKE_CATALOG:
+        add(
+            entry["name"],
+            label=entry["label"],
+            source_class="dedicated_module",
+            support_tier="unsupported",
+        )
+
+    # Import lazily to avoid the tools-package initialization cycle.
+    from . import AUTHENTICATED_AMBIENT_CRED_TOOL_NAMES
+
+    for name in AUTHENTICATED_AMBIENT_CRED_TOOL_NAMES:
+        if name in entries:
+            continue
+        add(
+            name,
+            label=name.replace("_", " ").title(),
+            source_class="ambient_credential_module",
+            support_tier="unsupported",
+        )
+    return [entries[name] for name in sorted(entries)]
