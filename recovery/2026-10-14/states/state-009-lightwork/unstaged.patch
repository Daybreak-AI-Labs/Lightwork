+{{/* Validate one identity/RBAC scalar before it can enter the public ConfigMap. */}}
+{{- define "maverick.validateIdentityString" -}}
+{{- $label := index . 0 -}}
+{{- $value := index . 1 -}}
+{{- $required := index . 2 -}}
+{{- if not (kindIs "string" $value) -}}
+{{- fail (printf "production.enforce requires %s to be a string." $label) -}}
+{{- end -}}
+{{- $text := toString $value -}}
+{{- if or (ne $text (trim $text)) (gt (len $text) 2048) (not (regexMatch "^[^[:cntrl:]]*$" $text)) -}}
+{{- fail (printf "production.enforce requires %s to be a bounded, trimmed printable string." $label) -}}
+{{- end -}}
+{{- if contains "${" $text -}}
+{{- fail (printf "production.enforce forbids environment interpolation in secret-free identity field %s." $label) -}}
+{{- end -}}
+{{- if and $required (not $text) -}}
+{{- fail (printf "production.enforce requires non-empty %s." $label) -}}
+{{- end -}}
+{{- end -}}
