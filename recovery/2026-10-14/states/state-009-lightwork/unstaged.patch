+    def test_authoritative_hydration_rejects_rehashed_tamper(self, tmp_path):
+        world, gid, store = self._indexed_world_goal(tmp_path)
+        doc, meta, emb = store.docs[f"goal:{gid}"]
+        meta["source_sha256"] = "0" * 64
+        # Model a store writer who also recomputes the unkeyed metadata checksum;
+        # hydration must still compare to the authoritative world record.
+        meta["integrity_sha256"] = sr._metadata_integrity(meta)
