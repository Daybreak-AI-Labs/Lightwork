+    displaced = record_path.with_name("displaced.json")
+    real_open = privacy_ops.os.open
+    swapped = False
+
+    def swapping_open(path, flags, mode=0o777, *, dir_fd=None):
+        nonlocal swapped
+        candidate = Path(path)
+        if not swapped and dir_fd is not None and candidate.name == record_path.name:
+            swapped = True
+            os.replace(record_path, displaced)
+            os.mkfifo(record_path, 0o600)
+            assert flags & os.O_NONBLOCK
+        if dir_fd is None:
+            return real_open(path, flags, mode)
+        return real_open(path, flags, mode, dir_fd=dir_fd)
+
+    monkeypatch.setattr(privacy_ops.os, "open", swapping_open)
+    with pytest.raises(PermissionError, match="changed during open"):
