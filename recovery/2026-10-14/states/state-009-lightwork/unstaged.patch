+{{- if eq .Values.identity.mode "oidc" -}}
+{{- range $field := list "issuer" "audience" "jwksUri" "clientId" -}}
+{{- if not (get $oidc $field) -}}
+{{- fail (printf "production.enforce OIDC mode requires identity.config.oidc.%s." $field) -}}
+{{- end -}}
+{{- end -}}
+{{- if not $algorithms -}}
+{{- fail "production.enforce OIDC mode requires one or more asymmetric algorithms." -}}
+{{- end -}}
+{{- range $field := list "issuer" "jwksUri" "redirectUri" "authorizationEndpoint" "tokenEndpoint" -}}
+{{- $url := get $oidc $field -}}
+{{- if and $url (not (regexMatch "^https://[^/?#@[:space:]]+(:[0-9]+)?(/[^?#[:space:]]*)?$" $url)) -}}
+{{- fail (printf "production.enforce requires identity.config.oidc.%s to be a credential-free HTTPS URL." $field) -}}
+{{- end -}}
+{{- end -}}
+{{- if ne (not (empty (get $oidc "authorizationEndpoint"))) (not (empty (get $oidc "tokenEndpoint"))) -}}
