+    incident_id: str | None,
+    action_id: str | None,
+    output: str,
+) -> None:
+    """Issue a strict, signed tenant/customer audit-evidence packet.
+
+    Unlike JSONL/CEF re-emission, this refuses malformed or unsigned source
+    rows, includes complete selected segments and anchor commitments, proves
+    the exact bounded selector result, and signs the whole packet. The packet's
+    publisher public key must be delivered to the verifier independently.
+    """
+    import getpass as _getpass
+    import hashlib as _hashlib
+    import json as _json
+    from pathlib import Path as _Path
+
+    from ..billing import feature_allowed
+    from ..connections import current_principal
+    from ..paths import current_tenant_id_strict
+
+    active_tenant = current_tenant_id_strict()
+    if not active_tenant:
+        raise click.ClickException(
+            "audit evidence export requires an explicit active tenant"
+        )
+    if tenant is not None and tenant != active_tenant:
+        raise click.ClickException(
+            "audit evidence tenant must equal the active tenant; switch tenant "
+            "context before export"
+        )
+    effective_tenant = active_tenant
+    if not feature_allowed("audit_export", tenant=effective_tenant):
+        raise click.ClickException(
+            f"tenant {effective_tenant!r} is not entitled to audit evidence export"
+        )
+    output_path = _Path(output)
+    output_resolved = output_path.resolve(strict=False)
+    from ..audit.export import audit_event_paths
+
+    for source in audit_event_paths(
+        day=day,
+        all_days=all_days,
+        since=since,
+        until=until,
+        tenant=effective_tenant,
+    ):
+        if output_resolved == source.resolve(strict=False):
+            raise click.ClickException("refusing to overwrite source audit evidence")
+
+    export_id = str(uuid.uuid4())
+    context = {
+        "export_id": export_id,
+        "actor": str(current_principal() or f"os:{_getpass.getuser()}")[:256],
+        "tenant": effective_tenant,
+        "day": day,
+        "all_days": bool(all_days),
+        "since": since,
+        "until": until,
+        "goal_id": goal_id,
+        "incident_id": incident_id,
+        "action_id": action_id,
+        "filename": output_path.name,
+        "destination_path_sha256": _hashlib.sha256(
+            str(output_resolved).encode("utf-8")
+        ).hexdigest(),
+    }
+    from ..audit import required_audit_event
+
+    required_audit_event(
+        "audit_evidence_export_authorized",
+        agent="cli",
+        _global=True,
+        state="AUTHORIZED",
+        **context,
+    )
+    from ..audit.evidence import AuditEvidenceError, build_evidence_bundle
+    try:
+        packet = build_evidence_bundle(
+            tenant=effective_tenant,
+            day=day,
+            all_days=all_days,
+            since=since,
+            until=until,
+            goal_id=goal_id,
+            incident_id=incident_id,
+            action_id=action_id,
+        )
+    except AuditEvidenceError as exc:
+        raise click.ClickException(str(exc)) from exc
+    body = _json.dumps(packet, indent=2, sort_keys=True, default=str) + "\n"
+    from ..file_lock import atomic_write_text
+
+    atomic_write_text(output_path, body, mode=0o600)
+    digest = _hashlib.sha256(body.encode("utf-8")).hexdigest()
+    required_audit_event(
+        "audit_evidence_export_completed",
+        agent="cli",
+        _global=True,
+        state="COMMITTED",
+        content_sha256=digest,
+        segment_count=packet["summary"]["segment_count"],
+        source_row_count=packet["summary"]["source_row_count"],
+        match_count=packet["summary"]["match_count"],
+        **context,
+    )
+    click.echo(
+        f"signed evidence written: {output_path} "
+        f"(sha256={digest}, matches={packet['summary']['match_count']})"
+    )
+
