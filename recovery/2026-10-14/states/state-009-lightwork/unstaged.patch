+{{- if or (not $header) (not (regexMatch "^[!#$%&'*+.^_`|~0-9A-Za-z-]{1,128}$" $header)) (has (lower $header) (list "authorization" "cookie" "host" "proxy-authorization" "x-forwarded-for")) -}}
+{{- fail "production.enforce trustedProxy mode requires one safe identity header." -}}
+{{- end -}}
+{{- if not $trustedProxies -}}
+{{- fail "production.enforce trustedProxy mode requires one or more exact trustedProxies." -}}
+{{- end -}}
+{{- if or (get $oidc "issuer") (get $oidc "audience") (get $oidc "jwksUri") $algorithms (get $oidc "clientId") (get $oidc "redirectUri") (get $oidc "authorizationEndpoint") (get $oidc "tokenEndpoint") -}}
+{{- fail "production.enforce trustedProxy mode rejects inactive OIDC configuration residue." -}}
+{{- end -}}
+{{- end -}}
+{{- end -}}
