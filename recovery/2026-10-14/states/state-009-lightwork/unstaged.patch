+def test_assessment_routes_use_saved_department_after_template_move(monkeypatch):
+    """Republishing a questionnaire cannot move an existing auth boundary."""
+    from maverick.assessment import (
+        AssessmentSession,
+        save_custom_template,
+        save_session,
+    )
+    from maverick_dashboard import rbac, suite_grants
+
+    payload = {
+        "type": "quarterly_controls",
+        "title": "Quarterly Controls",
+        "framework": "internal controls",
+        "department": "finance",
+        "questions": [{
+            "text": "Were reconciliations independently reviewed?",
+            "risk_answer": "no",
+            "severity": "high",
+        }],
+    }
+    first = save_custom_template(payload)
+    assessment = AssessmentSession(
+        type="quarterly_controls", subject="Pinned finance review",
+    )
+    assessment.record(first.questions[0].id, "yes")
+    save_session(assessment)
+
+    save_custom_template(
+        {**payload, "department": "privacy", "title": "Moved controls"},
+        expected_revision=first.revision,
+        expected_digest=first.digest,
+    )
+
+    rbac.set_role("user:privacy", "operator")
+    suite_grants.set_suites("user:privacy", ["privacy"])
+    _as(monkeypatch, "user:privacy")
+    listing = client.get("/api/v1/assess/sessions")
+    assert listing.status_code == 200
+    assert assessment.id not in {row["id"] for row in listing.json()["sessions"]}
+    assert client.get(
+        f"/api/v1/assess/sessions/{assessment.id}"
+    ).status_code == 403
+
+    rbac.set_role("user:finance", "operator")
+    suite_grants.set_suites("user:finance", ["finance"])
+    _as(monkeypatch, "user:finance")
+    listing = client.get("/api/v1/assess/sessions")
+    assert listing.status_code == 200
+    saved = next(
+        row for row in listing.json()["sessions"] if row["id"] == assessment.id
+    )
+    assert saved["department"] == "finance"
+    assert client.get(
+        f"/api/v1/assess/sessions/{assessment.id}"
+    ).status_code == 200
+
