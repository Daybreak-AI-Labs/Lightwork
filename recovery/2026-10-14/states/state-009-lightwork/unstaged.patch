+```bash
+export MAVERICK_PG_MIGRATION_DSN_FILE=/var/run/secrets/lightwork-migrator/dsn
+
+# Value-free preview of exact per-table scope.
+maverick tenant postgres-inventory acme --confirm-drained
+
+# Exact DB artifact. Application-sealed fields remain ciphertext.
+maverick tenant postgres-export acme \
+  --out /secure/acme-postgres.json --confirm-drained
+
+# Create the other required artifact for local audit, keys, memory, and policy.
+MAVERICK_TENANT=acme maverick backup create \
+  --out /secure/acme-local.tgz
+
+# Irreversible DB + local finalization; signed audit is retained by default.
