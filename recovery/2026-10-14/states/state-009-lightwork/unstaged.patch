+        "request_fingerprint": request_fingerprint,
+        "automatic_expiry": automatic_expiry,
+        "scheduled_for": float(run_at) if run_at is not None else None,
+        "created_at": time.time(),
+    }
+    existing_claim = store.load_resume_claim(run.run_id, pause_fingerprint)
+    if existing_claim is None:
