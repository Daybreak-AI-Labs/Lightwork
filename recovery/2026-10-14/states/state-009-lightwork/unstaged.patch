+def test_assessment_routes_cannot_cross_active_tenant(monkeypatch):
+    """List, read, follow-up, and decision stay in request tenant storage."""
+    from maverick.assessment import load_saved
+    from maverick.paths import reset_tenant, set_tenant
+    from maverick_dashboard import rbac, suite_grants
+
+    tenant_a = set_tenant("tenant-a")
+    try:
+        assessment = _seed("sox_control", "Tenant A controls")
+        revision = load_saved(assessment.id)["revision"]
+    finally:
+        reset_tenant(tenant_a)
+
+    rbac.set_role("user:finance", "operator")
+    suite_grants.set_suites("user:finance", ["finance"])
+    _as(monkeypatch, "user:finance")
+
+    tenant_b = set_tenant("tenant-b")
+    try:
+        listing = client.get("/api/v1/assess/sessions")
+        assert listing.status_code == 200
+        assert listing.json()["sessions"] == []
+        assert client.get(
+            f"/api/v1/assess/sessions/{assessment.id}"
+        ).status_code == 404
+        assert client.post(
+            f"/api/v1/assess/sessions/{assessment.id}/followups",
+            json={
+                "questions": ["Cross-tenant question"],
+                "expected_revision": revision,
+            },
+        ).status_code == 404
+        assert client.post(
+            f"/api/v1/assess/sessions/{assessment.id}/decide",
+            json={"decision": "approved", "expected_revision": revision},
+        ).status_code == 404
+    finally:
+        reset_tenant(tenant_b)
+
+    tenant_a = set_tenant("tenant-a")
+    try:
+        unchanged = load_saved(assessment.id)
+        assert unchanged["revision"] == revision
+        assert unchanged["status"] == "pending_review"
+        assert not unchanged.get("followups")
+    finally:
+        reset_tenant(tenant_a)
