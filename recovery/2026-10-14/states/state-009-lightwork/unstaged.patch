+def validate_applied_migration_prefix(
+    applied_versions: Iterator[object],
+    migrations: list[tuple[int, list[str]]] | None = None,
+) -> tuple[int, ...]:
+    """Return an applied ledger only when it is an exact ordered ladder prefix.
+
+    A maximum-version check is insufficient: ``[1, 11]`` and the complete
+    prefix ending at v11 have the same maximum but materially different schema.
+    The database query feeding this helper must therefore retain every row.
+    """
+    migs = MIGRATIONS if migrations is None else migrations
+    expected = tuple(version for version, _statements in sorted(migs))
+    if not expected or any(type(version) is not int or version <= 0 for version in expected):
+        raise ValueError("expected migration ladder must contain positive exact integers")
+    if len(set(expected)) != len(expected):
+        raise ValueError("expected migration ladder contains duplicate versions")
+
+    applied_values = tuple(applied_versions)
+    if any(type(version) is not int for version in applied_values):
+        raise ValueError("applied migration versions must be exact integers")
+    if applied_values != expected[: len(applied_values)]:
+        raise ValueError(
+            "applied migration ledger is newer, gapped, duplicated, out of "
+            "order, or not an exact reviewed prefix"
+        )
+    return applied_values
