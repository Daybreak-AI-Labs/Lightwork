+        sort_keys=True,
+        separators=(",", ":"),
+        ensure_ascii=False,
+        allow_nan=False,
+    ))
+
+
+def _citation(goal_id: object, source_version: str) -> str:
+    return f"world-goal:{goal_id}:{source_version}"
