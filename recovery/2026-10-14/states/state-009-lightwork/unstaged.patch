+def test_assessment_session_routes_enforce_record_department(monkeypatch):
+    """A generic operate role cannot list, read, or mutate another suite."""
+    finance = _seed("sox_control", "Q3 revenue controls")
+    privacy = _seed("pia", "Acme CRM")
+    from maverick.assessment import load_saved
+    from maverick_dashboard import rbac, suite_grants
+
+    finance_revision = load_saved(finance.id)["revision"]
+    rbac.set_role("user:legal", "operator")
+    suite_grants.set_suites("user:legal", ["legal"])
+    _as(monkeypatch, "user:legal")
+
+    listing = client.get("/api/v1/assess/sessions")
+    assert listing.status_code == 200
+    assert listing.json()["sessions"] == []
+    assert client.get(
+        f"/api/v1/assess/sessions/{finance.id}"
+    ).status_code == 403
+
+    mutations = (
+        ("followups", {
+            "questions": ["Who approved this?"],
+            "expected_revision": finance_revision,
+        }),
+        ("decide", {
+            "decision": "approved",
+            "expected_revision": finance_revision,
+        }),
+        ("assign", {
+            "assignee": "user:legal",
+            "expected_revision": finance_revision,
+        }),
+        ("accept-risk", {
+            "rationale": "Accepted by the wrong department",
+            "expected_revision": finance_revision,
+        }),
+        ("trigger-review", {
+            "reason": "Cross-department request",
+            "expected_revision": finance_revision,
+        }),
+    )
+    for action, body in mutations:
+        response = client.post(
+            f"/api/v1/assess/sessions/{finance.id}/{action}", json=body,
+        )
+        assert response.status_code == 403, (action, response.text)
+
+    # Authorization runs before any rewrite: repeated denied attempts leave the
+    # immutable type and CAS revision untouched.
+    after = load_saved(finance.id)
+    assert after["revision"] == finance_revision
+    assert after["type"] == "sox_control"
+
+    rbac.set_role("user:fin", "operator")
+    suite_grants.set_suites("user:fin", ["finance"])
+    _as(monkeypatch, "user:fin")
+
+    listing = client.get("/api/v1/assess/sessions")
+    assert listing.status_code == 200
+    assert [row["id"] for row in listing.json()["sessions"]] == [finance.id]
+    assert client.get(
+        f"/api/v1/assess/sessions/{finance.id}"
+    ).status_code == 200
+    assert client.get(
+        f"/api/v1/assess/sessions/{privacy.id}"
+    ).status_code == 403
+
