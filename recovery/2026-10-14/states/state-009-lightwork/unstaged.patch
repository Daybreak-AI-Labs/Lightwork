+class _PolicyCursor(RecordingCursor):
+    def __init__(
+        self,
+        policies: list[tuple],
+        *,
+        rls_enabled: bool = True,
+        rls_forced: bool = True,
+    ) -> None:
+        super().__init__()
+        self.policies = policies
+        self.rls_enabled = rls_enabled
+        self.rls_forced = rls_forced
+        self.result: tuple | list[tuple] | None = None
+
+    def execute(self, sql: str, params=None) -> None:
+        super().execute(sql, params)
+        normalized = sql.strip().upper()
+        if normalized.startswith("ALTER TABLE"):
+            if "ENABLE ROW LEVEL SECURITY" in normalized:
+                self.rls_enabled = True
+            elif "FORCE ROW LEVEL SECURITY" in normalized:
+                self.rls_forced = True
+            self.result = None
+        elif normalized.startswith("CREATE POLICY"):
+            table = sql.split()[4]
+            self.policies.append(_policy_tuple(table))
+            self.result = None
+        elif "FROM pg_catalog.pg_class" in sql:
+            self.result = (self.rls_enabled, self.rls_forced)
+        elif "FROM pg_catalog.pg_policies" in sql:
+            self.result = list(self.policies)
+        else:
+            self.result = None
+
+    def fetchone(self):
+        if isinstance(self.result, list):
+            return self.result[0] if self.result else None
+        return self.result
+
+    def fetchall(self):
+        if isinstance(self.result, list):
+            return list(self.result)
+        return [] if self.result is None else [self.result]
+
+
+def _policy_tuple(table: str, expression: str | None = None) -> tuple:
+    predicate = expression or pg_rls.policy_predicate(table)
+    return (
+        "mvk_tenant_isolation",
+        "PERMISSIVE",
+        ["public"],
+        "ALL",
+        predicate,
+        predicate,
+    )
+
+
+def _policy_is_active(
+    monkeypatch,
+    table: str,
+    expression: str | None = None,
+    *,
+    policies: list[tuple] | None = None,
