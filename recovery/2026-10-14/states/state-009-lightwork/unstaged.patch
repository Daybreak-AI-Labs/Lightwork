+def _canonical_transition(value: Mapping[str, object]) -> str:
+    try:
+        return json.dumps(
+            dict(value),
+            allow_nan=False,
+            ensure_ascii=True,
+            separators=(",", ":"),
+            sort_keys=True,
+        )
+    except (TypeError, ValueError, RecursionError) as exc:
+        raise FlowSnapshotError("flow node transition is not canonical JSON") from exc
