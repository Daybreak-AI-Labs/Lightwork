+    first = world.arm_halt("first", source="new")
+    assert first["generation"] == 1
+
+    # Pre-v33 clear code issued DELETE. The compatibility trigger converts it
+    # to an inactive tombstone so the generation can never restart at one.
+    with world._writing() as conn:
+        conn.execute("DELETE FROM halt WHERE scope = ''")
+        tombstone = conn.execute(
+            "SELECT generation, active FROM halt WHERE scope = ''"
+        ).fetchone()
+    assert tuple(tombstone) == (1, 0)
     assert world.active_halt() is None
 
+    # Pre-v33 arm code updated only the arm fields. Translate that write into
+    # an active, generation-advancing arm. Current code already changes both
+    # generation and active, so its later arm must advance exactly once.
+    with world._writing() as conn:
+        conn.execute(
+            "UPDATE halt SET reason = ?, source = ?, armed_by = ?, armed_at = ? "
+            "WHERE scope = ''",
