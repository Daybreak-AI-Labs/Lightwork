+{{- end -}}
+{{- $roles := get $kernel "roles" -}}
+{{- if not (kindIs "map" $roles) -}}
+{{- fail "production.enforce requires identity.config.kernel.roles to be a table." -}}
+{{- end -}}
+{{- range $name, $scope := $roles -}}
+{{- include "maverick.validateIdentityString" (list "identity.config.kernel.roles name" $name true) -}}
+{{- if not (kindIs "map" $scope) -}}
+{{- fail (printf "production.enforce requires identity.config.kernel.roles[%s] to be a table." $name) -}}
+{{- end -}}
+{{- range $field, $_ := $scope -}}
+{{- if not (has $field (list "allowTools" "denyTools" "maxRisk" "allowPaths" "allowHosts")) -}}
+{{- fail (printf "production.enforce kernel role %s contains unsupported field %s." $name $field) -}}
+{{- end -}}
+{{- end -}}
+{{- range $field := list "allowTools" "denyTools" "allowPaths" "allowHosts" -}}
+{{- $items := get $scope $field -}}
+{{- if not (kindIs "slice" $items) -}}
+{{- fail (printf "production.enforce requires kernel role %s.%s to be a string list." $name $field) -}}
+{{- end -}}
+{{- range $item := $items -}}
+{{- include "maverick.validateIdentityString" (list (printf "identity.config.kernel.roles[%s].%s entry" $name $field) $item true) -}}
+{{- end -}}
+{{- end -}}
+{{- include "maverick.validateIdentityString" (list (printf "identity.config.kernel.roles[%s].maxRisk" $name) (get $scope "maxRisk") false) -}}
+{{- if and (get $scope "maxRisk") (not (has (get $scope "maxRisk") (list "low" "medium" "high"))) -}}
+{{- fail "production.enforce kernel role maxRisk must be low, medium, high, or empty." -}}
+{{- end -}}
+{{- end -}}
+{{- $assignments := get $kernel "roleAssignments" -}}
+{{- if not (kindIs "map" $assignments) -}}
+{{- fail "production.enforce requires identity.config.kernel.roleAssignments to be a table." -}}
+{{- end -}}
+{{- range $principal, $role := $assignments -}}
+{{- include "maverick.validateIdentityString" (list "identity.config.kernel.roleAssignments principal" $principal true) -}}
+{{- include "maverick.validateIdentityString" (list (printf "identity.config.kernel.roleAssignments[%s]" $principal) $role true) -}}
+{{- if not (hasKey $roles $role) -}}
+{{- fail (printf "production.enforce kernel role assignment references unknown role %s." $role) -}}
+{{- end -}}
+{{- end -}}
