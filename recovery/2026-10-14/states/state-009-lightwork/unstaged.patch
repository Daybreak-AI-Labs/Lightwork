+def _startup_recovery_tenants(automation_queue) -> list[str]:
+    """Return every durable tenant scope that startup maintenance must visit.
+
+    The serving Postgres role cannot and must not bypass forced RLS for a global
+    scan. Authentication therefore reserves an immutable namespace claim before
+    any tenant transaction begins. The single-replica control plane persists
+    those claims on its governed volume and re-enters each exact scope here.
+    """
+    from maverick.paths import (
+        list_bound_tenant_namespaces,
+    )
+    from maverick.tenant.registry import (
+        TenantSuspended,
+        assert_execution_tenant_active,
+        assert_tenant_active,
+        list_tenants,
+        principal_for_api_tenant,
+    )
+
+    base = automation_queue._configured_tenant_floor()
+    if base:
+        # No roster means legacy single-tenant mode and this is a no-op. Once a
+        # roster exists, an unknown or suspended configured floor is fatal.
+        assert_tenant_active(base)
+    ordered = [base]
+    seen = {base}
+    records = list(list_tenants())
+    for record in records:
+        tenant = str(getattr(record, "id", "") or "").strip()
+        if not tenant or not getattr(record, "active", False) or tenant in seen:
+            continue
+        assert_tenant_active(tenant)
+        seen.add(tenant)
+        ordered.append(tenant)
+    for tenant in list_bound_tenant_namespaces():
+        if not tenant or tenant in seen:
+            continue
+        try:
+            assert_execution_tenant_active(
+                tenant,
+                principal_id=principal_for_api_tenant(tenant),
+            )
+        except TenantSuspended:
+            # Namespace claims are intentionally immutable and survive
+            # deprovisioning. An inactive identity has no runnable work.
+            continue
+        seen.add(tenant)
+        ordered.append(tenant)
+    return ordered
+
+
+def _reclaim_current_tenant_orphans(*, production: bool, automation_queue) -> int:
+    """Repair or quarantine orphan goals in the explicitly pinned tenant."""
+    wm = _world()  # honor the configured backend (SQLite or Postgres)
+    candidates = {
+        goal.id: goal.status
+        for status in ("active", "pending")
+        for goal in wm.list_goals(status=status, limit=100_000)
+    }
+    n = 0
+    if production:
+        # Every production HTTP goal is backed by the dashboard queue. A
+        # pending row with no live delivery is the create->enqueue crash
+        # window; waiting for the generic stale timeout would leave callers
+        # polling a task that can never run. Active rows retain the stale
+        # timeout because another worker may still be finishing one.
+        raw_age = os.environ.get("MAVERICK_ORPHAN_RECLAIM_SECONDS", "60")
+        try:
+            active_age = float(raw_age)
+            if not math.isfinite(active_age):
+                raise ValueError
+            active_age = max(0.0, active_age)
+        except (TypeError, ValueError, OverflowError):
+            active_age = 60.0
+        cutoff = time.time() - active_age
+        for goal_id, prior_status in candidates.items():
+            current = wm.get_goal(goal_id)
+            if current is None or current.status != prior_status:
+                continue
+            if prior_status == "pending":
+                if automation_queue.goal_run_job_status(goal_id):
+                    continue
+                try:
+                    dispatch_outbox = wm.get_goal_idempotent_dispatch(goal_id)
+                except Exception as exc:
+                    from maverick.api_idempotency import (
+                        ApiIdempotencyIndeterminate,
+                    )
+
+                    if not isinstance(exc, ApiIdempotencyIndeterminate):
+                        raise
+                    # One corrupt or unavailable historical envelope is not
+                    # authority to skip every other tenant-local recovery. The
+                    # affected goal is quarantined with a content-free reason;
+                    # healthy outboxes continue through this same pass.
+                    detail = (
+                        "transactional goal dispatch recovery state is "
+                        "indeterminate"
+                    )
+                    wm.set_goal_status(goal_id, "blocked", result=detail)
+                    n += 1
+                    continue
+                if dispatch_outbox is not None:
+                    from .task_dispatch import repair_idempotent_goal_dispatch
+
+                    repair_idempotent_goal_dispatch(goal_id, dispatch_outbox)
+                    if not automation_queue.goal_run_job_status(goal_id):
+                        raise RuntimeError(
+                            "transactional goal outbox repair did not create "
+                            "a live delivery"
+                        )
+                    continue
+                detail = (
+                    "control plane restarted before durable task dispatch "
+                    "was recorded"
+                )
+            else:
+                try:
+                    updated_at = float(current.updated_at)
+                except (TypeError, ValueError, OverflowError):
+                    updated_at = 0.0
+                if updated_at > cutoff:
+                    continue
+                detail = (
+                    "control plane restarted after goal execution began; "
+                    "external effects may have committed"
+                )
+            wm.set_goal_status(goal_id, "blocked", result=detail)
+            n += 1
+    else:
+        n = wm.reclaim_orphan_goals()
+    if n:
+        from maverick.failure_taxonomy import (
+            FailureKind,
+            failure_state,
+            persist_goal_state,
+        )
+
+        for goal_id, prior_status in candidates.items():
+            current = wm.get_goal(goal_id)
+            if current is None or current.status != "blocked":
+                continue
+            kind = (
+                FailureKind.INDETERMINATE_EFFECT
+                if prior_status == "active"
+                else FailureKind.PROVIDER_FAILURE
+            )
+            detail = current.result or (
+                "control plane restarted after goal execution began; external "
+                "effects may have committed"
+                if prior_status == "active"
+                else "control plane restarted before durable task dispatch was recorded"
+            )
+            persist_goal_state(
+                wm,
+                goal_id,
+                failure_state(kind, detail, origin="runtime"),
+            )
+    return n
 
 
