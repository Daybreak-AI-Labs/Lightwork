+    from maverick_dashboard import automation_queue as aq
+
+    monkeypatch.delenv("MAVERICK_REQUIRE_PRODUCTION_SURFACE", raising=False)
+    real_load = store.load_published_bundle
+    for published in (False, True):
+        current = store.save_flow(Flow(
+            id=f"lookup-transition-{published}",
+            name="Before",
+            start="a",
+            nodes={"a": FlowNode(id="a", kind="action", tool="web_search")},
+        ))
+        if published:
