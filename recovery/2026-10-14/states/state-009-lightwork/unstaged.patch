+{{/*
+Secret-free config consumed by runtime_identity_posture and the dashboard RBAC
+resolvers. JSON strings/arrays are valid TOML values and avoid key injection.
+Credential fields are deliberately impossible to render from chart values.
+*/}}
+{{- define "maverick.identityConfigToml" -}}
+{{- $config := .Values.identity.config -}}
+{{- if eq .Values.identity.mode "oidc" }}
+[auth.oidc]
+enabled = true
+issuer = {{ $config.oidc.issuer | toJson }}
+audience = {{ $config.oidc.audience | toJson }}
+jwks_uri = {{ $config.oidc.jwksUri | toJson }}
+algorithms = {{ $config.oidc.algorithms | toJson }}
+client_id = {{ $config.oidc.clientId | toJson }}
+redirect_uri = {{ $config.oidc.redirectUri | toJson }}
+authorization_endpoint = {{ $config.oidc.authorizationEndpoint | toJson }}
+token_endpoint = {{ $config.oidc.tokenEndpoint | toJson }}
+{{- else }}
+[auth.proxy]
+enabled = true
+header = {{ $config.trustedProxy.header | toJson }}
+trusted_proxies = {{ $config.trustedProxy.trustedProxies | toJson }}
+trust_loopback = false
+{{- end }}
+
+[dashboard]
+default_role = {{ $config.dashboard.defaultRole | toJson }}
+admins = {{ $config.dashboard.admins | toJson }}
+default_suites = {{ $config.dashboard.defaultSuites | toJson }}
+
+[dashboard.group_roles]
+{{- range $group, $role := $config.dashboard.groupRoles }}
+{{ $group | toJson }} = {{ $role | toJson }}
+{{- end }}
+
+[dashboard.group_suites]
+{{- range $group, $suites := $config.dashboard.groupSuites }}
+{{ $group | toJson }} = {{ $suites | toJson }}
+{{- end }}
+{{- range $name, $scope := $config.kernel.roles }}
+
+[roles.{{ $name | toJson }}]
+allow_tools = {{ get $scope "allowTools" | toJson }}
+deny_tools = {{ get $scope "denyTools" | toJson }}
+allow_paths = {{ get $scope "allowPaths" | toJson }}
+allow_hosts = {{ get $scope "allowHosts" | toJson }}
+{{- if get $scope "maxRisk" }}
+max_risk = {{ get $scope "maxRisk" | toJson }}
+{{- end }}
+{{- end }}
+
+[role_assignments]
+{{- range $principal, $role := $config.kernel.roleAssignments }}
+{{ $principal | toJson }} = {{ $role | toJson }}
+{{- end }}
+{{- end -}}
