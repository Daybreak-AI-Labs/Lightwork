+        raise ValueError("scheduled goal text must contain 1 to 64000 characters")
+    title = str(body.get("title") or text).strip()[:200]
+    schedule_id = str(body.get("schedule_id") or "").strip()
+    if not schedule_id or len(schedule_id) > 128:
+        raise ValueError("scheduled goal requires a bounded schedule_id")
+    owner = str(body.get("owner") or "").strip()
+    if len(owner) > 256:
+        raise ValueError("scheduled goal owner is too long")
+    body.update(
+        {
+            "schema": _DASHBOARD_SCHEDULE_TASK_SCHEMA,
+            "text": text,
+            "title": title,
+            "schedule_id": schedule_id,
+        }
+    )
+    # Never trust an imported/client-provided tenant. Capture the namespace
+    # pinned by the authenticated request that arms the schedule.
+    body.pop("tenant", None)
+    body.update(_job_tenant_payload())
+    body.pop("goal_id", None)
+    body.pop("delivery_claimed", None)
+    return body
