+    provider = (
+        os.environ.get("MAVERICK_KMS_PROVIDER")
+        or str(kms_cfg.get("provider") or "")
+    ).strip().lower()
+    if provider not in constraints["kms_providers"]:
+        violations.append("KMS provider is absent or outside the production manifest")
+    try:
+        from .tenant.kms import _dek_cache_ttl
