+{{- $values := deepCopy .Values -}}
+{{- $_ := unset $values "productionOnboarding" -}}
+{{- $secret := get $values "secret" -}}
+{{- $_ = unset $secret "rotationGeneration" -}}
+{{- sha256sum (toJson $values) -}}
+{{- end -}}
