+def _verify_production_surface() -> GuaranteeCheck:
+    name = "Production surface"
+    try:
+        from .production_scope import load_manifest, production_surface_required
+
+        if not production_surface_required():
+            return GuaranteeCheck(name, True, "not required for this development process")
+        manifest = load_manifest()
+    except Exception as exc:
+        return GuaranteeCheck(name, False, f"production manifest admission failed: {exc}")
+
+    violations: list[str] = []
+    if not manifest.release_eligible:
+        violations.append(f"release is not eligible: {manifest.release_reason}")
+    try:
+        from .config import load_config
+
+        cfg = load_config() or {}
+        if not isinstance(cfg, dict):
+            raise TypeError("configuration root is not a table")
+    except Exception:
+        violations.append("runtime configuration could not be loaded exactly")
+        cfg = {}
+    violations.extend(_production_configuration_violations(manifest, cfg))
+    if violations:
+        return GuaranteeCheck(name, False, "; ".join(dict.fromkeys(violations)))
+    return GuaranteeCheck(
+        name,
+        True,
+        f"profile {manifest.profile_id} admitted at manifest sha256:{manifest.sha256}",
+    )
