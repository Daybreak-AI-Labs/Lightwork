      "names": [
        "MAVERICK_AUDIT_SIGNING_KEY_WRAPPED"
      ],
      "scope": "required",
      "custody": "staged_file",
      "activation": "pod_recreate",
      "overlap": "retain_all_historical_public_keys_and_old_wrapped_generation",
      "rollback": "retained_old_secret_generation_and_public_key_set",
