{
  "schema": "lightwork.secret-rotation-contract.v1",
  "profile_id": "enterprise-single-control-plane-v1",
  "source_version": "0.1.7",
  "deployment_contract": {
    "credential_values_in_helm": false,
    "external_drill_required": true,
    "generation_must_not_be_secret_derived": true,
    "old_material_revoked_only_after_validation": true,
    "planned_availability_interruption": true,
    "rollout_strategy": "Recreate",
    "rollout_trigger": "secret.rotationGeneration",
    "runtime_snapshot": "immutable_per_pod",
    "secret_source": "pre_provisioned_kubernetes_secret",
    "zero_downtime_claimed": false
  },
  "required_phases": [
    "preflight_exact_scope",
    "prepare_new_provider_authority",
    "retain_old_generation_and_rollback",
    "stop_admission_and_drain",
    "publish_secret_and_bump_generation",
    "recreate_and_wait_for_readiness",
    "verify_new_authority_and_historical_access",
    "observe_and_reconcile",
    "revoke_old_authority",
    "remove_overlap_and_reverify"
  ],
  "secrets": [
    {
      "id": "postgres-runtime-dsn",
      "names": [
        "MAVERICK_PG_DSN"
      ],
      "scope": "required",
      "custody": "staged_file",
      "activation": "pod_recreate",
      "overlap": "distinct_runtime_principal_or_managed_dual_password",
      "rollback": "retained_old_secret_generation_before_revocation",
      "post_start_validation": "new_connection_verified_tls_exact_role_rls_and_schema",
      "qualification": "live_drill_required",
      "code_evidence": [
        "packages/maverick-core/maverick/secret_provider.py",
        "packages/maverick-core/maverick/world_model_backends/postgres.py",
        "packages/maverick-core/tests/test_postgres_production_posture.py"
      ]
    },
    {
      "id": "vault-auth-token",
      "names": [
        "VAULT_TOKEN"
      ],
      "scope": "required",
      "custody": "staged_file",
      "activation": "pod_recreate",
      "overlap": "two_live_tokens_or_auth_roles",
      "rollback": "retained_old_secret_generation_before_revocation",
      "post_start_validation": "new_token_wrap_unwrap_wrong_context_denial_and_readiness",
      "qualification": "live_drill_required",
      "code_evidence": [
        "packages/maverick-core/maverick/kms_backends.py",
        "packages/maverick-core/maverick/tenant/kms.py",
        "packages/maverick-core/tests/test_kms_backends.py"
      ]
    },
    {
      "id": "vault-wrapping-key",
      "names": [
        "MAVERICK_KMS_KEY_ID"
      ],
      "scope": "required",
      "custody": "staged_file",
      "activation": "provider_then_pod_recreate",
      "overlap": "old_key_decrypt_until_rewrap_restore_expiry",
      "rollback": "retained_old_key_authority_and_secret_generation",
      "post_start_validation": "new_wrap_and_historical_decrypt_restore_sample",
      "qualification": "live_drill_required",
      "code_evidence": [
        "packages/maverick-core/maverick/kms_backends.py",
        "packages/maverick-core/maverick/tenant/kms.py",
        "packages/maverick-core/tests/test_kms_fleet_rotation.py"
      ]
    },
    {
      "id": "vllm-gateway-token",
      "names": [
        "VLLM_API_KEY"
      ],
      "scope": "required",
      "custody": "staged_file",
      "activation": "pod_recreate",
      "overlap": "gateway_accepts_old_and_new",
      "rollback": "retained_old_secret_generation_before_revocation",
      "post_start_validation": "approved_model_call_usage_and_provider_cap_reconciliation",
