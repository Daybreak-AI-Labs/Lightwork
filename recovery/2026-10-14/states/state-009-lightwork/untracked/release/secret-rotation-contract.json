      "names": [
        "MAVERICK_OIDC_SESSION_SECRET"
      ],
      "scope": "oidc_only",
      "custody": "staged_file",
      "activation": "pod_recreate",
      "overlap": "none_force_reauthentication",
      "rollback": "retained_old_secret_generation_before_revocation",
      "post_start_validation": "new_session_accepted_old_session_rejected_logout_and_revocation",
      "qualification": "live_drill_required",
      "code_evidence": [
        "packages/maverick-core/maverick/oidc.py",
        "packages/maverick-dashboard/maverick_dashboard/auth.py",
        "packages/maverick-dashboard/tests/test_oidc_login.py"
      ]
    },
    {
      "id": "metrics-scrape-bearer",
      "names": [
        "MAVERICK_METRICS_TOKEN",
        "MAVERICK_METRICS_TOKEN_PREVIOUS"
      ],
      "scope": "required_with_optional_overlap",
      "custody": "kubernetes_secret_env",
      "activation": "pod_recreate",
      "overlap": "application_current_previous_pair",
      "rollback": "retained_old_current_and_previous_values",
      "post_start_validation": "scrape_new_then_current_only_and_unknown_denial",
      "qualification": "live_drill_required",
      "code_evidence": [
