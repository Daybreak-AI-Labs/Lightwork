      "custody": "staged_file",
      "activation": "pod_recreate",
      "overlap": "identity_provider_accepts_old_and_new",
      "rollback": "retained_old_secret_generation_before_revocation",
      "post_start_validation": "new_login_callback_and_exact_principal_tenant_attribution",
      "qualification": "live_drill_required",
      "code_evidence": [
        "packages/maverick-core/maverick/oidc.py",
