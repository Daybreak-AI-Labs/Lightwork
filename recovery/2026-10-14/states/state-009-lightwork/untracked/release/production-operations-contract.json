    "selector_modes": ["day", "all_days", "since_until"],
    "exact_selectors": ["goal_id", "incident_id", "action_id"],
    "fail_closed_on": ["unreadable", "malformed", "unsigned", "untrusted_key", "broken_chain", "missing_completed_day_anchor", "selector_mismatch", "publisher_key_mismatch"],
    "code_evidence": ["packages/maverick-core/maverick/audit/evidence.py", "packages/maverick-core/maverick/audit_evidence_verify.py", "packages/maverick-core/maverick/cli/__init__.py"]
