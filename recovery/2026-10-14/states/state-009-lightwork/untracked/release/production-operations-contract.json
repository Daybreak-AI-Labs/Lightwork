    "internal_ack_targets": {"SEV1": "15m", "SEV2": "30m", "SEV3": "4_business_hours", "SEV4": "1_business_day"},
    "live_requirements": ["named_primary_and_backup_on_call", "tested_page_delivery_and_escalation", "customer_intake", "status_owner", "maintenance_template", "breach_template", "end_to_end_support_exercise"]
