  "emergency_controls": {
    "halt": "maverick halt --reason REASON",
    "clear": "maverick unhalt",
    "required_evidence": ["incident_id", "actor", "utc_time", "halt_generation", "signed_receipt", "readyz_503", "typed_canary_refusal", "recovery_canary"],
    "prohibited": ["delete_halt_file", "killswitch.clear", "direct_arm_halt", "direct_disarm_halt", "direct_database_edit"],
    "live_drill_required": true
  },
  "capacity_and_cost": {
    "application_signals": ["concurrency", "queue_depth", "queue_dead_letter", "queue_stale_lease", "disk_free", "tokens", "spend_rate", "quota_authority", "quota_used", "quota_reserved", "quota_limit", "quota_remaining", "quota_over_limit"],
