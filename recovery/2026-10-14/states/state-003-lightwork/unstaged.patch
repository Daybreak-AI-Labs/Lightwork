+            _add("binary Git patches are not permitted")
+            continue
+
+        # `git diff --submodule` output is not a content patch.  A normal
+        # submodule patch also carries mode 160000 below; reject both spellings
+        # so an omitted/malformed index header cannot weaken the boundary.
+        if line.startswith("Submodule ") or line.startswith("Subproject commit"):
