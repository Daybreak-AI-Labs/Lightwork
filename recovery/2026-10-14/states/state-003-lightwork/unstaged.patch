+def test_flow_learning_endpoints_hide_cross_owner_metadata_and_mutations(monkeypatch, tmp_path):
+    """Every derived flow endpoint must enforce the same owner boundary as CRUD.
+
+    A flow's schemas, learning signal, proposal/history, and impact all expose
+    operational metadata; apply and rollback additionally mutate its definition.
+    Return a uniform 404 before reading any of that state for another owner.
+    """
+    _isolate(monkeypatch, tmp_path)
+    from maverick_dashboard import api as api_mod
+
+    current = {"principal": "user:alice"}
+    monkeypatch.setattr(api_mod, "caller_principal", lambda request: current["principal"])
+    monkeypatch.setattr(api_mod, "is_dashboard_admin", lambda principal: False)
+    monkeypatch.setattr(api_mod, "require_permission", lambda request, permission: None)
+
+    c = _client()
+    assert _save(c).status_code == 201
+
+    from maverick.flow import node_outcomes, store
+    store.record_flow_schema("f", {"customer": {"type": "object", "keys": ["email"]}})
+    for _ in range(12):
+        node_outcomes.record("f", "a", "agent", 1.0)
+    # Create both a history entry and an applied-change insight while Alice owns it.
+    assert c.post("/api/v1/flows/f/apply",
