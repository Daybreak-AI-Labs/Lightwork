+def _fixture_solver_runner(tasks_by_id: dict[str, Task]):
+    """A source-inspecting runner for this *synthetic test fixture only*.
+
+    It deliberately never imports or executes ``solver.py``. A real DGM run
+    must supply a container/VM-backed runner to :func:`dgm_uplift.run_solver`;
+    this tiny interpreter merely keeps the offline governance fixture
+    deterministic after the host-import path was retired. It maps an id to a
+    public synthetic problem input, never to a gold answer.
+    """
+    def run(solver_dir: Path, task, *, timeout: float) -> str:
+        del timeout
+        source = (Path(solver_dir) / "solver.py").read_text(encoding="utf-8")
+        instance = tasks_by_id[task.instance_id]
+        a_s, op, b_s = instance.spec.split()
+        a, b = int(a_s), int(b_s)
+        if op == "+":
+            return str(a + b)
+        if op == "-":
+            return str(a - b)
+        if op == "*" and 'if op == "*"' in source:
+            return str(a * b)
+        memo_match = re.search(
+            r"^\s*_memo\s*=\s*(\{.*\})\s*$", source, re.MULTILINE)
+        if memo_match:
+            try:
+                memo = json.loads(memo_match.group(1))
+            except (TypeError, ValueError):
+                memo = {}
+            value = memo.get(instance.spec)
+            if isinstance(value, str):
+                return value
+        return "0"
+    return run
+
