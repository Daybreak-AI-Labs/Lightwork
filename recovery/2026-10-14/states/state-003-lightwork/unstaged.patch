+    owned_insights = c.get("/api/v1/flows/insights").json()
+    assert any(row["flow_id"] == "f" and row["changes"] for row in owned_insights["flows"])
+
+    current["principal"] = "user:bob"
+    reads = [
+        c.get("/api/v1/flows/f/schema"),
+        c.get("/api/v1/flows/f/proposals"),
