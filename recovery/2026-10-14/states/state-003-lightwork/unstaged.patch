+    ctrl = _ctrl(ledger=ledger)
+    provenance = {
+        "deployment_manifest_sha256": "a" * 64,
+        "manifest": {"patch_sha256": "b" * 64, "scorer": "container-v1"},
+    }
+    cand = _cand(provenance=provenance)
+    assert ctrl.promote(cand).ok
+    provenance["manifest"]["patch_sha256"] = "forged"
+
+    receipt = ledger.get(cand.id)
+    assert receipt.provenance["manifest"]["patch_sha256"] == "b" * 64
