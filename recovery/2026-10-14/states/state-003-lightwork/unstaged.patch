+def _sync_file(path: Path) -> None:
+    """Flush a completed ledger file before reporting its commit."""
+    flags = os.O_RDWR if os.name == "nt" else os.O_RDONLY
+    fd = os.open(os.fspath(path), flags)
+    try:
+        os.fsync(fd)
+    finally:
+        os.close(fd)
