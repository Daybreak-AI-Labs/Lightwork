+def _sync_directory(path: Path) -> None:
+    """Persist a rename on POSIX; NTFS has no portable directory fsync API."""
+    if os.name == "nt":
+        return
+    flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0)
+    fd = os.open(os.fspath(path), flags)
+    try:
+        os.fsync(fd)
+    finally:
+        os.close(fd)
