+def _record_dependent_workflow_check(ctx, source, complete, verified, workflows, checked_at):
+    from maverick import audit
+
+    matches = []
+    for item in verified:
+        snapshot = workflows[item["flow_id"]]
+        matches.append({
+            "flow_id": item["flow_id"],
+            "draft_revision": snapshot["draft_revision"],
+            "draft_version": snapshot["draft_version"],
+            "draft_uses": item["draft_uses"],
+            "published_release_id": snapshot["release_id"] if item["published_uses"] else None,
+            "published_version": snapshot["published_version"] if item["published_uses"] else None,
+        })
+    recorded = audit.audit_event(
+        "flow_action_episode_dependents_checked", agent=ctx.actor,
+        actor=ctx.actor, tenant=ctx.tenant, resource_owner=ctx.resource_owner,
+        source_record_id=source["id"], source_revision=source["revision"],
+        checked_at=checked_at, complete=complete, result_count=len(matches),
+        matching_workflow_versions=matches,
+    )
+    if recorded is not True:
+        raise HTTPException(503, "The activity log could not confirm this check. Refresh before relying on its results.")
