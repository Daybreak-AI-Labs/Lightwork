+        response = client.post("/api/v1/copilot/product-operations/prepare", json={
+            "page": f"/chat/goal/{goal}", "selection": selection,
+            "operation": operation_id, "context": catalog.json()["context"],
+            "revision": operations[operation_id]["revision"], "arguments": arguments,
+        })
+        assert response.status_code == 200, response.text
+        assert response.json()["details"]["Open Chat action"]["href"] == expected
+        assert old.content not in response.text
