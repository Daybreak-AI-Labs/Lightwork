+def _provider_environment_winners(rows_by_path: dict) -> tuple[list[dict[str, Any]], int, int]:
+    """Return winning provider env rows without exposing credentials or URL paths."""
+    provider_rows: list[dict[str, Any]] = []
+    listed_delta = editable_delta = 0
+    try:
+        from maverick.config import PROVIDER_KEY_ENV_MAP, provider_configuration_state
+
+        for provider in PROVIDER_KEY_ENV_MAP:
+            state = provider_configuration_state(provider)
+            fields = (
+                ("api_key", "Provider credentials", "api_key_configured", "api_key_source"),
+                ("base_url", "Custom provider address", "base_url_configured", "base_url_source"),
+            )
+            for field, label, present_key, source_key in fields:
+                source = str(state.get(source_key) or "")
+                if not source.startswith("environment:") or not state.get(present_key):
+                    continue
+                path = f"providers.{provider}.{field}"
+                value = "Set" if field == "api_key" else "Configured (address hidden)"
+                if path in rows_by_path:
+                    row = rows_by_path[path]
+                    if not str(row.get("source", "")).startswith("Set on the server"):
+                        editable_delta -= 1
+                    row.update({
+                        "value": value,
+                        "secret": True,
+                        "source": "Set on this server",
+                        "link_label": "Review AI connection",
+                        "note": "The server-supplied value takes priority over the saved value.",
+                    })
+                    continue
+                provider_rows.append({
+                    "setting": f"{provider.replace('_', ' ').title()} {label.lower()}",
+                    "where": provider.replace("_", " ").title(),
+                    "value": value,
+                    "secret": True,
+                    "source": "Set on this server",
+                    "href": "/settings#settings-integrations",
+                    "link_label": "Open AI connections",
+                    "reason": "",
+                    "note": "The credential or full address is hidden. The server-supplied value is active.",
+                })
+                listed_delta += 1
+    except (KeyboardInterrupt, SystemExit):
+        raise
+    except Exception:
+        # Provider inventory is additive. Existing configuration rows remain
+        # available if the provider resolver cannot produce a safe snapshot.
+        pass
+    return provider_rows, listed_delta, editable_delta
