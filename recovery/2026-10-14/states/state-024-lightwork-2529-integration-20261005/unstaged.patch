+def _matching_episode_lineages(service, ctx, source_record_id, candidates, started):
+    matches, matching_lineages, complete = set(), set(), True
+    for identity, flow_ids in sorted(candidates.items()):
+        if time.monotonic() - started >= 3.0:
+            complete = False
+            break
+        try:
+            uses = _call(lambda identity=identity: service.uses_episode(ctx, identity, source_record_id))
+        except HTTPException as exc:
+            if exc.status_code in {400, 404, 409, 503}:
+                complete = False
+                continue
+            raise
+        if uses is None:
+            complete = False
+        elif uses:
+            matching_lineages.add(identity)
+            matches.update(flow_ids)
+    return matches, matching_lineages, complete
