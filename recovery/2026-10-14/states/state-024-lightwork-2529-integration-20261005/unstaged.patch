+    thread = world.get_or_create_conversation("web", f"local/{goal}")
+    world.append_turn(thread.id, "user", "First question", goal_id=goal)
+    world.append_turn(thread.id, "assistant", "Earlier saved answer", goal_id=goal)
+    old = next(turn for turn in ChatThreads(world).selected_turns(goal)
+               if turn.role == "assistant")
+    world.append_turn(thread.id, "user", "Second question", goal_id=goal)
+    world.append_turn(thread.id, "assistant", "Current saved answer", goal_id=goal)
+    world.set_goal_status(goal, "done", result="Current saved answer")
+    selection = {"kind": "goal", "id": goal, "goal_id": goal, "turn_id": old.id}
+    catalog = client.post("/api/v1/copilot/product-operations/catalog", json={
+        "page": f"/chat/goal/{goal}", "selection": selection,
+    })
+    assert catalog.status_code == 200, catalog.text
+    operations = {item["id"]: item for item in catalog.json()["operations"]}
+    expected = f"/chat/goal/{goal}#turn-actions-{old.id}"
+    assert old.content not in catalog.text
+    for operation_id, arguments in (
+        ("conversation.copy_answer", {}),
+        ("conversation.print", {}),
+        ("conversation.read", {}),
