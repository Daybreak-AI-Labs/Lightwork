+        raise HTTPException(409, "The selected form changed. Review it again.")
+    try:
+        receipt = native.form_submission_rebind_receipt(
+            request, Response(), name,
+            source_generation=prepared["expected_generation"],
+            target_release_id=prepared["expected_release_id"],
+            expected_waiting_total=prepared["expected_waiting_total"],
+            target_kind=prepared.get("expected_target_kind", "flow"),
+        )
+    except HTTPException as exc:
+        if exc.status_code == 404:
+            return None
+        raise
+    if (receipt.get("confirmed") is not True
+            or receipt.get("waiting_total") != prepared.get("expected_waiting_total")
+            or receipt.get("target_kind", "flow") != prepared.get("expected_target_kind", "flow")
