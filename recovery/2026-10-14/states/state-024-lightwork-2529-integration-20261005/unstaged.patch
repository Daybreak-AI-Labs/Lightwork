+def _copilot_answer_limits() -> tuple[float, int] | None:
+    """Read the bounded, workspace-configurable limits for one Copilot reply."""
+    import math
+
+    from maverick import config as runtime_config
+
+    try:
+        config = runtime_config.load_config()
+    except Exception:
+        return None
+    if not isinstance(config, dict):
+        return None
+    section = config.get("copilot", {})
+    if not isinstance(section, dict):
+        return None
+    raw_dollars = section.get("max_dollars", 0.25)
+    raw_tokens = section.get("max_output_tokens", 4096)
+    if isinstance(raw_dollars, bool):
+        return None
+    try:
+        max_dollars = float(raw_dollars)
+    except (TypeError, ValueError, OverflowError):
+        return None
+    if not math.isfinite(max_dollars) or not 0.05 <= max_dollars <= 5.0:
+        return None
+    if isinstance(raw_tokens, bool) or not isinstance(raw_tokens, int):
+        return None
+    if not 512 <= raw_tokens <= 16000:
+        return None
+    return max_dollars, raw_tokens
+
