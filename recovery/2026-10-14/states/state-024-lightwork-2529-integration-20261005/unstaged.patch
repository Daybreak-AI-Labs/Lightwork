+@pytest.mark.asyncio
+async def test_halt_between_serial_tools_is_not_recorded_as_agent_failure(
+    tmp_path, fake_llm, make_llm_response, monkeypatch,
+):
+    from maverick import consequence, orchestrator
+
+    monkeypatch.setenv("MAVERICK_PARALLEL_TOOLS", "0")
+    fake_llm.scripted = [
+        make_llm_response(
+            text="work",
+            tool_calls=[
+                ToolCall(id="first", name="shell", input={"cmd": "first"}),
+                ToolCall(id="second", name="shell", input={"cmd": "second"}),
+            ],
+        )
+    ]
+    calls = []
+
+    async def run_tool(_agent, name, _arguments):
+        calls.append(name)
+        killswitch.halt("between serial tools")
+        return "first tool completed"
+
+    monkeypatch.setattr(Agent, "_run_tool", run_tool)
+    recorded_failures = []
+    monkeypatch.setattr(
+        orchestrator, "_record_skill_outcome",
+        lambda _ctx, *, success: recorded_failures.append(("skill", success)),
+    )
+    monkeypatch.setattr(
+        orchestrator, "_record_planning_outcome",
+        lambda *_args, success, **_kwargs: recorded_failures.append(("planning", success)),
+    )
+    monkeypatch.setattr(
+        orchestrator, "_record_harness_outcome",
+        lambda *_args, success, **_kwargs: recorded_failures.append(("harness", success)),
+    )
+    monkeypatch.setattr(
+        consequence, "record_self_outcome",
+        lambda *_args, **_kwargs: recorded_failures.append(("consequence", False)),
+    )
+
+    world, goal_id = _goal(tmp_path)
+    try:
+        result = await run_goal(
+            llm=fake_llm,
+            world=world,
+            budget=Budget(max_dollars=5.0),
+            goal_id=goal_id,
+            sandbox=LocalBackend(workdir=tmp_path),
+            max_depth=1,
+        )
+    finally:
+        killswitch.clear()
+
+    assert len(calls) == 1
+    assert "halted mid-run" in result
+    assert "maverick unhalt" in result
+    assert world.get_goal(goal_id).result == "halted"
+    assert recorded_failures == []
+
+
