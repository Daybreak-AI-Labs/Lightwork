+    limit = 60600 if kind == "list" else field.get("max_length", 2048)
+    if isinstance(val, str) and len(val) > limit:
+        raise ValueError(f"{field['label']} is too long")
+    if kind == "list":
+        return _channel_people_value(name, val)
+    if kind == "channel_list":
+        return _channel_room_value(field, val)
+    if val in (None, ""):
+        return _KEEP_CHANNEL_VALUE
+    return _channel_scalar_value(field, val)
