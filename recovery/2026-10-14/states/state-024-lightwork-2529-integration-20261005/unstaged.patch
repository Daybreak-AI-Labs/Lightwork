+
+    candidates, workflows, complete = {}, {}, True
+    try:
+        summaries = store.list_flow_summaries(owner=owner, bounded=True)
+        for count, summary in enumerate(summaries, 1):
+            try:
+                check_scan(count, started)
+            except HistoryNarrowing:
+                complete = False
+                break
+            snapshot, valid = _saved_flow_lineages(request, store.load_flow(summary["id"]), owner)
+            complete = complete and valid
+            if snapshot is None:
+                continue
+            workflows[snapshot["flow_id"]] = snapshot
+            identities = snapshot["draft_refs"] | snapshot["published_refs"]
+            for identity in identities:
+                if len(candidates) >= 256 and identity not in candidates:
+                    complete = False
+                    break
+                candidates.setdefault(identity, set()).add(snapshot["flow_id"])
+            if len(candidates) >= 256 or time.monotonic() - started >= 3.0:
+                complete = False
+                break
+    except HistoryNarrowing:
+        complete = False
+    return candidates, workflows, complete
