+def _configuration_summary(sections: list, listed: int, editable: int,
+                           runtime_rows: list, runtime_unreadable: bool) -> str:
+    if listed:
+        read_only = listed - editable
+        server_set = sum(
+            1 for section in sections for row in section["keys"]
+            if str(row.get("source", "")).startswith(("Set on the server", "Set on this server"))
+        )
+        app_controlled = listed - read_only
+        installation_only = max(0, read_only - server_set)
+        summary = (
+            f"{listed} setting{'s are' if listed != 1 else ' is'} in effect beyond the built-in defaults: "
+            f"{app_controlled} can be changed in Lightwork, {server_set} are set by the server, "
+            f"and {installation_only} need an installation-level change. Each row shows where to go."
+        )
+    else:
+        summary = "No saved or server-supplied settings are changing the built-in defaults."
+    if runtime_rows:
