+        current["rebind_calls"] += 1
+        return {"waiting_total": 3, "moved": 3, "workflow_name": "Order intake",
+                "workflow_version": 4, "binding_revision": "f" * 64}
+
+    def receipt(_request, _response, name, **_query):
+        assert name == "order-intake"
