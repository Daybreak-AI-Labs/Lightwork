+    monkeypatch.setattr(codex_cli_provider, "_auth_file_present", lambda: True)
+    real_readiness = integration_readiness.provider_readiness
+
+    def readiness(name, *, configured):
+        if name != "codex_cli":
+            return real_readiness(name, configured=configured)
+        return {
+            "policy_allowed": True,
+            "policy_detail": "allowed",
+            "dependency": {"status": "passed", "detail": "available"},
+            "runtime": {"status": "failed", "detail": "Codex CLI did not start"},
+            "live": {
+                "status": "failed",
+                "detail": "configured Codex CLI binary was not found",
+                "tested_at": 1_900_000_000,
+                "evidence": {"kind": "local_runtime_probe"},
+            },
+        }
+
+    monkeypatch.setattr(integration_readiness, "provider_readiness", readiness)
+
+    settings = workspace.client.get("/settings").text
+    settings_row = settings.split('id="provider-codex_cli"', 1)[1].split(
+        '<div class="provider-row"', 1
+    )[0]
+    assert "Connection failed:" in settings_row
+    assert "Codex tool is not installed" in settings_row
+    assert "Choose a model" not in settings_row
+    assert "Review sign-in setup" in settings_row
+
+    providers = workspace.client.get("/providers").text
+    provider_row = providers.split("ChatGPT subscription", 1)[1].split("</tr>", 1)[0]
+    assert "Connection failed:" in provider_row
+    assert "Codex tool is not installed" in provider_row
