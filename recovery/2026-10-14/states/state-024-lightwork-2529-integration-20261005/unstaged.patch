+    script = """
+import json
+from maverick.agent import _BB_TURN_DELTA_ENTRIES, _MAX_PATCH_REVISION_ATTEMPTS
+from maverick.agent_bus import _MAX_INBOXES
+from maverick.blackboard import Blackboard
+from maverick.safety.refusal_calibration import configured_ceilings
+from maverick.tools.pandas_query import _max_json_bytes
+from maverick.worker import _GOAL_SLOT_DEFER_SECONDS, _MAX_GOAL_SLOT_DEFERS
