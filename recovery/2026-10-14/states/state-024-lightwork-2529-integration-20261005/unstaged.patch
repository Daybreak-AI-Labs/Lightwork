+
+
+def test_spending_screen_reads_all_providers_and_health_from_one_sealed_snapshot(
+    tmp_path, monkeypatch,
+):
+    monkeypatch.setenv("MAVERICK_HOME", str(tmp_path))
+    config = tmp_path / "config.toml"
+    config.write_text(
+        "[budget.provider_caps]\nopenai = 50.0\nanthropic = 40.0\n",
+        encoding="utf-8",
+    )
+    monkeypatch.setenv("MAVERICK_CONFIG", str(config))
+    monkeypatch.setattr(cap, "_INDEXED_MIGRATION_BYTES", 1)
+    path = cap._ledger_path()
+    period = cap.period_key()
+    settled = {
+        f"settled-{number}": {"projected": 0.01, "state": "settled", "actual": 0.01}
+        for number in range(2_000)
+    }
+    cap._save_json(path, {
+        period: {"openai": 20.0, "anthropic": 20.0},
+        cap._RECEIPTS: {period: {"openai": settled, "anthropic": settled}},
+    })
+    # Convert once before measuring the view's cost.
+    assert cap.check("openai").spent == pytest.approx(20.0)
+    assert indexed.is_active(path)
+
+    digests = 0
+    original_digest = indexed._digest_file
+
+    def counted_digest(database):
+        nonlocal digests
+        digests += 1
+        return original_digest(database)
+
+    monkeypatch.setattr(indexed, "_digest_file", counted_digest)
+    report = spending.status(period)
+
+    assert report["available"] is True
+    assert report["ledger_health"]["available"] is True
+    assert {row["provider"]: row["spent"] for row in report["providers"]} == {
+        "openai": pytest.approx(20.0), "anthropic": pytest.approx(20.0),
+    }
+    assert digests == 1
