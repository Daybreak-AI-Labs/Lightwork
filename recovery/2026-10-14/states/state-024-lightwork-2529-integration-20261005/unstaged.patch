+    if runtime_unreadable:
+        summary += " Some controls saved in Lightwork could not be read, so this list may be incomplete."
+    if not listed and not runtime_rows:
+        return "Lightwork is using its built-in settings. Nothing has been changed yet."
+    return summary
+
