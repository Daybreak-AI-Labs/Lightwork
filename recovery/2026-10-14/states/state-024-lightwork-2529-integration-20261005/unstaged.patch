+def existing_tenant_data_ids(known_tenants=()) -> list[str]:
+    """Return every validated tenant namespace that currently has data.
+
+    Fleet maintenance uses this to include channel-created per-user workspaces
+    that are intentionally absent from the business roster. Namespace claims
+    are the authority for those identities. Unknown, linked, or malformed
+    tenant storage fails closed so a retention run cannot report success while
+    silently skipping a workspace it cannot identify.
