+def _save_form_template_rebind(request, tenant, current, token, source_generation,
+                               target_generation, next_trigger, route_rows,
+                               waiting_total, form_recovery, event_triggers_store):
+    from maverick.paths import tenant_scope
+    from maverick.templates import load_template
+
+    from .triggers_store import snapshot_from_template, snapshot_revision
+
+    with tenant_scope(tenant=tenant or None):
+        latest_template = load_template(str(current["template"]))
+    assert_template_access(request, latest_template)
+    latest_snapshot = snapshot_from_template(latest_template)
+    target_release_id = snapshot_revision(latest_snapshot)
+    if target_release_id != next_trigger.get("template_revision"):
+        raise HTTPException(
+            status_code=409,
+            detail="The current form template changed. Review it again before continuing.",
+        )
+    form_recovery.record_rebind(
+        token, source_generation, target_generation, next_trigger, route_rows,
+        waiting_total=waiting_total, actor=caller_principal(request) or "local",
+        target_kind="template",
+    )
+    return event_triggers_store.replace_form_template_binding_locked(
+        str(current["name"]), expected_generation=source_generation,
+        template=str(current["template"]), template_snapshot=latest_snapshot,
+        template_revision=target_release_id, owner=str(current.get("owner") or ""),
+        tenant=tenant,
