+    target_kind = prepared.get("expected_target_kind", "flow")
+    target_label = "form" if target_kind == "template" else "workflow"
+    target_version = prepared.get("target_version")
+    target_summary = prepared["target_name"]
+    if target_version is not None:
+        target_summary += f" version {target_version}"
+    return Outcome(
+        "replayed",
+        f"The saved change routed {receipt['moved']} answers to the current {target_label} ({target_summary}).",
+        {"form": name, "waiting_answers": receipt["waiting_total"],
