+def customer_result(status: str | None, raw: str | None, *, include_action: bool = False) -> str:
+    """Project a saved result for an ordinary product surface.
+
+    Kernel stop strings are retained on the goal for recovery and support, but
+    can include terminal commands, exception details, paths, or raw spending
+    summaries. Customer-facing API and export paths use this projection just
+    like Chat and channel replies do.
+    """
+    normalized = str(status or "").strip().lower()
+    if normalized in {"blocked", "failed"}:
+        stop = explain_stop(raw, status=normalized)
+        parts = [stop.message]
+        if include_action and stop.action:
+            parts.append(stop.action)
+        return "\n\n".join(parts)
+    if normalized == "cancelled":
+        return "This task was cancelled."
+    if normalized == "error":
+        return "Something went wrong inside Lightwork. Ask your workspace administrator for help."
+    return raw or ""
+
+
+def customer_error(raw: str | None) -> dict[str, str | None]:
+    """Project one recorded error into a safe message for the task page.
+
+    Error-event bodies often contain exception text, tool output, paths, or
+    user data. Only the fixed explanations from the known stop catalog are
+    suitable for an ordinary product surface; unknown text gets a generic
+    explanation and a clear next step.
+    """
+    text = str(raw or "").strip()
+    # Event bodies may be arbitrary tool or provider output. Reuse specific
+    # advice only for the closed, stable provider stop codes written by the
+    # runtime; free-form text is never safe to classify or display here.
+    if re.fullmatch(
+        r"provider_error:(?:authentication|rate_limit|model_not_found|paused|unavailable|connection|configuration)",
+        text,
+        flags=re.IGNORECASE,
+    ):
+        reason = explain_stop(text)
+    else:
+        return {
+            "message": "Lightwork ran into a problem during this step.",
+            "action": _GENERIC_ACTION,
+            "link": None,
+            "link_label": None,
+        }
+    return {
+        "message": reason.message,
+        "action": reason.action,
+        "link": reason.link,
+        "link_label": reason.link_label,
+    }
