+    segments = {_tenant_segment(value): value for value in known}
+
+    claims_root = home / _TENANT_NAMESPACE_DIR
+    if claims_root.is_symlink():
+        raise TenantPolicyError("Tenant namespace claims are linked; fleet maintenance is unavailable.")
+    if claims_root.exists():
+        if not claims_root.is_dir():
+            raise TenantPolicyError("Tenant namespace claims are not a directory.")
+        ensure_private_directory(claims_root)
+        try:
+            for shard in claims_root.iterdir():
+                if shard.is_symlink() or not shard.is_dir():
+                    raise TenantPolicyError("Tenant namespace claims contain an unsupported item.")
+                ensure_private_directory(shard)
+                for claim_path in shard.iterdir():
+                    if claim_path.is_symlink() or not claim_path.is_file():
+                        raise TenantPolicyError("Tenant namespace claims contain an unsupported item.")
+                    claim = _read_tenant_claim(claim_path)
+                    namespace_key = claim.get("namespace_key")
+                    if not isinstance(namespace_key, str):
+                        raise TenantPolicyError("Tenant namespace claim is invalid.")
+                    owner = _tenant_claim_owner(claim, namespace_key, claim_path)
+                    if claim_path != _tenant_claim_path(home, namespace_key):
+                        raise TenantPolicyError("Tenant namespace claim is stored at an invalid path.")
+                    segment = _tenant_segment(owner)
+                    other = segments.get(segment)
+                    if other is not None and other != owner:
+                        raise TenantNamespaceCollision("Tenant namespaces collide during fleet maintenance.")
+                    segments[segment] = owner
+        except OSError as exc:
+            raise TenantPolicyError("Tenant namespace inventory is unavailable.") from exc
+
+    if tenants_root.is_symlink():
+        raise TenantPolicyError("Tenant storage is linked; fleet maintenance is unavailable.")
+    if not tenants_root.exists():
+        return []
+    if not tenants_root.is_dir():
+        raise TenantPolicyError("Tenant storage is not a directory.")
+    ensure_private_directory(tenants_root)
+
+    existing: set[str] = set()
+    try:
+        for entry in tenants_root.iterdir():
+            if entry.is_symlink() or not entry.is_dir():
+                raise TenantPolicyError("Tenant storage contains a linked or unsupported item.")
+            owner = segments.get(entry.name)
+            if owner is None:
