+def _verified_dependent_workflows(request, ctx, matches, matching_lineages, workflows):
+    from maverick.flow import store
+    from maverick.paths import tenant_scope
+
+    from .api import _assert_flow_access
+
+    verified, complete = [], True
+    with tenant_scope(tenant=ctx.tenant):
+        for flow_id in sorted(matches):
+            snapshot = workflows[flow_id]
+            current = store.load_flow(flow_id)
+            if (current is None or current.owner != ctx.resource_owner
+                    or current.revision != snapshot["draft_revision"]
+                    or current.version != snapshot["draft_version"]):
+                complete = False
+                continue
+            try:
+                _assert_flow_access(request, current)
+                published = store.load_published_bundle(current.id)
+            except HTTPException as exc:
+                if exc.status_code in {403, 404}:
+                    complete = False
+                    continue
+                raise
+            except store.FlowSnapshotError:
+                complete = False
+                continue
+            release_id = published[1].get("release_id") if published else None
+            published_uses = bool(snapshot["published_refs"] & matching_lineages)
+            if release_id != snapshot["release_id"]:
+                complete = False
+                published_uses = False
+            draft_uses = bool(snapshot["draft_refs"] & matching_lineages)
+            if draft_uses or published_uses:
+                verified.append({"flow_id": current.id, "name": current.name or "Saved workflow",
