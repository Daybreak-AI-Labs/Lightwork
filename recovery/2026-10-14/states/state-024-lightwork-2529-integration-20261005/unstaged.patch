+def _server_runtime_environment_rows() -> list[dict[str, Any]]:
+    """Describe the model and spending choices set directly for this server."""
+    rows: list[dict[str, Any]] = []
+    for name, raw in sorted(os.environ.items()):
+        if not raw.strip():
+            continue
+        if name == "MAVERICK_MODEL_OVERRIDE":
+            setting, value = "AI model for all roles", raw.strip()[:300]
+            note = "This server choice takes priority over saved model choices for new runs."
+        elif name.startswith("MAVERICK_MODEL_OVERRIDE_"):
+            role = name.removeprefix("MAVERICK_MODEL_OVERRIDE_").replace("_", " ").lower()
+            setting, value = f"AI model for {role}", raw.strip()[:300]
+            note = "This server choice takes priority over the saved choice for this role."
+        elif name == "MAVERICK_BUDGET_DOLLARS":
+            setting = "Spending cap per task"
+            try:
+                amount = float(raw.strip())
+                value = f"${amount:,.2f}" if amount >= 0 and amount < float("inf") else "Set (limit could not be read)"
+            except (TypeError, ValueError):
+                value = "Set (limit could not be read)"
+            note = "Applies to new tasks; any lower task, workspace, or organization limit still applies."
+        else:
+            continue
+        rows.append({
+            "setting": setting,
+            "where": "AI models" if "model" in name else "Spending",
+            "value": value,
+            "secret": False,
+            "source": "Set on this server",
+            "href": "/settings#settings-models" if "model" in name else "/settings#settings-task-budget",
+            "link_label": "Open this setting",
+            "reason": "",
+            "note": note,
+        })
+    return rows
+
