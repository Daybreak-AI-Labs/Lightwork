+@router.post("/event-triggers/{name}/form-submissions/rebind")
+def rebind_waiting_form_submissions(
+    request: Request, response: Response, name: str, payload: FormRebindIn,
+) -> dict:
+    """Owner-confirmed routing of every waiting form answer to the current release."""
+    from maverick import form_store
+    from maverick.audit.errors import AuditRefused
+    from maverick.automation_events import EventSourceError, _decode_cursor
+    from maverick.flow import store as flow_store
+    from maverick.paths import current_tenant_id
+
+    from maverick_dashboard import event_triggers_store, form_recovery
+    from maverick_dashboard.event_poll import _trigger_key
+
+    require_permission(request, "operate")
+    _require_event_triggers()
+    tenant = current_tenant_id() or ""
+    current = event_triggers_store.get_trigger(name, tenant=tenant)
+    if (current is None or current.get("source") != "form"
+            or current.get("owner", "") not in _event_trigger_allowed_owners(request)):
+        raise HTTPException(status_code=404, detail="no form automation with that name")
+    token = str((current.get("config") or {}).get("token") or "")
+    try:
+        with form_recovery.locked(token), event_triggers_store.registry_lock():
+            current = event_triggers_store.get_trigger(name, tenant=tenant)
+            if (current is None or current.get("source") != "form"
+                    or current.get("owner", "") not in _event_trigger_allowed_owners(request)
+                    or str((current.get("config") or {}).get("token") or "") != token
+                    or _trigger_key(current) != payload.expected_generation):
+                raise HTTPException(status_code=409, detail="This form changed. Refresh it.")
+            target_kind = payload.expected_target_kind
+            raw = _decode_cursor(
+                str(current.get("cursor") or "0"), "form",
+                int(current.get("cursor_format") or 0),
+            )
+            rows, _ = form_store.since(token, raw)
+            total = form_store.pending(token, raw)
+            if (total != payload.expected_waiting_total or total != len(rows)):
+                raise HTTPException(
+                    status_code=409,
+                    detail="The waiting answers changed. Review the current list before continuing.",
+                )
+            target_flow, target_release_id, target_name, target_version, next_trigger = (
+                _prepare_form_rebind_target(
+                    request, current, rows, form_recovery,
+                    target_kind=target_kind,
+                    expected_release_id=payload.expected_release_id,
+                    tenant=tenant, flow_store=flow_store,
+                )
+            )
+            decisions = form_recovery.decisions_for_events(token, rows)
+            route_rows = [row for row in rows if row["_seq"] not in decisions]
+            if any(form_recovery.already_started(current, row, _world()) for row in route_rows):
+                raise HTTPException(
+                    status_code=409,
+                    detail="At least one answer may already have started work. Review its run before moving any answers.",
+                )
+            next_generation = _trigger_key(next_trigger)
+            if target_kind == "flow":
+                with flow_store.published_flow_guard(
+                    str(current["flow"]), expected_release_id=target_release_id,
+                ) as (guarded_flow, guarded_release):
+                    if (guarded_flow.owner != target_flow.owner
+                            or int(guarded_flow.version) != int(target_flow.version)
+                            or str(guarded_flow.revision or "") != str(target_flow.revision or "")
+                            or str(guarded_release.get("release_id") or "") != target_release_id):
+                        raise HTTPException(
+                            status_code=409,
+                            detail="The published workflow changed. Review its current version before continuing.",
+                        )
+                    form_recovery.record_rebind(
+                        token, payload.expected_generation, next_generation,
+                        next_trigger, route_rows, waiting_total=total,
+                        actor=caller_principal(request) or "local",
+                    )
+                    updated = event_triggers_store.replace_form_flow_revision_locked(
+                        name, expected_generation=payload.expected_generation,
+                        flow_id=str(current["flow"]),
+                        flow_owner=str(current.get("flow_owner") or ""),
+                        release_id=target_release_id,
+                        owner=str(current.get("owner") or ""), tenant=tenant,
+                    )
+            else:
+                updated = _save_form_template_rebind(
+                    request, tenant, current, token, payload.expected_generation,
+                    next_generation, next_trigger, route_rows, total,
+                    form_recovery, event_triggers_store,
+                )
+            if updated is None:
+                raise HTTPException(status_code=409, detail="This form changed. Refresh it.")
+    except (form_recovery.FormRecoveryConflict,
+            event_triggers_store.FormTriggerConflict) as exc:
+        raise HTTPException(status_code=409, detail=str(exc)) from exc
+    except AuditRefused as exc:
+        raise HTTPException(
+            status_code=503,
+            detail="The signed activity record was refused. No answers were moved.",
+        ) from exc
+    except (form_store.FormStoreUnavailable, form_recovery.FormRecoveryUnavailable,
+            EventSourceError, flow_store.FlowSnapshotError, OSError, ValueError) as exc:
+        raise HTTPException(
+            status_code=503,
+            detail="The waiting answers or published workflow cannot be verified right now. Nothing was moved.",
+        ) from exc
+    response.headers["Cache-Control"] = "no-store"
+    return {
+        "name": name, "binding_revision": _trigger_key(updated),
+        "waiting_total": total, "moved": len(route_rows),
+        "target_kind": target_kind, "target_name": target_name,
+        "target_revision": target_release_id, "target_version": target_version,
+        **({"workflow_name": target_name, "workflow_version": target_version}
+           if target_kind == "flow" else {"template_name": target_name}),
+    }
+
+
