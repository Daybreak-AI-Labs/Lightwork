+def shareable_event_payloads(events, *, include_agent: bool = True) -> list[dict]:
+    """Project task events for customer-facing guides and video captions.
+
+    Unlike the live event stream, shareable exports never carry recorded
+    prompts, outputs, arguments, paths or arbitrary error bodies.
+    """
+    projected = []
+    for event in events or ():
+        kind = str(getattr(event, "kind", "") or "").strip().lower()
+        agent = getattr(event, "agent", "")
+        content = str(getattr(event, "content", "") or "")
+        tool = _TOOL_LINE.match(content.strip())
+        if tool and tool.group("tool") not in _TOOLS:
+            step = Step("Ran into a problem" if kind == "error" else "Used a connected tool")
+        else:
+            step = narrate(kind, agent, content)
+        if step.hidden or not step.text:
+            continue
+        safe_kind = kind if kind in {"plan", "finding", "skill", "error"} else "observation"
+        record = {
+            "kind": safe_kind,
+            "content": step.text,
+            "ts": getattr(event, "ts", None),
+        }
+        if include_agent:
+            record["agent"] = who(agent)
+        projected.append(record)
+    return projected
+
+
+__all__ = ["GENERIC", "Step", "agent_parts", "event_payload", "narrate",
+           "role_title", "shareable_event_payloads", "who"]
