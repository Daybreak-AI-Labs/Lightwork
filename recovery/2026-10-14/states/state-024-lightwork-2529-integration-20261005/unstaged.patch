+def execute_rebind(request, selection, _arguments, prepared, _operation_id):
+    name = _rebind_selection(selection)
+    if prepared.get("name") != name:
+        raise HTTPException(409, "The selected form changed. Review it again.")
+    result = native.rebind_waiting_form_submissions(
+        request, Response(), name,
+        FormRebindIn(
+            expected_target_kind=prepared.get("expected_target_kind", "flow"),
+            expected_generation=prepared["expected_generation"],
+            expected_release_id=prepared["expected_release_id"],
+            expected_waiting_total=prepared["expected_waiting_total"],
+        ),
+    )
+    target_kind = prepared.get("expected_target_kind", "flow")
+    if (result.get("waiting_total") != prepared["expected_waiting_total"]
+            or result.get("target_kind", "flow") != target_kind
