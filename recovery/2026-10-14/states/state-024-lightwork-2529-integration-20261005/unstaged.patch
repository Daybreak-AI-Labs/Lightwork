+def read_period_buckets(legacy: Path, period: str, providers, cap):
+    """Read a provider-spending view and ledger health from one sealed snapshot.
+
+    The spending page displays all retained charges and health at once. Reading
+    each provider separately reopened and rehashed the complete database for
+    every row; this keeps the same complete validation and seal while taking
+    one consistent snapshot and performing one full-file digest.
+    """
+    if (not isinstance(period, str) or not period or not isinstance(providers, (list, tuple))
+            or len(providers) > 5_000
+            or any(not isinstance(provider, str) or not provider for provider in providers)
+            or len(set(providers)) != len(providers)):
+        raise cap.ProviderAccountingUnavailable
+    database = ensure(legacy, cap)
+    connection = _connect(database)
+    try:
+        connection.execute("BEGIN")
+        data = _read_complete(connection, cap)
+        totals = data.get(period, {})
+        receipts_by_provider = data.get(cap._RECEIPTS, {}).get(period, {})
+        buckets = {}
+        for provider in providers:
+            raw_total = totals.get(provider)
+            receipts = receipts_by_provider.get(provider, {})
+            if raw_total is None and receipts:
+                raise cap.ProviderAccountingUnavailable
+            total = cap._amount(float(raw_total)) if raw_total is not None else 0.0
