+        person = str(entry).strip()
+        if not person:
+            continue
+        if not re.fullmatch(pattern, person):
+            raise ValueError(f"Enter {error}")
+        if person not in people:
+            people.append(person)
+    # An explicit empty list denies everyone rather than restoring inherited access.
+    return people
+
+
+def _channel_room_value(field: dict, value: object) -> list[str]:
+    entries = (re.split(r"[,\r\n]+", value) if isinstance(value, str)
+               else value if isinstance(value, list) else None)
+    if entries is None or len(entries) > field.get("max_items", 100):
+        raise ValueError("Add fewer IRC rooms")
+    rooms = []
+    for entry in entries:
+        room = str(entry).strip()
+        if not room:
+            continue
+        if not re.fullmatch(r"#[A-Za-z0-9_][A-Za-z0-9_-]{0,63}", room):
+            raise ValueError("Enter each IRC room as a name starting with #")
+        if room.casefold() not in {item.casefold() for item in rooms}:
+            rooms.append(room)
+    return rooms
+
+
+def _channel_scalar_value(field: dict, val: object):
+    key, kind = field["key"], field.get("type")
+    if kind == "int":
+        try:
+            number = int(val)
+        except (TypeError, ValueError) as exc:
+            raise ValueError(f"{field['label']} must be a number") from exc
+        minimum, maximum = field.get("minimum", 1), field.get("maximum", 65535)
+        if not minimum <= number <= maximum:
+            raise ValueError(f"{field['label']} must be between {minimum} and {maximum}")
+        return number
+    if kind == "url":
+        return _channel_server_address(field["label"], val)
+    if kind == "bool":
+        text_value = str(val).strip().lower()
+        if text_value not in {"true", "false"}:
+            raise ValueError(f"Choose whether to {field['label'].lower()}")
+        return text_value == "true"
+    if kind == "choice":
+        choices = {str(value) for value, _label in field.get("choices", ())}
+        if str(val) not in choices:
+            raise ValueError(f"Choose a listed {field['label'].lower()}")
+        return str(val)
+    if key == "service_account_json":
+        if len(str(val)) > 64 * 1024:
+            raise ValueError("Choose a service-account file smaller than 64 KB")
+        try:
+            parsed = json.loads(str(val))
+        except (TypeError, ValueError) as exc:
+            raise ValueError("Enter the complete Google service-account credential text") from exc
+        required = {"client_email", "private_key", "token_uri"}
+        if (not isinstance(parsed, dict) or parsed.get("type") != "service_account"
+                or not required.issubset(parsed)
+                or parsed.get("token_uri") not in {
+                    "https://oauth2.googleapis.com/token",
+                    "https://accounts.google.com/o/oauth2/token",
+                }):
+            raise ValueError("Enter the complete Google service-account credential text")
+        return str(val)
+    if key == "trusted_authserv_id":
+        from maverick.mail_auth import valid_trusted_mail_server
+
+        if not valid_trusted_mail_server(val):
+            raise ValueError("Incoming mail server identity must be a server name")
+        return str(val).lower()
+    text = str(val)
+    if len(text) > field.get("max_length", 2048):
+        raise ValueError(f"{field['label']} is too long")
+    pattern = field.get("pattern")
+    if pattern and not re.fullmatch(pattern, text):
+        raise ValueError(field.get("error", f"Check {field['label'].lower()}"))
+    return text
+
