+def _channel_people_value(name: str, value: object) -> list[str]:
+    access = CHANNEL_ALLOWLISTS[name]
+    pattern, error = access[5], access[6]
+    entries = (re.split(r"[,\r\n]+", value) if isinstance(value, str)
