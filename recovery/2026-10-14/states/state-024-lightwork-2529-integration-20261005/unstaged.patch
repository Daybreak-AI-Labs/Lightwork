+def list_action_episode_dependents(request: Request, flow_id: FlowPath, run_id: RunPath):
+    """Find saved owner workflows whose signed learning uses this example."""
+    from maverick.paths import tenant_scope
+
+    from .api_flow_recipe_lineage import _service as lineage_service_for_request
+
+    episodes, ctx = _call(lambda: _service(request, flow_id))
+    source = _call(lambda: episodes.get(ctx, flow_id, run_id))
+    if source.get("audit_status") != "delivered":
+        return JSONResponse({"available": False, "complete": False, "workflows": [],
+            "message": "The example's activity record is still being confirmed. Refresh before checking saved workflows."},
+            status_code=503, headers={"Cache-Control": "no-store"})
+    if not source.get("grant_sha256"):
+        return JSONResponse({"available": True, "complete": True, "workflows": [],
+            "message": "This example has not been allowed for learning."}, headers={"Cache-Control": "no-store"})
+    lineage_service, lineage_ctx = _call(lambda: lineage_service_for_request(request))
+    if ((lineage_ctx.tenant, lineage_ctx.actor, lineage_ctx.resource_owner)
+            != (ctx.tenant, ctx.actor, ctx.resource_owner)):
+        raise HTTPException(403, "Example access changed. Refresh before continuing.")
+    started = time.monotonic()
+    with tenant_scope(tenant=ctx.tenant):
+        candidates, workflows, complete = _scan_owner_workflow_lineages(request, ctx.resource_owner, started)
+    matches, matching_lineages, lineage_complete = _matching_episode_lineages(
+        lineage_service, lineage_ctx, source["id"], candidates, started)
+    complete = complete and lineage_complete
+    verified, flow_complete = _verified_dependent_workflows(
+        request, ctx, matches, matching_lineages, workflows)
+    complete = complete and flow_complete
+    latest = _call(lambda: episodes.get(ctx, flow_id, run_id))
+    if latest.get("id") != source.get("id") or latest.get("revision") != source.get("revision"):
+        raise HTTPException(409, "This example changed during the check. Refresh and try again.")
+    checked_at = time.time()
+    _call(lambda: _record_dependent_workflow_check(ctx, source, complete, verified, workflows, checked_at))
+    message = ("These saved workflow versions are linked to this example. Review each one before relying on it." if verified else
+        "No linked saved workflow was found in the history Lightwork could check. Downloaded copies are not included." if complete else
+        "Lightwork couldn't check all saved workflow history. Any linked versions found are listed; an empty or partial list doesn't mean no copies exist.")
+    return JSONResponse({"available": True, "complete": complete, "workflows": verified,
+        "message": message + " The check was recorded in the activity log.", "checked_at": checked_at},
+        headers={"Cache-Control": "private, no-store"})
